+				dA = A; dB = B; dsx = sx; dsy = sy; dcx = cx; dcy = cy;
+				bool is_cam = s.cam.valid && same(A, s.cam.A) && same(B, s.cam.B);
+				if (!s.cam_this_frame && color_key != ~0ull && surface_w && surface_h && A < 0.f && B < 0.f && sx > 0.2f && sx < 8.f && sy > 0.2f && sy < 8.f &&
+					std::fabs((sy / sx) / (static_cast<f32>(surface_w) / surface_h) - 1.f) < 0.12f)
