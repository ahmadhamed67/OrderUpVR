+		// Live status for the launcher (log/orderup_status.txt, once a second): what the game and the headset are doing.
+		// Written even while the headset is off, so the launcher always knows the game is running.
+		void write_status(xr_state& xr)
+		{
+			{
+				static u64 last_status = 0, last_frames = 0;
+				const u64 now_st = GetTickCount64();
+				if (now_st - last_status >= 1000)
+				{
+					cam_info cs;
+					u64 frames = 0;
+					{
+						std::lock_guard lock(g_state_mutex);
+						cs = g_cam;
+						frames = g_frame_id;
+					}
+					const u64 last_frame = g_last_frame_tick.load();
+					const f32 fps = last_status ? (frames - last_frames) * 1000.f / (now_st - last_status) : 0.f;
+					last_frames = frames;
+					last_status = now_st;
+					const std::string tmp = fs::get_log_dir() + "orderup_status.tmp", dst = fs::get_log_dir() + "orderup_status.txt";
+					if (std::FILE* f = std::fopen(tmp.c_str(), "w"))
+					{
+						std::fprintf(f, "time=%llu\nsession=%d\ngame_frames=%llu\npicture_fps=%.1f\npicture_age_ms=%lld\nchannel=%s\nchoosing=%d\nmode=%s\nview=%s\nscene3d=%d\ncinema=%d\npaused=%d\npanel=%s\ncalibrated=%d\n",
+							static_cast<unsigned long long>(now_st), static_cast<int>(xr.session_state), static_cast<unsigned long long>(frames), fps,
+							last_frame ? static_cast<long long>(now_st - last_frame) : -1ll, xr.channel.c_str(), xr.chooser_active ? 1 : 0,
+							xr.chooser_active ? "none" : xr.mode3d ? "truevr" : "flat", xr.live3d ? "3d" : "screen", cs.valid ? 1 : 0, cs.cinema ? 1 : 0,
+							cs.hud_seen[3] > 0 ? 1 : 0, xr.panel_text.empty() ? "" : std::string(xr.panel_title.begin(), xr.panel_title.end()).c_str(), g_calib_tick.load() ? 1 : 0);
+						std::fclose(f);
+						MoveFileExA(tmp.c_str(), dst.c_str(), MOVEFILE_REPLACE_EXISTING);
+					}
+				}
+			}
+
+		}
