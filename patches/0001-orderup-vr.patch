+		// ---- The EXIT button. Reach up over your left shoulder, close your left hand (GRIP) there and keep it closed for
+		// a moment (0.4 s, you feel it build up): a big red push button comes out in the middle of your left palm, with a
+		// pop. GRIP again puts it away (a pop and a puff of cloud). Push its red cap down with a finger of your right hand:
+		// it follows your finger, and near the bottom it snaps down the last 2 mm with a click and a strong buzz - that
+		// full press closes the game at once (the headset goes black straight away). Let go before that and the cap springs
+		// back up. A quick grip near your shoulder (taking food, swinging your arm) does nothing, and nothing comes out
+		// while either hand holds food.
+		constexpr u64 xb_take_ms = 400;                         // GRIP held over your shoulder this long takes it out
+		constexpr f32 xb_base_r = 0.045f, xb_base_h = 0.03f;   // the white base
+		constexpr f32 xb_cap_r = 0.034f, xb_cap_h = 0.018f;    // the red cap on it
+		constexpr f32 xb_cap_top = xb_base_h + xb_cap_h;      // top of the cap above the base's bottom centre, at rest
+		constexpr f32 xb_travel = 0.010f;                       // how far the cap goes down
+		constexpr f32 xb_snap = 0.002f;                         // the last bit of the travel the cap snaps down on its own
+		constexpr f32 xb_over = 0.003f;                         // how far the cap may spring up past its rest
+
+		// The EXIT button's full press: the headset shows black from the next frame on and the process ends at once
+		std::atomic<bool> g_quit_now{false};
+		std::atomic<int> g_quit_black_frames{0};   // black frames shown since
+
+		// Your left shoulder (the same place the chef's arm hangs from), scaled with you
+		vec3 left_shoulder(const xr_state& xr)
+		{
+			const XrQuaternionf hq = xr.views_valid ? xr.views[0].pose.orientation : XrQuaternionf{0, 0, 0, 1};
+			return chef::real_shoulder(xr.last_head, hq, xr.body_yaw, xr.unit * chef_eye_u, 0);
+		}
+
+		// Your left hand is over your left shoulder: beside or above it (not more than 2 cm below its top), and not out in
+		// front of it. loose: the wider zone that keeps a hand counted as there once it is (and that keeps a grip there
+		// from being a press for the game).
+		bool exit_zone(const xr_state& xr, bool loose)
+		{
+			if (!xr.hand_valid[0]) return false;
+			const f32 k = std::clamp(xr.unit * chef_eye_u / 1.6f, 0.7f, 1.3f);
+			const vec3 d = to_vec(xr.hand_pose[0].position) - left_shoulder(xr);
+			const vec3 fb{-std::sin(xr.body_yaw), 0.f, -std::cos(xr.body_yaw)};
+			const f32 r = (loose ? 0.32f : 0.25f) * k;
+			if (dot(d, d) > r * r) return false;
+			if (d.y < (loose ? -0.08f : -0.02f) * k) return false;        // over the shoulder, not hanging beside it
+			return dot(d, fb) < (loose ? 0.16f : 0.08f) * k;              // at or behind it, not reaching forward
+		}
+
+		bool chef_hands_shown();
+
+		// Where the button sits: in your left hand, standing on your curled fingers and facing the way your palm faces
+		// (turn your palm up and the button stands upright on it). c is the centre of the base's bottom, up its axis.
+		bool exit_button_frame(const xr_state& xr, vec3& c, vec3& up)
+		{
+			if (!xr.hand_valid[0]) return false;
+			const XrPosef& g = xr.hand_pose[0];
+			// Your real palm is wrapped round the controller's handle, so the button cannot stand in it: it stands on the
+			// outside of your curled fingers instead (the side your palm faces, the grip pose's +X), its base 5 cm out from
+			// the handle's middle (more for a big chef hand), so its cap is clear of your hand and the controller and your
+			// right fingertip can push it down without the two controllers knocking. The same spot for the chef hand and
+			// the mod's hand.
+			const f32 s = chef_hands_shown() ? std::clamp(xr.unit, 0.6f, 1.5f) : 1.f;
+			up = normalize(rotate(g.orientation, {1.f, 0.f, 0.f}));
+			c = to_vec(g.position) + up * (0.05f * std::max(1.f, s));
+			return true;
+		}
+
+		// A short pop, made on the spot (no sound files are shipped): rising when the button comes out, falling when it goes
+		void play_pop(bool out)
+		{
+			static std::vector<u8> wav[2];
+			auto& w = wav[out ? 1 : 0];
+			if (w.empty())
+			{
+				const u32 rate = 22050, n = rate * 18 / 100;
+				w.resize(44 + n * 2);
+				const auto put32 = [&](size_t o, u32 v) { std::memcpy(&w[o], &v, 4); };
+				const auto put16 = [&](size_t o, u16 v) { std::memcpy(&w[o], &v, 2); };
+				std::memcpy(&w[0], "RIFF", 4); put32(4, 36 + n * 2); std::memcpy(&w[8], "WAVEfmt ", 8);
+				put32(16, 16); put16(20, 1); put16(22, 1); put32(24, rate); put32(28, rate * 2); put16(32, 2); put16(34, 16);
+				std::memcpy(&w[36], "data", 4); put32(40, n * 2);
+				u32 seed = 12345;
+				f32 ph = 0.f;
+				for (u32 i = 0; i < n; i++)
+				{
+					const f32 t = static_cast<f32>(i) / rate;
+					const f32 f = out ? 300.f + 900.f * std::min(1.f, t / 0.06f) : 900.f - 700.f * std::min(1.f, t / 0.08f);
+					ph += 6.2831853f * f / rate;
+					seed = seed * 1664525u + 1013904223u;
+					const f32 noise = (static_cast<f32>(seed >> 9) / 4194304.f - 1.f) * std::exp(-t * 90.f);
+					const f32 env = std::min(1.f, t * 400.f) * std::exp(-t * 28.f);
+					const f32 v = (std::sin(ph) * 0.8f + noise * 0.5f) * env;
+					put16(44 + i * 2, static_cast<u16>(static_cast<s16>(std::clamp(v, -1.f, 1.f) * 26000.f)));
+				}
+			}
+			PlaySoundW(reinterpret_cast<LPCWSTR>(w.data()), nullptr, SND_MEMORY | SND_ASYNC | SND_NODEFAULT);
+		}
+
+		// The sharp click of the cap snapping down (made on the spot too): a short bright tick over a low knock, 60 ms
+		void play_click()
+		{
+			static std::vector<u8> w;
+			if (w.empty())
+			{
+				const u32 rate = 22050, n = rate * 6 / 100;
+				w.resize(44 + n * 2);
+				const auto put32 = [&](size_t o, u32 v) { std::memcpy(&w[o], &v, 4); };
+				const auto put16 = [&](size_t o, u16 v) { std::memcpy(&w[o], &v, 2); };
+				std::memcpy(&w[0], "RIFF", 4); put32(4, 36 + n * 2); std::memcpy(&w[8], "WAVEfmt ", 8);
+				put32(16, 16); put16(20, 1); put16(22, 1); put32(24, rate); put32(28, rate * 2); put16(32, 2); put16(34, 16);
+				std::memcpy(&w[36], "data", 4); put32(40, n * 2);
+				u32 seed = 777;
+				for (u32 i = 0; i < n; i++)
+				{
+					const f32 t = static_cast<f32>(i) / rate;
+					seed = seed * 1664525u + 1013904223u;
+					const f32 noise = (static_cast<f32>(seed >> 9) / 4194304.f - 1.f) * std::exp(-t * 700.f);
+					const f32 tick = std::sin(6.2831853f * 3200.f * t) * std::exp(-t * 260.f);
+					const f32 knock = std::sin(6.2831853f * 180.f * t) * std::exp(-t * 70.f);
+					const f32 v = noise * 0.7f + tick * 0.5f + knock * 0.6f;
+					put16(44 + i * 2, static_cast<u16>(static_cast<s16>(std::clamp(v, -1.f, 1.f) * 28000.f)));
+				}
+			}
+			PlaySoundW(reinterpret_cast<LPCWSTR>(w.data()), nullptr, SND_MEMORY | SND_ASYNC | SND_NODEFAULT);
+		}
+
+		// Close the game now (the EXIT button's full press, the diner's EXIT sign). The headset shows black from the next
+		// frame on, what the live test stream still holds goes out (at most 300 ms), and the process ends straight away:
+		// no waiting for the emulator to shut down (which took 3-5 s).
+		void quit_now(const char* why)
+		{
+			if (g_quit_now.exchange(true)) return;
+			vr_log("Exit: %s - the view goes black and the game closes now", why);
+			std::thread([]
+			{
+				const u64 t0 = GetTickCount64();
+				live::flush_now(300);
+				// the black frame is on the headset and the click has sounded (at most 150 ms more)
+				while ((g_quit_black_frames.load() < 2 || GetTickCount64() - t0 < 120) && GetTickCount64() - t0 < 450) Sleep(5);
+				// The game may be saving your progress right now (it autosaves after a kitchen): wait for that to finish
+				// (up to 5 s more) so the save is never cut off half written
+				if (g_savedata_ops.load() > 0)
+				{
+					vr_log("Exit: the game is saving - waiting for the save to finish before closing");
+					const u64 w0 = GetTickCount64();
+					while (g_savedata_ops.load() > 0 && GetTickCount64() - w0 < 5000) Sleep(10);
+					vr_log("Exit: %s after %llu ms", g_savedata_ops.load() > 0 ? "the save is still running (a save dialog?), closing anyway" : "the save finished",
+						static_cast<unsigned long long>(GetTickCount64() - w0));
+					Sleep(100);   // the last file is closed and on disk
+				}
+				vr_log("Exit: closing the process (%llu ms after the press)", static_cast<unsigned long long>(GetTickCount64() - t0));
+				TerminateProcess(GetCurrentProcess(), 0);
+			}).detach();
+		}
+
+		void buzz(xr_state& xr, int hand, f32 amplitude, int ms);
+
+		// Every frame (input): take out, put away, squeeze
+		void update_exit_button(xr_state& xr, u64 now_ms)
+		{
+			const bool lg = xr.hand_grip[0] > 0.6f;
+			const bool l_press = lg && !xr.xb_lgrip_prev;
+			xr.xb_lgrip_prev = lg;
+			vec3 c, up;
+			if (!exit_button_frame(xr, c, up)) { xr.xb_squeeze_since = xr.xb_arm_since = xr.xb_snap_since = 0; xr.xb_from_top = false; xr.xb_push = 0.f; xr.xb_cap_tick = now_ms; return; }
+			if (xr.xb_out) xr.xb_pos = c;
+			// (food in either hand: your grips are for the food, nothing comes out)
+			const bool food = xr.grab_has || xr.grab_wait;
+			if (l_press)
+			{
+				if (!xr.xb_out && exit_zone(xr, false) && !food)
+				{
+					// GRIP closed over your shoulder: it comes out if you keep it closed there a moment
+					xr.xb_arm_since = now_ms;
+					xr.xb_arm_tick = 0;
+				}
+				else if (xr.xb_out && now_ms - xr.xb_since > 300)
+				{
+					xr.xb_out = false; xr.xb_puff_tick = now_ms; xr.xb_puff_pos = c; xr.xb_squeeze_since = 0; play_pop(false);
+					xr.xb_depress = xr.xb_cap_v = xr.xb_push = xr.xb_push_max = 0.f;
+					vr_log("Exit button: put away");
+				}
+			}
+			if (xr.xb_arm_since && !xr.xb_out)
+			{
+				const u64 held = now_ms - xr.xb_arm_since;
+				if (!lg || !exit_zone(xr, true) || food)
+				{
+					// let go too soon, or the hand moved away from the shoulder: nothing happens
+					vr_log("Exit button: not taken out (%s after %.2f s; keep GRIP closed over your shoulder for %.1f s)",
+						food ? "food in your hand" : !lg ? "GRIP opened" : "hand left the shoulder", held / 1000.f, xb_take_ms / 1000.f);
+					xr.xb_arm_since = 0;
+				}
+				else if (held >= xb_take_ms)
+				{
+					xr.xb_arm_since = 0;
+					xr.xb_out = true; xr.xb_since = now_ms; xr.xb_pos = c; play_pop(true);
+					xr.xb_depress = xr.xb_cap_v = xr.xb_push = xr.xb_push_max = 0.f;
+					buzz(xr, 0, 0.6f, 90);
+					vr_log("Exit button: taken out over the left shoulder (GRIP held there %.2f s)", held / 1000.f);
+				}
+				else if (now_ms - xr.xb_arm_tick >= 90)
+				{
+					// a little buzz that grows while it builds up
+					xr.xb_arm_tick = now_ms;
+					buzz(xr, 0, 0.08f + 0.3f * static_cast<f32>(held) / xb_take_ms, 25);
+				}
+			}
+			// A real push button with a spring under its red cap. The cap goes down as far as a fingertip (or the palm) of
+			// your right hand pushes it from above, so it follows your finger down. When your finger has it within 2 mm of the
+			// bottom it snaps down the rest on its own, with a click and a strong buzz in both hands: that is the full press,
+			// and the game closes at once. Let go before that and the spring pushes the cap back up, a little past its rest
+			// and back, and the game goes on.
+			const u64 last_tick = xr.xb_cap_tick;
+			xr.xb_cap_tick = now_ms;
+			const f32 dt = last_tick ? std::clamp(static_cast<f32>(now_ms - last_tick) / 1000.f, 0.f, 0.05f) : 0.f;
+			f32 push = 0.f;
+			if (xr.xb_out && xr.hand_valid[1] && now_ms - xr.xb_since > 600)
+			{
+				const hand_geo r = make_hand(xr.hand_pose[1], 1, xr.hand_grip[1], xr.hand_trig[1]);
+				vec3 pts[6];
+				for (int f = 0; f < 5; f++) pts[f] = r.joints[f][3];
+				pts[5] = r.palm;
+				f32 deepest = 0.f;
+				for (const vec3& p : pts)
+				{
+					const vec3 d = p - c;
+					const f32 h = dot(d, up);                      // height above the base's bottom centre
+					const vec3 radial = d - up * h;
+					if (dot(radial, radial) > xb_cap_r * xb_cap_r) continue;   // not over the cap
+					const f32 into = xb_cap_top - (h - 0.008f);     // fingertip radius ~8 mm
+					if (into > 0.f && into < 0.04f) deepest = std::max(deepest, into);
+				}
+				// Only a finger that comes down onto the cap's top pushes it: one that slides in from the side or comes up
+				// from below (or a tracking jump) is already deep on its first touch and does nothing until it leaves the
+				// cap. And the cap follows the finger down at most 4 mm a frame, so it is always pushed down bit by bit.
+				if (deepest <= 0.f) xr.xb_from_top = false;
+				else if (!xr.xb_from_top && deepest <= std::max(0.f, xr.xb_depress) + 0.004f) xr.xb_from_top = true;
+				if (xr.xb_from_top) push = std::min({deepest, xb_travel, std::max(0.f, xr.xb_depress) + 0.004f});
+			}
+			else xr.xb_from_top = false;
+			xr.xb_push = push;
+			if (!xr.xb_out)
+			{
+				xr.xb_depress = xr.xb_cap_v = xr.xb_push_max = 0.f;
+				xr.xb_squeeze_since = xr.xb_snap_since = 0;
+				return;
+			}
+			if (xr.exit_done || g_quit_now.load())
+			{
+				xr.xb_depress = xb_travel;   // it stays down
+				xr.xb_cap_v = 0.f;
+				return;
+			}
+			// The cap must stay at the snap depth for 3 frames or so (60 ms) before it snaps: a brush does nothing
+			if (push >= xb_travel - xb_snap) { if (!xr.xb_snap_since) xr.xb_snap_since = now_ms; }
+			else xr.xb_snap_since = 0;
+			if (xr.xb_snap_since && now_ms - xr.xb_snap_since >= 60)
+			{
+				// The snap and click at the bottom: the full press
+				xr.xb_depress = xb_travel;
+				xr.xb_cap_v = 0.f;
+				xr.exit_done = true;
+				play_click();
+				buzz(xr, 1, 1.f, 90);
+				buzz(xr, 0, 0.8f, 70);
+				quit_now("the player pushed the EXIT button all the way down");
+				return;
+			}
+			if (push > 0.f && push >= xr.xb_depress)
+			{
+				// Your finger holds the cap down this far
+				xr.xb_depress = push;
+				xr.xb_cap_v = 0.f;
+			}
+			else if (dt > 0.f)
+			{
+				// The spring pushes it up towards your finger (or its rest): free of your finger it goes a little past the
+				// rest and settles back (a lightly damped spring, about 8 bounces a second)
+				constexpr f32 w = 50.f, zeta = 0.45f, step = 0.002f;
+				for (f32 left = dt; left > 1e-5f; left -= step)
+				{
+					const f32 h = std::min(step, left);
+					const f32 a = -w * w * (xr.xb_depress - push) - 2.f * zeta * w * xr.xb_cap_v;
+					xr.xb_cap_v += a * h;
+					xr.xb_depress += xr.xb_cap_v * h;
+					if (push > 0.f && xr.xb_depress < push) { xr.xb_depress = push; xr.xb_cap_v = 0.f; }   // it stops at your finger
+					if (xr.xb_depress < -xb_over) { xr.xb_depress = -xb_over; xr.xb_cap_v = 0.f; }
+				}
+				if (push <= 0.f && std::fabs(xr.xb_depress) < 0.0001f && std::fabs(xr.xb_cap_v) < 0.005f) xr.xb_depress = xr.xb_cap_v = 0.f;
+			}
+			if (push > 0.002f)
+			{
+				if (!xr.xb_squeeze_since) { xr.xb_squeeze_since = now_ms; vr_log("Exit button: being pushed"); }
+				xr.xb_push_max = std::max(xr.xb_push_max, push);
+			}
+			else if (push <= 0.f && xr.xb_squeeze_since)
+			{
+				vr_log("Exit button: let go %.1f mm down (it closes the game %.1f mm down), it springs back up and the game goes on",
+					xr.xb_push_max * 1000.f, (xb_travel - xb_snap) * 1000.f);
+				xr.xb_squeeze_since = 0;
+				xr.xb_push_max = 0.f;
+			}
+		}
