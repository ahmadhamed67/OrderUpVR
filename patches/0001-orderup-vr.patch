+		vec3 to_player(const xr_state& xr, vec3 local) { return rotate(qconj(yaw_q(xr.player_yaw)), local - xr.player_pos); }
+		vec3 from_player(const xr_state& xr, vec3 rel) { return xr.player_pos + rotate(yaw_q(xr.player_yaw), rel); }
