+		// Rotation that takes the unit vector u onto +Y (sign = -1: the inverse rotation).
+		vec3 level(vec3 u, vec3 v, f32 sign = 1.f)
+		{
+			const vec3 a = cross(u, {0.f, 1.f, 0.f});
+			const f32 s = std::sqrt(dot(a, a)) * sign, c = u.y;
+			if (std::fabs(s) < 1e-6f) return c >= 0.f ? v : vec3{v.x, -v.y, -v.z};
+			const vec3 k = a * (1.f / std::fabs(s));
+			return v * c + cross(k, v) * s + k * (dot(k, v) * (1.f - c));
+		}
