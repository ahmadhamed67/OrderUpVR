+		// ---- Quick setup: the VR settings, presented one by one after PLAY (like other VR games), the same choices as the
+		// launcher's Settings. A choice takes effect at once (config/orderupvr_comfort_vr.txt, read with the launcher's
+		// file; the launcher takes them over when it next starts). "Don't show this again" ends it for good; the launcher
+		// can bring it back.
+		struct setup_opt { const char* key; const wchar_t* title; const wchar_t* hint; const char* def; std::vector<std::pair<const char*, const wchar_t*>> opts; };
+		const std::vector<setup_opt>& setup_table()
+		{
+			static const std::vector<setup_opt> t = {
+				{"playmode", L"Play position", L"Seated keeps the kitchen at a comfortable height while you sit", "standing", {{"standing", L"Standing"}, {"seated", L"Seated"}}},
+				{"turn", L"Turning", L"How the right stick turns you", "snap", {{"snap", L"Snap"}, {"smooth", L"Smooth"}}},
+				{"snapangle", L"Snap angle", L"How far one flick of the right stick turns you", "45", {{"15", L"15\u00B0"}, {"30", L"30\u00B0"}, {"45", L"45\u00B0"}, {"60", L"60\u00B0"}, {"90", L"90\u00B0"}}},
+				{"turnspeed", L"Turn speed", L"How fast smooth turning goes", "120", {{"60", L"Slow"}, {"90", L"Gentle"}, {"120", L"Medium"}, {"180", L"Fast"}, {"240", L"Very fast"}}},
+				{"movespeed", L"Walking speed", L"How fast the left stick walks you", "1.4", {{"1.0", L"Slow"}, {"1.4", L"Normal"}, {"2.0", L"Fast"}}},
+				{"vignette", L"Comfort vignette", L"Darkens the edges of your view while the stick moves you", "on", {{"on", L"On"}, {"off", L"Off"}}},
+				{"menuchef", L"Your chef", L"Your body in VR, everywhere in the game", "male", {{"male", L"Male"}, {"female", L"Female"}}},
+				{"lipsync", L"Lip sync", L"Your chef's mouth moves when you talk (nothing is recorded)", "on", {{"on", L"On"}, {"off", L"Off"}}},
+			};
+			return t;
+		}
+		std::vector<const setup_opt*> setup_steps(const xr_state& xr)
+		{
+			std::vector<const setup_opt*> v;
+			const auto it = xr.setup_vals.find("turn");
+			const bool smooth = it != xr.setup_vals.end() && it->second == "smooth";
+			for (const auto& o : setup_table())
+			{
+				if (!std::strcmp(o.key, "snapangle") && smooth) continue;
+				if (!std::strcmp(o.key, "turnspeed") && !smooth) continue;
+				v.push_back(&o);
+			}
+			return v;
+		}
+		std::string setup_val(const xr_state& xr, const setup_opt& o)
+		{
+			const auto it = xr.setup_vals.find(o.key);
+			return it != xr.setup_vals.end() ? it->second : std::string(o.def);
+		}
+		ui::card setup_card(const xr_state& xr)
+		{
+			const auto steps = setup_steps(xr);
+			const int n = static_cast<int>(steps.size()), k = std::clamp(xr.setup_step, 0, n - 1);
+			const setup_opt& o = *steps[k];
+			ui::card c;
+			c.style = ui::card::SETUP;
+			c.kicker = L"QUICK SETUP  \u00B7  " + std::to_wstring(k + 1) + L" OF " + std::to_wstring(n);
+			c.title = o.title;
+			c.subtitle = o.hint;
+			const std::string cur = setup_val(xr, o);
+			for (usz i = 0; i < o.opts.size(); i++)
+			{
+				c.rows.push_back({o.opts[i].second, L""});
+				if (cur == o.opts[i].first) c.selected = static_cast<int>(i);
+			}
+			c.hover = xr.chooser_hover;
+			c.disabled = k == 0 ? 100 : -1;
+			c.progress_label = k == n - 1 ? L"Done" : L"Next";
+			c.check = xr.setup_hide;
+			c.tip = L"Point and pull the TRIGGER  \u00B7  you can change these any time in the launcher's Settings";
+			return c;
+		}
+		void setup_write(const xr_state& xr)
+		{
+			if (std::FILE* f = std::fopen((fs::get_config_dir(true) + "orderupvr_comfort_vr.txt").c_str(), "w"))
+			{
+				for (const auto& [k, v] : xr.setup_vals) std::fprintf(f, "%s=%s\n", k.c_str(), v.c_str());
+				std::fclose(f);
+			}
+		}
+		// Reads key=value lines of one of the launcher's files into kv (later files override earlier ones)
+		void read_kv(const char* name, std::map<std::string, std::string>& kv)
+		{
+			if (std::FILE* f = open_launcher_file(name))
+			{
+				char line[256];
+				while (std::fgets(line, sizeof(line), f))
+				{
+					std::string l(line);
+					while (!l.empty() && (l.back() == 10 || l.back() == 13 || l.back() == 32)) l.pop_back();
+					if (const usz eq = l.find('='); eq != std::string::npos) kv[l.substr(0, eq)] = l.substr(eq + 1);
+				}
+				std::fclose(f);
+			}
+		}
