+		// Draws a card (see OrderUpVR_ui.inl) and uploads it to its swapchain (premultiplied alpha).
+		void draw_card(xr_state& xr, XrSwapchain& sc, std::vector<XrSwapchainImageD3D11KHR>& images, bool& is_bgra, bool& has_image, u32 cw, u32 ch, const ui::card& card)
+		{
+			if (sc == XR_NULL_HANDLE)
+			{
+				const s64 format = pick_format(xr, is_bgra);
+				if (!format) return;
+
+				XrSwapchainCreateInfo info{XR_TYPE_SWAPCHAIN_CREATE_INFO};
+				info.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_SAMPLED_BIT;
+				info.format = format;
+				info.sampleCount = 1;
+				info.width = cw;
+				info.height = ch;
+				info.faceCount = 1;
+				info.arraySize = 1;
+				info.mipCount = 1;
+				if (!xr_ok(xr, xrCreateSwapchain(xr.session, &info, &sc), "xrCreateSwapchain(card)")) return;
+
+				u32 count = 0;
+				xrEnumerateSwapchainImages(sc, 0, &count, nullptr);
+				images.assign(count, XrSwapchainImageD3D11KHR{XR_TYPE_SWAPCHAIN_IMAGE_D3D11_KHR});
+				if (!xr_ok(xr, xrEnumerateSwapchainImages(sc, count, &count,
+					reinterpret_cast<XrSwapchainImageBaseHeader*>(images.data())), "xrEnumerateSwapchainImages(card)"))
+				{
+					xrDestroySwapchain(sc);
+					sc = XR_NULL_HANDLE;
+					return;
+				}
+			}
+
+			std::vector<u8> px;
+			if (!ui::render(card, cw, ch, px)) { vr_log("Card: could not draw \"%s\"", fmt::format("%s", std::string(card.title.begin(), card.title.end())).c_str()); return; }
+			if (!is_bgra) for (usz i = 0; i + 3 < px.size(); i += 4) std::swap(px[i], px[i + 2]);
+
+			u32 index = 0;
+			XrSwapchainImageAcquireInfo acquire{XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+			if (XR_SUCCEEDED(xrAcquireSwapchainImage(sc, &acquire, &index)))
+			{
+				XrSwapchainImageWaitInfo wait{XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO};
+				wait.timeout = XR_INFINITE_DURATION;
+				if (XR_SUCCEEDED(xrWaitSwapchainImage(sc, &wait)))
+				{
+					xr.context->UpdateSubresource(images[index].texture, 0, nullptr, px.data(), cw * 4, 0);
+					has_image = true;
+				}
+				XrSwapchainImageReleaseInfo release{XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+				xrReleaseSwapchainImage(sc, &release);
+			}
+		}
