+				u32 count = 0;
+				xrEnumerateSwapchainImages(sc, 0, &count, nullptr);
+				imgs.assign(count, XrSwapchainImageD3D11KHR{XR_TYPE_SWAPCHAIN_IMAGE_D3D11_KHR});
+				return xr_ok(xr, xrEnumerateSwapchainImages(sc, count, &count, reinterpret_cast<XrSwapchainImageBaseHeader*>(imgs.data())), "xrEnumerateSwapchainImages(body)");
+			};
+			g.ew = g.bw;
+			g.eh = g.bh;
+			for (int e = 0; e < 2 && ok; e++)
+			{
+				ok = make_sc(g.body_sc[e], g.body_img[e], g.bw, g.bh) && make_sc(g.env_sc[e], g.env_img[e], g.ew, g.eh);
+				D3D11_TEXTURE2D_DESC td{};
+				td.Width = g.bw; td.Height = g.bh; td.MipLevels = 1; td.ArraySize = 1; td.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
+				td.SampleDesc.Count = 1; td.Usage = D3D11_USAGE_DEFAULT; td.BindFlags = D3D11_BIND_DEPTH_STENCIL;
+				ok = ok && SUCCEEDED(dev->CreateTexture2D(&td, nullptr, &g.depth[e])) && SUCCEEDED(dev->CreateDepthStencilView(g.depth[e], nullptr, &g.dsv[e]));
+			}
+			g.ok = ok;
+			vr_log("Body and hands: %s (%ux%u per eye)", ok ? "ready" : "could not be set up", g.bw, g.bh);
+			return ok;
+		}
