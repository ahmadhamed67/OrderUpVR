+
+	// Every string in the UI scripts' string pools (the element names among them)
+	void load_names(const std::string& usrdir)
+	{
+		g.names_tried = true;
+		wad_reader w;
+		if (!w.open(usrdir + "Chef.wad")) return;
+		for (const auto& [pkg, file] : ui_scripts)
+		{
+			std::vector<u8> b;
+			if (!w.nested_file(pkg, file, b)) continue;
+			static const char mod[] = "<module>";
+			const auto it = std::search(b.begin(), b.end(), mod, mod + 8);
+			if (it == b.end()) continue;
+			usz p = static_cast<usz>(it - b.begin()) + 9;
+			while (p < b.size())
+			{
+				while (p < b.size() && b[p] == 0) p++;
+				usz e = p;
+				while (e < b.size() && b[e] != 0) e++;
+				if (e > p && e - p < 96)
+				{
+					const std::string s(reinterpret_cast<const char*>(&b[p]), e - p);
+					g.names.emplace(crc_name(s), s);
+				}
+				p = e + 1;
+			}
+		}
+		vr_log("UI tree: %zu names from the game's UI scripts", g.names.size());
+	}
+
+	bool readable(u32 a, u32 n) { return a >= 0x10000 && a < 0xc0000000 &&   /* the game heap lives above 0x30000000 */ vm::check_addr(a, vm::page_readable, n); }
+	u32 rd32(u32 a) { const u8* p = static_cast<const u8*>(vm::base(a)); return rd32be(p); }
+	f32 rdf(u32 a) { return std::bit_cast<f32>(rd32(a)); }
+
+	// The game's element classes (vtables seen in the live tree): panel, image, text, button, sprites
+	bool is_element_vt(u32 vt)
+	{
+		switch (vt)
+		{
+		case 0x342c40: case 0x342e00: case 0x342fc0: case 0x343238: case 0x343748: case 0x343880: case 0x343af0: return true;
+		default: return false;
+		}
+	}
+
+	// What an element is in VR, from its own name or the nearest parent with a telling name
+	u8 category_of(const std::string& name)
+	{
+		std::string n = name;
+		for (char& ch : n) ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+		const auto has = [&](const char* w) { return n.find(w) != std::string::npos; };
+		if (has("trash")) return C_TRASH;
+		if (has("plate") && !has("thermometer") && !has("meal")) return C_PLATE;
+		if (has("processor") && !has("timer")) return C_PROC;
+		if (has("oven") && !has("timer")) return C_OVEN;
+		if (has("big_ticket") || has("orderbig")) return C_RECIPE;
+		if (has("order_reel")) return C_TICKETS;
+		if (has("meter") || has("power") || has("thermometer")) return C_METER;
+		if (has("asstchef") || has("assistant")) return C_LEFT;
+		// (the utensil tips are text in a tip box: they stay with their box)
+		if (has("gesture") || (has("utensil") && !has("text")) || has("spice")) return C_RIGHT;
+		if (has("pause") || has("newspaper") || has("worldmap") || has("frontmenu") || has("mainmenu") || has("endofday") || has("saveload") ||
+			has("payphone") || has("option") || has("menu_") || has("_menu") || has("character") || has("profile") || has("dialog") || has("popup"))
+			return C_MENU;
+		return C_NONE;
+	}
+
+	// A button of a menu, from its name in the game's scripts (the scripts name them for what they do)
+	bool is_button_name(const std::string& name)
+	{
+		std::string n = name;
+		for (char& ch : n) ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+		if (n.find("background") != std::string::npos || n.find("_bg") != std::string::npos || n.find("shadow") != std::string::npos || n.find("title") != std::string::npos) return false;
+		static const char* words[] = {"button", "btn", "option", "item", "choice", "tab", "yes", "no_", "_no", "back", "ok", "confirm", "cancel",
+			"continue", "play", "start", "select", "arrow", "next", "prev", "slot", "quit", "resume", "retry", "restart", "accept", "skip", "icon_", "restaurant", "dish", "recipe"};
+		for (const char* w : words) if (n.find(w) != std::string::npos) return true;
+		if (n.find("district_panel") != std::string::npos || (n.find("_panel") != std::string::npos && n.find("info") == std::string::npos && n.find("worldmap") == std::string::npos && n.find("background") == std::string::npos && n.find("ui_panel") == std::string::npos && n.find("drag") == std::string::npos)) return true;
+		return n == "no";
+	}
+
+	struct card_t { f32 x0 = 0, y0 = 0, x1 = 0, y1 = 0; int gdepth = -1; int depth = 0; };
+	inline std::string ui_lines;   // named elements of this pass, for the live stream
+
+	void walk(u32 e, int depth, int& count, bool log, f32 pax, f32 pay, f32 paw, f32 pah, u8 cat, f32 rx0, f32 ry0, f32 rx1, f32 ry1, card_t card = {}, int parent = -1)
+	{
+		if (count > 900 || depth > 14 || !readable(e, 0x1a0)) return;
+		const u32 vt = rd32(e);
+		if (!is_element_vt(vt)) return;
+		count++;
+		const u32 nh = rd32(e + 0x14c);
+		const u8 flags = static_cast<const u8*>(vm::base(e + 0x180))[0];
+		const auto it = g.names.find(nh);
+		const f32 ox = rdf(e + 0x50) + rdf(e + 0xd0), oy = rdf(e + 0x54) + rdf(e + 0xd4);   // its offset in its parent
+		const f32 w = rdf(e + 0x78), h = rdf(e + 0x7c);
+		// Where it is on the screen (checked against the game's draws: the oven at offset -24 in the 1280-wide kitchen bar
+		// is drawn at 1094..1256): a negative offset counts from the parent's right / bottom edge, else from its left / top
+		const f32 x = ox < 0.f ? pax + paw + ox - w : pax + ox;
+		const f32 y = oy < 0.f ? pay + pah + oy - h : pay + oy;
+		if (log) std::fprintf(g.f, "%*s%s [%08x] vt %08x flags %02x%s at %.1f %.1f size %.1f %.1f (offset %.1f %.1f)",
+			depth * 2, "", it != g.names.end() ? it->second.c_str() : "?", nh, vt, flags, (flags & 4) ? " HIDDEN" : "", x, y, w, h, ox, oy);
+		if (flags & 4) { if (log) std::fprintf(g.f, "\n"); return; }   // hidden: neither it nor its children are drawn
+		// a telling name starts a group: this element's rectangle is the group's (it keeps its layout on its VR anchor)
+		if (it != g.names.end())
+		{
+			const u8 c = category_of(it->second);
+			// inside a menu (hiring assistants, buying spices) the assistants' and spices' pictures belong to that menu
+			const bool in_menu = cat == C_MENU && (c == C_TICKETS || c == C_LEFT || c == C_RIGHT || c == C_RECIPE);
+			if (c && c != cat && !in_menu && std::isfinite(w) && w > 4.f && h > 4.f) { cat = c; rx0 = x; ry0 = y; rx1 = x + w; ry1 = y + h; card = {x, y, x + w, y + h, depth, depth}; }
+			if (ui_lines.size() < 6000 && !(flags & 4))
+			{
+				char l[160];
+				std::snprintf(l, sizeof(l), "%d:%s c%d %.0f,%.0f %.0fx%.0f; ", depth, it->second.c_str(), cat, x, y, w, h);
+				ui_lines += l;
+			}
+		}
+		// a direct child of a group is one card of it (one ticket of the reel): its pieces move together
+		if (card.gdepth >= 0 && depth == card.gdepth + 1 && std::isfinite(w) && w > 4.f && h > 4.f) card = {x, y, x + w, y + h, card.gdepth, depth};
+		if (log) std::fprintf(g.f, " cat %d%s\n", cat, it != g.names.end() && is_button_name(it->second) ? " BUTTON" : "");
+		int me = parent;   // what this element's children sit in (an element too small to list passes its own parent on)
+		if (std::isfinite(x) && std::isfinite(y) && std::isfinite(w) && std::isfinite(h) && w > 0.5f && h > 0.5f && g.out.size() < 1200)
+		{
+			const bool named = it != g.names.end();
+			g.out.push_back({x, y, x + w, y + h, rx0, ry0, rx1, ry1, cat, static_cast<u8>(std::min(depth, 255)), named && is_button_name(it->second), card.x0, card.y0, card.x1, card.y1, static_cast<u8>(std::max(card.depth, 0)),
+				static_cast<s16>(parent), false, named, vt});
+			me = static_cast<int>(g.out.size()) - 1;
+			// at offset 0 a narrower element may be centred in its parent instead (the ticket reel's picture is): both are matched
+			// (the copy keeps the group and card of the element: the first ticket of the reel is at offset 0 too, and a
+			// centred copy of it must not become a second ticket)
+			if (ox == 0.f && w < paw - 1.f && g.out.size() < 1200)
+				g.out.push_back({pax + (paw - w) * 0.5f, y, pax + (paw + w) * 0.5f, y + h, rx0, ry0, rx1, ry1, cat, static_cast<u8>(std::min(depth, 255)), false, card.x0, card.y0, card.x1, card.y1, static_cast<u8>(std::max(card.depth, 0)),
+					static_cast<s16>(parent), true, named, vt});
+		}
+		// children: a circular list at +0x18c, only when it holds elements (images keep their texture there)
+		const u32 head = e + 0x18c;
+		u32 node = rd32(head);
+		for (int n = 0; n < 256 && node != head && readable(node, 8); n++)
+		{
+			const u32 child = rd32(node + 4);
+			if (!readable(child, 4) || !is_element_vt(rd32(child))) break;
+			walk(child, depth + 1, count, log, x, y, w, h, cat, rx0, ry0, rx1, ry1, card, me);
+			node = rd32(node);
+		}
+	}
+
+	// A dialog's card: a panel the scripts name, smaller than the screen (the kitchen's own bars and drag areas are full
+	// width or full height)
+	bool dialog_card(const elem& e)
+	{
+		const f32 w = e.x1 - e.x0, h = e.y1 - e.y0;
+		return e.cat == C_NONE && e.named && !e.dup && w >= 400.f && w < 1200.f && h >= 200.f && h <= 700.f;
+	}
+	// A menu of the game: the element whose name makes it one (it does not sit in another menu), big enough to be a menu
+	// (a small pause icon in a corner of the HUD is not one)
+	bool menu_root(const std::vector<elem>& el, usz i)
+	{
+		const elem& e = el[i];
+		if (e.cat != C_MENU || e.dup) return false;
+		if (e.parent >= 0 && static_cast<usz>(e.parent) < i && el[e.parent].cat == C_MENU) return false;
+		return (e.x1 - e.x0) * (e.y1 - e.y0) >= 0.04f * 1280.f * 720.f;
+	}
+	// A menu or a dialog of the game is on the screen (the stations stay, the menu comes within reach)
+	bool menu_open(const std::vector<elem>& el)
+	{
+		for (usz i = 0; i < el.size(); i++)
+			if (menu_root(el, i) || dialog_card(el[i])) return true;
+		return false;
+	}
+
+	// About 5 times a second while the game runs: the game's visible UI elements with their screen rectangles and what
+	// they are in VR (published for the renderer); in Experimental also the whole tree to log/orderup_ui.log every 3 s
+	void tick(const std::string& usrdir, bool experimental)
+	{
+		if (!g_game_known) return;
+		const u64 now = GetTickCount64();
+		if (now - g.last_labels < 200) return;
+		g.last_labels = now;
+		if (!g.names_tried && !usrdir.empty()) load_names(usrdir);
+		bool log = false;
+		if (experimental && now - g.last_dump >= 3000)
+		{
+			g.last_dump = now;
+			if (!g.f && !g.f_tried) { g.f_tried = true; g.f = std::fopen((fs::get_log_dir() + "orderup_ui.log").c_str(), "w"); }
+			log = g.f && std::ftell(g.f) < 12 * 1024 * 1024;
+		}
+		constexpr u32 sys_ptr = 0x0036df0c;
+		if (!readable(sys_ptr, 4)) return;
+		const u32 sys = rd32(sys_ptr);
+		if (!readable(sys, 0x80)) return;
+		if (log)
+		{
+			SYSTEMTIME t;
+			GetLocalTime(&t);
+			std::fprintf(g.f, "==== %02d:%02d:%02d menu system %08x\n", t.wHour, t.wMinute, t.wSecond, sys);
+		}
+		g.out.clear();
+		const u32 head = sys + 0x2c;
+		u32 node = rd32(head);
+		int count = 0;
+		for (int n = 0; n < 64 && node != head && readable(node, 8); n++)
+		{
+			const u32 menu = rd32(node + 4);
+			if (readable(menu, 0x20))
+			{
+				if (log) std::fprintf(g.f, "-- menu %08x root %08x\n", menu, rd32(menu + 0x10));
+				walk(rd32(menu + 0x10), 1, count, log, 0.f, 0.f, 1280.f, 720.f, C_NONE, 0.f, 0.f, 1280.f, 720.f);
+			}
+			node = rd32(node);
+		}
+		if (log) std::fflush(g.f);
+		{
+			static std::size_t last_hash = 0;
+			static u64 last_sent = 0;
+			const std::size_t hsh = std::hash<std::string>{}(ui_lines);
+			if (experimental && !ui_lines.empty() && hsh != last_hash && now - last_sent > 5000)
+			{
+				last_hash = hsh; last_sent = now;
+				for (std::size_t i = 0; i < ui_lines.size(); i += 900) vr_log("UI tree: %s", ui_lines.substr(i, 900).c_str());
+			}
+			ui_lines.clear();
+		}
+		auto fresh = std::make_shared<const std::vector<elem>>(g.out);
+		std::lock_guard lock(elems_mutex);
+		elems = std::move(fresh);
+	}
+}
diff --git a/rpcs3/Emu/Io/OrderUpVR_vrui.inl b/rpcs3/Emu/Io/OrderUpVR_vrui.inl
new file mode 100644
index 000000000..d829160b8
--- /dev/null
+++ b/rpcs3/Emu/Io/OrderUpVR_vrui.inl
@@ -0,0 +1,612 @@
+// Order Up VR: the VR UI framework, the 3D side (BLES01470).
+//
+// The game's own UI is read live from its memory (OrderUpVR_uitree.inl); the renderer moves each of the game's HUD
+// pictures to its place in your kitchen (stereo_draw_transform). This file builds the physical things around them:
+//  - menus within reach: a real key for every button of the open menu or dialog (from the game's UI tree): in the lobby
+//    on the menu stand at arm's length (a lectern whose sloping screen shows the game's menu), inside the game on the
+//    menu panel in front of you. The key lights up when you point at it, goes in as your fingertip pushes it, and the
+//    press goes to that button in the game (the game's pointer is put on the button's centre, then the game's select
+//    button is pressed);
+//  - the plate on the counter, the trash bin by your leg, the oven and the food processor: real objects at your
+//    counter's height, with the game's live picture of each standing on them as their sign; they glow while food you
+//    hold is over them;
+//  - the ticket rail: a steel rail the game's tickets hang from, each ticket on its own clip;
+//  - the HUD cards' holders (draw_cards): the assistants' stand, the shelf for the gesture, utensil and spice cards, and
+//    the clipboard in your left hand for the recipe card. The renderer draws each card of the game's HUD on its own plane
+//    there (rv_layout_cards) and tells where (cam.cards), so pointing and touching hit each card exactly where it is seen.
+//    The rail, the stand, the shelf and the clipboard are boards you can pick up by their frame (GRIP), carry and put down
+//    anywhere in the kitchen (update_boards in OrderUpVR.cpp); their cards go with them.
+// Everything is in your room (world-locked), sized in metres from your own height.
+//
+// The 3D layer is composited over the game's picture without a shared depth, so nothing here is drawn where a game
+// picture is seen through it: the objects stand in front of and below their signs, keys are frames around buttons.
+//
+// Included inside namespace ouvr { namespace { ... } } of OrderUpVR.cpp, before gfx_render.
+
+namespace vrui
+{
+	const vec3 wood{0.36f, 0.22f, 0.12f}, wood_dark{0.24f, 0.14f, 0.07f}, brass{0.80f, 0.62f, 0.28f}, glow{1.f, 0.86f, 0.35f},
+		go{0.45f, 1.f, 0.55f}, steel{0.70f, 0.72f, 0.76f}, dark{0.16f, 0.17f, 0.18f}, ceramic{0.94f, 0.94f, 0.91f};
+
+	vec3 mix(vec3 a, vec3 b, f32 t) { return a + (b - a) * t; }
+
+	// A rectangular frame around a rectangle (centre c, axes A right, B up, N towards you): bars t thick, d deep
+	void frame(xr_state& xr, vec3 c, vec3 A, vec3 B, vec3 N, f32 hw, f32 hh, f32 t, f32 d, vec3 col)
+	{
+		const vec3 cf = c + N * (d * 0.5f);
+		draw_boxo(xr, cf + B * (hh + t * 0.5f), A, B, N, {2.f * (hw + t), t, d}, col);
+		draw_boxo(xr, cf - B * (hh + t * 0.5f), A, B, N, {2.f * (hw + t), t, d}, col);
+		draw_boxo(xr, cf + A * (hw + t * 0.5f), A, B, N, {t, 2.f * hh, d}, col);
+		draw_boxo(xr, cf - A * (hw + t * 0.5f), A, B, N, {t, 2.f * hh, d}, col);
+	}
+
+	// A ring of short bars (a rim) in the plane of A and B
+	void ring(xr_state& xr, vec3 c, vec3 A, vec3 B, f32 r, f32 thick, vec3 col, int n = 24)
+	{
+		for (int i = 0; i < n; i++)
+		{
+			const f32 a0 = 6.2831853f * i / n, a1 = 6.2831853f * (i + 1) / n;
+			draw_limb(xr, c + (A * std::cos(a0) + B * std::sin(a0)) * r, c + (A * std::cos(a1) + B * std::sin(a1)) * r, thick, thick, col);
+		}
+	}
+
+	// ---- Menus within reach. The game's menus and dialogs (from its UI tree) have their buttons as keys: in the lobby on the
+	// menu stand at arm's length (the game's menu picture is its screen), inside the game on the menu panel that opens in
+	// front of you. Touch a key with a fingertip and push it in, or point at it and pull the TRIGGER: the game's pointer goes
+	// to the middle of that button and the game's select button presses it. A light tick when you reach a key, a firm one
+	// when it goes in.
+	constexpr f32 key_rise = 0.012f;                       // a key on the stand stands this high above its screen (m)
+	constexpr f32 key_base3 = 0.018f, key_rise3 = 0.010f;  // inside the game: the menu's pieces stack up in front of its panel
+	constexpr f32 stand_hw = 0.36f, stand_slope = 0.61f;   // the stand's screen: 0.72 m wide, sloping back 35 degrees
+	constexpr f32 stand_ahead = 0.44f, stand_below = 0.34f;   // in front of the spot you stand on, below your eyes (m)
+
+	// The game's buttons of its open menus and dialogs, as keys (ndc of the game's screen, y up), from its UI tree:
+	//  1. the elements its scripts name as buttons (ok_button, back_button, the world map's districts...);
+	//  2. the items of a list: two or more elements of the same size side by side or one below the other in the same parent
+	//     (the restaurants to pick, the lines of the title and pause menus);
+	//  3. the small elements in the lower part of a dialog's card (its OK, Yes, No).
+	// Only inside a menu or a dialog, and only where the game draws something (drawn, from the renderer: empty = not known).
+	// A key that holds two or more keys is only a box round them; a key inside another key is its label or picture.
+	void find_keys(const std::vector<uitree::elem>& el, const std::vector<u8>& drawn, std::vector<vr_button>& keys)
+	{
+		keys.clear();
+		const usz n = el.size();
+		if (!n) return;
+		// (nothing marked at all: the renderer could not see where the game's draws land, every element counts)
+		const bool know = drawn.size() == n && std::find(drawn.begin(), drawn.end(), u8{1}) != drawn.end();
+		std::vector<u8> shown(n, 1);   // the game draws it, or something in it
+		if (know)
+		{
+			for (usz i = 0; i < n; i++) shown[i] = drawn[i];
+			for (usz i = n; i-- > 0;)
+			{
+				const int p = el[i].parent;
+				if (shown[i] && p >= 0 && static_cast<usz>(p) < i) shown[p] = 1;
+			}
+		}
+		std::vector<int> root(n, -1), dlg(n, -1);   // the menu or dialog it is part of, the dialog's card it is on
+		for (usz i = 0; i < n; i++)
+		{
+			const int p = el[i].parent;
+			const bool pin = p >= 0 && static_cast<usz>(p) < i;
+			if (pin && root[p] >= 0) root[i] = root[p];
+			else if (uitree::menu_root(el, i) || uitree::dialog_card(el[i])) root[i] = static_cast<int>(i);
+			if (pin && dlg[p] >= 0) dlg[i] = dlg[p];
+			else if (uitree::dialog_card(el[i])) dlg[i] = static_cast<int>(i);
+		}
+		std::vector<vr_button> cand;
+		for (usz i = 0; i < n && cand.size() < 120; i++)
+		{
+			const auto& e = el[i];
+			if (root[i] < 0 || root[i] == static_cast<int>(i) || !shown[i]) continue;
+			const f32 w = e.x1 - e.x0, h = e.y1 - e.y0;
+			if (w < 16.f || h < 10.f || w * h > 0.5f * 1280.f * 720.f) continue;
+			if (e.x1 <= 0.f || e.y1 <= 0.f || e.x0 >= 1280.f || e.y0 >= 720.f) continue;   // off the screen (still sliding in)
+			u8 why = 0;
+			if (e.btn && w <= 1000.f && h <= 420.f) why = 1;
+			const int p = e.parent;
+			if (!why && !e.dup && p >= 0 && w >= 40.f && w <= 900.f && h >= 18.f && h <= 240.f &&
+				!(w >= 0.9f * (el[p].x1 - el[p].x0) && h >= 0.9f * (el[p].y1 - el[p].y0)))   // (not a background filling its parent)
+			{
+				for (usz j = 0; j < n; j++)
+				{
+					const auto& o = el[j];
+					if (j == i || o.parent != e.parent || o.dup || !shown[j]) continue;
+					const f32 wj = o.x1 - o.x0, hj = o.y1 - o.y0;
+					if (std::fabs(wj - w) > 0.1f * std::max(w, wj) + 3.f || std::fabs(hj - h) > 0.1f * std::max(h, hj) + 3.f) continue;
+					const f32 dx = std::fabs((o.x0 + o.x1) - (e.x0 + e.x1)) * 0.5f, dy = std::fabs((o.y0 + o.y1) - (e.y0 + e.y1)) * 0.5f;
+					if (dx > 0.5f * w || dy > 0.5f * h) { why = 2; break; }
+				}
+			}
+			if (!why && dlg[i] >= 0 && dlg[i] != static_cast<int>(i))
+			{
+				const auto& d = el[dlg[i]];
+				const f32 dw = d.x1 - d.x0, dh = d.y1 - d.y0, cy = (e.y0 + e.y1) * 0.5f;
+				if (cy > d.y0 + 0.55f * dh && w >= 40.f && w <= 0.6f * dw && h >= 18.f && h <= 160.f) why = 3;
+			}
+			if (why) cand.push_back({e.x0 / 640.f - 1.f, 1.f - e.y1 / 360.f, e.x1 / 640.f - 1.f, 1.f - e.y0 / 360.f, e.depth, why, e.vt});
+		}
+		const auto inside = [](const vr_button& a, const vr_button& b)
+		{
+			return a.x0 >= b.x0 - 0.004f && a.x1 <= b.x1 + 0.004f && a.y0 >= b.y0 - 0.004f && a.y1 <= b.y1 + 0.004f;
+		};
+		std::vector<u8> box(cand.size(), 0);
+		for (usz a = 0; a < cand.size(); a++)
+		{
+			int holds = 0;
+			for (usz b = 0; b < cand.size(); b++) if (a != b && inside(cand[b], cand[a]) && !inside(cand[a], cand[b])) holds++;
+			box[a] = holds >= 2;
+		}
+		for (usz a = 0; a < cand.size() && keys.size() < 40; a++)
+		{
+			if (box[a]) continue;
+			bool label = false;
+			for (usz b = 0; b < cand.size() && !label; b++)
+				if (a != b && !box[b] && inside(cand[a], cand[b])) label = !inside(cand[b], cand[a]) || b < a;   // (the same twice: the first)
+			if (!label) keys.push_back(cand[a]);
+		}
+	}
+
+	// The game draws something of a menu or a dialog of its UI tree (drawn: from the renderer; not known: the tree alone).
+	// (A dialog's panel can sit in the tree for a while before the game shows it.)
+	bool menu_drawn(const std::vector<uitree::elem>& el, const std::vector<u8>& drawn)
+	{
+		const usz n = el.size();
+		// (nothing marked at all: the renderer could not see where the game's draws land, the tree alone decides)
+		if (drawn.size() != n || std::find(drawn.begin(), drawn.end(), u8{1}) == drawn.end()) return true;
+		std::vector<u8> shown(drawn);
+		for (usz i = n; i-- > 0;)
+		{
+			const int p = el[i].parent;
+			if (shown[i] && p >= 0 && static_cast<usz>(p) < i) shown[p] = 1;
+		}
+		for (usz i = 0; i < n; i++)
+			if (shown[i] && (uitree::menu_root(el, i) || uitree::dialog_card(el[i]))) return true;
+		return false;
+	}
+
+	// Once a frame: is a menu or a dialog of the game open (its UI tree has one and the game draws it), and its keys (found
+	// again whenever the game's UI tree changes, or the renderer has seen more of what the game draws). Logs the keys (with
+	// the game's class of each: which class the buttons are) when they change.
+	void update_menu(xr_state& xr)
+	{
+		std::shared_ptr<const std::vector<uitree::elem>> el;
+		{
+			std::lock_guard lock(uitree::elems_mutex);
+			el = uitree::elems;
+		}
+		if (!xr.mode3d) el = nullptr;   // (the game's UI tree is read in true VR only)
+		const u64 now = GetTickCount64();
+		if (el != xr.keys_seen)
+		{
+			xr.keys_seen = el;
+			xr.keys_seen_at = now;
+			xr.menu_tree = el && uitree::menu_open(*el);
+		}
+		std::vector<u8> drawn;
+		u32 ver = 0;
+		bool known = false, changed = false;
+		{
+			std::lock_guard lock(g_state_mutex);
+			known = el && g_drawn.src == el.get() && g_drawn.drawn.size() == el->size();
+			ver = known ? g_drawn.ver : 0;
+			changed = el != xr.keys_el || (known && ver != xr.keys_drawn_ver);
+			if (changed && known) drawn = g_drawn.drawn;
+		}
+		if (!changed) return;
+		// A new list with a menu in it: wait a moment (at most 250 ms) for the renderer to say what of it the game draws, so
+		// no key shows up for one frame where nothing is drawn (the menu and keys of the list before stay meanwhile)
+		if (!known && el && xr.menu_tree && now - xr.keys_seen_at < 250) return;
+		xr.keys_el = el;
+		xr.keys_drawn_ver = ver;
+		xr.menu_open = xr.menu_tree && el && menu_drawn(*el, drawn);
+		if (xr.menu_open) find_keys(*el, drawn, xr.vr_btns);
+		else xr.vr_btns.clear();
+		// the log: the keys, when they change (at most every 2 s)
+		std::string sig;
+		char b[96];
+		for (usz i = 0; i < xr.vr_btns.size() && i < 24; i++)
+		{
+			const auto& k = xr.vr_btns[i];
+			std::snprintf(b, sizeof(b), "%.0f,%.0f %.0fx%.0f %s vt %x; ", (k.x0 + 1.f) * 640.f, (1.f - k.y1) * 360.f, (k.x1 - k.x0) * 640.f, (k.y1 - k.y0) * 360.f,
+				k.why == 1 ? "named" : k.why == 2 ? "list" : "dialog", k.vt);
+			sig += b;
+		}
+		if (xr.menu_open && sig.empty()) sig = "(a menu without keys)";
+		if (sig != xr.keys_sig && (now - xr.keys_log_tick > 2000 || sig.empty() != xr.keys_sig.empty()))
+		{
+			xr.keys_sig = sig;
+			xr.keys_log_tick = now;
+			if (xr.vr_btns.empty()) vr_log("Menu keys: none (%s)", xr.menu_open ? "a menu is open, no buttons found in it: point anywhere on it" : "no menu open");
+			else vr_log("Menu keys: %zu (%s): %s", xr.vr_btns.size(), known ? "where the game draws" : "the game's drawing not known", sig.c_str());
+		}
+	}
+
+	// The lobby's menu stand: a lectern at arm's length in front of the spot you stand on, its screen sloping away from you
+	// like a kiosk's. It is part of the lobby (it moves with the lobby when you walk or turn with the sticks).
+	// Where you are now (not where you were placed, before you walked): the stand's spot is your feet, it faces the way you
+	// look, at your eye height now. Kept in the lobby's frame (along its screen's right and normal), so walking or turning
+	// with the sticks moves it with the lobby like any other thing in it.
+	void anchor_stand(xr_state& xr)
+	{
+		const vec3 normal{std::sin(xr.screen_yaw), 0.f, std::cos(xr.screen_yaw)}, right{std::cos(xr.screen_yaw), 0.f, -std::sin(xr.screen_yaw)};
+		vec3 f{xr.last_forward.x, 0.f, xr.last_forward.z};
+		f = dot(f, f) > 0.09f ? normalize(f) : normal * -1.f;   // (looking straight down: towards the big screen)
+		const vec3 rel = xr.last_head - xr.screen_center;
+		xr.stand_r = dot(rel, right);
+		xr.stand_n = dot(rel, normal);
+		xr.stand_yaw = std::atan2(-f.x, -f.z) - xr.screen_yaw;
+		xr.stand_eyes = xr.last_head.y;
+		xr.stand_anchored = true;
+	}
+	void place_stand(xr_state& xr)
+	{
+		if (!xr.stand_anchored) anchor_stand(xr);
+		const vec3 normal{std::sin(xr.screen_yaw), 0.f, std::cos(xr.screen_yaw)}, right{std::cos(xr.screen_yaw), 0.f, -std::sin(xr.screen_yaw)}, up{0.f, 1.f, 0.f};
+		const f32 yaw = xr.screen_yaw + xr.stand_yaw;
+		const vec3 f{-std::sin(yaw), 0.f, -std::cos(yaw)};   // the way you faced when it came: away from you
+		vec3 spot = xr.screen_center + right * xr.stand_r + normal * xr.stand_n;   // where you stood when it came
+		spot.y = xr.stand_eyes;
+		hud_panel& s = xr.stand;
+		s.on = true;
+		s.P = spot + f * stand_ahead;
+		s.P.y = xr.stand_eyes - stand_below;
+		s.A = {-f.z, 0.f, f.x};
+		s.B = up * std::cos(stand_slope) + f * std::sin(stand_slope);
+		s.hw = stand_hw;
+		s.hh = stand_hw * (xr.sc_w ? static_cast<f32>(xr.sc_h) / static_cast<f32>(xr.sc_w) : 9.f / 16.f);
+	}
+
+	// True VR, in the lobby: while the game shows a menu (its UI tree), its picture is on the stand within reach instead of
+	// on the big screen far away (a short gap between two menus keeps it there; loading screens and films go back to the
+	// big screen)
+	void update_stand(xr_state& xr, u64 now)
+	{
+		// (when the game draws no 3D scene: the lobby. A cutscene on the big screen has no menu and keeps the big screen; a
+		// short gap in the kitchen's 3D keeps you in the 3D view, where the menu panel in front of you takes the menu)
+		// (a menu the game shows as a flat picture after its 3D stopped, the kitchen's pause menu among them: on the stand too,
+		// after 0.3 s, never on the big screen where you were placed)
+		const bool lobby = !xr.last_3d_tick || now - xr.last_3d_tick > 300;
+		const bool want = xr.mode3d && !xr.live3d && lobby && xr.menu_open && xr.have_image && xr.screen_placed && !xr.chooser_active && xr.panel_text.empty();
+		if (want) { xr.stand_want_at = now; if (!xr.stand_want_since) xr.stand_want_since = now; }
+		else xr.stand_want_since = 0;
+		const bool was = xr.menu_near;
+		if (!xr.mode3d || xr.live3d || xr.chooser_active || !xr.screen_placed) xr.menu_near = false;
+		else if (want && now - xr.stand_want_since >= 150) xr.menu_near = true;
+		else if (!want && now - xr.stand_want_at > 1200) xr.menu_near = false;
+		// It comes to where you are each time a menu comes, and again when you have walked more than a metre from it (with
+		// the stick or in your room) while it is open; not while your fingertip is on it
+		if (xr.menu_near && !was) anchor_stand(xr);
+		else if (xr.menu_near && xr.stand_anchored && !xr.ptr_touch)
+		{
+			const vec3 normal{std::sin(xr.screen_yaw), 0.f, std::cos(xr.screen_yaw)}, right{std::cos(xr.screen_yaw), 0.f, -std::sin(xr.screen_yaw)};
+			const vec3 rel = xr.last_head - xr.screen_center;
+			const f32 dr = dot(rel, right) - xr.stand_r, dn = dot(rel, normal) - xr.stand_n;
+			if (dr * dr + dn * dn > 1.0f)
+			{
+				anchor_stand(xr);
+				vr_log("Menu stand: you walked away from it, it came to where you are now");
+			}
+		}
+		if (xr.menu_near) place_stand(xr);
+		else { xr.stand.on = false; xr.stand_touch_ok = false; xr.stand_anchored = false; }
+		if (!xr.live3d) xr.menu_touch_ok = false;   // (the menu panel inside the game: a fingertip must come to it anew)
+		if (xr.menu_near != was)
+			vr_log(xr.menu_near ? "Menu stand: the game's menu is on the stand in front of you (%zu keys): touch a key or point at it" :
+				"Menu stand: put away (%zu keys), the game's picture is on the big screen", xr.vr_btns.size());
+	}
+
+	// The pointer on a menu snaps to the key under it (the press lands on that button in the game). margin: ndc
+	void snap_to_button(xr_state& xr, f32& nx, f32& ny, f32 margin = 0.01f)
+	{
+		xr.btn_hover = -1;
+		for (usz i = 0; i < xr.vr_btns.size(); i++)
+		{
+			const auto& b = xr.vr_btns[i];
+			if (nx < b.x0 - margin || nx > b.x1 + margin || ny < b.y0 - margin || ny > b.y1 + margin) continue;
+			// the smallest button under the pointer (a list item inside a list)
+			if (xr.btn_hover >= 0)
+			{
+				const auto& o = xr.vr_btns[xr.btn_hover];
+				if ((o.x1 - o.x0) * (o.y1 - o.y0) <= (b.x1 - b.x0) * (b.y1 - b.y0)) continue;
+			}
+			xr.btn_hover = static_cast<int>(i);
+		}
+		// Not on any key: the nearest key close by (in the gap between two of the game's buttons, or just past a button's
+		// edge, the press goes to the nearest real button instead of to nothing). Distances in the screen's x units (a y unit
+		// is 9/16 of one), up to 0.02 (1% of the screen's width), 0.03 for a fingertip, and only among the keys (inside the
+		// box round all of them): the keys found in the game's UI may miss some of its buttons (a slider, an options switch),
+		// and a press on one of those must go where you press it, not to the nearest key found
+		bool among = false;
+		if (xr.btn_hover < 0 && !xr.vr_btns.empty())
+		{
+			f32 bx0 = 1e9f, by0 = 1e9f, bx1 = -1e9f, by1 = -1e9f;
+			for (const auto& b : xr.vr_btns) { bx0 = std::min(bx0, b.x0); by0 = std::min(by0, b.y0); bx1 = std::max(bx1, b.x1); by1 = std::max(by1, b.y1); }
+			among = nx >= bx0 - 0.005f && nx <= bx1 + 0.005f && ny >= by0 - 0.005f && ny <= by1 + 0.005f;
+		}
+		if (xr.btn_hover < 0 && among)
+		{
+			const f32 reach = margin > 0.015f ? 0.03f : 0.02f;
+			f32 best = reach * reach;
+			for (usz i = 0; i < xr.vr_btns.size(); i++)
+			{
+				const auto& b = xr.vr_btns[i];
+				const f32 dx = nx < b.x0 ? b.x0 - nx : nx > b.x1 ? nx - b.x1 : 0.f;
+				const f32 dy = (ny < b.y0 ? b.y0 - ny : ny > b.y1 ? ny - b.y1 : 0.f) * 0.5625f;
+				const f32 d2 = dx * dx + dy * dy;
+				if (d2 < best) { best = d2; xr.btn_hover = static_cast<int>(i); }
+			}
+		}
+		if (xr.btn_hover >= 0)
+		{
+			const auto& b = xr.vr_btns[xr.btn_hover];
+			nx = (b.x0 + b.x1) * 0.5f;
+			ny = (b.y0 + b.y1) * 0.5f;
+		}
+	}
+
+	// Where your counter is (room space y): standing, from your real floor and height; seated, below your eyes
+	f32 counter_y(const xr_state& xr)
+	{
+		// placed against a kitchen from the game files: its own counter tops, as far below your eyes as you were placed
+		if (xr.counter_drop > 0.2f && xr.counter_drop < 1.6f) return xr.last_head.y - xr.counter_drop;
+		if (!xr.comfort.seated && xr.floor_known) return xr.floor_y + counter_k * (xr.last_head.y - xr.floor_y);
+		return xr.last_head.y - 0.48f;
+	}
+	f32 floor_or(const xr_state& xr, f32 fallback) { return !xr.comfort.seated && xr.floor_known ? xr.floor_y : fallback; }
+
+	// The open menu's keys on a panel whose plane is the game's whole screen: a raised rim round each of the game's buttons
+	// (round its picture, never over it: the mod's things are drawn over the game's picture). It lights up while you point
+	// at it and goes in as your fingertip pushes it (all the way, green, while it presses). base: where the keys stand
+	// (in front of the panel), rise: how high
+	void draw_keys(xr_state& xr, const hud_panel& pn, f32 base, f32 rise)
+	{
+		if (xr.vr_btns.empty() || pn.hw <= 0.f || pn.hh <= 0.f) return;
+		const vec3 N = normalize(cross(pn.A, pn.B));
+		const u64 now = GetTickCount64();
+		for (usz i = 0; i < xr.vr_btns.size(); i++)
+		{
+			const auto& b = xr.vr_btns[i];
+			const vec3 c = pn.P + pn.A * ((b.x0 + b.x1) * 0.5f * pn.hw) + pn.B * ((b.y0 + b.y1) * 0.5f * pn.hh) + N * base;
+			const f32 hw = (b.x1 - b.x0) * 0.5f * pn.hw + 0.003f, hh = (b.y1 - b.y0) * 0.5f * pn.hh + 0.003f;
+			const bool hover = xr.btn_hover == static_cast<int>(i);
+			const bool down = hover && (xr.btn_pressed || now < xr.key_hold_until);
+			f32 h = rise;
+			if (hover && xr.key_push >= 0.f) h = std::clamp(xr.key_push - base, 0.003f, rise);   // your fingertip pushes it in
+			if (down) h = 0.003f;
+			const f32 pulse = hover ? 0.5f + 0.5f * std::sin(now * 0.012f) : 0.f;
+			const vec3 col = down ? go : hover ? mix(brass, glow, 0.6f + 0.4f * pulse) : mix(wood_dark, brass, 0.35f);
+			frame(xr, c, pn.A, pn.B, N, hw, hh, hover ? 0.007f : 0.005f, h, col);
+		}
+	}
+
+	// The lobby's menu stand: a wooden bezel with a brass edge round its sloping screen (the game's menu is on it), a post
+	// down to the lobby's floor and a foot
+	void draw_stand(xr_state& xr)
+	{
+		const hud_panel& s = xr.stand;
+		if (!s.on) return;
+		const vec3 N = normalize(cross(s.A, s.B)), up{0.f, 1.f, 0.f};
+		frame(xr, s.P, s.A, s.B, N, s.hw + 0.003f, s.hh + 0.003f, 0.03f, 0.02f, wood);
+		frame(xr, s.P + N * 0.02f, s.A, s.B, N, s.hw + 0.003f, s.hh + 0.003f, 0.005f, 0.003f, brass);
+		// (the lobby's floor: as the lobby itself measures it)
+		const f32 eyes = xr.screen_center.y + 0.10f;
+		const f32 floor = xr.comfort.seated || !xr.floor_known ? eyes - chef_eye_u * xr.unit : xr.floor_y;
+		// the post starts under the bezel's lower edge and a little behind it (so it is never seen over the screen)
+		const vec3 top = s.P - s.B * (s.hh + 0.06f) - N * 0.03f;
+		vec3 bot = top;
+		bot.y = floor + 0.02f;
+		if (top.y > bot.y + 0.1f)
+		{
+			draw_limb(xr, top, bot, 0.028f, 0.034f, wood_dark);
+			vec3 nh{N.x, 0.f, N.z};
+			nh = dot(nh, nh) > 1e-6f ? normalize(nh) : vec3{0.f, 0.f, 1.f};
+			draw_boxo(xr, bot, s.A, up, nh, {0.42f, 0.03f, 0.32f}, wood_dark);
+		}
+	}
+
+	// ---- The boards you can pick up (the ticket rail, the assistants' stand, the shelf, the recipe clipboard). Close a hand
+	// (GRIP) on a board's frame, not on a card, and it comes with that hand; open the hand and it stays there in the kitchen.
+	// Its frame glows while a hand can take it, and while you carry it.
+	vec3 lit_col(const xr_state& xr, int k, vec3 base)
+	{
+		if (k < 0 || k > 3 || !xr.board_lit[k]) return base;
+		const f32 pulse = 0.5f + 0.5f * std::sin(GetTickCount64() * 0.010f);
+		return xr.board_lit[k] == 2 ? mix(base, go, 0.55f) : mix(base, glow, 0.45f + 0.35f * pulse);
+	}
+
+	// The handles of a board (room space): the pieces of its frame a closed hand takes it by, as segments, and how near the
+	// hand must be to each (m). The same pieces are drawn below (draw_rail, draw_cards), so what you see is what you can
+	// take. The clipboard has none here: its whole hardboard edge is its handle (update_boards). Returns how many.
+	int board_segs(const xr_state& xr, int k, vec3 (&a)[4], vec3 (&b)[4], f32 (&r)[4])
+	{
+		const hud_panel& p = xr.board_room[k];
+		const vec3 N = normalize(cross(p.A, p.B));
+		const f32 lo = xr.board_lo[k], hi = xr.board_hi[k];
+		switch (k)
+		{
+		case 0:   // the ticket rail: the steel bar the tickets hang from, and its two end knobs
+		{
+			const vec3 top = p.P + p.B * (p.hh + 0.014f) + N * 0.012f;
+			a[0] = top - p.A * (p.hw + 0.05f); b[0] = top + p.A * (p.hw + 0.05f); r[0] = 0.06f;
+			return 1;
+		}
+		case 1:   // the assistants' stand: its wooden ledge, end to end
+		{
+			const vec3 c = p.P - p.B * 0.014f + N * 0.035f;
+			a[0] = c + p.A * (lo - 0.04f); b[0] = c + p.A * (hi + 0.04f); r[0] = 0.06f;
+			return 1;
+		}
+		case 2:   // the shelf: its lowest plank and its two posts
+		{
+			const vec3 c = p.P - p.B * 0.009f + N * 0.045f;
+			a[0] = c + p.A * (lo - 0.045f); b[0] = c + p.A * (hi + 0.045f); r[0] = 0.05f;
+			int n = 1;
+			for (const f32 e : {lo - 0.045f, hi + 0.045f})
+			{
+				const vec3 base = p.P + p.A * e + N * 0.045f;
+				// (from 10 cm up the post: the foot of the post on the counter is among the food, a grip there is for the food)
+				a[n] = base - p.B * std::max(xr.holder_up[1] - 0.10f, 0.f); b[n] = base + p.B * (xr.board_top[2] + 0.04f); r[n] = 0.05f;
+				n++;
+			}
+			return n;
+		}
+		default: return 0;
+		}
+	}
+
+	void draw_rail(xr_state& xr, bool clips = true)
+	{
+		if (!xr.vr_pan_ok[0]) return;
+		const hud_panel& pn = xr.vr_pan[0];
+		const vec3 N = normalize(cross(pn.A, pn.B));
+		const vec3 top = pn.P + pn.B * (pn.hh + 0.014f) + N * 0.012f;
+		const vec3 a = top - pn.A * (pn.hw + 0.05f), b = top + pn.A * (pn.hw + 0.05f);
+		const vec3 rail_col = lit_col(xr, 0, steel);
+		draw_limb(xr, a, b, 0.009f, 0.009f, rail_col);
+		// a knob at each end, to take it by (it hangs wherever you put it; nothing ties it to a wall), and the clips along the
+		// rail (while no ticket hangs there: each ticket has its own clip)
+		for (const vec3 e : {a, b})
+		{
+			draw_limb(xr, e, e + pn.B * 0.035f, 0.006f, 0.006f, rail_col);
+			draw_boxo(xr, e + pn.B * 0.045f, pn.A, pn.B, N, {0.022f, 0.022f, 0.022f}, lit_col(xr, 0, brass));
+		}
+		if (!clips) return;
+		for (int i = 0; i <= 8; i++)
+		{
+			const vec3 p = top - pn.A * pn.hw + pn.A * (2.f * pn.hw * i / 8.f) + N * 0.004f;
+			draw_boxo(xr, p - pn.B * 0.012f, pn.A, pn.B, N, {0.012f, 0.02f, 0.004f}, dark);
+		}
+	}
+
+	// The HUD cards' holders, round the game's own pictures of the cards (never over them: the mod's things have no depth
+	// against the game's picture): a clip on the rail for each ticket; the stand's ledge and a thin brass frame for each
+	// assistant's portrait on it; the shelf's lowest plank, its two posts, and a plank under each card of a higher row; the
+	// clipboard round the recipe card with its steel clip. The card under your pointer glows (green while you press); a
+	// board's frame glows while a hand can take it. The cards come from the renderer (cam.cards: where it drew them, player
+	// frame) and the boards from where they are now (xr.board_room), so these follow when you carry a board.
+	void draw_cards(xr_state& xr, const cam_info& cam)
+	{
+		const XrQuaternionf q = yaw_q(xr.player_yaw);
+		const bool pressing = xr.touch_press || xr.hand_trig[xr.active_hand] > 0.5f;
+		// The stand and the shelf as whole boards (where they are now: beside you, or where you put them), as long as their
+		// cards need: the stand's wooden ledge with a brass knob at each end; the shelf's lowest plank and its two posts
+		for (int k = 1; k <= 2; k++)
+		{
+			if (!xr.board_ok[k]) continue;
+			const hud_panel& p = xr.board_room[k];
+			const vec3 N = normalize(cross(p.A, p.B));
+			const f32 lo = xr.board_lo[k], hi = xr.board_hi[k];
+			const vec3 wcol = lit_col(xr, k, wood), bcol = lit_col(xr, k, brass);
+			if (k == 1)
+			{
+				const vec3 c = p.P - p.B * 0.014f + N * 0.035f;
+				draw_boxo(xr, c + p.A * ((lo + hi) * 0.5f), p.A, p.B, N, {hi - lo + 0.06f, 0.028f, 0.07f}, wcol);
+				for (const f32 e : {lo - 0.04f, hi + 0.04f}) draw_boxo(xr, c + p.A * e + p.B * 0.022f, p.A, p.B, N, {0.022f, 0.045f, 0.022f}, bcol);
+			}
+			else
+			{
+				const vec3 c = p.P - p.B * 0.009f + N * 0.045f;
+				draw_boxo(xr, c + p.A * ((lo + hi) * 0.5f), p.A, p.B, N, {hi - lo + 0.12f, 0.018f, 0.10f}, wcol);
+				for (const f32 e : {lo - 0.045f, hi + 0.045f})
+				{
+					const vec3 base = p.P + p.A * e + N * 0.045f;
+					draw_limb(xr, base - p.B * xr.holder_up[1], base + p.B * (xr.board_top[2] + 0.04f), 0.009f, 0.009f, wcol);
+				}
+			}
+		}
+		for (int i = 0; i < cam.card_n; i++)
+		{
+			const vr_card& cd = cam.cards[i];
+			const vec3 P = from_player(xr, cd.pn.P), A = rotate(q, cd.pn.A), B = rotate(q, cd.pn.B);
+			const vec3 N = normalize(cross(A, B));
+			const f32 hw = cd.pn.hw, hh = cd.pn.hh;
+			f32 pad = 0.f;
+			switch (cd.holder)
+			{
+			case 0:   // a ticket: its clip on the rail
+				draw_boxo(xr, P + B * (hh + 0.002f) + N * 0.004f, A, B, N, {0.028f, 0.02f, 0.006f}, dark);
+				break;
+			case 1:   // an assistant's portrait: a thin brass frame standing on the stand's ledge
+				frame(xr, P, A, B, N, hw, hh, 0.006f, 0.006f, brass);
+				pad = 0.006f;
+				break;
+			case 2:   // a card on the shelf: a plank under each card of the higher rows (the lowest row stands on the shelf's plank)
+				if (xr.board_ok[2])
+				{
+					const hud_panel& sp = xr.board_room[2];
+					const vec3 Ns = normalize(cross(sp.A, sp.B));
+					const f32 above = dot(P - B * hh - sp.P, sp.B);   // the card's bottom edge above the lowest plank
+					if (above > 0.03f)
+						draw_boxo(xr, sp.P + sp.A * dot(P - sp.P, sp.A) + sp.B * (above - 0.009f) + Ns * 0.045f, sp.A, sp.B, Ns, {2.f * hw + 0.05f, 0.018f, 0.10f}, lit_col(xr, 2, wood));
+				}
+				break;
+			default:  // the recipe card: hardboard round it and a steel clip at its top
+				frame(xr, P, A, B, N, hw, hh, 0.016f, 0.006f, lit_col(xr, 3, wood_dark));
+				draw_boxo(xr, P + B * (hh + 0.008f) + N * 0.008f, A, B, N, {0.075f, 0.026f, 0.012f}, lit_col(xr, 3, steel));
+				pad = 0.016f;
+				break;
+			}
+			const bool hover = xr.ptr_card_on && std::fabs(xr.ptr_card_kr.cx - cd.kr.cx) + std::fabs(xr.ptr_card_kr.cy - cd.kr.cy) +
+				std::fabs(xr.ptr_card_kr.hx - cd.kr.hx) + std::fabs(xr.ptr_card_kr.hy - cd.kr.hy) < 1e-3f;
+			if (hover) frame(xr, P, A, B, N, hw + pad, hh + pad, 0.005f, 0.008f, pressing ? go : glow);
+		}
+	}
+
+	// The plate, the trash bin, the oven and the food processor, standing in front of and below their signs
+	void draw_stations(xr_state& xr, const cam_info& cam)
+	{
+		const u64 now = GetTickCount64();
+		for (int k = 0; k < 4; k++)
+		{
+			const hud_panel& s = xr.spot_room[k];
+			if (!s.on || !cam.spot_seen[k]) continue;
+			const bool hot = xr.over_spot && xr.over_k == k;
+			const bool near_hand = xr.hold_now && dot(xr.hold_hand - s.P, xr.hold_hand - s.P) < 0.35f * 0.35f;
+			const f32 pulse = hot ? 0.5f + 0.5f * std::sin(now * 0.015f) : 0.f;
+			const vec3 hi = hot ? mix(go, vec3{1.f, 1.f, 1.f}, pulse * 0.4f) : near_hand ? glow : vec3{};
+			const bool lit = hot || near_hand;
+			vec3 N = normalize(cross(s.A, s.B));
+			if (k == 0)
+			{
+				// The plate lies flat: a ceramic rim around the game's picture, a wooden board under the rim
+				const f32 r = std::max(s.hw, s.hh) * 1.10f;
+				ring(xr, s.P, s.A, s.B, r, 0.008f, lit ? hi : ceramic);
+				ring(xr, s.P - vec3{0.f, 0.006f, 0.f}, s.A, s.B, r + 0.02f, 0.010f, wood, 28);
+				continue;
+			}
+			// Upright signs (trash, oven, food processor): the game's kitchen already has these things in 3D, so no
+			// solid stand-ins (drawn without depth they covered the counter and your hands). Only a glowing frame
+			// round the sign while food you hold is near or over it.
+			if (lit) frame(xr, s.P, s.A, s.B, N, s.hw, s.hh, hot ? 0.010f : 0.006f, 0.006f, hi);
+		}
+	}
+
+	void draw(xr_state& xr)
+	{
+		if (!xr.mode3d) return;
+		cam_info cam;
+		{
+			std::lock_guard lock(g_state_mutex);
+			cam = g_cam;
+		}
+		// (no wooden board and chains around the game's menus any more: a frame round a flat picture is not VR. The menus' own
+		// buttons are keys you press instead.)
+		if (xr.live3d && xr.mode3d)
+		{
+			int tickets = 0;
+			for (int i = 0; i < cam.card_n; i++) if (cam.cards[i].holder == 0) tickets++;
+			if (cam.hud_seen[0]) draw_rail(xr, tickets == 0);
+			draw_stations(xr, cam);
+			draw_cards(xr, cam);
+			// a menu or a dialog inside the game: its keys on the menu panel in front of you
+			if (xr.menu_open && xr.vr_pan_ok[3]) draw_keys(xr, xr.vr_pan[3], key_base3, key_rise3);
+		}
+		// in the lobby: the menu stand with its keys
+		if (!xr.live3d && xr.menu_near)
+		{
+			draw_stand(xr);
+			draw_keys(xr, xr.stand, 0.f, key_rise);
+		}
+	}
+}
