diff --git a/rpcs3/Emu/Io/OrderUpVR.h b/rpcs3/Emu/Io/OrderUpVR.h
new file mode 100644
index 000000000..29dbc672b
--- /dev/null
+++ b/rpcs3/Emu/Io/OrderUpVR.h
@@ -0,0 +1,64 @@
+#pragma once
+
+// Order Up VR: OpenXR bridge for the PS3 game Order Up!! (BLES01470).
+//
+// A dedicated thread owns an OpenXR session (D3D11 binding, independent of the
+// emulator's renderer). The renderer hands it finished game frames, which are
+// shown on a large world-locked virtual screen. The VR controller that aims at
+// that screen becomes the game's PlayStation Move pointer (see cellGem.cpp).
+
+#include "util/types.hpp"
+
+#include <vector>
+
+namespace ouvr
+{
+	struct pointer_state
+	{
+		bool active = false; // VR session is focused and a controller is tracked; use this instead of the mouse
+		bool on_screen = false;
+		f32 x = 0.5f;        // 0..1 across the virtual screen, left to right
+		f32 y = 0.5f;        // 0..1 top to bottom
+		f32 trigger = 0.0f;  // 0..1
+		bool t = false;
+		bool move = false;
+		bool cross = false;
+		bool circle = false;
+		bool square = false;
+		bool triangle = false;
+		bool start = false;
+		bool select = false;
+
+		// Real controller motion, in the emulated PS Eye camera frame (= the virtual screen: x right, y up,
+		// z towards the player). A real PS Move reports the same quantities, so the game's motion gestures work.
+		bool motion = false;
+		f32 rq[4] = {0.f, 0.f, 0.f, 1.f}; // rotation beyond aiming (wrist twist, flicking past the screen), x y z w
+		f32 vel[3] = {};       // mm/s
+		f32 accel[3] = {};     // mm/s^2
+		f32 angvel[3] = {};    // rad/s
+		f32 angaccel[3] = {};  // rad/s^2
+		f32 disp[3] = {};      // mm, quick hand movement (slow drift removed)
+		f32 acc_dev[3] = {0.f, 0.f, 1.f}; // accelerometer in device axes, G (gravity included)
+		f32 gyro_dev[3] = {};  // gyroscope in device axes, rad/s
+	};
+
+	// Called by the renderer when a game boots / shuts down.
+	void start();
+	void stop();
+
+	// True while the VR session is running and wants a copy of every presented frame.
+	bool wants_frames();
+
+	// Latest presented game frame, 4 bytes per pixel.
+	void submit_frame(std::vector<u8>&& pixels, u32 width, u32 height, bool is_bgra);
+
+	// The renderer could not present because the desktop game window is minimized or has no size.
+	void report_window_unavailable();
+
+	// Current controller-as-pointer state (thread safe).
+	pointer_state get_pointer();
+
+	// Diagnostics (written to log/orderup_vr.log). trace() counts calls per name and reports them every few seconds.
+	void trace(const char* name);
+	void note(const char* fmt, ...);
+}
