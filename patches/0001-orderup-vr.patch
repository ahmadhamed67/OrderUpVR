+	void submit_frame(std::vector<u8>&& pixels, u32 width, u32 height, bool is_bgra)
+	{
+		const frame_tag tag = rv_end_frame(); // how this frame was rendered (which eye, from where)
+		std::lock_guard lock(g_state_mutex);
+		auto& slot = g_pending[tag.eye == 1 ? 1 : tag.eye < 0 ? 2 : 0];
+		slot.px = std::move(pixels);
+		slot.w = width;
+		slot.h = height;
+		slot.bgra = is_bgra;
+		slot.tag = tag;
+		slot.id = ++g_frame_id;
+		g_last_frame_tick = GetTickCount64();
+	}
+
+	void report_window_unavailable()
+	{
+		g_window_unavailable_tick = GetTickCount64();
+	}
+
+	// Test hook: ORDERUP_VR_FAKE_FILE names a text file holding "x y buttonmask". While set, its content is used as
+	// the VR pointer, so the controller->Move path can be exercised without a headset.
+	// Mask bits: 1=T 2=Move 4=Cross 8=Circle 16=Square 32=Triangle 64=Start 128=Select
+	static bool read_fake_pointer(pointer_state& out)
+	{
+		static const std::string path = []{ const char* e = std::getenv("ORDERUP_VR_FAKE_FILE"); return std::string(e ? e : ""); }();
+		if (path.empty()) return false;
+
+		static std::mutex mtx;
+		static pointer_state cached;
+		static u64 last_read = 0;
+
+		std::lock_guard lock(mtx);
+		if (const u64 now = GetTickCount64(); now - last_read >= 8)
+		{
+			last_read = now;
+			if (std::FILE* f = std::fopen(path.c_str(), "r"))
+			{
+				float x = 0.5f, y = 0.5f;
+				int mask = 0;
+				if (std::fscanf(f, "%f %f %d", &x, &y, &mask) >= 2)
+				{
+					cached = {};
+					cached.active = true;
+					cached.on_screen = true;
+					cached.x = x;
+					cached.y = y;
+					cached.t = !!(mask & 1);
+					cached.trigger = cached.t ? 1.0f : 0.0f;
+					cached.move = !!(mask & 2);
+					cached.cross = !!(mask & 4);
+					cached.circle = !!(mask & 8);
+					cached.square = !!(mask & 16);
+					cached.triangle = !!(mask & 32);
+					cached.start = !!(mask & 64);
+					cached.select = !!(mask & 128);
+				}
+				std::fclose(f);
+			}
+		}
+		out = cached;
+		return cached.active;
+	}
+
+	pointer_state get_pointer()
+	{
+		if (pointer_state fake; read_fake_pointer(fake)) return fake;
+
+		std::lock_guard lock(g_state_mutex);
+		return g_pointer;
+	}
+
+	void research_constants(u32 program_id, const f32* consts, const u16* ids, usz id_count)
+	{
+		static std::mutex mtx;
+		static std::FILE* out = nullptr;
+		static u64 window_end = 0, next_window = 0;
+		static int windows = 0;
+		static std::set<u32> seen;
+
+		const u64 now = GetTickCount64();
+		std::lock_guard lock(mtx);
+		if (!next_window) next_window = now + 30000; // first sample 30 s after the renderer starts
+		if (now >= window_end)
+		{
+			if (now < next_window || windows >= 20) return;
+			window_end = now + 50;
+			next_window = now + 20000;
+			windows++;
+			seen.clear();
+			if (!out)
+			{
+				out = std::fopen((fs::get_log_dir() + "orderup_research.log").c_str(), "w");
+				if (!out) return;
+			}
+			std::fprintf(out, "=== sample %d at %llu ms\n", windows, static_cast<unsigned long long>(now - g_start_tick.load()));
+		}
+		if (!out || !seen.insert(program_id).second || seen.size() > 80) return;
+
+		std::fprintf(out, "prog %u: %zu constants:", program_id, id_count);
+		for (usz i = 0; i < id_count && i < 48; i++) std::fprintf(out, " %u", ids[i]);
+		std::fprintf(out, "\n");
+
+		// 4x4 blocks whose last row or column has a unit-length xyz part: the signature of a perspective camera
+		// (view-projection or model-view-projection) matrix. Logged with all 16 values for offline analysis.
+		for (usz i = 0; i + 3 < id_count; i++)
+		{
+			const u16 k = ids[i];
+			if (k > 464 || ids[i + 1] != k + 1 || ids[i + 2] != k + 2 || ids[i + 3] != k + 3) continue;
+			const f32* m = consts + k * 4;
+			const f32 row = std::sqrt(m[12] * m[12] + m[13] * m[13] + m[14] * m[14]);
+			const f32 col = std::sqrt(m[3] * m[3] + m[7] * m[7] + m[11] * m[11]);
+			const bool r = row > 0.9f && row < 1.1f, c = col > 0.9f && col < 1.1f;
+			if (!r && !c) continue;
+			std::fprintf(out, "  c%u %s:", k, r && c ? "row+col" : r ? "row" : "col");
+			for (int j = 0; j < 16; j++) std::fprintf(out, " %.5g", m[j]);
+			std::fprintf(out, "\n");
+		}
+		std::fflush(out);
+	}
+
+	namespace
+	{
+		// The headset eye's projection, with the game's own depth mapping (A, B) so depth testing behaves the same.
+		mat4 eye_projection(const XrFovf& fov, f32 A, f32 B)
+		{
+			const f32 l = std::tan(fov.angleLeft), r = std::tan(fov.angleRight), u = std::tan(fov.angleUp), d = std::tan(fov.angleDown);
+			mat4 p;
+			p.m[0] = 2.f / (r - l); p.m[2] = (r + l) / (r - l);
+			p.m[5] = 2.f / (u - d); p.m[6] = (u + d) / (u - d);
+			p.m[10] = A; p.m[11] = B;
+			p.m[14] = -1.f;
+			return p;
+		}
+
+		mat4 level_mat(vec3 up)
+		{
+			mat4 L;
+			const vec3 axes[3] = {{1.f, 0.f, 0.f}, {0.f, 1.f, 0.f}, {0.f, 0.f, 1.f}};
+			for (int j = 0; j < 3; j++)
+			{
+				const vec3 c = level(up, axes[j]);
+				L.m[j] = c.x; L.m[4 + j] = c.y; L.m[8 + j] = c.z;
+			}
+			L.m[15] = 1.f;
+			return L;
+		}
+
+		void rv_begin_frame()
+		{
+			auto& s = g_rv;
+			s.begun = true;
+			s.cam_this_frame = false;
+			s.x3_ready = s.x2_ready = false;
+			s.n3 = s.n2 = s.n0 = 0;
+			s.votes.clear();
+			s.depths.clear();
+			s.tag = {};
+
+			view_snapshot v;
+			{
+				std::lock_guard lock(g_state_mutex);
+				v = g_views;
+			}
+			s.unit = v.unit;
+			s.enabled = v.valid && v.mode3d && s.want3d;
+			if (!s.enabled) return;
+
+			XrPosef pose;
+			XrFovf fov;
+			if (v.stereo)
+			{
+				// Alternate eyes every frame; the headset shows each eye's newest image from where it was rendered.
+				const int e = static_cast<int>(s.gen.load() & 1);
+				pose = v.eye[e];
+				fov = v.fov[e];
+				s.tag.eye = e;
+			}
+			else
+			{
+				const auto& a = v.eye[0];
+				const auto& b = v.eye[1];
+				pose.position = {(a.position.x + b.position.x) * 0.5f, (a.position.y + b.position.y) * 0.5f, (a.position.z + b.position.z) * 0.5f};
+				pose.orientation = qnorm({a.orientation.x + b.orientation.x, a.orientation.y + b.orientation.y, a.orientation.z + b.orientation.z, a.orientation.w + b.orientation.w});
+				fov.angleLeft = std::min(v.fov[0].angleLeft, v.fov[1].angleLeft);
+				fov.angleRight = std::max(v.fov[0].angleRight, v.fov[1].angleRight);
+				fov.angleUp = std::max(v.fov[0].angleUp, v.fov[1].angleUp);
+				fov.angleDown = std::min(v.fov[0].angleDown, v.fov[1].angleDown);
+				s.tag.eye = 2;
+			}
+			// Keep the field of view sane (the game picture has a fixed number of pixels)
+			const auto cl = [](f32 a) { return std::clamp(a, -0.9f, 0.9f); };
+			fov = {cl(fov.angleLeft), cl(fov.angleRight), cl(fov.angleUp), cl(fov.angleDown)};
+
+			// Eye relative to the player frame (= where the game camera sits in the room)
+			const XrQuaternionf py = yaw_q(v.player_yaw);
+			const vec3 rel_p = rotate(qconj(py), to_vec(pose.position) - v.player_pos);
+			const XrQuaternionf rel_q = qnorm(qmul(qconj(py), pose.orientation));
+			s.tag.rel.position = {rel_p.x, rel_p.y, rel_p.z};
+			s.tag.rel.orientation = rel_q;
+			s.tag.fov = fov;
+
+			// World -> eye, in game units
+			const vec3 t = rel_p * (1.f / s.unit);
+			const vec3 ax = rotate(rel_q, {1.f, 0.f, 0.f}), ay = rotate(rel_q, {0.f, 1.f, 0.f}), az = rotate(rel_q, {0.f, 0.f, 1.f});
+			mat4 E;
+			E.m[0] = ax.x; E.m[1] = ax.y; E.m[2] = ax.z; E.m[3] = -dot(ax, t);
+			E.m[4] = ay.x; E.m[5] = ay.y; E.m[6] = ay.z; E.m[7] = -dot(ay, t);
+			E.m[8] = az.x; E.m[9] = az.y; E.m[10] = az.z; E.m[11] = -dot(az, t);
+			E.m[15] = 1.f;
+			s.E = E;
+		}
+
+		void rv_build(bool scene)
+		{
+			auto& s = g_rv;
+			const auto& c = s.cam;
+			if (scene ? s.x3_ready : s.x2_ready) return;
+			const mat4 base = mmul(mmul(eye_projection(s.tag.fov, c.A, c.B), s.E), level_mat(s.have_up ? s.up : vec3{0.f, 1.f, 0.f}));
+			if (scene)
+			{
+				// Undo the game's projection, then view from the eye with the eye's projection
+				mat4 P;
+				P.m[0] = c.sx; P.m[2] = c.cx; P.m[5] = c.sy; P.m[6] = c.cy; P.m[10] = c.A; P.m[11] = c.B; P.m[14] = -1.f;
+				mat4 Pi;
+				if (minv(P, Pi)) { s.X3 = mmul(base, Pi); s.x3_ready = true; }
+			}
+			else
+			{
+				// 2D (HUD, menus): a flat plane that exactly fills the game camera's view at the typical object distance
+				const f32 D = s.depth;
+				mat4 S2;
+				S2.m[0] = D / c.sx; S2.m[3] = D * c.cx / c.sx;
+				S2.m[5] = D / c.sy; S2.m[7] = D * c.cy / c.sy;
+				S2.m[11] = -D;
+				S2.m[15] = 1.f;
+				s.X2 = mmul(base, S2);
+				s.x2_ready = true;
+			}
+		}
+
+		frame_tag rv_end_frame()
+		{
+			auto& s = g_rv;
+			frame_tag out = (s.begun && s.enabled) ? s.tag : frame_tag{};
+
+			// World up: the direction most scenery agrees on
+			if (!s.votes.empty())
+			{
+				const auto best = std::max_element(s.votes.begin(), s.votes.end(), [](const auto& a, const auto& b) { return a.n < b.n; });
+				if (best->n >= 3 && best->n * 3 >= s.n3)
+				{
+					const vec3 u = normalize(best->sum);
+					if (!s.have_up || dot(u, s.up) < 0.99f) s.up = u;    // camera cut: follow at once
+					else s.up = normalize(s.up * 0.8f + u * 0.2f);
+					s.have_up = true;
+				}
+			}
+			// Typical distance of things in view
+			if (s.depths.size() >= 3)
+			{
+				auto mid = s.depths.begin() + s.depths.size() / 2;
+				std::nth_element(s.depths.begin(), mid, s.depths.end());
+				const f32 med = *mid;
+				if (std::fabs(med - s.depth) > 0.5f * s.depth) s.depth = med;
+				else s.depth += (med - s.depth) * 0.1f;
+				s.x2_ready = false;
+			}
+
+			// Is the game showing a 3D scene? (menus and loading screens are flat)
+			if (s.n3 >= 10) { s.frames_with++; s.frames_without = 0; }
+			else if (++s.frames_without >= 30) s.frames_with = 0;
+			const bool want = s.frames_with >= 3;
+			if (want != s.want3d)
+			{
+				s.want3d = want;
+				vr_log("True VR: game %s a 3D scene", want ? "shows" : "no longer shows");
+			}
+
+			{
+				std::lock_guard lock(g_state_mutex);
+				g_cam.valid = s.cam.valid && s.want3d;
+				g_cam.sx = s.cam.sx; g_cam.sy = s.cam.sy; g_cam.cx = s.cam.cx; g_cam.cy = s.cam.cy;
+				g_cam.up = s.have_up ? s.up : vec3{0.f, 1.f, 0.f};
+				g_cam.depth = s.depth;
+			}
+
+			s.tot3 += s.n3; s.tot2 += s.n2; s.tot0 += s.n0; s.frames++;
+			const u64 now = GetTickCount64();
+			if (now - s.last_log > 15000)
+			{
+				vr_log("True VR: %s, eye=%d, per frame 3D=%llu 2D=%llu other=%llu; camera %s sx=%.3f sy=%.3f A=%.4f B=%.4f; up (%.2f %.2f %.2f); depth %.2f",
+					s.enabled ? "rendering for the headset" : "flat", out.eye,
+					static_cast<unsigned long long>(s.tot3 / std::max<u64>(s.frames, 1)), static_cast<unsigned long long>(s.tot2 / std::max<u64>(s.frames, 1)),
+					static_cast<unsigned long long>(s.tot0 / std::max<u64>(s.frames, 1)), s.cam.valid ? "found" : "not found",
+					s.cam.sx, s.cam.sy, s.cam.A, s.cam.B, s.up.x, s.up.y, s.up.z, s.depth);
+				s.last_log = now;
+				s.tot3 = s.tot2 = s.tot0 = s.frames = 0;
+			}
+
+			s.begun = false;
+			s.gen++;
+			return out;
+		}
+	}
+
+	int stereo_draw_transform(const f32* consts, bool uses_mvp, u32 surface_w, u32 surface_h, u32 color_offset, f32 x[16])
+	{
+		if (!g_session_running.load(std::memory_order_relaxed)) return 0;
+		auto& s = g_rv;
+		if (!s.begun) rv_begin_frame();
+
+		int kind = 0;
+		bool perspective = false;
+		if (uses_mvp && consts)
+		{
+			// c1..c4 = rows of the model-view-projection matrix
+			const f32* m = consts + 4;
+			const vec3 r0{m[0], m[1], m[2]}, r1{m[4], m[5], m[6]}, r2{m[8], m[9], m[10]}, r3{m[12], m[13], m[14]};
+			const f32 l2 = dot(r3, r3);
+			if (l2 > 1e-8f && std::isfinite(l2) && std::isfinite(m[15]))
+			{
+				perspective = true;
+				// The projection's depth terms survive any model matrix exactly
+				const f32 A = -dot(r2, r3) / l2;
+				const f32 B = m[11] + A * m[15];
+				const auto same = [](f32 a, f32 b) { return std::fabs(a - b) <= 1e-3f * std::fabs(b) + 1e-5f; };
+				const f32 len = std::sqrt(l2);
+				const f32 cx = -dot(r0, r3) / l2, cy = -dot(r1, r3) / l2;
+				const vec3 xr = r0 + r3 * cx, yr = r1 + r3 * cy;
+				const f32 sx = std::sqrt(dot(xr, xr)) / len, sy = std::sqrt(dot(yr, yr)) / len;
+
+				bool is_cam = s.cam.valid && same(A, s.cam.A) && same(B, s.cam.B);
+				if (!s.cam_this_frame && surface_w && surface_h && A < 0.f && B < 0.f && sx > 0.2f && sx < 8.f && sy > 0.2f && sy < 8.f &&
+					std::fabs((sy / sx) / (static_cast<f32>(surface_w) / surface_h) - 1.f) < 0.12f)
+				{
+					// The main camera: its picture shape matches the render target. Take this frame's zoom from it.
+					if (!s.cam.valid || !same(A, s.cam.A) || !same(B, s.cam.B) || std::fabs(sx - s.cam.sx) > 1e-4f || std::fabs(cx - s.cam.cx) > 1e-4f)
+					{
+						s.x3_ready = s.x2_ready = false;
+					}
+					s.cam = {true, sx, sy, cx, cy, A, B};
+					s.cam_this_frame = true;
+					s.scene_off = color_offset;
+					s.scene_w = surface_w;
+					s.scene_h = surface_h;
+					is_cam = true;
+				}
+
+				if (is_cam)
+				{
+					kind = 1;
+					// World up = the model's own up axis, for the (many) objects that are not rotated
+					const vec3 xn = normalize(xr), yn = normalize(yr), zn = r3 * (-1.f / len);
+					if (dot(cross(xn, yn), zn) > 0.9f && s.votes.size() < 32)
+					{
+						const vec3 up{xn.y, yn.y, zn.y};
+						bool added = false;
+						for (auto& b : s.votes)
+						{
+							const vec3 avg = normalize(b.sum);
+							if (dot(avg, up) > 0.997f) { b.sum = b.sum + up; b.n++; added = true; break; }
+						}
+						if (!added) s.votes.push_back({up, 1});
+					}
+					const f32 near_plane = B / A;
+					if (m[15] > near_plane && m[15] < 60.f && s.depths.size() < 512) s.depths.push_back(m[15]);
+				}
+			}
+		}
+
+		if (!kind && !perspective && s.cam.valid && color_offset == s.scene_off && surface_w == s.scene_w && surface_h == s.scene_h)
+		{
+			kind = 2;
+		}
+
+		if (kind == 1) s.n3++;
+		else if (kind == 2) s.n2++;
+		else s.n0++;
+
+		if (!s.enabled || !kind || !s.cam.valid) return 0;
+		rv_build(kind == 1);
+		if (kind == 1 && !s.x3_ready) return 0;
+		std::memcpy(x, (kind == 1 ? s.X3 : s.X2).m, sizeof(f32) * 16);
+		return kind;
+	}
+
+	u64 stereo_generation()
+	{
+		return g_rv.gen.load(std::memory_order_relaxed);
+	}
+
+	void stereo_apply(void* rows, const f32 x[16])
+	{
+		mat4 S, X;
+		std::memcpy(S.m, rows, sizeof(S.m));
+		std::memcpy(X.m, x, sizeof(X.m));
+		const mat4 R = mmul(S, X);
+		std::memcpy(rows, R.m, sizeof(R.m));
+	}
+
+	void note(const char* fmt, ...)
+	{
+		char buf[512];
+		va_list args;
+		va_start(args, fmt);
+		std::vsnprintf(buf, sizeof(buf), fmt, args);
+		va_end(args);
+		vr_log("%s", buf);
+	}
+
+	void trace(const char* name)
+	{
+		static std::mutex mtx;
+		static std::map<std::string, u32> counts;
+		static u64 last_dump = 0;
+		static const bool enabled = []{ const char* e = std::getenv("ORDERUP_VR_TRACE"); return e && *e == '1'; }();
+		if (!enabled) return;
+
+		std::lock_guard lock(mtx);
+		counts[name]++;
+		const u64 now = GetTickCount64();
+		if (!last_dump) last_dump = now;
+		if (now - last_dump >= 5000)
+		{
+			std::string line = "calls/5s:";
+			for (const auto& [n, c] : counts) line += " " + n + "=" + std::to_string(c);
+			vr_log("%s", line.c_str());
+			counts.clear();
+			last_dump = now;
+		}
+	}
+}
+
+#else // !_WIN32
+
+namespace ouvr
+{
+	void start() {}
+	void stop() {}
+	bool wants_frames() { return false; }
+	void submit_frame(std::vector<u8>&&, u32, u32, bool) {}
+	void report_window_unavailable() {}
+	pointer_state get_pointer() { return {}; }
+	void trace(const char*) {}
+	void research_constants(u32, const f32*, const u16*, usz) {}
+	void note(const char*, ...) {}
+	int stereo_draw_transform(const f32*, bool, u32, u32, u32, f32*) { return 0; }
+	u64 stereo_generation() { return 0; }
+	void stereo_apply(void*, const f32*) {}
+}
+
+#endif
diff --git a/rpcs3/Emu/Io/OrderUpVR.h b/rpcs3/Emu/Io/OrderUpVR.h
new file mode 100644
index 000000000..971131bbd
--- /dev/null
+++ b/rpcs3/Emu/Io/OrderUpVR.h
@@ -0,0 +1,83 @@
+#pragma once
+
+// Order Up VR: OpenXR bridge for the PS3 game Order Up!! (BLES01470).
+//
+// A dedicated thread owns an OpenXR session (D3D11 binding, independent of the
+// emulator's renderer). The renderer hands it finished game frames, which are
+// shown on a large world-locked virtual screen. The VR controller that aims at
+// that screen becomes the game's PlayStation Move pointer (see cellGem.cpp).
+
+#include "util/types.hpp"
+
+#include <vector>
+
+namespace ouvr
+{
+	struct pointer_state
+	{
+		bool active = false; // VR session is focused and a controller is tracked; use this instead of the mouse
+		bool on_screen = false;
+		f32 x = 0.5f;        // 0..1 across the virtual screen, left to right
+		f32 y = 0.5f;        // 0..1 top to bottom
+		f32 trigger = 0.0f;  // 0..1
+		bool t = false;
+		bool move = false;
+		bool cross = false;
+		bool circle = false;
+		bool square = false;
+		bool triangle = false;
+		bool start = false;
+		bool select = false;
+
+		// Real controller motion, in the emulated PS Eye camera frame (= the virtual screen: x right, y up,
+		// z towards the player). A real PS Move reports the same quantities, so the game's motion gestures work.
+		bool motion = false;
+		bool assist = false;   // the stick-flick flip is playing
+		f32 rq[4] = {0.f, 0.f, 0.f, 1.f}; // rotation beyond aiming (wrist twist, flicking past the screen), x y z w
+		f32 vel[3] = {};       // mm/s
+		f32 accel[3] = {};     // mm/s^2
+		f32 angvel[3] = {};    // rad/s
+		f32 angaccel[3] = {};  // rad/s^2
+		f32 disp[3] = {};      // mm, quick hand movement (slow drift removed)
+		f32 acc_dev[3] = {0.f, 0.f, 1.f}; // accelerometer in device axes, G (gravity included)
+		f32 gyro_dev[3] = {};  // gyroscope in device axes, rad/s
+	};
+
+	// Called by the renderer when a game boots / shuts down.
+	void start();
+	void stop();
+
+	// True while the VR session is running and wants a copy of every presented frame.
+	bool wants_frames();
+
+	// Latest presented game frame, 4 bytes per pixel.
+	void submit_frame(std::vector<u8>&& pixels, u32 width, u32 height, bool is_bgra);
+
+	// The renderer could not present because the desktop game window is minimized or has no size.
+	void report_window_unavailable();
+
+	// Current controller-as-pointer state (thread safe).
+	pointer_state get_pointer();
+
+	// Diagnostics (written to log/orderup_vr.log). trace() counts calls per name and reports them every few seconds.
+	void trace(const char* name);
+
+	// True-VR research: records likely camera/projection matrices from vertex shader constants a few times per session
+	// (log/orderup_research.log). consts = all 468 transform constants (4 floats each), ids = constants the program reads.
+	void research_constants(u32 program_id, const f32* consts, const u16* ids, usz id_count);
+	void note(const char* fmt, ...);
+
+	// True VR (stereo + head tracking), called by the renderer for every draw on the RSX thread.
+	// The game draws every 3D object with one model-view-projection matrix in constants c1..c4; the mod finds the
+	// camera projection in it and re-renders the scene from the headset's eye. consts = the 468 transform constants,
+	// uses_mvp = the vertex program reads c1..c4.
+	// Returns 0 = leave the draw alone, 1 = 3D scene draw, 2 = 2D overlay draw (HUD, menus: placed on a plane in
+	// the 3D world). For 1 and 2, x receives a row-major 4x4 matrix to apply to the program's clip-space output.
+	int stereo_draw_transform(const f32* consts, bool uses_mvp, u32 surface_w, u32 surface_h, u32 color_offset, f32 x[16]);
+
+	// Changes once per presented frame (the eye being rendered changes); the renderer re-applies the transform then.
+	u64 stereo_generation();
+
+	// rows = the renderer's 4x4 viewport (scale/offset) matrix, row-major; it becomes rows * x.
+	void stereo_apply(void* rows, const f32 x[16]);
+}
