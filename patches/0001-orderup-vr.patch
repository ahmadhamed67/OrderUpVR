+		XrAction make_action(xr_state& xr, const char* name, XrActionType type, bool per_hand)
+		{
+			XrActionCreateInfo info{XR_TYPE_ACTION_CREATE_INFO};
+			std::snprintf(info.actionName, sizeof(info.actionName), "%s", name);
+			std::snprintf(info.localizedActionName, sizeof(info.localizedActionName), "%s", name);
+			info.actionType = type;
+			if (per_hand)
+			{
+				info.countSubactionPaths = 2;
+				info.subactionPaths = xr.hand_path;
+			}
+			XrAction action = XR_NULL_HANDLE;
+			xr_ok(xr, xrCreateAction(xr.action_set, &info, &action), name);
+			return action;
+		}
