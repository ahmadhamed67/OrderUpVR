+						s.scene_key = color_key;
+						if (std::find(s.tainted.begin(), s.tainted.end(), color_key) == s.tainted.end()) s.tainted.push_back(color_key);
+						s.scene_w = surface_w;
+						s.scene_h = surface_h;
+					}
+					is_cam = true;
+				}
+
+				if (is_cam)
+				{
+					kind = 1;
+					if (color_key != ~0ull)
+					{
+						auto it = std::find_if(s.n3_by_key.begin(), s.n3_by_key.end(), [&](const auto& e) { return e.first == color_key; });
