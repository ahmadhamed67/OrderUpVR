+		// Mesh parts: each starts with a block naming its material (0x198 bytes before its first segment), then its
+		// drawn segments (with a vertex attribute block), then their shadow copies (none). Big parts have several.
+		struct part_t { int mat = -1; std::vector<usz> draw; };
+		std::vector<part_t> parts_list;
+		for (const auto& sg : segs)
+		{
+			const usz s = sg.s;
+			const auto mi = s >= 0x198 ? mat_index.find(rd32be(&scene[s - 0x198])) : mat_index.end();
+			if (mi != mat_index.end()) { parts_list.emplace_back(); parts_list.back().mat = mi->second; }
+			if (parts_list.empty()) continue;
+			if (rd32be(&scene[s + 0x30]) != 0) parts_list.back().draw.push_back(&sg - segs.data());
+		}
+
+		// sky, outside, fake-shadow overlays, and the run-down look the game shows only in a neglected restaurant
+		static const char* skip_words[] = {"sphere", "sky", "exterior", "aofakery", "downgrade", "splat", "street", "sidewalk", "building", "overlay", "decal",
+			"shadow", "stain", "cobweb", "web_", "dirt", "rust", "scratch", "filthy", "destroyed", "broken", "mop", "fallen", "can_open", "t_can",
+			"bag_brown", "wetfloor", "kitchen_ao", "ao_overlay", "plate_dirty"};
+		std::map<std::pair<int, u8>, std::vector<u32>> by_batch;   // (picture, blend) -> indices
+		usz pi_next = 0;
+		int parts_bad = 0;
+		for (u32 k = 0; k < nnodes; k++)
+		{
+			const node_t& nd = nodes[k];
+			const auto wi = where.find(nd.hash);
+			bool skip = wi == where.end();
+			if (!skip)
+			{
+				std::string lower = names[nd.hash];
+				for (char& c : lower) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+				for (const char* sw : skip_words) if (lower.find(sw) != std::string::npos) skip = true;
+			}
+			for (u32 part = 0; part < nd.parts; part++)
+			{
+				if (pi_next >= parts_list.size()) break;
+				const part_t& pt = parts_list[pi_next++];
+				if (skip) continue;
+				const int m = pt.mat;
+				const auto ti = mats.find(mat_lib[m]);
+				if (ti == mats.end()) continue;
+				const auto pi = pic_of_image.find(ti->second.image);
+				if (pi == pic_of_image.end() || r.pics[pi->second].rgba.empty()) continue;
+				// Glows (light pools under lamps, lamp cones: black around a bright spot) add light; the rest is solid, cut-out
+				// or see-through as its own picture's alpha says
+				const u8 blend = mat_alpha[m] == 2 ? 3 : r.pics[pi->second].kind;   // +0x60 == 2: added light (lamp pools, light shafts)
+				(void)mat_flags;   // 0x80 only marks thin two-sided cloth, leaves and webs
+				const xform& x = wi->second;
+				for (usz di : pt.draw)
+				{
+					const auto& sg = segs[di];
+					const usz s = sg.s;
+					// the index stream
+					const u32 isz = rd16be(&scene[s + 20]);
+					const u32 tris = sg.ni / 3;
+					std::vector<u16> ix;
+					usz st = 0;
+					for (usz q = s + 16; q + 8 < scene.size() && q < s + 0x2000; q += 16)
+					{
+						const u32 n = rd16be(&scene[q]), X = rd16be(&scene[q + 4]), bits = scene[q + 6];
+						if (bits > 16 || X == 0 || X > 4096) continue;
+						const usz tot = 8 + X + (tris * 2 + 7) / 8 + (usz{n} * bits + 7) / 8;
+						if (pad16(tot) != isz || n > sg.ni || q + isz > scene.size()) continue;
+						std::vector<u16> cand;
+						if (!edge_decompress(job, &scene[s], &scene[q], isz, sg.ni, cand)) continue;
+						u16 mx = 0;
+						for (u16 c : cand) mx = std::max(mx, c);
+						if (mx + 1u != sg.nv) continue;
+						ix = std::move(cand);
+						st = q;
+						break;
+					}
+					if (ix.empty()) { parts_bad++; continue; }
+					// vertices
+					const usz po = st + isz;
+					// positions (f32 x3), the attribute block (u32 size at +0x30), then its Edge stream description: u8 count,
+					// u8 stride, u8 blocks, pad[5], per attribute (offset, format 2 = f32, components, id 2 normal / 3 tangent /
+					// 5 UV / 9 colour, size, slot)
+					const u32 attr_size = rd32be(&scene[s + 0x30]);
+					const u32 stride = attr_size / sg.nv;
+					const usz ao = po + pad16(usz{sg.nv} * 12);
+					const usz dsc = ao + pad16(usz{attr_size});
+					int col_off = -1, uv_off = -1;
+					if (stride && attr_size == stride * sg.nv && dsc + 8 <= scene.size() && scene[dsc + 1] == stride && scene[dsc] >= 1 && scene[dsc] <= 8 &&
+						dsc + 8 + usz{scene[dsc]} * 8 <= scene.size())
+					{
+						for (u32 ai = 0; ai < scene[dsc]; ai++)
+						{
+							const u8* b = &scene[dsc + 8 + usz{ai} * 8];
+							if (b[1] != 2 || u32{b[0]} + b[4] > stride) continue;
+							if (b[3] == 9 && b[2] == 4) col_off = b[0];
+							else if (b[3] == 5 && b[2] == 2) uv_off = b[0];
+						}
+					}
+					if (col_off < 0 || uv_off < 0 || ao + usz{sg.nv} * stride > scene.size()) { parts_bad++; continue; }
+					const u32 base = static_cast<u32>(r.v.size());
+					bool sane = true;
+					for (u32 i = 0; i < sg.nv; i++)
+					{
+						vec3 p{rdf32be(&scene[po + i * 12]), rdf32be(&scene[po + i * 12 + 4]), rdf32be(&scene[po + i * 12 + 8])};
+						if (!std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z) || std::fabs(p.x) > 500.f || std::fabs(p.y) > 500.f || std::fabs(p.z) > 500.f) sane = false;
+						p = {p.x * x.scale.x, p.y * x.scale.y, p.z * x.scale.z};
+						p = qrot(x.rot, p) + x.pos;
+						const u8* a = &scene[ao + usz{i} * stride];
+						vert vv{};
+						vv.p[0] = p.x; vv.p[1] = p.y; vv.p[2] = p.z;
+						for (int c = 0; c < 4; c++) vv.c[c] = std::clamp(rdf32be(a + col_off + c * 4), 0.f, 1.f);
+						vv.uv[0] = rdf32be(a + uv_off); vv.uv[1] = rdf32be(a + uv_off + 4);
+						if (!std::isfinite(vv.uv[0]) || !std::isfinite(vv.uv[1])) { vv.uv[0] = vv.uv[1] = 0.f; }
+						r.v.push_back(vv);
+					}
+					if (!sane) { r.v.resize(base); parts_bad++; continue; }
+					auto& dst = by_batch[{pi->second, blend}];
+					for (u16 c : ix) dst.push_back(base + c);
+				}
+			}
+		}
+		// Opaque first, then cut-outs, then the see-through ones
+		for (u8 b = 0; b < 4; b++)
+			for (auto& [key, list] : by_batch)
+			{
+				if (key.second != b) continue;
+				batch bt;
+				bt.first = static_cast<u32>(r.idx.size());
+				bt.count = static_cast<u32>(list.size());
+				bt.tex = key.first;
+				bt.blend = b;
+				r.idx.insert(r.idx.end(), list.begin(), list.end());
+				r.batches.push_back(bt);
+			}
+		if (r.idx.empty()) { r.error = fmt::format("no geometry (%d parts not decoded)", parts_bad); return false; }
+		{
+			usz parts = 0;
+			for (const auto& nd : nodes) parts += nd.parts;
+			r.info = fmt::format("%u nodes (%zu parts, %zu found), %u materials, %zu segments, %zu placed names, %d parts not decoded", nnodes, parts, parts_list.size(), nmat, segs.size(), where.size(), parts_bad);
+		}
+
+		// Where to stand: inside (floor below, ceiling above), with the most free space around, then the board in
+		// the direction with the longest free view
+		{
+			// floor height: the most common height of upward-facing area
+			std::map<int, f32> up_area;
+			for (usz t = 0; t + 2 < r.idx.size(); t += 3)
+			{
+				const auto& A = r.v[r.idx[t]].p; const auto& B = r.v[r.idx[t + 1]].p; const auto& C = r.v[r.idx[t + 2]].p;
+				const vec3 n = cross(vec3{B[0] - A[0], B[1] - A[1], B[2] - A[2]}, vec3{C[0] - A[0], C[1] - A[1], C[2] - A[2]});
+				const f32 area = std::sqrt(dot(n, n)) * 0.5f;
+				if (area < 1e-4f || std::fabs(n.y) < 0.95f * std::sqrt(dot(n, n))) continue;
+				up_area[static_cast<int>(std::floor((A[1] + B[1] + C[1]) / 3.f * 10.f))] += area;
+			}
+			// The dining room's middle (median of its tables), when the layout names them
+			bool have_tables = tables.size() >= 2;
+			vec3 tmid{};
+			if (have_tables)
+			{
+				std::vector<f32> tx, ty, tz;
+				for (const auto& t : tables) { tx.push_back(t.x); ty.push_back(t.y); tz.push_back(t.z); }
+				std::sort(tx.begin(), tx.end()); std::sort(ty.begin(), ty.end()); std::sort(tz.begin(), tz.end());
+				tmid = {tx[tx.size() / 2], ty[ty.size() / 2], tz[tz.size() / 2]};
+			}
+			// floor: the biggest upward area (near the tables' height when known)
+			int floor_bin = 0;
+			f32 best = 0.f;
+			for (const auto& [b, a] : up_area)
+			{
+				if (b >= 30) continue;
+				if (have_tables && std::fabs(b * 0.1f - tmid.y) > 1.2f) continue;
+				if (a > best) { best = a; floor_bin = b; }
+			}
+			const f32 fy = floor_bin * 0.1f + 0.05f;
+			// grid over the geometry
+			f32 x0 = 1e9f, x1 = -1e9f, z0 = 1e9f, z1 = -1e9f;
+			for (const auto& vv : r.v) { x0 = std::min(x0, vv.p[0]); x1 = std::max(x1, vv.p[0]); z0 = std::min(z0, vv.p[2]); z1 = std::max(z1, vv.p[2]); }
+			constexpr f32 cell = 0.2f;
+			const int gw = std::clamp(static_cast<int>((x1 - x0) / cell) + 1, 1, 600), gh = std::clamp(static_cast<int>((z1 - z0) / cell) + 1, 1, 600);
+			std::vector<u8> occ(usz(gw) * gh, 0), flo(usz(gw) * gh, 0), roof(usz(gw) * gh, 0);
+			const auto mark = [&](std::vector<u8>& g, f32 x, f32 z)
+			{
+				const int i = static_cast<int>((x - x0) / cell), j = static_cast<int>((z - z0) / cell);
+				if (i >= 0 && j >= 0 && i < gw && j < gh) g[usz(j) * gw + i] = 1;
+			};
+			for (usz t = 0; t + 2 < r.idx.size(); t += 3)
+			{
+				const vec3 A{r.v[r.idx[t]].p[0], r.v[r.idx[t]].p[1], r.v[r.idx[t]].p[2]};
+				const vec3 B{r.v[r.idx[t + 1]].p[0], r.v[r.idx[t + 1]].p[1], r.v[r.idx[t + 1]].p[2]};
+				const vec3 C{r.v[r.idx[t + 2]].p[0], r.v[r.idx[t + 2]].p[1], r.v[r.idx[t + 2]].p[2]};
+				const vec3 n = cross(B - A, C - A);
+				const f32 nl = std::sqrt(dot(n, n));
+				if (nl < 1e-6f) continue;
+				const f32 ny = n.y / nl;
+				// sample the triangle every ~10 cm
+				const f32 e = std::max({std::sqrt(dot(B - A, B - A)), std::sqrt(dot(C - A, C - A)), std::sqrt(dot(C - B, C - B))});
+				const int steps = std::clamp(static_cast<int>(e / 0.1f) + 1, 1, 400);
+				for (int a = 0; a <= steps; a++)
+					for (int b = 0; a + b <= steps; b++)
+					{
+						const f32 u = static_cast<f32>(a) / steps, vv = static_cast<f32>(b) / steps;
+						const vec3 p = A + (B - A) * u + (C - A) * vv;
+						const f32 h = p.y - fy;
+						if (ny > 0.9f && std::fabs(h) < 0.25f) mark(flo, p.x, p.z);
+						else if (ny < -0.5f && h > 2.0f && h < 8.f) mark(roof, p.x, p.z);
+						else if (h > 0.12f && h < 1.9f) mark(occ, p.x, p.z);
+					}
+			}
+			// free = inside and not occupied; clearance by repeated erosion
+			std::vector<int> dist(usz(gw) * gh, 0);
+			for (usz i = 0; i < dist.size(); i++) dist[i] = (flo[i] && roof[i] && !occ[i]) ? 1000 : 0;
+			for (int pass = 0; pass < 2; pass++)
+				for (int jj = 0; jj < gh; jj++)
+					for (int ii = 0; ii < gw; ii++)
+					{
+						const int i = pass ? gw - 1 - ii : ii, j = pass ? gh - 1 - jj : jj;
+						int& d = dist[usz(j) * gw + i];
+						if (!d) continue;
+						const int di = pass ? 1 : -1;
+						const int a = (i + di >= 0 && i + di < gw) ? dist[usz(j) * gw + i + di] : 0;
+						const int b = (j + di >= 0 && j + di < gh) ? dist[usz(j + di) * gw + i] : 0;
+						d = std::min(d, std::min(a, b) + 1);
+					}
+			// The restaurant's busy middle (the median of all its detail): stand within 10 m of it, never on a porch outside
+			std::vector<f32> xs, zs;
+			xs.reserve(r.v.size()); zs.reserve(r.v.size());
+			for (const auto& vv : r.v) { xs.push_back(vv.p[0]); zs.push_back(vv.p[2]); }
+			std::nth_element(xs.begin(), xs.begin() + xs.size() / 2, xs.end());
+			std::nth_element(zs.begin(), zs.begin() + zs.size() / 2, zs.end());
+			const f32 mx = have_tables ? tmid.x : xs[xs.size() / 2], mz = have_tables ? tmid.z : zs[zs.size() / 2];
+			int bi = -1, bd = 0;
+			for (f32 radius : {have_tables ? 5.f : 10.f, 1000.f})
+			{
+				for (int j = 0; j < gh; j++)
+					for (int i = 0; i < gw; i++)
+					{
+						const f32 cx = x0 + (i + 0.5f) * cell - mx, cz = z0 + (j + 0.5f) * cell - mz;
+						if (cx * cx + cz * cz > radius * radius) continue;
+						if (dist[usz(j) * gw + i] > bd) { bd = dist[usz(j) * gw + i]; bi = j * gw + i; }
+					}
+				if (bi >= 0) break;
+			}
+			if (bi < 0) { r.error = "no free floor"; return false; }
+			// The longest free line of sight from a cell (16 directions)
+			const auto view = [&](int cidx, f32& facing)
+			{
+				const f32 sx = x0 + (cidx % gw + 0.5f) * cell, sz = z0 + (cidx / gw + 0.5f) * cell;
+				f32 best_len = 0.f;
+				for (int k = 0; k < 16; k++)
+				{
+					const f32 a = k * 6.2831853f / 16.f;
+					const f32 dx = -std::sin(a), dz = -std::cos(a);
+					f32 len = 0.f;
+					for (; len < 12.f; len += cell * 0.5f)
+					{
+						const int i = static_cast<int>((sx + dx * len - x0) / cell), j = static_cast<int>((sz + dz * len - z0) / cell);
+						if (i < 0 || j < 0 || i >= gw || j >= gh) break;
+						const usz c = usz(j) * gw + i;
+						if (occ[c] || !flo[c]) break;
+					}
+					if (len > best_len) { best_len = len; facing = a; }
+				}
+				return best_len;
+			};
+			// Among the roomy spots near the middle, the one with the best view for the board
+			f32 best_score = -1.f;
+			int pick = bi;
+			const int need = std::max(2, bd * 6 / 10);
+			for (int j = 0; j < gh; j += 2)
+				for (int i = 0; i < gw; i += 2)
+				{
+					const int d = dist[usz(j) * gw + i];
+					if (d < need) continue;
+					const f32 cx = x0 + (i + 0.5f) * cell - mx, cz = z0 + (j + 0.5f) * cell - mz;
+					if (cx * cx + cz * cz > (have_tables ? 25.f : 100.f)) continue;
+					f32 fa = 0.f;
+					const f32 score = std::min(view(j * gw + i, fa), 8.f) + 2.f * d * cell;
+					if (score > best_score) { best_score = score; pick = j * gw + i; }
+				}
+			r.spawn = {x0 + (pick % gw + 0.5f) * cell, fy, z0 + (pick / gw + 0.5f) * cell};
+			r.board_dist = view(pick, r.facing);
+		}
+		r.ok = true;
+		return true;
+	}
+}
diff --git a/rpcs3/Emu/Io/OrderUpVR_ui.inl b/rpcs3/Emu/Io/OrderUpVR_ui.inl
new file mode 100644
index 000000000..6bb2773ba
--- /dev/null
+++ b/rpcs3/Emu/Io/OrderUpVR_ui.inl
@@ -0,0 +1,484 @@
+// Order Up VR: the cards shown in the headset (loading, controls, the diner sign, hints), drawn with Direct2D and
+// DirectWrite into premultiplied BGRA pictures. Also writes PNG files for the developer tools.
+// Included from OrderUpVR.cpp inside namespace ouvr.
+
+namespace ui
+{
+	struct row { std::wstring key, text; };
+
+	struct card
+	{
+		enum style_t { PANEL, SIGN, HELP, HINT, CHOOSER } style = PANEL;
+		std::wstring kicker, title, subtitle;
+		std::vector<row> rows;
+		int progress = -1;            // 0..100; -2 = busy (moving bar)
+		f32 phase = 0.f;              // 0..1: where the busy bar is
+		std::wstring progress_label;  // under the bar, left
+		std::wstring tip;             // footer
+		int columns = 1;              // rows in this many columns (controls card)
+		// CHOOSER: rows are big tiles (key = name, text = what it is); hover lights one, disabled shows "Coming soon"
+		int hover = -1, disabled = -1;
+
+		std::wstring signature() const
+		{
+			std::wstring s = kicker + L"|" + title + L"|" + subtitle + L"|" + progress_label + L"|" + tip + L"|" + std::to_wstring(progress) + L"|" + std::to_wstring(static_cast<int>(phase * 20));
+			for (const auto& r : rows) s += L"|" + r.key + L"=" + r.text;
+			s += L"|" + std::to_wstring(hover) + L"|" + std::to_wstring(disabled);
+			return s;
+		}
+	};
+
+	inline std::wstring wide(const std::string& s)
+	{
+		if (s.empty()) return {};
+		const int n = MultiByteToWideChar(CP_UTF8, 0, s.c_str(), static_cast<int>(s.size()), nullptr, 0);
+		std::wstring w(n, L'\0');
+		MultiByteToWideChar(CP_UTF8, 0, s.c_str(), static_cast<int>(s.size()), w.data(), n);
+		return w;
+	}
+
+	struct factories
+	{
+		ID2D1Factory* d2d = nullptr;
+		IDWriteFactory* dw = nullptr;
+		IWICImagingFactory* wic = nullptr;
+		bool tried = false;
+	};
+
+	inline factories& fac()
+	{
+		thread_local factories f;
+		if (!f.tried)
+		{
+			f.tried = true;
+			CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+			D2D1CreateFactory(D2D1_FACTORY_TYPE_SINGLE_THREADED, &f.d2d);
+			DWriteCreateFactory(DWRITE_FACTORY_TYPE_SHARED, __uuidof(IDWriteFactory), reinterpret_cast<IUnknown**>(&f.dw));
+			CoCreateInstance(CLSID_WICImagingFactory, nullptr, CLSCTX_INPROC_SERVER, IID_PPV_ARGS(&f.wic));
+		}
+		return f;
+	}
+
+	template <typename T> void rel(T*& p) { if (p) { p->Release(); p = nullptr; } }
+
+	inline D2D1_COLOR_F rgba(u32 rgb, f32 a = 1.f) { return D2D1::ColorF(rgb, a); }
+
+	struct painter
+	{
+		ID2D1RenderTarget* rt = nullptr;
+		IDWriteFactory* dw = nullptr;
+		ID2D1Factory* d2d = nullptr;
+
+		IDWriteTextFormat* font(f32 size, DWRITE_FONT_WEIGHT weight, bool display = false, bool wrap = true, DWRITE_TEXT_ALIGNMENT align = DWRITE_TEXT_ALIGNMENT_LEADING)
+		{
+			IDWriteTextFormat* tf = nullptr;
+			dw->CreateTextFormat(display ? L"Segoe UI Variable Display" : L"Segoe UI Variable Text", nullptr, weight, DWRITE_FONT_STYLE_NORMAL, DWRITE_FONT_STRETCH_NORMAL, size, L"en-us", &tf);
+			if (!tf) dw->CreateTextFormat(L"Segoe UI", nullptr, weight, DWRITE_FONT_STYLE_NORMAL, DWRITE_FONT_STRETCH_NORMAL, size, L"en-us", &tf);
+			if (tf)
+			{
+				tf->SetWordWrapping(wrap ? DWRITE_WORD_WRAPPING_WRAP : DWRITE_WORD_WRAPPING_NO_WRAP);
+				tf->SetTextAlignment(align);
+				if (!wrap)
+				{
+					DWRITE_TRIMMING tr{DWRITE_TRIMMING_GRANULARITY_CHARACTER, 0, 0};
+					IDWriteInlineObject* ell = nullptr;
+					dw->CreateEllipsisTrimmingSign(tf, &ell);
+					tf->SetTrimming(&tr, ell);
+					rel(ell);
+				}
+			}
+			return tf;
+		}
+
+		// Draws text in a box; returns the height it took
+		f32 text(const std::wstring& s, f32 x, f32 y, f32 w, f32 h, f32 size, DWRITE_FONT_WEIGHT weight, D2D1_COLOR_F col, bool display = false, bool wrap = true,
+			DWRITE_TEXT_ALIGNMENT align = DWRITE_TEXT_ALIGNMENT_LEADING)
+		{
+			if (s.empty()) return 0.f;
+			IDWriteTextFormat* tf = font(size, weight, display, wrap, align);
+			if (!tf) return 0.f;
+			IDWriteTextLayout* tl = nullptr;
+			dw->CreateTextLayout(s.c_str(), static_cast<UINT32>(s.size()), tf, w, h, &tl);
+			f32 used = 0.f;
+			if (tl)
+			{
+				ID2D1SolidColorBrush* b = nullptr;
+				rt->CreateSolidColorBrush(col, &b);
+				if (b) rt->DrawTextLayout({x, y}, tl, b, D2D1_DRAW_TEXT_OPTIONS_CLIP);
+				DWRITE_TEXT_METRICS m{};
+				tl->GetMetrics(&m);
+				used = m.height;
+				rel(b);
+				rel(tl);
+			}
+			rel(tf);
+			return used;
+		}
+
+		f32 text_width(const std::wstring& s, f32 size, DWRITE_FONT_WEIGHT weight)
+		{
+			IDWriteTextFormat* tf = font(size, weight, false, false);
+			if (!tf) return 0.f;
+			IDWriteTextLayout* tl = nullptr;
+			dw->CreateTextLayout(s.c_str(), static_cast<UINT32>(s.size()), tf, 4000.f, 400.f, &tl);
+			DWRITE_TEXT_METRICS m{};
+			if (tl) tl->GetMetrics(&m);
+			rel(tl);
+			rel(tf);
+			return m.widthIncludingTrailingWhitespace;
+		}
+
+		void fill_round(D2D1_RECT_F r, f32 rad, D2D1_COLOR_F col)
+		{
+			ID2D1SolidColorBrush* b = nullptr;
+			rt->CreateSolidColorBrush(col, &b);
+			if (b) rt->FillRoundedRectangle({r, rad, rad}, b);
+			rel(b);
+		}
+
+		void stroke_round(D2D1_RECT_F r, f32 rad, D2D1_COLOR_F col, f32 width)
+		{
+			ID2D1SolidColorBrush* b = nullptr;
+			rt->CreateSolidColorBrush(col, &b);
+			if (b) rt->DrawRoundedRectangle({r, rad, rad}, b, width);
+			rel(b);
+		}
+
+		ID2D1LinearGradientBrush* linear(D2D1_POINT_2F a, D2D1_POINT_2F b, std::initializer_list<D2D1_GRADIENT_STOP> stops)
+		{
+			ID2D1GradientStopCollection* sc = nullptr;
+			std::vector<D2D1_GRADIENT_STOP> v(stops);
+			rt->CreateGradientStopCollection(v.data(), static_cast<UINT32>(v.size()), &sc);
+			ID2D1LinearGradientBrush* br = nullptr;
+			if (sc) rt->CreateLinearGradientBrush({a, b}, sc, &br);
+			rel(sc);
+			return br;
+		}
+
+		ID2D1RadialGradientBrush* radial(D2D1_POINT_2F c, f32 r, D2D1_COLOR_F col)
+		{
+			const D2D1_GRADIENT_STOP st[2] = {{0.f, col}, {1.f, D2D1::ColorF(col.r, col.g, col.b, 0.f)}};
+			ID2D1GradientStopCollection* sc = nullptr;
+			rt->CreateGradientStopCollection(st, 2, &sc);
+			ID2D1RadialGradientBrush* br = nullptr;
+			if (sc) rt->CreateRadialGradientBrush({c, {0, 0}, r, r}, sc, &br);
+			rel(sc);
+			return br;
+		}
+
+		// The brand mark: a rounded square in the orange-to-pink gradient with "VR"
+		void badge(f32 x, f32 y, f32 s)
+		{
+			ID2D1LinearGradientBrush* g = linear({x, y}, {x + s, y + s}, {{0.f, rgba(0xFFA21F)}, {1.f, rgba(0xFF3D6E)}});
+			if (g) rt->FillRoundedRectangle({{x, y, x + s, y + s}, s * 0.28f, s * 0.28f}, g);
+			rel(g);
+			text(L"VR", x, y + s * 0.18f, s, s, s * 0.40f, DWRITE_FONT_WEIGHT_BLACK, rgba(0xFFFFFF), true, false, DWRITE_TEXT_ALIGNMENT_CENTER);
+		}
+
+		// A key chip like the launcher's: tinted orange with a thin border; returns its width
+		f32 chip(const std::wstring& s, f32 x, f32 y, f32 size, f32 min_w = 0.f)
+		{
+			const f32 pad = size * 0.65f, w = std::max(min_w, text_width(s, size, DWRITE_FONT_WEIGHT_BOLD) + pad * 2.f), h = size * 1.75f;
+			fill_round({x, y, x + w, y + h}, h * 0.32f, rgba(0xFF8A00, 0.16f));
+			stroke_round({x + 0.75f, y + 0.75f, x + w - 0.75f, y + h - 0.75f}, h * 0.32f, rgba(0xFF8A00, 0.55f), 1.5f);
+			text(s, x, y + (h - size * 1.33f) * 0.5f, w, h, size, DWRITE_FONT_WEIGHT_BOLD, rgba(0xFFB25C), false, false, DWRITE_TEXT_ALIGNMENT_CENTER);
+			return w;
+		}
+
+		// Frosted dark glass with a soft shadow, warm glows and a fine edge
+		void glass(D2D1_RECT_F r, f32 rad)
+		{
+			for (int k = 6; k >= 1; k--)
+			{
+				const f32 g = k * 3.f;
+				fill_round({r.left - g, r.top - g + 6.f, r.right + g, r.bottom + g + 6.f}, rad + g, rgba(0x000000, 0.045f));
+			}
+			ID2D1LinearGradientBrush* body = linear({r.left, r.top}, {r.left, r.bottom}, {{0.f, rgba(0x1D2130, 0.97f)}, {1.f, rgba(0x111319, 0.97f)}});
+			if (body) rt->FillRoundedRectangle({r, rad, rad}, body);
+			rel(body);
+			ID2D1RoundedRectangleGeometry* clip = nullptr;
+			d2d->CreateRoundedRectangleGeometry({r, rad, rad}, &clip);
+			if (clip)
+			{
+				ID2D1Layer* layer = nullptr;
+				rt->CreateLayer(&layer);
+				if (layer)
+				{
+					rt->PushLayer(D2D1::LayerParameters(D2D1::InfiniteRect(), clip), layer);
+					const f32 w = r.right - r.left, h = r.bottom - r.top;
+					if (auto* g1 = radial({r.left + w * 0.08f, r.top + h * 0.02f}, std::max(w, h) * 0.55f, rgba(0xFF8A00, 0.22f))) { rt->FillRectangle(r, g1); g1->Release(); }
+					if (auto* g2 = radial({r.right - w * 0.05f, r.bottom}, std::max(w, h) * 0.5f, rgba(0xFF3D6E, 0.16f))) { rt->FillRectangle(r, g2); g2->Release(); }
+					if (auto* g3 = radial({r.left + w * 0.55f, r.top + h * 0.6f}, std::max(w, h) * 0.35f, rgba(0x8B5CF6, 0.08f))) { rt->FillRectangle(r, g3); g3->Release(); }
+					// light along the top edge
+					if (auto* hl = linear({r.left, r.top}, {r.left, r.top + 90.f}, {{0.f, rgba(0xFFFFFF, 0.07f)}, {1.f, rgba(0xFFFFFF, 0.f)}})) { rt->FillRectangle({r.left, r.top, r.right, r.top + 90.f}, hl); hl->Release(); }
+					rt->PopLayer();
+					rel(layer);
+				}
+				rel(clip);
+			}
+			stroke_round({r.left + 1.f, r.top + 1.f, r.right - 1.f, r.bottom - 1.f}, rad - 1.f, rgba(0xFFFFFF, 0.13f), 2.f);
+		}
+
+		void progress(D2D1_RECT_F r, int percent, f32 phase)
+		{
+			const f32 h = r.bottom - r.top;
+			fill_round(r, h * 0.5f, rgba(0x2A2F3B));
+			f32 x0 = r.left, x1 = r.left;
+			if (percent >= 0) x1 = r.left + (r.right - r.left) * std::clamp(percent, 0, 100) / 100.f;
+			else
+			{
+				const f32 span = (r.right - r.left) * 0.28f, t = phase - std::floor(phase);
+				x0 = r.left - span + (r.right - r.left + span) * t;
+				x1 = x0 + span;
+				x0 = std::max(x0, r.left);
+				x1 = std::min(x1, r.right);
+			}
+			if (x1 - x0 < h) return;
+			ID2D1LinearGradientBrush* g = linear({r.left, r.top}, {r.right, r.top}, {{0.f, rgba(0xFFA21F)}, {1.f, rgba(0xFF3D6E)}});
+			if (g) rt->FillRoundedRectangle({{x0, r.top, x1, r.bottom}, h * 0.5f, h * 0.5f}, g);
+			rel(g);
+			// a soft glow under the fill
+			fill_round({x0, r.top - 3.f, x1, r.bottom + 3.f}, h * 0.5f + 3.f, rgba(0xFF7A00, 0.10f));
+		}
+
+		// Neon tube text for the diner sign: a wide soft halo, then the bright tube
+		void neon(const std::wstring& s, f32 x, f32 y, f32 w, f32 h, f32 size, u32 col)
+		{
+			for (int ring = 3; ring >= 1; ring--)
+			{
+				const f32 d = ring * 2.6f;
+				for (int k = 0; k < 12; k++)
+				{
+					const f32 a = k * 0.5235988f;
+					text(s, x + std::cos(a) * d, y + std::sin(a) * d, w, h, size, DWRITE_FONT_WEIGHT_BOLD, rgba(col, 0.035f * (4 - ring)), true, false, DWRITE_TEXT_ALIGNMENT_CENTER);
+				}
+			}
+			text(s, x, y, w, h, size, DWRITE_FONT_WEIGHT_BOLD, rgba(col), true, false, DWRITE_TEXT_ALIGNMENT_CENTER);
+			text(s, x, y, w, h, size, DWRITE_FONT_WEIGHT_BOLD, rgba(0xFFF3E0, 0.35f), true, false, DWRITE_TEXT_ALIGNMENT_CENTER);
+		}
+	};
+
+	// Chooser tiles in card pixels (the headset's hit test uses the same rectangles)
+	inline D2D1_RECT_F chooser_tile(u32 w, u32 h, int i)
+	{
+		const f32 m = 22.f, pad = 52.f, x0 = m + pad, x1 = static_cast<f32>(w) - m - pad, gap = 32.f;
+		const f32 tw = (x1 - x0 - gap) * 0.5f;
+		const f32 y0 = 250.f, y1 = static_cast<f32>(h) - m - 120.f;
+		const f32 l = x0 + i * (tw + gap);
+		return {l, y0, l + tw, y1};
+	}
+
+	// Draws the card into premultiplied BGRA pixels (w x h)
+	inline bool render(const card& c, u32 w, u32 h, std::vector<u8>& out)
+	{
+		auto& f = fac();
+		if (!f.d2d || !f.dw || !f.wic) return false;
