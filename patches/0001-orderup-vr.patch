+	// The emulator's fatal error handler: a crash report to the live stream before the process ends
+	void live_fatal(std::string_view text) { live::fatal(text); }
+
+	void stereo_apply(void* rows, const f32 x[16])
+	{
+		mat4 S, X;
+		std::memcpy(S.m, rows, sizeof(S.m));
+		std::memcpy(X.m, x, sizeof(X.m));
+		const mat4 R = mmul(S, X);
+		std::memcpy(rows, R.m, sizeof(R.m));
+	}
