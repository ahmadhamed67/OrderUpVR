+		// The game camera's height above the restaurant floor, from the game's own camera (its world position is kept at
+		// 0x00382218, next to its view matrix; the restaurants' floors are at about y = 0 in game units)
+		bool game_camera_height(f32& h)
+		{
+			if (!g_game_known || !vm::check_addr(0x00382218, vm::page_readable, 12)) return false;
+			h = chef::rdf32be(static_cast<const u8*>(vm::base(0x0038221c)));
+			return std::isfinite(h) && h > 1.f && h < 20.f;
+		}
+
+		void place_screen(xr_state& xr)
+		{
+			vec3 f = xr.last_forward;
+			f.y = 0.0f;
+			const f32 len = std::sqrt(dot(f, f));
+			f = len > 0.001f ? f * (1.0f / len) : vec3{0.0f, 0.0f, -1.0f};
+
+			xr.screen_center = xr.last_head + f * xr.screen_distance;
+			xr.screen_center.y = xr.last_head.y - 0.10f;
+			xr.screen_yaw = std::atan2(-f.x, -f.z);
+			xr.screen_placed = true;
+			xr.hud_locked = false;   // the HUD panels are placed again where you are
+			xr.hud_world_ok = false;
+
+			// True VR: one scale for your body, the lobby and the restaurant (your eyes are the chef's eyes). Your eyes go
+			// to the chef's eye height above the game's floor (at most eye_drop below the game camera), stepped towards
+			// what the camera looks at until it is within reach.
+			xr.player_pos = xr.last_head;
+			xr.player_yaw = xr.screen_yaw;
+			xr.eye_off = {};
+			{
+				cam_info c;
+				{
+					std::lock_guard lock(g_state_mutex);
+					c = g_cam;
+				}
+				const bool real_floor = !xr.comfort.seated && xr.floor_known;
+				const f32 eye_m = real_floor ? (xr.eye_est > 0.9f ? xr.eye_est : xr.last_head.y - xr.floor_y) : seated_eye_m;
+				xr.unit = std::clamp(eye_m / chef_eye_u, 0.85f, 1.35f);
+				const f32 u = xr.unit;
+				f32 cam_mem = 0.f;
+				const bool mem_ok = game_camera_height(cam_mem);
+				const f32 cam_u = mem_ok ? cam_mem : -c.floor_lev;   // the game camera above the restaurant's floor (game units)
+				vr_log("Camera height: %.2f units from the game's camera%s, %.2f from the scene estimate", cam_mem, mem_ok ? "" : " (not readable)", -c.floor_lev);
+				if ((mem_ok || c.bounds) && cam_u > 1.f && cam_u < 20.f)
+				{
+					f32 eye_u = std::clamp(cam_u - xr.eye_drop / u, std::min(chef_eye_u, cam_u), cam_u);
+					const vec3 lv = level(c.up_a, xform(c.D, vec3{0.f, 0.f, -(c.food_d > 0.05f ? c.food_d : c.depth)}));
+					// The game's counter (where the camera looks at the food) goes to your counter's height: your eyes are as
+					// far above the game's counter as a real counter is below your eyes. Neither too high nor underground.
+					{
+						const f32 counter_u = cam_u + lv.y;
+						if (lv.y < -0.3f && counter_u > 0.3f && counter_u < cam_u - 0.3f)
+						{
+							eye_u = std::clamp(counter_u + eye_over_counter_k * eye_m / u, counter_u + 0.3f, cam_u);
+							vr_log("Height: the game's counter is %.2f units up; your eyes go %.2f units above it (%.2f m, as at a real counter)", counter_u, eye_u - counter_u, (eye_u - counter_u) * u);
+						}
+					}
+					const f32 lh = std::sqrt(lv.x * lv.x + lv.z * lv.z);
+					const f32 k = lh > 1e-3f ? std::clamp(lh - xr.reach / u, 0.f, xr.max_step / u) / lh : 0.f;
+					xr.eye_off = {lv.x * k, eye_u - cam_u, lv.z * k};
+					xr.player_pos = xr.last_head - rotate(yaw_q(xr.player_yaw), xr.eye_off * u);
+					vr_log("Recentred: %s, %.3f m per unit (your eyes %.2f m = the chef's); camera %.2f units up, your eyes %.2f units up, %.2f m forward",
+						xr.comfort.seated ? "seated" : "standing", u, eye_m, cam_u, eye_u, lh * k * u);
+				}
+				else vr_log("Recentred: %s, %.3f m per unit, the game camera is at your eyes (restaurant floor %s)",
+					xr.comfort.seated ? "seated" : "standing", u, c.bounds ? "out of range" : "not measured yet");
+			}
+			xr.player_pos.y += xr.lower;
+			vr_log("Screen placed: centre (%.2f, %.2f, %.2f), yaw %.1f deg, %.2f m wide at %.2f m",
+				xr.screen_center.x, xr.screen_center.y, xr.screen_center.z, xr.screen_yaw * 57.29578f, xr.screen_width, xr.screen_distance);
+		}
