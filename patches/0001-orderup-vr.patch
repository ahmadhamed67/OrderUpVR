+		// The restaurant around the menus and the big screen: a diner with a checkered floor, tiled walls, counters
+		// and lamps, built around the screen so the game's menu hangs on the front wall like a menu board.
+		f32 room_width(const xr_state& xr) { return std::max(6.5f, xr.screen_width + 3.f); }
+		constexpr f32 room_depth = 6.f;
+
+		// mirror_pass: drawn as the mirror's reflection; the wall behind the glass is left out (its reflection
+		// would land in front of the glass and cover the whole reflection)
+		void draw_room(xr_state& xr, bool mirror_pass = false)
+		{
+			auto& g = g_gfx;
+			const vec3 normal{std::sin(xr.screen_yaw), 0.f, std::cos(xr.screen_yaw)};   // from the screen toward you
+			const vec3 F = normal * -1.f, Rt{std::cos(xr.screen_yaw), 0.f, -std::sin(xr.screen_yaw)}, Up{0.f, 1.f, 0.f};
+			const f32 floor = xr.floor_known ? xr.floor_y : xr.last_head.y - 1.65f;
+			const f32 sw = xr.screen_width, sh = xr.sc_w ? sw * xr.sc_h / xr.sc_w : sw * 9.f / 16.f;
+			const vec3 front = xr.screen_center + F * 0.04f;           // front wall surface, just behind the screen
+			const f32 W = room_width(xr), Dp = room_depth, H = std::max(3.3f, xr.screen_center.y - floor + sh * 0.5f + 0.9f);
+			const vec3 base{front.x, floor, front.z};
+			const vec3 mid = base - F * (Dp * 0.5f);
+			// A box: centre c, size along (right, up, forward)
+			const auto box = [&](vec3 c, vec3 size, vec3 col, f32 mode)
+			{
+				g.pattern_size = size;
+				gfx_draw(xr, g.box, m_cols(Rt * size.x, Up * size.y, F * size.z, c), col, mode);
+			};
+			const vec3 tile{0.62f, 0.80f, 0.76f}, cream{0.93f, 0.89f, 0.80f}, wood{0.36f, 0.22f, 0.13f}, steel{0.72f, 0.74f, 0.76f}, red{0.72f, 0.12f, 0.10f};
+			// Floor and ceiling
+			box(mid + Up * -0.01f, {W, 0.02f, Dp}, {1.f, 1.f, 1.f}, 2.f);
+			box(mid + Up * (H + 0.05f), {W, 0.1f, Dp}, {0.20f, 0.17f, 0.15f}, 0.f);
+			// Walls: tiles up to 1.2 m, painted above, with a red trim line
+			const auto wall = [&](vec3 c, vec3 dir_len, f32 len)
+			{
+				const bool along_x = std::fabs(dot(dir_len, Rt)) > 0.5f;
+				const vec3 s_low = along_x ? vec3{len, 1.2f, 0.06f} : vec3{0.06f, 1.2f, len};
+				const vec3 s_trim = along_x ? vec3{len, 0.08f, 0.08f} : vec3{0.08f, 0.08f, len};
+				const vec3 s_up = along_x ? vec3{len, H - 1.28f, 0.06f} : vec3{0.06f, H - 1.28f, len};
+				box(c + Up * 0.6f, s_low, tile, 3.f);
+				box(c + Up * 1.24f, s_trim, red, 0.f);
+				box(c + Up * (1.28f + (H - 1.28f) * 0.5f), s_up, cream, 0.f);
+			};
+			wall(base + F * 0.03f, Rt, W);                                  // front (behind the menu board)
+			wall(base - F * (Dp + 0.03f), Rt, W);                           // back
+			if (!mirror_pass) wall(mid - Rt * (W * 0.5f + 0.03f), F, Dp);   // left (the mirror's wall)
+			wall(mid + Rt * (W * 0.5f + 0.03f), F, Dp);                     // right
+			// The menu board: a wooden frame around the game's picture
+			{
+				const vec3 sc = xr.screen_center + F * 0.02f;
+				const f32 t = 0.12f;
+				box(sc + Up * (sh * 0.5f + t * 0.5f), {sw + 2.f * t, t, 0.06f}, wood, 0.f);
+				box(sc - Up * (sh * 0.5f + t * 0.5f), {sw + 2.f * t, t, 0.06f}, wood, 0.f);
+				box(sc - Rt * (sw * 0.5f + t * 0.5f), {t, sh, 0.06f}, wood, 0.f);
+				box(sc + Rt * (sw * 0.5f + t * 0.5f), {t, sh, 0.06f}, wood, 0.f);
+				box(sc + F * 0.03f, {sw + 2.f * t, sh + 2.f * t, 0.02f}, {0.05f, 0.05f, 0.05f}, 0.f);
+				// Ticket rail under the board
+				box(sc - Up * (sh * 0.5f + t + 0.06f) - F * 0.04f, {sw * 0.9f, 0.04f, 0.04f}, steel, 0.f);
+			}
+			// Counters along both sides: wooden body, steel top, a grill and a fryer on the left
+			// Counters: the right one with the grill and the fryer; the left wall is kept clear for the full-length mirror
+			{
+				const vec3 c = mid + Rt * (W * 0.5f - 0.4f);
+				box(c + Up * 0.45f, {0.75f, 0.9f, Dp * 0.8f}, wood, 0.f);
+				box(c + Up * 0.92f, {0.8f, 0.04f, Dp * 0.8f + 0.04f}, steel, 0.f);
+				box(c + Up * 0.98f + F * 0.6f, {0.6f, 0.08f, 0.9f}, {0.12f, 0.12f, 0.12f}, 0.f);    // grill
+				box(c + Up * 1.06f - F * 0.8f, {0.5f, 0.24f, 0.5f}, steel, 0.f);                   // fryer
+				box(c + Up * 1.19f - F * 0.8f, {0.4f, 0.02f, 0.4f}, {0.75f, 0.55f, 0.18f}, 4.f);    // oil
+				// a short counter on the left, at the back of the diner
+				const vec3 l = base - F * (Dp - 1.2f) - Rt * (W * 0.5f - 0.4f);
+				box(l + Up * 0.45f, {0.75f, 0.9f, 1.6f}, wood, 0.f);
+				box(l + Up * 0.92f, {0.8f, 0.04f, 1.64f}, steel, 0.f);
+			}
+			// Back counter with stools, facing the board
+			{
+				const vec3 c = base - F * (Dp - 0.6f);
+				box(c + Up * 0.5f, {W * 0.6f, 1.0f, 0.6f}, red, 0.f);
+				box(c + Up * 1.02f, {W * 0.6f + 0.05f, 0.04f, 0.66f}, cream, 0.f);
+			}
+			// Hanging lamps (warm glow)
+			for (int k = -1; k <= 1; k++)
+			{
+				const vec3 c = mid + Rt * (k * W * 0.28f) + F * 1.0f + Up * (H - 0.75f);
+				box(c + Up * 0.4f, {0.015f, 0.7f, 0.015f}, {0.1f, 0.1f, 0.1f}, 0.f);
+				g.pattern_size = {1.f, 1.f, 1.f};
+				gfx_draw(xr, g.sphere, m_cols(Rt * 0.13f, Up * 0.09f, F * 0.13f, c), {1.f, 0.86f, 0.62f}, 4.f);
+			}
+			g.pattern_size = {1.f, 1.f, 1.f};
+		}
