+		// Picks an 8-bit colour format the runtime supports. Returns 0 if none.
+		s64 pick_format(xr_state& xr, bool& is_bgra)
+		{
+			u32 count = 0;
+			xrEnumerateSwapchainFormats(xr.session, 0, &count, nullptr);
+			std::vector<s64> formats(count);
+			if (!xr_ok(xr, xrEnumerateSwapchainFormats(xr.session, count, &count, formats.data()), "xrEnumerateSwapchainFormats")) return 0;
+
+			// The images are gamma encoded, so prefer sRGB formats.
+			const struct { DXGI_FORMAT format; bool bgra; } wanted[] =
+			{
+				{DXGI_FORMAT_R8G8B8A8_UNORM_SRGB, false},
+				{DXGI_FORMAT_B8G8R8A8_UNORM_SRGB, true},
+				{DXGI_FORMAT_R8G8B8A8_UNORM, false},
+				{DXGI_FORMAT_B8G8R8A8_UNORM, true},
+			};
+			for (const auto& w : wanted)
+			{
+				if (std::find(formats.begin(), formats.end(), static_cast<s64>(w.format)) != formats.end())
+				{
+					is_bgra = w.bgra;
+					return w.format;
+				}
+			}
+			vr_log("ERROR: the VR runtime offers no 8-bit RGBA swapchain format");
+			return 0;
+		}
