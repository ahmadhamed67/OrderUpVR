+				}
+			}
+			layout_holders(xr, c, view_ok ? &gv : nullptr);
+			// the boards you picked up or put down somewhere: there instead (their cards go with them)
+			apply_boards(xr, c, view_ok ? &gv : nullptr, out);
+		}
+
+		// Pointing at a HUD panel: where the ray meets it, in the game's screen units (-1..1, y up)
+		bool hit_panel(const hud_panel& pn, const hud_region& rg, vec3 o, vec3 d, f32& nx, f32& ny, vec3& hitp)
+		{
+			const vec3 n = cross(pn.A, pn.B);
+			const f32 den = dot(d, n);
+			if (std::fabs(den) < 1e-4f) return false;
+			const f32 t = dot(pn.P - o, n) / den;
+			if (t <= 0.f || t > 4.f) return false;
+			hitp = o + d * t;
+			const f32 u = dot(hitp - pn.P, pn.A) / pn.hw, v = dot(hitp - pn.P, pn.B) / pn.hh;
+			if (std::fabs(u) > 1.f || std::fabs(v) > 1.f) return false;
+			nx = rg.cx + u * rg.hx;
+			ny = rg.cy + v * rg.hy;
+			return true;
+		}
+
+		// Pointing at the HUD cards (each one's plane as the renderer drew it last frame, and the part of the game's screen it
+		// shows): the spot of the card you touch or point at is that spot of the game's screen. The recipe card in your left
+		// hand is not pointed at by that same hand.
+		// (nor the cards on a board that hand carries)
+		bool card_skipped(const vr_card& cd, int hand)
+		{
+			return (cd.holder == 3 && hand == 0) || (hand >= 0 && hand < 2 && cd.holder < 32 && ((g_board_skip[hand] >> cd.holder) & 1u));
+		}
+		// Your fingertip near a card (up to 10 cm in front of it, or pushed up to 3 cm into it) points at the spot under it; the
+		// nearest card wins. dist: how far the fingertip is in front of the card (below 1.5 cm it presses).
+		int touch_card(const cam_info& cam, int hand, vec3 tip, f32& nx, f32& ny, vec3& hitp, f32& dist)
+		{
+			int best = -1;
+			f32 best_d = 1e9f;
+			for (int i = 0; i < cam.card_n; i++)
+			{
+				const vr_card& cd = cam.cards[i];
+				if (card_skipped(cd, hand) || cd.pn.hw <= 0.f || cd.pn.hh <= 0.f) continue;
+				const vec3 n = normalize(cross(cd.pn.A, cd.pn.B));
+				const f32 d = dot(tip - cd.pn.P, n);
+				if (d > 0.10f || d < -0.03f || std::fabs(d) >= best_d) continue;
+				const vec3 q = tip - n * d;
+				const f32 u = dot(q - cd.pn.P, cd.pn.A) / cd.pn.hw, v = dot(q - cd.pn.P, cd.pn.B) / cd.pn.hh;
+				if (std::fabs(u) > 1.f || std::fabs(v) > 1.f) continue;
+				best = i;
+				best_d = std::fabs(d);
+				dist = d;
+				hitp = q;
+				nx = cd.kr.cx + u * cd.kr.hx;
+				ny = cd.kr.cy + v * cd.kr.hy;
+			}
+			return best;
+		}
+		// A ray (the laser, or your hand's ray for cards out of reach): the nearest card it meets within 4 m. With hands the
+		// recipe card in your other hand is only touched (your hand's ray crossing it while you reach for food is not a point)
+		int ray_card(const cam_info& cam, int hand, vec3 o, vec3 d, f32& nx, f32& ny, vec3& hitp, bool touch_held = false)
+		{
+			int best = -1;
+			f32 best_t = 4.f;
+			for (int i = 0; i < cam.card_n; i++)
+			{
+				const vr_card& cd = cam.cards[i];
+				if (card_skipped(cd, hand) || (touch_held && cd.holder == 3) || cd.pn.hw <= 0.f || cd.pn.hh <= 0.f) continue;
+				const vec3 n = cross(cd.pn.A, cd.pn.B);
+				const f32 den = dot(d, n);
+				if (std::fabs(den) < 1e-4f) continue;
+				const f32 t = dot(cd.pn.P - o, n) / den;
+				if (t <= 0.f || t >= best_t) continue;
+				const vec3 q = o + d * t;
+				const f32 u = dot(q - cd.pn.P, cd.pn.A) / cd.pn.hw, v = dot(q - cd.pn.P, cd.pn.B) / cd.pn.hh;
+				if (std::fabs(u) > 1.f || std::fabs(v) > 1.f) continue;
+				best = i;
+				best_t = t;
+				hitp = q;
+				nx = cd.kr.cx + u * cd.kr.hx;
+				ny = cd.kr.cy + v * cd.kr.hy;
+			}
+			return best;
+		}
+		const char* card_name(int holder)
+		{
+			switch (holder)
+			{
+			case 0: return "a ticket on the rail";
+			case 1: return "an assistant's card on the stand";
+			case 2: return "a card on the shelf";
+			case 3: return "the recipe card in your left hand";
+			case 4: return "the recipe card on the counter";
+			default: return "a card";
+			}
+		}
+
+		// Experimental: a track of what you do, 4 times a second (log/orderup_track.log), and an event for every press
+		// One line of the track: to the file, and to the live stream (an EVENT also asks for a picture)
+		void tl_print(std::FILE* f, const char* fmt, ...)
+		{
+			char line[1024];
