+			for (int i = 0; i < 4; i++)
+				for (int j = 0; j < 4; j++)
+					r.m[i * 4 + j] = a.m[i * 4] * b.m[j] + a.m[i * 4 + 1] * b.m[4 + j] + a.m[i * 4 + 2] * b.m[8 + j] + a.m[i * 4 + 3] * b.m[12 + j];
+			return r;
+		}
