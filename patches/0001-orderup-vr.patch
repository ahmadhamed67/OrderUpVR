+		void load_comfort(xr_state& xr)
+		{
+			std::map<std::string, std::string> kv;
+			if (std::FILE* f = open_launcher_file("orderupvr_comfort.txt"))
+			{
+				char line[256];
+				while (std::fgets(line, sizeof(line), f))
+				{
+					std::string l(line);
+					while (!l.empty() && (l.back() == 10 || l.back() == 13 || l.back() == 32)) l.pop_back();
+					const usz eq = l.find('=');
+					if (eq != std::string::npos) kv[l.substr(0, eq)] = l.substr(eq + 1);
+				}
+				std::fclose(f);
+			}
+			const auto get = [&](const char* k, const char* def) { const auto it = kv.find(k); return it == kv.end() ? std::string(def) : it->second; };
+			const auto num = [&](const char* k, f32 def, f32 lo, f32 hi) { const std::string v = get(k, ""); return v.empty() ? def : std::clamp(static_cast<f32>(std::atof(v.c_str())), lo, hi); };
+			auto& c = xr.comfort;
+			const auto old = c;
+			c.body = get("chef", "auto") != "off";
+			c.cinema = get("cutscenes", "screen") != "3d";
+			c.wide = get("wideview", "on") != "off";
+			c.lipsync = get("lipsync", "on") != "off";
+			c.menu_female = get("menuchef", "male") == "female";
+			c.seated = get("playmode", "standing") == "seated";
+			c.smooth_turn = get("turn", "snap") == "smooth";
+			c.vignette = get("vignette", "on") != "off";
+			c.snap_deg = num("snapangle", 45.f, 10.f, 180.f);
+			c.turn_speed = num("turnspeed", 120.f, 20.f, 400.f);
+			c.move_speed = num("movespeed", 1.4f, 0.3f, 5.f);
+			c.hud_dist = num("huddist", 1.5f, 0.6f, 6.f);
+			c.room = get("kitchen", "room") != "follow";
+			c.look_switch = get("lookswitch", "on") != "off";
+			if (const std::string st = get("stereo", ""); !st.empty()) xr.stereo = st != "off";
+			if (const std::string pt = get("pointing", ""); !pt.empty()) xr.pointing_laser = pt == "laser";
+			if (std::memcmp(&old, &c, sizeof(c)) != 0 || !xr.comfort_read)
+			{
+				vr_log("Comfort: body %s, %s, turn %s (%.0f deg snap, %.0f deg/s smooth), move %.1f m/s, vignette %s, HUD at %.1f m, %s, pointing with %s",
+					!c.body ? "hidden" : c.female ? "female chef" : "male chef", c.seated ? "seated" : "standing", c.smooth_turn ? "smooth" : "snap",
+					c.snap_deg, c.turn_speed, c.move_speed, c.vignette ? "on" : "off", c.hud_dist, xr.stereo ? "3D depth" : "no depth",
+					xr.pointing_laser ? "the laser" : "the hands");
+				vr_log("Comfort: kitchen %s, look to change station %s, cutscenes %s", c.room ? "stays still in the room" : "follows the game camera", c.look_switch ? "on" : "off",
+					c.cinema ? "on the big screen" : "inside the game");
+			}
+		}
+
+		// Kitchen stations in room mode. The game changes station with Cross and Circle (A and B). The mod learns which
+		// way each one goes from the camera's own move, remembers where every station's camera looks, and when you
+		// turn your head well past the current station toward a neighbour, it presses the button for you.
+		void update_stations(xr_state& xr, const cam_info& cam, pointer_state& out, u64 now, bool grabbing)
+		{
+			auto& n = xr.nav;
+			if (!xr.live3d || !cam.valid || !cam.room)
+			{
+				if (n.ready || !n.target.empty()) vr_log("Stations: left the kitchen view");
+				const int side = n.side_cross;
+				n = {};
+				n.side_cross = side;
+				return;
+			}
+			if (!n.side_cross)
+			{
+				const std::string v = persist_get("station_cross");
+				if (v == "1" || v == "-1") n.side_cross = v == "1" ? 1 : -1;
+			}
+			// Where the game camera looks, in the room
+			const vec3 look_v = xform(cam.D, {0.f, 0.f, -cam.depth});
+			const vec3 tgt = from_player(xr, level(cam.up_a, look_v) * xr.unit);
+			const vec3 pivot = xr.last_head - rotate(yaw_q(xr.player_yaw), vec3{xr.eye_off.x, 0.f, xr.eye_off.z} * xr.unit);   // the game camera's spot
+			const auto heading = [&](vec3 p) { const vec3 v = p - pivot; return std::atan2(-v.x, -v.z); };
+			const bool settled = cam.still >= 18;
+
+			const auto start = [&](int btn, bool automatic)
+			{
+				n.pending_btn = btn;
+				n.pending_auto = automatic;
+				xr.input_tick = now;
+				n.before = tgt;
+				n.pending_since = now;
+				n.moves_at_press = cam.moves;
+				n.moved = false;
+			};
+
+			// Your own presses (A = Cross, B = Circle) teach the mod which way they go
+			const bool a = get_bool(xr, xr.btn_a), b = get_bool(xr, xr.btn_b);
+			if (!n.pending_btn && a && !n.prev_a) start(1, false);
+			else if (!n.pending_btn && b && !n.prev_b) start(2, false);
+			n.prev_a = a;
+			n.prev_b = b;
+
+			// A press of ours is being held
+			if (now < n.press_until)
+			{
+				if (n.press_btn == 1) out.cross = true;
+				else out.circle = true;
+			}
+
+			if (n.pending_btn)
+			{
+				if (cam.moves != n.moves_at_press) n.moved = true;
+				if (n.moved && settled)
+				{
+					const f32 dh = std::remainder(heading(tgt) - heading(n.before), 6.2831853f);
+					if (std::fabs(dh) > 0.07f && std::fabs(dh) < 2.2f)
+					{
+						const int side = dh > 0.f ? 1 : -1;
+						const int sc = n.pending_btn == 1 ? side : -side;
+						if (sc != n.side_cross)
+						{
+							n.side_cross = sc;
+							persist_set("station_cross", sc > 0 ? "1" : "-1");
+						}
+						if (!n.ready) vr_log("Stations: %s changes station to your %s; look-to-change is ready", n.pending_btn == 1 ? "Cross (A)" : "Circle (B)", side > 0 ? "left" : "right");
+						n.ready = true;
+						n.target[n.idx] = n.before;
+						n.idx += side;
+						n.target[n.idx] = tgt;
+						n.blocked_side = 0;
+					}
+					n.pending_btn = 0;
+				}
+				else if (!n.moved && now - n.pending_since > 1500)
+				{
+					// Nothing happened: no station that way from here (only remembered for our own presses)
+					if (n.pending_auto) { n.blocked_side = (n.pending_btn == 1) == (n.side_cross > 0) ? 1 : -1; n.blocked_idx = n.idx; }
+					n.pending_btn = 0;
+				}
+				else if (now - n.pending_since > 6000) n.pending_btn = 0;
+			}
+			else if (settled && n.ready) n.target[n.idx] = tgt;
+
+			// Look to change station
+			if (!xr.comfort.look_switch || !n.ready || !n.side_cross || n.pending_btn || !settled || grabbing || now < n.press_until + 300) { n.off_since = 0; return; }
+			vec3 f = xr.last_forward;
+			const f32 hh = std::atan2(-f.x, -f.z);
+			const f32 diff = std::remainder(hh - heading(tgt), 6.2831853f);
+			const int side = diff > 0.f ? 1 : -1;
+			if (std::fabs(diff) < 0.26f && n.blocked_side) n.blocked_side = 0;
+			bool want = std::fabs(diff) > 0.52f;    // more than 30 degrees past this station
+			if (const auto it = n.target.find(n.idx + side); it != n.target.end())
+			{
+				// A known neighbour: go when you look closer to it than to this station
+				const f32 dn = std::fabs(std::remainder(hh - heading(it->second), 6.2831853f));
+				want = std::fabs(diff) > 0.17f && dn < std::fabs(diff);
+			}
+			if (n.blocked_side == side && n.blocked_idx == n.idx) want = false;
+			if (!want) { n.off_since = 0; return; }
+			if (!n.off_since || n.off_side != side) { n.off_since = now; n.off_side = side; return; }
+			if (now - n.off_since < 350) return;
+			n.press_btn = side == n.side_cross ? 1 : 2;
+			n.press_until = now + 150;
+			n.off_since = 0;
+			start(n.press_btn, true);
+			vr_log("Stations: you looked %s, pressing %s", side > 0 ? "left" : "right", n.press_btn == 1 ? "Cross" : "Circle");
+		}
+
+		// Where the VR HUD panels are this frame (player frame, metres; the player frame is the game camera's place)
+		// The game's current camera, straight from its memory: the view matrix (3 rows of right, up, back, each with its
+		// translation) the game keeps at 0x003821d8 in its data (found with the camera capture, BLES01470 only)
+		struct game_view { vec3 r[3]{}; vec3 t{}; };
+		bool read_game_view(game_view& v)
+		{
+			if (!g_game_known) return false;
+			constexpr u32 addr = 0x003821d8;
+			if (!vm::check_addr(addr, vm::page_readable, 48)) return false;
+			const u8* p = static_cast<const u8*>(vm::base(addr));
+			f32 f[12];
+			for (int k = 0; k < 12; k++)
+			{
+				f[k] = chef::rdf32be(p + k * 4);
+				if (!std::isfinite(f[k]) || std::fabs(f[k]) > 1e5f) return false;
+			}
+			for (int r = 0; r < 3; r++)
+			{
+				v.r[r] = {f[r * 4], f[r * 4 + 1], f[r * 4 + 2]};
+				const f32 n = dot(v.r[r], v.r[r]);
+				if (n < 0.8f || n > 1.2f) return false;
+			}
+			v.t = {f[3], f[7], f[11]};
+			return true;
+		}
+		vec3 game_to_view(const game_view& v, vec3 w) { return {dot(v.r[0], w) + v.t.x, dot(v.r[1], w) + v.t.y, dot(v.r[2], w) + v.t.z}; }
+		vec3 view_to_game(const game_view& v, vec3 q) { return v.r[0] * (q.x - v.t.x) + v.r[1] * (q.y - v.t.y) + v.r[2] * (q.z - v.t.z); }
+
+		// A short buzz in one controller
+		void buzz(xr_state& xr, int hand, f32 amplitude, int ms)
+		{
+			if (xr.haptic == XR_NULL_HANDLE || xr.session == XR_NULL_HANDLE) return;
+			XrHapticActionInfo info{XR_TYPE_HAPTIC_ACTION_INFO};
+			info.action = xr.haptic;
+			info.subactionPath = xr.hand_path[hand];
+			XrHapticVibration v{XR_TYPE_HAPTIC_VIBRATION};
+			v.amplitude = amplitude;
+			v.duration = static_cast<XrDuration>(ms) * 1000000;
+			v.frequency = XR_FREQUENCY_UNSPECIFIED;
+			xrApplyHapticFeedback(xr.session, &info, reinterpret_cast<const XrHapticBaseHeader*>(&v));
+		}
+
+		// A panel between your room and the player frame (the game's world)
+		hud_panel to_pf_impl(const xr_state& xr, hud_panel p)
+		{
+			const XrQuaternionf inv = qconj(yaw_q(xr.player_yaw));
+			p.P = to_player(xr, p.P); p.A = rotate(inv, p.A); p.B = rotate(inv, p.B);
+			return p;
+		}
+		hud_panel from_pf_impl(const xr_state& xr, hud_panel p)
+		{
+			const XrQuaternionf q = yaw_q(xr.player_yaw);
+			p.P = from_player(xr, p.P); p.A = rotate(q, p.A); p.B = rotate(q, p.B);
+			return p;
+		}
+
+		void layout_hud(xr_state& xr, hud_panel out[4])
+		{
+			const auto to_pf = [&](const hud_panel& p) { return to_pf_impl(xr, p); };
+			const auto from_pf = [&](const hud_panel& p) { return from_pf_impl(xr, p); };
+			cam_info c;
+			{
+				std::lock_guard lock(g_state_mutex);
+				c = g_cam;
+			}
+			// Each panel keeps the shape of its part of the game's screen
+			const f32 aspect = std::max(c.sy, 0.2f) / std::max(c.sx, 0.2f);   // screen width / height
+			const auto set = [](hud_panel& pn, vec3 at, vec3 face_to, f32 hw, f32 hh)
+			{
+				vec3 n = face_to - at;
+				n.y = 0.f;
+				n = dot(n, n) > 1e-6f ? normalize(n) : vec3{0.f, 0.f, 1.f};
+				pn.on = true;
+				pn.P = at;
+				pn.A = normalize(cross(vec3{0.f, 1.f, 0.f}, n));
+				pn.B = {0.f, 1.f, 0.f};
+				pn.hw = hw;
+				pn.hh = hh;
+			};
+			vec3 fwd = xr.last_forward;
+			fwd.y = 0.f;
+			fwd = dot(fwd, fwd) > 1e-6f ? normalize(fwd) : vec3{0.f, 0.f, -1.f};
+			const vec3 right{-fwd.z, 0.f, fwd.x};
+			const vec3 head = xr.last_head;
+			// Tickets and the side panels: placed once where you are placed, within reach, ticket-sized
+			if (!xr.hud_locked)
+			{
+				const f32 rail_hw = 0.48f;   // the top strip of the screen (22.5% of its height, full width)
+				set(xr.hud_room[0], head + fwd * 1.10f + vec3{0.f, 0.15f, 0.f}, head, rail_hw, rail_hw * 0.225f / aspect);
+				const f32 side_hw = 0.11f;   // the side strips (30% of the width, 77.5% of the height)
+				set(xr.hud_room[1], head + fwd * 1.00f - right * 0.55f + vec3{0.f, -0.20f, 0.f}, head, side_hw * 1.6f, side_hw * 1.6f * (0.775f / 0.3f) / aspect);
+				set(xr.hud_room[2], head + fwd * 1.00f + right * 0.55f + vec3{0.f, -0.20f, 0.f}, head, side_hw * 1.6f, side_hw * 1.6f * (0.775f / 0.3f) / aspect);
+				// The stations at your counter (56% of your eye height): the plate lies on it in front of you, a little to the
+				// left; the trash bin stands on the floor by your right leg; the oven under the counter on your left, its
+				// controls on the counter's edge; the food processor on the counter on your right. All within reach (0.4-0.7 m).
+				{
+					const f32 cy = vrui::counter_y(xr);
+					const auto at = [&](f32 f, f32 r, f32 y) { vec3 p = head + fwd * f + right * r; p.y = y; return p; };
+					auto& pl = xr.spot_room[0];
+					pl.on = true; pl.P = at(0.42f, -0.18f, cy + 0.01f);
+					pl.A = right; pl.B = fwd; pl.hw = pl.hh = 0.13f;
+					auto& tr = xr.spot_room[1];
+					tr.on = true; tr.hw = tr.hh = 0.10f; tr.P = at(0.36f, 0.45f, cy - 0.10f);
+					tr.A = right; tr.B = {0.f, 1.f, 0.f};
+					auto& ov = xr.spot_room[2];
+					ov.on = true; ov.hw = ov.hh = 0.11f; ov.P = at(0.45f, -0.50f, cy + 0.02f + 0.11f);
+					ov.A = normalize(right + fwd * 0.6f); ov.B = {0.f, 1.f, 0.f};
+					auto& fp = xr.spot_room[3];
+					fp.on = true; fp.hw = fp.hh = 0.10f; fp.P = at(0.45f, 0.50f, cy + 0.24f + 0.10f);
+					fp.A = normalize(right - fwd * 0.6f); fp.B = {0.f, 1.f, 0.f};
+					vr_log("Stations: counter at %.2f m (floor %s), plate, bin, oven and food processor placed around you", cy - xr.floor_y, xr.floor_known ? "known" : "guessed");
+				}
+				xr.hud_locked = true;
+				// fixed in the game's world from now on: walking or turning with the stick no longer carries them along
+				for (int k = 0; k < 3; k++) xr.hud_pf[k] = to_pf(xr.hud_room[k]);
+				for (int k = 0; k < 4; k++) xr.spot_pf[k] = to_pf(xr.spot_room[k]);
+			}
+			// Cards and menus: each time one opens, in front of you at arm's length
+			const bool menu_up = c.hud_seen[3] > 0;
+			if ((menu_up && !xr.menu_was_up) || !xr.menu_locked)
+			{
+				const f32 hw = 0.55f;   // a menu board about 1.1 m wide at 1.3 m (about 46 degrees)
+				set(xr.hud_room[3], head + fwd * 1.30f + vec3{0.f, -0.05f, 0.f}, head, hw, hw / aspect);
+				xr.hud_pf[3] = to_pf(xr.hud_room[3]);
+				xr.menu_locked = true;
+			}
+			xr.menu_was_up = menu_up;
+			// The player frame is the game's world (what the renderer and the pointer use): the panels stay where they were
+			// placed in the kitchen; the stations' room positions follow from there (you move, they do not)
+			for (int k = 0; k < 4; k++)
+			{
+				out[k] = xr.hud_pf[k];
+				xr.hud_room[k] = from_pf(xr.hud_pf[k]);
+				if (xr.spot_pf[k].on) xr.spot_room[k] = from_pf(xr.spot_pf[k]);
+			}
+			// Anchored in the game's world: placed once (at the food's distance, where the game's HUD shows each strip),
+			// then each frame from the game's camera to you. Facing you, upright.
+			game_view gv;
+			const bool view_ok = xr.live3d && c.valid && read_game_view(gv);
+			if (view_ok && !xr.hud_world_ok && c.food_d > 0.05f)
+			{
+				const f32 k = std::clamp(c.hud_k, 0.2f, 1.f);
+				const f32 sxn = std::max(c.sx * k, 0.1f), syn = std::max(c.sy * k, 0.1f), d = c.food_d;
+				const vec3 q[3] = {
+					{0.f, 0.775f * d / syn, -d},                 // the tickets: the top strip, centred
+					{-0.7f * d / sxn, -0.225f * d / syn, -d},    // the left strip
+					{0.7f * d / sxn, -0.225f * d / syn, -d},     // the right strip
+				};
+				for (int i = 0; i < 3; i++) xr.hud_world[i] = view_to_game(gv, q[i]);
+				xr.hud_world_ok = true;
+				vr_log("HUD: tickets and side panels anchored in the restaurant (food %.2f units away; tickets at %.2f %.2f %.2f)", d, xr.hud_world[0].x, xr.hud_world[0].y, xr.hud_world[0].z);
+			}
+			if (view_ok && xr.hud_world_ok)
+			{
+				const vec3 head_p = to_player(xr, xr.last_head);
+				for (int i = 0; i < 3; i++)
+				{
+					const vec3 pp = level(c.up_a, xform(c.D, game_to_view(gv, xr.hud_world[i]))) * xr.unit;
+					const vec3 rel = pp - head_p;
+					if (!std::isfinite(pp.x) || dot(rel, rel) > 25.f) continue;   // more than 5 m away (another part of the restaurant): keep the room spot
+					vec3 n = head_p - pp;
+					n.y = 0.f;
+					n = dot(n, n) > 1e-6f ? normalize(n) : vec3{0.f, 0.f, 1.f};
+					out[i].P = pp;
+					out[i].A = normalize(cross(vec3{0.f, 1.f, 0.f}, n));
+					out[i].B = {0.f, 1.f, 0.f};
+				}
+			}
+		}
+
+		// Pointing at a HUD panel: where the ray meets it, in the game's screen units (-1..1, y up)
+		bool hit_panel(const hud_panel& pn, const hud_region& rg, vec3 o, vec3 d, f32& nx, f32& ny, vec3& hitp)
+		{
+			const vec3 n = cross(pn.A, pn.B);
+			const f32 den = dot(d, n);
+			if (std::fabs(den) < 1e-4f) return false;
+			const f32 t = dot(pn.P - o, n) / den;
+			if (t <= 0.f || t > 4.f) return false;
+			hitp = o + d * t;
+			const f32 u = dot(hitp - pn.P, pn.A) / pn.hw, v = dot(hitp - pn.P, pn.B) / pn.hh;
+			if (std::fabs(u) > 1.f || std::fabs(v) > 1.f) return false;
+			nx = rg.cx + u * rg.hx;
+			ny = rg.cy + v * rg.hy;
+			return true;
+		}
+
+		// Experimental: a track of what you do, 4 times a second (log/orderup_track.log), and an event for every press
+		// One line of the track: to the file, and to the live stream (an EVENT also asks for a picture)
+		void tl_print(std::FILE* f, const char* fmt, ...)
+		{
+			char line[1024];
+			va_list a;
+			va_start(a, fmt);
+			std::vsnprintf(line, sizeof(line), fmt, a);
+			va_end(a);
+			std::fputs(line, f);
+			std::string t(line);
+			while (!t.empty() && t.back() == '\n') t.pop_back();
+			const bool ev = t.find(" EVENT ") != std::string::npos;
+			live::log("debug", t, ev ? "event" : "track");
+			if (ev) live::request_frame("press");
+			else live::g.last_track = t;
+		}
+
+		void track_log(xr_state& xr, const pointer_state& out)
+		{
+			static std::FILE* f = nullptr;
+			static u64 last = 0, opened = 0;
+			const u64 now = GetTickCount64();
+			if (!f && !opened) { opened = now; f = std::fopen((fs::get_log_dir() + "orderup_track.log").c_str(), "w"); }
+			if (!f) return;
+			if (std::ftell(f) > 30 * 1024 * 1024) return;
+			cam_info c;
+			{
+				std::lock_guard lock(g_state_mutex);
+				c = g_cam;
+			}
+			SYSTEMTIME t; GetLocalTime(&t);
+			const auto hp = [&](int k) { const vec3 p = to_player(xr, to_vec(xr.hand_pose[k].position)); return p; };
+			// events: a press of grip or trigger, and where it pointed
+			const bool press[4] = {xr.hand_grip[0] > 0.6f, xr.hand_grip[1] > 0.6f, xr.hand_trig[0] > 0.6f, xr.hand_trig[1] > 0.6f};
+			static const char* names[4] = {"left GRIP", "right GRIP", "left TRIGGER", "right TRIGGER"};
+			for (int k = 0; k < 4; k++)
+			{
+				if (press[k] && !xr.prev_press[k])
+				{
+					const vec3 h = hp(k & 1);
+					tl_print(f, "[%02d:%02d:%02d.%03d] EVENT %s: pointer %.3f %.3f %s, on %s, hand %.2f %.2f %.2f (player frame, m), view %s%s\n",
+						t.wHour, t.wMinute, t.wSecond, t.wMilliseconds, names[k], out.x, out.y, out.on_screen ? "on screen" : "off screen",
+						xr.ptr_panel < 0 ? (xr.live3d ? "the 3D scene" : "the big screen") : xr.ptr_panel == 0 ? "the tickets rail" : xr.ptr_panel == 1 ? "the left panel" : xr.ptr_panel == 2 ? "the right panel" : "the front panel",
+						h.x, h.y, h.z, xr.live3d ? "3d" : "screen", xr.exit_hover ? ", on the EXIT sign" : "");
+				}
+				xr.prev_press[k] = press[k];
+			}
+			if (now - last < 250) return;
+			last = now;
+			const vec3 head = to_player(xr, xr.last_head), l = hp(0), r = hp(1);
+			const f32 yaw = std::atan2(-xr.last_forward.x, -xr.last_forward.z) * 57.29578f;
+			tl_print(f, "[%02d:%02d:%02d.%03d] view %s mode %s cinema %d still %d | head %.2f %.2f %.2f yaw %.0f | L %.2f %.2f %.2f g%.1f t%.1f | R %.2f %.2f %.2f g%.1f t%.1f | "
+				"ptr %.3f %.3f %d panel %d move %d T %d | hud rail %d left %d right %d front %d | unit %.3f food %.1f depth %.1f\n",
+				t.wHour, t.wMinute, t.wSecond, t.wMilliseconds, xr.live3d ? "3d" : "screen", xr.chooser_active ? "choosing" : xr.mode3d ? "vr" : "flat", c.cinema, c.still,
+				head.x, head.y, head.z, yaw, l.x, l.y, l.z, xr.hand_grip[0], xr.hand_trig[0], r.x, r.y, r.z, xr.hand_grip[1], xr.hand_trig[1],
+				out.x, out.y, out.on_screen, xr.ptr_panel, out.move, out.t, c.hud_seen[0], c.hud_seen[1], c.hud_seen[2], c.hud_seen[3], xr.unit, c.food_d, c.depth);
+			std::fflush(f);
+		}
