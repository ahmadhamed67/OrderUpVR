+	// Runs the game's Edge index decompressor (job code loaded at LS 0) on one segment's compressed index stream.
+	bool edge_decompress(const std::vector<u8>& job, const u8* cfg16, const u8* stream, usz stream_size, u32 num_indexes, std::vector<u16>& out)
+	{
+		spu_vm vm;
+		if (job.size() > 0x3c000) return false;
+		std::memcpy(vm.ls.data(), job.data(), job.size());
+		constexpr u32 ls_in = 0x20000, ls_ctx = 0x30000;
+		if (stream_size > 0xff00) return false;
+		std::memcpy(vm.ls.data() + ls_in, stream, stream_size);
+		std::memcpy(vm.ls.data() + ls_ctx, cfg16, 16);
+		vm.ls[ls_ctx + 0x190] = static_cast<u8>(num_indexes >> 8);
+		vm.ls[ls_ctx + 0x191] = static_cast<u8>(num_indexes);
+		spu_vm::sw(vm.ls.data() + ls_ctx + 0x17c, 0, 0x2ff00);
+		spu_vm::sw(vm.r[1], 0, 0x3e000);   // stack
+		spu_vm::sw(vm.r[0], 0, 0x3fff0);   // return address: stop here
+		spu_vm::sw(vm.r[3], 0, ls_ctx);
+		spu_vm::sw(vm.r[4], 0, ls_in);
+		if (!vm.run(0x6e60, 0x3fff0)) { if (std::getenv("OUVR_CHEF_DEBUG")) std::fprintf(stderr, "edge: stopped at %05x (%08x) after %llu steps\n", vm.pc, rd32be(vm.ls.data() + vm.pc), static_cast<unsigned long long>(vm.steps)); return false; }
+		const u32 at = rd32be(vm.ls.data() + ls_ctx + 0x50);
+		if (at + num_indexes * 2 > vm.ls.size()) return false;
+		out.resize(num_indexes);
+		for (u32 k = 0; k < num_indexes; k++) out[k] = rd16be(vm.ls.data() + at + k * 2);
+		return true;
+	}
