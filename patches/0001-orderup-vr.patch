+		void vr_log(const char* fmt, ...)
+		{
+			std::lock_guard lock(g_log_mutex);
+			if (!g_log)
+			{
+				const std::string path = fs::get_log_dir() + "orderup_vr.log";
+				g_log = std::fopen(path.c_str(), "w");
+				if (!g_log) return;
+			}
+
+			SYSTEMTIME st;
+			GetLocalTime(&st);
+			std::fprintf(g_log, "[%02d:%02d:%02d.%03d] ", st.wHour, st.wMinute, st.wSecond, st.wMilliseconds);
+
+			va_list args;
+			va_start(args, fmt);
+			std::vfprintf(g_log, fmt, args);
+			va_end(args);
+			std::fputc('\n', g_log);
+			std::fflush(g_log);
+		}
