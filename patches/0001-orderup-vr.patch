+
+		constexpr const char* chef_shader = R"(
+cbuffer C : register(b0) { float4x4 vp; float4 eye; float4 clipsph; float4 tint; float4 pad; };
+Texture2D tex : register(t0);
+SamplerState smp : register(s0);
+struct VI { float3 p : POSITION; float3 n : NORMAL; float2 uv : TEXCOORD0; };
+struct VO { float4 pos : SV_Position; float3 n : NORMAL; float2 uv : TEXCOORD0; float3 wp : TEXCOORD1; };
+VO vs_main(VI i)
+{
+	VO o;
+	o.pos = mul(float4(i.p, 1), vp);
+	o.n = i.n;
+	o.uv = i.uv;
+	o.wp = i.p;
+	return o;
+}
+float4 ps_main(VO i) : SV_Target
+{
+	// First person: your own face and nose are cut away around your eyes
+	if (clipsph.w > 0 && distance(i.wp, clipsph.xyz) < clipsph.w) discard;
+	float3 n = normalize(i.n);
+	float3 tv = eye.xyz - i.wp;
+	// Only surfaces that face the viewer (never the inside of the body)
+	if (dot(n, tv) < -0.05 * length(tv)) discard;
+	float3 c = tex.Sample(smp, i.uv).rgb;
+	float l = 0.58 + 0.42 * saturate(dot(n, normalize(float3(0.3, 0.9, 0.25)))) + 0.10 * saturate(dot(n, normalize(float3(-0.4, 0.2, -0.7))));
+	return float4(c * l * tint.rgb, 1);
+}
+)";
+
+		constexpr const char* gfx_shader = R"(
+cbuffer C : register(b0) { float4x4 mvp; float4x4 model; float4 color; float4 params; };
+struct VI { float3 p : POSITION; float3 n : NORMAL; };
+struct VO { float4 pos : SV_Position; float3 n : NORMAL; float3 lp : TEXCOORD0; };
+VO vs_main(VI i)
+{
+	VO o;
+	o.pos = mul(float4(i.p, 1), mvp);
+	if (params.x > 4.5) o.pos.z = o.pos.w * 0.99999;   // mirror: reset depth to far behind the glass
+	o.n = mul(i.n, (float3x3)model);
+	o.lp = i.p;
+	return o;
+}
+float4 ps_main(VO i) : SV_Target
+{
+	if (params.x > 4.5) return float4(color.rgb, 1);
+	if (params.x > 1.5)
+	{
+		// The restaurant room: params.x = 2 checker floor, 3 wall tiles, 4 lamp glow; params.yzw = box size (m)
+		float3 n = normalize(i.n);
+		float3 q = i.lp * params.yzw;
+		float3 an = abs(i.lp);
+		float2 uv = an.y >= max(an.x, an.z) ? q.xz : an.z >= an.x ? q.xy : q.zy;
+		if (params.x > 3.5) return float4(color.rgb, 1);
+		float key = saturate(dot(n, normalize(float3(0.2, 0.95, 0.15))));
+		float lit = 0.55 + 0.45 * key;
+		if (params.x < 2.5)
+		{
+			float2 t = floor(uv / 0.32);
+			float k = fmod(abs(t.x + t.y), 2.0);
+			float2 f = frac(uv / 0.32);
+			float grout = (f.x < 0.03 || f.y < 0.03) ? 0.85 : 1.0;
+			float3 c = lerp(float3(0.80, 0.78, 0.72), float3(0.10, 0.10, 0.11), k) * grout;
+			return float4(c * lit, 1);
+		}
+		// Subway tiles: 15 x 7.5 cm, every other row shifted by half a tile
+		float row = floor(uv.y / 0.075);
+		float2 g = frac(float2(uv.x / 0.15 + fmod(row, 2.0) * 0.5, uv.y / 0.075));
+		float edge = (g.x < 0.04 || g.y < 0.08) ? 0.72 : 1.0;
+		return float4(color.rgb * edge * lit, 1);
+	}
+	if (params.x > 0.5)
+	{
+		// The room around the game: a calm, warm, dark studio
+		float3 d = normalize(i.lp);
+		float3 horizon = float3(0.075, 0.060, 0.050);
+		float3 c = d.y < 0 ? lerp(horizon, float3(0.030, 0.025, 0.022), saturate(-d.y * 2.0))
+		                   : lerp(horizon, float3(0.018, 0.020, 0.035), saturate(d.y * 1.6));
+		return float4(c, 1);
+	}
+	float3 n = normalize(i.n);
+	float key = saturate(dot(n, normalize(float3(0.35, 0.9, 0.25))));
+	float fill = saturate(dot(n, normalize(float3(-0.5, 0.2, -0.6)))) * 0.25;
+	return float4(color.rgb * (0.38 + 0.62 * key + fill), 1);
+}
+)";
+
+		mat4 m_cols(vec3 X, vec3 Y, vec3 Z, vec3 T)
+		{
+			mat4 m;
+			m.m[0] = X.x; m.m[4] = X.y; m.m[8] = X.z;
+			m.m[1] = Y.x; m.m[5] = Y.y; m.m[9] = Y.z;
+			m.m[2] = Z.x; m.m[6] = Z.y; m.m[10] = Z.z;
+			m.m[3] = T.x; m.m[7] = T.y; m.m[11] = T.z;
