+		void gfx_destroy()
+		{
+			auto& g = g_gfx;
+			const auto rel = [](auto*& p) { if (p) { p->Release(); p = nullptr; } };
+			chef_shutdown();
+			for (auto& [tex, view] : g.rtv) view->Release();
+			g.rtv.clear();
+			for (int e = 0; e < 2; e++)
+			{
+				if (g.body_sc[e] != XR_NULL_HANDLE) xrDestroySwapchain(g.body_sc[e]);
+				if (g.env_sc[e] != XR_NULL_HANDLE) xrDestroySwapchain(g.env_sc[e]);
+				rel(g.dsv[e]);
+				rel(g.depth[e]);
+			}
+			for (gmesh* m : {&g.sphere, &g.cyl, &g.box}) { rel(m->vb); rel(m->ib); }
+			rel(g.vs); rel(g.ps); rel(g.il); rel(g.cb); rel(g.rs); rel(g.ds_on); rel(g.ds_off);
+			rel(g.cvs); rel(g.cps); rel(g.cil); rel(g.ccb); rel(g.cvb); rel(g.cib); rel(g.csrv); rel(g.ctex); rel(g.csmp);
+			rel(g.ds_mask); rel(g.ds_reset); rel(g.ds_inside);
+			g = {};
+		}
