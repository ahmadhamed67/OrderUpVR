+		// RPCS3's own first-start preparation progress (the same numbers its progress dialog shows).
+		bool get_progress(u32& percent, std::string& text, u32& done, u32& total)
+		{
+			const u32 ftotal = g_progr_ftotal, ptotal = g_progr_ptotal, pdone = g_progr_pdone;
+			const u64 ftotal_bits = g_progr_ftotal_bits, fknown_bits = g_progr_fknown_bits;
+			if (!ftotal && !ptotal) return false;
+			const bool use_bits = fknown_bits && ftotal_bits;
+			const u64 known = use_bits ? fknown_bits : ftotal;
+			const u64 all = std::max<u64>(ptotal, 1) * std::max<u64>(use_bits ? ftotal_bits : ftotal, 1) / std::max<u64>(known, 1);
+			percent = pdone >= all ? 100 : static_cast<u32>(pdone * 100 / all);
+			text = std::string(g_progr_text);
+			done = pdone;
+			total = ptotal;
+			return true;
+		}
+
+		// What the loading card shows right now. Returns false when the game picture is live (no card).
+		bool panel_card(ui::card& c)
+		{
+			const u64 now = GetTickCount64();
+			c = {};
+			c.style = ui::card::PANEL;
+			c.tip = loading_tip(now);
+
+			static u64 progress_since = 0;
+			static u32 logged_percent = 1000;
+			u32 percent = 0, done = 0, total = 0;
+			std::string what;
+			if (get_progress(percent, what, done, total))
+			{
+				if (!progress_since) progress_since = now;
+				if (percent / 5 != logged_percent / 5) { vr_log("Progress: %u%% %s (%u of %u)", percent, what.c_str(), done, total); logged_percent = percent; }
+
+				// While the game picture is already live, RPCS3 draws its own progress on it; do not cover it.
+				const u64 live_frame = g_last_frame_tick.load();
+				if (live_frame && now - live_frame < 3000) return false;
+
+				const bool first = !already_prepared();
+				if (percent >= 100) persist_set("prepared", mod_version());
+				std::wstring eta;
+				const u64 elapsed = (now - progress_since) / 1000;
+				if (percent >= 3 && percent < 100 && elapsed >= 10)
+				{
+					const u64 left = elapsed * (100 - percent) / percent;
+					eta = left >= 90 ? L"About " + std::to_wstring((left + 30) / 60) + L" minutes left" : L"Less than 2 minutes left";
+				}
+				c.kicker = first ? L"FIRST START" : L"LOADING";
+				c.title = first ? L"Setting up your kitchen" : L"Getting the kitchen ready";
+				c.subtitle = first ? L"A one-time step after installing or updating. Later starts are quick." : L"Order Up!! is loading on your PC.";
+				c.progress = static_cast<int>(percent);
+				c.progress_label = eta.empty() ? (total ? L"Step " + std::to_wstring(done) + L" of " + std::to_wstring(total) : L"Working on it") : eta;
+				return true;
+			}
+			progress_since = 0;
+			const u64 last_frame = g_last_frame_tick.load();
+			const u64 no_window = g_window_unavailable_tick.load();
+
+			if (last_frame && now - last_frame < 3000)
+			{
+				persist_set("prepared", mod_version());
+				return false;
+			}
+			c.progress = -2;
+			c.phase = static_cast<f32>(now % 1600) / 1600.f;
+			if (no_window && now - no_window < 2000)
+			{
+				c.kicker = L"PAUSED";
+				c.title = L"The game window is minimized";
+				c.subtitle = L"Restore the Order Up!! window on your PC (click it in the taskbar). The headset needs that window open.";
+				c.progress = -1;
+				return true;
+			}
+			if (last_frame)
+			{
+				c.kicker = L"ALMOST THERE";
+				c.title = L"Loading the next scene";
+				c.subtitle = L"Hang tight, Chef. If this takes minutes, close the game and send the logs from the launcher.";
+				return true;
+			}
+			const u64 secs = (now - g_start_tick.load()) / 1000;
+			c.kicker = L"ORDER UP!! VR";
+			c.title = already_prepared() ? L"Opening the restaurant" : L"Opening the restaurant for the first time";
+			c.subtitle = already_prepared() ? L"Starting the game on your PC. Keep its window open."
+				: L"The first start after an install or update prepares the game for this PC. It can take a few minutes.";
+			c.progress_label = std::to_wstring(secs) + L" s";
+			return true;
+		}
