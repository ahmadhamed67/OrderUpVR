@@ -2638,14 +2668,103 @@ static void mouse_pos_to_gem_state(u32 mouse_no, gem_config::gem_controller& con
 
 	const auto& mouse = ::at32(handler.GetMice(), mouse_no);
 
+	f32 x_pos = mouse.x_pos;
+	f32 y_pos = mouse.y_pos;
+
+	// Order Up VR: aim of the VR controller on the virtual screen replaces the mouse position
+	if (mouse_no == 0)
+	{
+		if (const ouvr::pointer_state vr = ouvr::get_pointer(); vr.active)
+		{
+			// The game moves its pointer further than the emulated wand moves (measured on BLES01470 with the
+			// rotation cone at 10 degrees: 2.6x horizontally, 3.74x vertically), so scale the aim down to land 1:1.
+			static const f32 gain_x = []{ const char* e = std::getenv("ORDERUP_VR_GAIN_X"); return e ? static_cast<f32>(std::atof(e)) : 2.6f; }();
+			static const f32 gain_y = []{ const char* e = std::getenv("ORDERUP_VR_GAIN_Y"); return e ? static_cast<f32>(std::atof(e)) : 3.74f; }();
+			x_pos = std::clamp(0.5f + (vr.x - 0.5f) / gain_x, 0.02f, 0.98f);
+			y_pos = std::clamp(0.5f + (vr.y - 0.5f) / gain_y, 0.02f, 0.98f);
+		}
+	}
+
+	// Order Up VR experiments: ORDERUP_VR_PTR_MODE 1 = orientation only, 2 = position only (0 = stock behaviour)
+	static const int ptr_mode = []{ const char* e = std::getenv("ORDERUP_VR_PTR_MODE"); return e ? std::atoi(e) : 0; }();
+	static const f32 ptr_cone_h = []{ const char* e = std::getenv("ORDERUP_VR_CONE_H"); return e ? static_cast<f32>(std::atof(e)) : 10.0f; }();
+	static const f32 ptr_cone_v = []{ const char* e = std::getenv("ORDERUP_VR_CONE_V"); return e ? static_cast<f32>(std::atof(e)) : 10.0f; }();
+
 	if constexpr (std::is_same_v<T, vm::ptr<CellGemState>>)
 	{
 		ps_move_data& move_data = ::at32(g_fxo->get<gem_config>().fake_move_data, mouse_no);
-		pos_to_gem_state(mouse_no, controller, gem_state, mouse.x_pos, mouse.y_pos, move_data);
+
+		if (ptr_mode == 1)
+		{
+			pos_to_gem_state(mouse_no, controller, gem_state, 0.5f, 0.5f, move_data);
+
+			const f32 roll = -PadHandlerBase::degree_to_rad((y_pos - 0.5f) * ptr_cone_v); // pitch
+			const f32 pitch = -PadHandlerBase::degree_to_rad((x_pos - 0.5f) * ptr_cone_h); // yaw
+			const f32 cr = std::cos(roll * 0.5f), sr = std::sin(roll * 0.5f);
+			const f32 cp = std::cos(pitch * 0.5f), sp = std::sin(pitch * 0.5f);
+			gem_state->quat[0] = sr * cp;
+			gem_state->quat[1] = cr * sp;
+			gem_state->quat[2] = -sr * sp;
+			gem_state->quat[3] = cr * cp;
+		}
+		else
+		{
+			pos_to_gem_state(mouse_no, controller, gem_state, x_pos, y_pos, move_data);
+
+			// Order Up VR: real controller motion on top of the pointer, so motion gestures (flipping) work
+			if (mouse_no == 0)
+			{
+				if (const ouvr::pointer_state vr = ouvr::get_pointer(); vr.active && vr.motion)
+				{
+					const f32 ax = gem_state->quat[0], ay = gem_state->quat[1], az = gem_state->quat[2], aw = gem_state->quat[3];
+					const f32 bx = vr.rq[0], by = vr.rq[1], bz = vr.rq[2], bw = vr.rq[3];
+					gem_state->quat[0] = aw * bx + ax * bw + ay * bz - az * by;
+					gem_state->quat[1] = aw * by - ax * bz + ay * bw + az * bx;
+					gem_state->quat[2] = aw * bz + ax * by - ay * bx + az * bw;
+					gem_state->quat[3] = aw * bw - ax * bx - ay * by - az * bz;
+
+					for (u32 i = 0; i < 3; i++)
+					{
+						if (vr.assist) // only for the assisted flip: real hand movement made the pointer uneven while dragging
+						{
+							gem_state->pos[i] = gem_state->pos[i] + vr.disp[i];
+							gem_state->handle_pos[i] = gem_state->handle_pos[i] + vr.disp[i];
+						}
+						gem_state->vel[i] = vr.vel[i];
+						gem_state->accel[i] = vr.accel[i];
+						gem_state->handle_vel[i] = vr.vel[i];
+						gem_state->handle_accel[i] = vr.accel[i];
+						gem_state->angvel[i] = vr.angvel[i];
+						gem_state->angaccel[i] = vr.angaccel[i];
+					}
+				}
+			}
+
+			if (ptr_mode == 2)
+			{
+				gem_state->quat[0] = 0.f;
+				gem_state->quat[1] = 0.f;
+				gem_state->quat[2] = 0.f;
+				gem_state->quat[3] = 1.f;
+			}
+		}
 	}
 	else if constexpr (std::is_same_v<T, vm::ptr<CellGemImageState>>)
 	{
-		pos_to_gem_image_state(mouse_no, controller, gem_state, mouse.x_pos, mouse.y_pos);
+		pos_to_gem_image_state(mouse_no, controller, gem_state, ptr_mode == 1 ? 0.5f : x_pos, ptr_mode == 1 ? 0.5f : y_pos);
+	}
+	if constexpr (std::is_same_v<T, vm::ptr<CellGemState>>)
+	{
+		static u64 last_note = 0;
+		static const bool trace_state = []{ const char* e = std::getenv("ORDERUP_VR_TRACE"); return e && *e == '1'; }();
+		if (const u64 now = get_system_time(); trace_state && now - last_note > 500'000)
+		{
+			last_note = now;
+			ouvr::note("gem state: in=(%.3f, %.3f) pos=(%.1f, %.1f, %.1f) quat=(%.4f, %.4f, %.4f, %.4f) vel=(%.1f, %.1f, %.1f) tracking=0x%x radius_valid=%d",
+				x_pos, y_pos, +gem_state->pos[0], +gem_state->pos[1], +gem_state->pos[2],
+				+gem_state->quat[0], +gem_state->quat[1], +gem_state->quat[2], +gem_state->quat[3],
+				+gem_state->vel[0], +gem_state->vel[1], +gem_state->vel[2], +gem_state->tracking_flags, controller.radius_valid);
+		}
 	}
 }
 
