+					{
+						if (mr_is_scalar(c.type) || c.tests >= 2 || c.hits < 3 || c.misses > c.hits || !mr_matches_now(c, t)) continue;
+						if (!best || c.hits > best->hits) best = &c;
+					}
+					if (best) pick.push_back(best);
+					else
+					{
+						// Then all the single values at once; a change in the picture is narrowed down by halves
+						for (const auto& c : m.cands)
+						{
+							if (!mr_is_scalar(c.type) || c.tests || c.hits < 2 || c.misses > c.hits || !mr_matches_now(c, t)) continue;
+							pick.push_back(&c);
+							if (pick.size() >= 512) break;
+						}
+						group = true;
+					}
+				}
+				for (const auto* c : pick)
+				{
+					mr_write w;
+					if (mr_make_write(*c, t, w)) m.exp.push_back(std::move(w));
+				}
+				if (!m.exp.empty())
+				{
+					m.exp_group = group;
+					m.exp_from_half = from_half;
+					m.exp_frames = 0;
+					m.experiments++;
+					m.next_exp = now + 1500;
+					if (m.log)
+					{
+						if (group) std::fprintf(m.log, "test %d: changing a group of %zu values for a moment\n", m.experiments, m.exp.size());
+						else std::fprintf(m.log, "test %d: changing %s at 0x%08x for a moment\n", m.experiments, mr_type_name(m.exp[0].type), m.exp[0].addr);
+						std::fflush(m.log);
+					}
+				}
+				else if (from_half) m.other_half.clear();
+			}
+
+			// Summary every 30 s
+			static u64 last_summary = 0;
+			if (now - last_summary > 30000)
+			{
+				last_summary = now;
+				std::lock_guard lock(m.mtx);
+				if (m.log)
+				{
+					std::fprintf(m.log, "summary at frame %llu: camera rows (%.4f %.4f %.4f) (%.4f %.4f %.4f) (%.4f %.4f %.4f) sx %.4f sy %.4f; %zu candidates, %zu suspects, capture state %d\n",
+						static_cast<unsigned long long>(m.frame), R[0].x, R[0].y, R[0].z, R[1].x, R[1].y, R[1].z, R[2].x, R[2].y, R[2].z, sx, sy, m.cands.size(), m.suspects.size(), m.snap_state.load());
+					std::vector<mr_cand> top = m.cands;
+					std::sort(top.begin(), top.end(), [](const mr_cand& a, const mr_cand& b) { return a.effects != b.effects ? a.effects > b.effects : a.hits - a.misses > b.hits - b.misses; });
+					for (usz i = 0; i < top.size() && i < 40; i++)
+					{
+						const auto& c = top[i];
+						std::fprintf(m.log, "  0x%08x %-30s stride %d  followed %d  lost %d  tests %d  moved the picture %d\n", c.addr, mr_type_name(c.type), c.stride, c.hits, c.misses, c.tests, c.effects);
+					}
+					std::fflush(m.log);
+				}
+			}
+		}
+	}
+
+	bool stereo_clear_color(u64 color_key, f32 rgba[4])
+	{
+		if (!g_session_running.load(std::memory_order_relaxed)) return false;
+		auto& s = g_rv;
+		if (!s.begun) rv_begin_frame();
+		if (!s.enabled || (color_key != s.scene_key && !s.is_screen(color_key))) return false;
+		// The key colour: the headset makes it see-through and shows a calm room behind the game
+		rgba[0] = 2.f / 255.f; rgba[1] = 3.f / 255.f; rgba[2] = 5.f / 255.f; rgba[3] = 1.f;
+		return true;
+	}
+
+	int stereo_draw_transform(const f32* consts, bool uses_mvp, u32 surface_w, u32 surface_h, u64 color_key, const u64* tex_keys, u32 tex_count, f32 x[16])
+	{
+		if (!g_session_running.load(std::memory_order_relaxed)) return 0;
+		auto& s = g_rv;
+		if (!s.begun) rv_begin_frame();
+		const u64 gen = s.gen.load();
+
+		int kind = 0;
+		bool perspective = false;
+		if (uses_mvp && consts)
+		{
+			// c1..c4 = rows of the model-view-projection matrix
+			const f32* m = consts + 4;
+			const vec3 r0{m[0], m[1], m[2]}, r1{m[4], m[5], m[6]}, r2{m[8], m[9], m[10]}, r3{m[12], m[13], m[14]};
+			const f32 l2 = dot(r3, r3);
+			if (l2 > 1e-8f && std::isfinite(l2) && std::isfinite(m[15]))
+			{
+				perspective = true;
+				// The projection's depth terms survive any model matrix exactly
+				const f32 A = -dot(r2, r3) / l2;
+				const f32 B = m[11] + A * m[15];
+				const auto same = [](f32 a, f32 b) { return std::fabs(a - b) <= 1e-3f * std::fabs(b) + 1e-5f; };
+				const f32 len = std::sqrt(l2);
+				const f32 cx = -dot(r0, r3) / l2, cy = -dot(r1, r3) / l2;
+				const vec3 xr = r0 + r3 * cx, yr = r1 + r3 * cy;
+				const f32 sx = std::sqrt(dot(xr, xr)) / len, sy = std::sqrt(dot(yr, yr)) / len;
+
+				bool is_cam = s.cam.valid && same(A, s.cam.A) && same(B, s.cam.B);
+				if (!s.cam_this_frame && surface_w && surface_h && A < 0.f && B < 0.f && sx > 0.2f && sx < 8.f && sy > 0.2f && sy < 8.f &&
+					std::fabs((sy / sx) / (static_cast<f32>(surface_w) / surface_h) - 1.f) < 0.12f)
+				{
+					// The main camera: its picture shape matches the render target. Take this frame's zoom from it.
+					if (!s.cam.valid || !same(A, s.cam.A) || !same(B, s.cam.B) || std::fabs(sx - s.cam.sx) > 1e-4f || std::fabs(cx - s.cam.cx) > 1e-4f)
+					{
+						s.x3_ready = s.x2_ready = false;
+					}
+					s.cam = {true, sx, sy, cx, cy, A, B};
+					s.cam_this_frame = true;
+					if (s.scene_key != color_key)
+					{
+						s.scene_key = color_key;
+						if (std::find(s.tainted.begin(), s.tainted.end(), color_key) == s.tainted.end()) s.tainted.push_back(color_key);
+					}
+					s.scene_w = surface_w;
+					s.scene_h = surface_h;
+					is_cam = true;
+				}
+
+				if (is_cam)
+				{
+					kind = 1;
+					if (!s.fp_set) { std::memcpy(s.fp, m, sizeof(s.fp)); s.fp_set = true; }
+					// World up = the model's own up axis, for the (many) objects that are not rotated
+					const vec3 xn = normalize(xr), yn = normalize(yr), zn = r3 * (-1.f / len);
+					if (dot(cross(xn, yn), zn) > 0.9f && s.votes.size() < 32)
+					{
+						const vec3 up{xn.y, yn.y, zn.y};
+						bool added = false;
+						for (auto& b : s.votes)
+						{
+							const vec3 avg = normalize(b.sum);
+							if (dot(avg, up) > 0.997f) { b.sum = b.sum + up; b.n++; added = true; break; }
+						}
+						if (!added) s.votes.push_back({up, 1, xn, yn, zn});
+					}
+					const f32 near_plane = B / A;
+					if (m[15] > near_plane && m[15] < 60.f && s.depths.size() < 512) s.depths.push_back(m[15]);
+					// Room mode: this object's transform in the camera's view space (MVP with the projection taken off)
+					if (s.vms.size() < 1024)
+					{
+						const auto& c = s.cam;
+						rsx_vr_state::vm34 v;
+						for (int k = 0; k < 4; k++)
+						{
+							v.m[k] = (m[k] + c.cx * m[12 + k]) / c.sx;
+							v.m[4 + k] = (m[4 + k] + c.cy * m[12 + k]) / c.sy;
+							v.m[8 + k] = -m[12 + k];
+						}
+						s.vms.push_back(v);
+					}
+				}
+			}
+		}
+
+		u64 content_gen = gen;
+		if (kind == 1)
+		{
+			if (s.enabled) rv_content_set(color_key, gen);
+		}
+		else
+		{
+			// A draw that reads the scene's picture copies it (onto the screen, or into effects): leave it alone, and
+			// remember which frame's eye view its target now holds.
+			bool reads_scene = false;
+			u64 src_gen = 0;
+			for (u32 i = 0; i < tex_count; i++)
+			{
+				if (std::find(s.tainted.begin(), s.tainted.end(), tex_keys[i]) != s.tainted.end())
+				{
+					reads_scene = true;
+					src_gen = std::max(src_gen, rv_content_get(tex_keys[i]));
+				}
+			}
+			if (reads_scene)
+			{
+				if (std::find(s.tainted.begin(), s.tainted.end(), color_key) == s.tainted.end()) s.tainted.push_back(color_key);
+				if (src_gen) rv_content_set(color_key, src_gen);
+				if (color_key != s.scene_key && surface_w * 4 >= s.scene_w * 3 && surface_h * 4 >= s.scene_h * 3) s.composite_this = color_key;
+			}
+			else if (!perspective && s.cam.valid && (color_key == s.scene_key || color_key == s.composite_this || s.is_screen(color_key)))
+			{
+				// HUD, order tickets, menus: on a plane in the world, in the eye view of the picture already in that target.
+				// Flat draws before any 3D draw this frame are backdrops (sky, scenery pictures): far away instead.
+				kind = s.n3 == 0 ? 3 : 2;
+				if (const u64 g = rv_content_get(color_key); g && rv_ring(g)) content_gen = g;
+			}
+		}
+
+		if (kind == 1) s.n3++;
+		else if (kind == 2) s.n2++;
+		else if (kind == 3) s.n2b++;
+		else s.n0++;
+
+		if (!s.enabled || !kind || !s.cam.valid) return 0;
+		if (!rv_build(kind == 1, kind == 1 ? gen : content_gen, kind == 3)) return 0;
+		std::memcpy(x, (kind == 1 ? s.X3 : kind == 3 ? s.X2b : s.X2).m, sizeof(f32) * 16);
+		return kind;
+	}
+
+	void note_calibration()
+	{
+		g_calib_tick = GetTickCount64();
+		vr_log("PS Move calibration started by the game");
+	}
+
+	u64 stereo_generation()
+	{
+		return g_rv.gen.load(std::memory_order_relaxed);
+	}
+
+	void stereo_apply(void* rows, const f32 x[16])
+	{
+		mat4 S, X;
+		std::memcpy(S.m, rows, sizeof(S.m));
+		std::memcpy(X.m, x, sizeof(X.m));
+		const mat4 R = mmul(S, X);
+		std::memcpy(rows, R.m, sizeof(R.m));
+	}
+
+	void note(const char* fmt, ...)
+	{
+		char buf[512];
+		va_list args;
+		va_start(args, fmt);
+		std::vsnprintf(buf, sizeof(buf), fmt, args);
+		va_end(args);
+		vr_log("%s", buf);
+	}
+
+	void trace(const char* name)
+	{
+		static std::mutex mtx;
+		static std::map<std::string, u32> counts;
+		static u64 last_dump = 0;
+		static const bool enabled = []{ const char* e = std::getenv("ORDERUP_VR_TRACE"); return e && *e == '1'; }();
+		if (!enabled) return;
+
+		std::lock_guard lock(mtx);
+		counts[name]++;
+		const u64 now = GetTickCount64();
+		if (!last_dump) last_dump = now;
+		if (now - last_dump >= 5000)
+		{
+			std::string line = "calls/5s:";
+			for (const auto& [n, c] : counts) line += " " + n + "=" + std::to_string(c);
+			vr_log("%s", line.c_str());
+			counts.clear();
+			last_dump = now;
+		}
+	}
+}
+
+#else // !_WIN32
+
+namespace ouvr
+{
+	void start() {}
+	void stop() {}
+	bool wants_frames() { return false; }
+	void submit_frame(std::vector<u8>&&, u32, u32, bool, u64) {}
+	void report_window_unavailable() {}
+	pointer_state get_pointer() { return {}; }
+	void trace(const char*) {}
+	void research_constants(u32, const f32*, const u16*, usz) {}
+	void note(const char*, ...) {}
+	int stereo_draw_transform(const f32*, bool, u32, u32, u64, const u64*, u32, f32*) { return 0; }
+	bool stereo_clear_color(u64, f32*) { return false; }
+	void note_calibration() {}
+	u64 stereo_generation() { return 0; }
+	void stereo_apply(void*, const f32*) {}
+}
+
+#endif
+
+#include "Emu/Cell/SPUDisAsm.h"
+
+namespace ouvr
+{
+	// Developer tools, run from the command line; never used during play.
+	int dev_tool(int argc, char** argv)
+	{
+		const std::string cmd = argv[1];
+		if (cmd == "--ouvr-spu-disasm" && argc >= 4)
+		{
+			std::FILE* in = std::fopen(argv[2], "rb");
+			if (!in) return 2;
+			std::vector<u8> data(0x40000);
+			const usz n = std::fread(data.data(), 1, data.size(), in);
+			std::fclose(in);
+			const u32 start = argc > 4 ? static_cast<u32>(std::strtoul(argv[4], nullptr, 0)) : 0;
+			const u32 len = argc > 5 ? static_cast<u32>(std::strtoul(argv[5], nullptr, 0)) : static_cast<u32>(n);
+			std::FILE* out = std::fopen(argv[3], "w");
+			if (!out) return 3;
+			SPUDisAsm dis(cpu_disasm_mode::normal, data.data(), 0);
+			for (u32 pc = start & ~3u; pc < start + len && pc + 4 <= n; pc += 4)
+			{
+				dis.disasm(pc);
+				std::fprintf(out, "%05x: %08x  %s\n", pc, static_cast<u32>(data[pc] << 24 | data[pc + 1] << 16 | data[pc + 2] << 8 | data[pc + 3]), dis.last_opcode.c_str());
+			}
+			std::fclose(out);
+			return 0;
+		}
+		if (cmd == "--ouvr-chef-test" && argc >= 4)
+		{
+			// Rebuilds both chefs from a game's USRDIR and writes them as OBJ (rest pose and a reaching pose)
+			for (int fem = 0; fem < 2; fem++)
+			{
+				chef::model m;
+				const u64 t0 = GetTickCount64();
+				const bool ok = chef::load(m, argv[2], fem != 0);
+				std::printf("%s chef: %s, %zu vertices, %zu triangles, texture %ux%u, %llu ms %s\n", fem ? "female" : "male", ok ? "ok" : "FAILED", m.v.size(), m.idx.size() / 3, m.tw, m.th,
+					static_cast<unsigned long long>(GetTickCount64() - t0), m.error.c_str());
+				if (!ok) continue;
+				for (int posed = 0; posed < 2; posed++)
+				{
+					chef::pose_in in;
+					in.scale = 1.f;
+					in.head = {0.f, m.eye_y, m.face_z + 0.03f};
+					in.body_yaw = 3.14159265f;    // facing +z, like the T pose
+					if (posed)
+					{
+						for (int sd = 0; sd < 2; sd++)
+						{
+							in.hand_valid[sd] = true;
+							in.hand[sd].position = {sd == 0 ? 0.25f : -0.25f, m.eye_y - 0.35f, m.face_z + 0.45f};
+							in.hand[sd].orientation = yaw_q(3.14159265f);   // pointing forward (+z)
+							in.grip[sd] = sd == 0 ? 1.f : 0.f;
+						}
+					}
+					chef::rigid T[chef::P_COUNT];
+					vec3 root; XrQuaternionf rq;
+					chef::solve(m, in, T, root, rq);
+					std::vector<vec3> P, N;
+					chef::skin(m, T, root, rq, in.scale, P, N);
+					std::FILE* f = std::fopen(fmt::format("%s_%s_%s.obj", argv[3], fem ? "female" : "male", posed ? "posed" : "rest").c_str(), "w");
+					if (!f) continue;
+					for (usz i = 0; i < P.size(); i++) std::fprintf(f, "v %f %f %f\nvt %f %f\n", P[i].x, P[i].y, P[i].z, m.v[i].u, m.v[i].v);
+					for (usz i = 0; i + 2 < m.idx.size(); i += 3) std::fprintf(f, "f %u/%u %u/%u %u/%u\n", m.idx[i] + 1, m.idx[i] + 1, m.idx[i + 1] + 1, m.idx[i + 1] + 1, m.idx[i + 2] + 1, m.idx[i + 2] + 1);
+					std::fclose(f);
+				}
+				// parts histogram
+				int hist[chef::P_COUNT]{};
+				for (const auto& x : m.v) hist[x.part[0]]++;
+				for (int k = 0; k < chef::P_COUNT; k++) std::printf(" part %d: %d", k, hist[k]);
+				std::printf("\n");
+			}
+			return 0;
+		}
+		return 1;
+	}
+}
diff --git a/rpcs3/Emu/Io/OrderUpVR.h b/rpcs3/Emu/Io/OrderUpVR.h
