+			xr.btn_x = make_action(xr, "button_x", XR_ACTION_TYPE_BOOLEAN_INPUT, false);
+			xr.btn_y = make_action(xr, "button_y", XR_ACTION_TYPE_BOOLEAN_INPUT, false);
+			xr.btn_menu = make_action(xr, "button_menu", XR_ACTION_TYPE_BOOLEAN_INPUT, false);
+
+			// Quest / Rift Touch controllers
+			{
+				const XrActionSuggestedBinding bindings[] =
+				{
+					{xr.aim, to_path(xr, "/user/hand/left/input/aim/pose")},
+					{xr.aim, to_path(xr, "/user/hand/right/input/aim/pose")},
+					{xr.trigger, to_path(xr, "/user/hand/left/input/trigger/value")},
+					{xr.trigger, to_path(xr, "/user/hand/right/input/trigger/value")},
+					{xr.squeeze, to_path(xr, "/user/hand/left/input/squeeze/value")},
+					{xr.squeeze, to_path(xr, "/user/hand/right/input/squeeze/value")},
+					{xr.stick_click, to_path(xr, "/user/hand/left/input/thumbstick/click")},
+					{xr.stick_click, to_path(xr, "/user/hand/right/input/thumbstick/click")},
+					{xr.stick, to_path(xr, "/user/hand/left/input/thumbstick")},
+					{xr.stick, to_path(xr, "/user/hand/right/input/thumbstick")},
+					{xr.btn_a, to_path(xr, "/user/hand/right/input/a/click")},
+					{xr.btn_b, to_path(xr, "/user/hand/right/input/b/click")},
+					{xr.btn_x, to_path(xr, "/user/hand/left/input/x/click")},
+					{xr.btn_y, to_path(xr, "/user/hand/left/input/y/click")},
+					{xr.btn_menu, to_path(xr, "/user/hand/left/input/menu/click")},
+				};
+				XrInteractionProfileSuggestedBinding suggested{XR_TYPE_INTERACTION_PROFILE_SUGGESTED_BINDING};
+				suggested.interactionProfile = to_path(xr, "/interaction_profiles/oculus/touch_controller");
+				suggested.suggestedBindings = bindings;
+				suggested.countSuggestedBindings = static_cast<u32>(std::size(bindings));
+				xr_ok(xr, xrSuggestInteractionProfileBindings(xr.instance, &suggested), "suggest bindings (touch)");
+			}
+
+			// Generic fallback
+			{
+				const XrActionSuggestedBinding bindings[] =
+				{
+					{xr.aim, to_path(xr, "/user/hand/left/input/aim/pose")},
+					{xr.aim, to_path(xr, "/user/hand/right/input/aim/pose")},
+					{xr.trigger, to_path(xr, "/user/hand/left/input/select/click")},
+					{xr.trigger, to_path(xr, "/user/hand/right/input/select/click")},
+					{xr.btn_menu, to_path(xr, "/user/hand/left/input/menu/click")},
+					{xr.btn_a, to_path(xr, "/user/hand/right/input/menu/click")},
+				};
+				XrInteractionProfileSuggestedBinding suggested{XR_TYPE_INTERACTION_PROFILE_SUGGESTED_BINDING};
+				suggested.interactionProfile = to_path(xr, "/interaction_profiles/khr/simple_controller");
+				suggested.suggestedBindings = bindings;
+				suggested.countSuggestedBindings = static_cast<u32>(std::size(bindings));
+				xr_ok(xr, xrSuggestInteractionProfileBindings(xr.instance, &suggested), "suggest bindings (simple)");
+			}
+
+			for (int hand = 0; hand < 2; hand++)
+			{
+				XrActionSpaceCreateInfo info{XR_TYPE_ACTION_SPACE_CREATE_INFO};
+				info.action = xr.aim;
+				info.subactionPath = xr.hand_path[hand];
+				info.poseInActionSpace.orientation.w = 1.0f;
+				if (!xr_ok(xr, xrCreateActionSpace(xr.session, &info, &xr.aim_space[hand]), "xrCreateActionSpace")) return false;
