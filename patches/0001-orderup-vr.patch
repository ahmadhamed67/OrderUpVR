+					knee = hip + fb * thigh + up * 0.02f;
+					foot = knee - up * shin + fb * 0.05f;
+				}
+				else
+				{
+					const f32 ph = xr.walk_phase + (leg ? 3.14159265f : 0.f);
+					const f32 swing = std::sin(ph) * 0.45f * xr.walk_amount;
+					const f32 lift = std::max(0.f, std::cos(ph)) * 0.7f * xr.walk_amount; // knee bends while the leg swings forward
+					const vec3 tdir = up * -std::cos(swing) + fb * std::sin(swing);
+					knee = hip + tdir * thigh;
+					const f32 sa = swing - lift;
+					foot = knee + (up * -std::cos(sa) + fb * std::sin(sa)) * shin;
+				}
+				draw_limb(xr, hip, knee, (0.075f + 0.005f * fem) * scale, 0.058f * scale, c_pants);
+				draw_limb(xr, knee, foot, 0.058f * scale, 0.045f * scale, c_pants);
+				draw_ellipsoid(xr, foot + fb * 0.05f + up * (-0.02f), rb, up, fb, {0.05f, 0.04f, 0.12f}, c_shoe);
