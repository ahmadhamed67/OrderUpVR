+		// ------------------------------------------------- the chef: the game's own model as your body
+		struct chef_runtime
+		{
+			std::thread th;
+			std::atomic<int> state{0};   // 0 nothing, 1 loading, 2 ready, 3 failed
+			int which = -1;              // 0 male, 1 female
+			chef::model m;
+			f32 scale = 1.f;
+			vec3 eye_w{};
+			bool posed = false;
+		};
+		chef_runtime g_chef;
+
+		void chef_shutdown()
+		{
+			if (g_chef.th.joinable()) g_chef.th.join();
+			g_chef.which = -1;
+			g_chef.state = 0;
+			g_chef.posed = false;
+		}
+
+		// The game's USRDIR (disc games: /dev_bdvd; folder games are mounted there too)
+		std::string game_usrdir()
+		{
+			std::string d = vfs::get("/dev_bdvd/PS3_GAME/USRDIR/");
+			if (!d.empty() && fs::is_file(d + "Chef.wad")) return d;
+			std::string boot = Emu.GetBoot();
+			for (int up = 0; up < 4 && !boot.empty(); up++)
+			{
+				const usz cut = boot.find_last_of("/\\");
+				if (cut == std::string::npos) break;
+				boot.resize(cut);
+				for (const char* sub : {"/", "/USRDIR/", "/PS3_GAME/USRDIR/"})
+					if (fs::is_file(boot + sub + "Chef.wad")) return boot + sub;
+			}
+			return {};
+		}
+
+		void chef_release_gpu()
+		{
+			auto& g = g_gfx;
+			for (auto** p : {reinterpret_cast<IUnknown**>(&g.cvb), reinterpret_cast<IUnknown**>(&g.cib), reinterpret_cast<IUnknown**>(&g.csrv), reinterpret_cast<IUnknown**>(&g.ctex)})
+				if (*p) { (*p)->Release(); *p = nullptr; }
+			g.chef_gpu = false;
+		}
