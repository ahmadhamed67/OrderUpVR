+		{
+			mat4 r;
+			for (int i = 0; i < 3; i++)
+				for (int j = 0; j < 3; j++) r.m[i * 4 + j] = a.m[j * 4 + i];
+			for (int i = 0; i < 3; i++) r.m[i * 4 + 3] = -(r.m[i * 4] * a.m[3] + r.m[i * 4 + 1] * a.m[7] + r.m[i * 4 + 2] * a.m[11]);
