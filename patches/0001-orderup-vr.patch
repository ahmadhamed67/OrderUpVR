+		vec3 level(vec3 u, vec3 v, f32 sign = 1.f)
+		{
+			const vec3 a = cross(u, {0.f, 1.f, 0.f});
+			const f32 s = std::sqrt(dot(a, a)) * sign, c = u.y;
