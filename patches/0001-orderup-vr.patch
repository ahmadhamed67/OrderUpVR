+		// Rotates a LOCAL-space vector into the virtual screen's frame (x right, y up, z towards the player),
+		// which is the frame of the emulated PS Eye camera.
+		vec3 to_screen(const xr_state& xr, vec3 v)
+		{
+			const f32 c = std::cos(xr.screen_yaw), s = std::sin(xr.screen_yaw);
+			return {v.x * c - v.z * s, v.y, v.x * s + v.z * c};
+		}
+
+		// Fills the PS Move motion fields from the real controller pose and velocity.
+		// center/yaw: the (virtual) screen the emulated PS Eye camera sits on.
+		void compute_motion(xr_state& xr, const XrSpaceLocation& aim, const XrSpaceVelocity& sv, pointer_state& out, f32 dt, f32 width, f32 height, vec3 center, f32 yaw)
+		{
+			const auto to_s = [yaw](vec3 v) { const f32 c = std::cos(yaw), s = std::sin(yaw); return vec3{v.x * c - v.z * s, v.y, v.x * s + v.z * c}; };
+			const XrQuaternionf qs = yaw_q(yaw);
+			const XrQuaternionf qc = qnorm(qmul(qconj(qs), aim.pose.orientation)); // controller orientation, screen frame
+			const vec3 p = to_s(to_vec(aim.pose.position) - center); // metres
+
+			// Split the orientation into "aiming at the screen" (already sent as the pointer) and the rest (twist, or
+			// pointing past the screen edge, as in a flick). The rest is what the game would see a real Move do.
+			const vec3 d = rotate(qc, {0.f, 0.f, -1.f});
+			const f32 dist = std::max(p.z, 0.2f);
+			f32 tx = d.z < -0.05f ? d.x / -d.z : (d.x >= 0.f ? 10.f : -10.f);
+			f32 ty = d.z < -0.05f ? d.y / -d.z : (d.y >= 0.f ? 10.f : -10.f);
+			tx = std::clamp(tx, (-width * 0.5f - p.x) / dist, (width * 0.5f - p.x) / dist);
+			ty = std::clamp(ty, (-height * 0.5f - p.y) / dist, (height * 0.5f - p.y) / dist);
+			const vec3 dc = normalize({tx, ty, -1.f});
+			const vec3 fwd{0.f, 0.f, -1.f};
+			const vec3 axis = cross(fwd, dc);
+			const XrQuaternionf qdir = qnorm({axis.x, axis.y, axis.z, 1.f + dot(fwd, dc)});
+			XrQuaternionf r = qnorm(qmul(qconj(qdir), qc));
+			if (r.w < 0.f) r = {-r.x, -r.y, -r.z, -r.w};
+			out.rq[0] = r.x; out.rq[1] = r.y; out.rq[2] = r.z; out.rq[3] = r.w;
+
+			vec3 v{}, av{};
+			if (sv.velocityFlags & XR_SPACE_VELOCITY_LINEAR_VALID_BIT) v = to_s(to_vec(sv.linearVelocity)) * 1000.f;
+			if (sv.velocityFlags & XR_SPACE_VELOCITY_ANGULAR_VALID_BIT) av = to_s(to_vec(sv.angularVelocity));
+			if (xr.have_prev && dt > 0.f)
+			{
+				xr.accel = xr.accel * 0.5f + ((v - xr.prev_vel) * (1.f / dt)) * 0.5f;
+				xr.angaccel = xr.angaccel * 0.5f + ((av - xr.prev_angvel) * (1.f / dt)) * 0.5f;
+			}
+			xr.prev_vel = v;
+			xr.prev_angvel = av;
+			xr.have_prev = true;
+
+			// Quick hand movement relative to where the hand has been over the last ~quarter second
+			const vec3 pm = p * 1000.f;
+			if (!xr.lp_init) { xr.lp_pos = pm; xr.lp_init = true; }
+			xr.lp_pos = xr.lp_pos + (pm - xr.lp_pos) * std::min(1.f, dt / 0.25f);
+			const vec3 disp = pm - xr.lp_pos;
+
+			for (int i = 0; i < 3; i++)
+			{
+				out.vel[i] = (&v.x)[i];
+				out.accel[i] = (&xr.accel.x)[i];
+				out.angvel[i] = (&av.x)[i];
+				out.angaccel[i] = (&xr.angaccel.x)[i];
+				out.disp[i] = (&disp.x)[i];
+			}
+
+			// Inertial sensors in device axes (Move: x right, y towards the sphere, z up)
+			const XrQuaternionf qi = qconj(qc);
+			const vec3 a_dev = rotate(qi, xr.accel * (1.f / 9810.f) + vec3{0.f, 1.f, 0.f});
+			const vec3 g_dev = rotate(qi, av);
+			out.acc_dev[0] = a_dev.x; out.acc_dev[1] = -a_dev.z; out.acc_dev[2] = a_dev.y;
+			out.gyro_dev[0] = g_dev.x; out.gyro_dev[1] = -g_dev.z; out.gyro_dev[2] = g_dev.y;
+			out.motion = true;
+		}
+
+		// Stick-flick flip: plays a clean half-circle flip on top of the real motion, for when a real flick is not
+		// recognised. Wrist rotates up and back (about 150 degrees) while the hand traces a half circle.
+		void apply_flip_assist(xr_state& xr, pointer_state& out)
+		{
+			if (!xr.assist_start) return;
+			constexpr f32 duration = 0.45f, pi = 3.14159265f, radius = 120.f, max_angle = 2.6f, h = 0.01f;
+			const f32 t = (GetTickCount64() - xr.assist_start) / 1000.f;
+			if (t >= duration) { xr.assist_start = 0; return; }
+
+			const auto pos = [&](f32 tt) { const f32 u = std::clamp(tt / duration, 0.f, 1.f); return vec3{-radius * std::cos(pi * u) * std::sin(pi * u), radius * std::sin(pi * u), 0.f}; };
+			const auto ang = [&](f32 tt) { const f32 u = std::clamp(tt / duration, 0.f, 1.f); return max_angle * std::sin(pi * u); };
+
+			const vec3 p0 = pos(t), p1 = pos(t - h), p2 = pos(t - 2 * h);
+			const vec3 vel = (p0 - p1) * (1.f / h);
+			const vec3 acc = (p0 - p1 * 2.f + p2) * (1.f / (h * h));
+			const f32 a0 = ang(t), a1 = ang(t - h), a2 = ang(t - 2 * h);
+			const f32 w = (a0 - a1) / h, wa = (a0 - 2 * a1 + a2) / (h * h);
+
+			const XrQuaternionf rq{out.rq[0], out.rq[1], out.rq[2], out.rq[3]};
+			const XrQuaternionf flip{std::sin(a0 * 0.5f), 0.f, 0.f, std::cos(a0 * 0.5f)};
+			const XrQuaternionf r = qnorm(qmul(rq, flip));
+			out.rq[0] = r.x; out.rq[1] = r.y; out.rq[2] = r.z; out.rq[3] = r.w;
+			for (int i = 0; i < 3; i++)
+			{
+				out.vel[i] += (&vel.x)[i];
+				out.accel[i] += (&acc.x)[i];
+				out.disp[i] += (&p0.x)[i];
+			}
+			out.assist = true;
+			out.angvel[0] += w;
+			out.angaccel[0] += wa;
+			out.gyro_dev[0] += w;
+			out.acc_dev[2] += acc.y / 9810.f;
+			out.motion = true;
+		}
