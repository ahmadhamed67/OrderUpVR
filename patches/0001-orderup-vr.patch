+		rt->Clear(D2D1::ColorF(0, 0.f));
+		rt->SetTextAntialiasMode(D2D1_TEXT_ANTIALIAS_MODE_GRAYSCALE);
+		const f32 W = static_cast<f32>(w), H = static_cast<f32>(h), m = 22.f;   // margin for the shadow
+		const D2D1_RECT_F r{m, m, W - m, H - m};
+
+		if (c.style == card::SIGN)
+		{
+			// A diner's neon sign: dark enamel board, a pink neon border, the name in orange neon
+			p.fill_round({r.left - 6.f, r.top - 6.f, r.right + 6.f, r.bottom + 6.f}, 40.f, rgba(0x000000, 0.25f));
+			ID2D1LinearGradientBrush* board = p.linear({r.left, r.top}, {r.left, r.bottom}, {{0.f, rgba(0x1A1C26)}, {1.f, rgba(0x0D0E13)}});
+			if (board) rt->FillRoundedRectangle({r, 34.f, 34.f}, board);
+			rel(board);
+			p.stroke_round(r, 34.f, rgba(0xB9BFCC, 0.55f), 5.f);   // chrome trim
+			const D2D1_RECT_F tube{r.left + 18.f, r.top + 18.f, r.right - 18.f, r.bottom - 18.f};
+			for (int k = 4; k >= 1; k--) p.stroke_round(tube, 22.f, rgba(0xFF3D6E, 0.07f), 3.f + k * 5.f);
+			p.stroke_round(tube, 22.f, rgba(0xFF6F96), 3.f);
+			const f32 left = tube.left + 30.f, inner_w = tube.right - tube.left - 60.f;
+			p.neon(c.title, left, tube.top + 14.f, inner_w, 120.f, 92.f, 0xFF9A2E);
+			p.text(c.subtitle, left, tube.top + 132.f, inner_w, 60.f, 30.f, DWRITE_FONT_WEIGHT_SEMI_BOLD, rgba(0xF3F4F7), false, false, DWRITE_TEXT_ALIGNMENT_CENTER);
+			p.text(c.tip, left, tube.top + 176.f, inner_w, 50.f, 23.f, DWRITE_FONT_WEIGHT_NORMAL, rgba(0xB7BDC9), false, false, DWRITE_TEXT_ALIGNMENT_CENTER);
+		}
+		else
+		{
+			const f32 rad = c.style == card::HINT ? 34.f : 40.f;
+			p.glass(r, rad);
+			const f32 pad = 52.f;
+			f32 x = r.left + pad, y = r.top + 44.f;
+			const f32 cw = r.right - r.left - pad * 2.f;
+			if (c.style == card::CHOOSER)
+			{
+				p.badge(x, y, 60.f);
+				p.text(c.kicker, x + 80.f, y + 16.f, cw - 80.f, 40.f, 22.f, DWRITE_FONT_WEIGHT_BOLD, rgba(0xFFC58A), false, false);
+				p.text(c.title, x, y + 84.f, cw, 80.f, 50.f, DWRITE_FONT_WEIGHT_SEMI_BOLD, rgba(0xFFFFFF), true, false);
+				for (int i = 0; i < static_cast<int>(c.rows.size()) && i < 2; i++)
+				{
+					const D2D1_RECT_F t = chooser_tile(w, h, i);
+					const bool off = i == c.disabled, on = i == c.hover && !off;
+					if (on)
+					{
+						for (int k = 3; k >= 1; k--) p.stroke_round(t, 26.f, rgba(0xFF8A00, 0.10f), 4.f + k * 6.f);
+						ID2D1LinearGradientBrush* g = p.linear({t.left, t.top}, {t.right, t.bottom}, {{0.f, rgba(0xFF8A00, 0.30f)}, {1.f, rgba(0xFF3D6E, 0.22f)}});
+						if (g) rt->FillRoundedRectangle({t, 26.f, 26.f}, g);
+						ui::rel(g);
+						p.stroke_round(t, 26.f, rgba(0xFFB25C), 3.f);
+					}
+					else
+					{
+						p.fill_round(t, 26.f, rgba(0xFFFFFF, off ? 0.03f : 0.06f));
+						p.stroke_round(t, 26.f, rgba(0xFFFFFF, off ? 0.08f : 0.16f), 2.f);
+					}
+					const f32 tx = t.left + 34.f, tw2 = t.right - t.left - 68.f;
+					// a small picture: a screen for flat, a headset for true VR
+					const f32 iy = t.top + 36.f;
+					const u32 ic = off ? 0x6B7280 : 0xFFFFFF;
+					if (i == 0)
+					{
+						p.stroke_round({tx, iy, tx + 96.f, iy + 58.f}, 8.f, rgba(ic), 5.f);
+						p.fill_round({tx + 38.f, iy + 62.f, tx + 58.f, iy + 74.f}, 3.f, rgba(ic));
+					}
+					else
+					{
+						p.stroke_round({tx, iy + 8.f, tx + 104.f, iy + 62.f}, 24.f, rgba(ic), 5.f);
+						p.fill_round({tx + 16.f, iy + 22.f, tx + 46.f, iy + 46.f}, 10.f, rgba(ic, 0.8f));
+						p.fill_round({tx + 58.f, iy + 22.f, tx + 88.f, iy + 46.f}, 10.f, rgba(ic, 0.8f));
+					}
+					p.text(c.rows[i].key, tx, iy + 100.f, tw2, 60.f, 40.f, DWRITE_FONT_WEIGHT_SEMI_BOLD, rgba(off ? 0x8A909C : 0xFFFFFF), true, false);
+					p.text(c.rows[i].text, tx, iy + 152.f, tw2, 120.f, 23.f, DWRITE_FONT_WEIGHT_NORMAL, rgba(off ? 0x6B7280 : 0xC9CED8));
+					if (off)
+					{
+						const f32 cwid = p.text_width(L"COMING SOON", 17.f, DWRITE_FONT_WEIGHT_BOLD) + 17.f * 1.3f;
+						p.chip(L"COMING SOON", t.right - 30.f - cwid, t.top + 30.f, 17.f);
+					}
+				}
+				p.text(c.tip, x, r.bottom - 74.f, cw, 40.f, 22.f, DWRITE_FONT_WEIGHT_NORMAL, rgba(0xB7BDC9), false, false, DWRITE_TEXT_ALIGNMENT_CENTER);
+			}
+			else if (c.style == card::HINT)
+			{
+				// A picture instead of words: the pink square -> your controller's X button
+				const f32 sz = H - m * 2.f - 100.f, top = r.top + 50.f;
+				const D2D1_RECT_F sq{x, top, x + sz, top + sz};
+				for (int k = 3; k >= 1; k--) p.stroke_round(sq, 18.f, rgba(0xFF6FB5, 0.08f), 8.f + k * 8.f);
+				p.fill_round(sq, 18.f, rgba(0xFF6FB5, 0.12f));
+				const f32 in = sz * 0.26f;
+				p.stroke_round({sq.left + in, sq.top + in, sq.right - in, sq.bottom - in}, 4.f, rgba(0xFF8CC6), 9.f);
+				// arrow
+				const f32 ax0 = sq.right + 26.f, ax1 = ax0 + 70.f, ay = top + sz * 0.5f;
+				{
+					ID2D1SolidColorBrush* b = nullptr;
+					rt->CreateSolidColorBrush(rgba(0xFFC58A), &b);
+					if (b)
+					{
+						rt->DrawLine({ax0, ay}, {ax1, ay}, b, 8.f);
+						rt->DrawLine({ax1 - 22.f, ay - 20.f}, {ax1 + 2.f, ay}, b, 8.f);
+						rt->DrawLine({ax1 - 22.f, ay + 20.f}, {ax1 + 2.f, ay}, b, 8.f);
+						ui::rel(b);
+					}
+				}
+				// the X button, as on the left Quest controller
+				const f32 bx = ax1 + 30.f;
+				const D2D1_RECT_F bt{bx, top, bx + sz, top + sz};
+				p.fill_round(bt, sz * 0.5f, rgba(0x2A2F3B));
+				p.stroke_round(bt, sz * 0.5f, rgba(0xFFB25C), 6.f);
+				p.text(L"X", bx, top + sz * 0.16f, sz, sz, sz * 0.52f, DWRITE_FONT_WEIGHT_BOLD, rgba(0xFFFFFF), true, false, DWRITE_TEXT_ALIGNMENT_CENTER);
+				x = bt.right + 40.f;
+				const f32 tw = r.right - pad - x;
+				p.text(c.kicker, x, y, tw, 40.f, 22.f, DWRITE_FONT_WEIGHT_BOLD, rgba(0xFFC58A), false, false);
+				y += 36.f;
+				y += p.text(c.title, x, y, tw, 90.f, 52.f, DWRITE_FONT_WEIGHT_SEMI_BOLD, rgba(0xFFFFFF), true, false) + 8.f;
+				p.text(c.subtitle, x, y, tw, r.bottom - y - 20.f, 26.f, DWRITE_FONT_WEIGHT_NORMAL, rgba(0xB7BDC9));
+			}
+			else
+			{
+				// Header: badge, kicker, title, subtitle
+				p.badge(x, y, 60.f);
+				p.text(c.kicker, x + 80.f, y + 16.f, cw - 80.f, 40.f, 22.f, DWRITE_FONT_WEIGHT_BOLD, rgba(0xFFC58A), false, false);
+				y += 84.f;
+				y += p.text(c.title, x, y, cw, 140.f, c.style == card::HELP ? 50.f : 54.f, DWRITE_FONT_WEIGHT_SEMI_BOLD, rgba(0xFFFFFF), true) + 6.f;
+				if (!c.subtitle.empty()) y += p.text(c.subtitle, x, y, cw, 120.f, 26.f, DWRITE_FONT_WEIGHT_NORMAL, rgba(0xB7BDC9)) + 18.f;
+				else y += 14.f;
+
+				// Rows: key chips and their meaning, in one or two columns
+				if (!c.rows.empty())
+				{
+					const int cols = std::max(1, c.columns);
+					const f32 gap = 34.f, colw = (cw - gap * (cols - 1)) / cols;
+					f32 key_w = 0.f;
+					for (const auto& rw : c.rows) key_w = std::max(key_w, p.text_width(rw.key, 19.f, DWRITE_FONT_WEIGHT_BOLD) + 19.f * 1.3f);
+					key_w = std::min(key_w, colw * 0.45f);
+					const int per_col = (static_cast<int>(c.rows.size()) + cols - 1) / cols;
+					f32 col_bottom = y;
+					for (int ci = 0; ci < cols; ci++)
+					{
+						f32 yy = y;
+						const f32 xx = x + ci * (colw + gap);
+						for (int k = ci * per_col; k < std::min<int>((ci + 1) * per_col, static_cast<int>(c.rows.size())); k++)
+						{
+							p.chip(c.rows[k].key, xx, yy, 19.f, key_w);
+							const f32 th = p.text(c.rows[k].text, xx + key_w + 18.f, yy + 1.f, colw - key_w - 18.f, 90.f, 24.f, DWRITE_FONT_WEIGHT_NORMAL, rgba(0xF3F4F7));
+							yy += std::max(th, 19.f * 1.75f) + 16.f;
+						}
+						col_bottom = std::max(col_bottom, yy);
+					}
+					y = col_bottom + 4.f;
+				}
+
+				// Progress at the bottom, tip under it
+				f32 bottom = r.bottom - 40.f;
+				if (!c.tip.empty())
+				{
+					const f32 tip_y = bottom - 36.f;
+					p.fill_round({x, tip_y - 6.f, x + cw, tip_y + 40.f}, 14.f, rgba(0xFFFFFF, 0.04f));
+					const f32 cwid = p.chip(L"TIP", x + 10.f, tip_y + 1.f, 15.f);
+					p.text(c.tip, x + 10.f + cwid + 14.f, tip_y + 3.f, cw - cwid - 34.f, 40.f, 21.f, DWRITE_FONT_WEIGHT_NORMAL, rgba(0xB7BDC9), false, false);
+					bottom = tip_y - 30.f;
+				}
+				if (c.progress != -1)
+				{
+					const f32 by = bottom - 16.f;
+					if (!c.progress_label.empty()) p.text(c.progress_label, x, by - 42.f, cw * 0.78f, 40.f, 22.f, DWRITE_FONT_WEIGHT_NORMAL, rgba(0xB7BDC9), false, false);
+					if (c.progress >= 0) p.text(std::to_wstring(c.progress) + L"%", x, by - 46.f, cw, 44.f, 30.f, DWRITE_FONT_WEIGHT_SEMI_BOLD, rgba(0xFFFFFF), true, false, DWRITE_TEXT_ALIGNMENT_TRAILING);
+					p.progress({x, by, x + cw, by + 16.f}, c.progress, c.phase);
+				}
+			}
+		}
+
+		const HRESULT hr = rt->EndDraw();
+		rel(rt);
+		bool ok = SUCCEEDED(hr);
+		if (ok)
+		{
+			out.resize(static_cast<usz>(w) * h * 4);
+			ok = SUCCEEDED(bmp->CopyPixels(nullptr, w * 4, static_cast<UINT>(out.size()), out.data()));
+		}
+		rel(bmp);
+		return ok;
+	}
+
+	// PNG of premultiplied BGRA pixels (developer tools and the headset simulator)
+	inline bool save_png(const std::string& path, const u8* bgra, u32 w, u32 h, bool premultiplied = true)
+	{
+		auto& f = fac();
+		if (!f.wic) return false;
+		std::vector<u8> px(bgra, bgra + static_cast<usz>(w) * h * 4);
+		if (premultiplied)
+			for (usz i = 0; i + 3 < px.size(); i += 4)
+				if (const u8 al = px[i + 3]; al && al < 255)
+					for (int k = 0; k < 3; k++) px[i + k] = static_cast<u8>(std::min(255, px[i + k] * 255 / al));
+		IWICStream* st = nullptr;
+		IWICBitmapEncoder* enc = nullptr;
+		IWICBitmapFrameEncode* frame = nullptr;
+		bool ok = SUCCEEDED(f.wic->CreateStream(&st)) && SUCCEEDED(st->InitializeFromFilename(wide(path).c_str(), GENERIC_WRITE)) &&
+			SUCCEEDED(f.wic->CreateEncoder(GUID_ContainerFormatPng, nullptr, &enc)) && SUCCEEDED(enc->Initialize(st, WICBitmapEncoderNoCache)) &&
+			SUCCEEDED(enc->CreateNewFrame(&frame, nullptr)) && SUCCEEDED(frame->Initialize(nullptr)) && SUCCEEDED(frame->SetSize(w, h));
+		WICPixelFormatGUID fmt = GUID_WICPixelFormat32bppBGRA;
+		ok = ok && SUCCEEDED(frame->SetPixelFormat(&fmt));
+		ok = ok && SUCCEEDED(frame->WritePixels(h, w * 4, w * h * 4, px.data())) && SUCCEEDED(frame->Commit()) && SUCCEEDED(enc->Commit());
+		rel(frame);
+		rel(enc);
+		rel(st);
+		return ok;
+	}
+}
diff --git a/rpcs3/Emu/Io/OrderUpVR_uitree.inl b/rpcs3/Emu/Io/OrderUpVR_uitree.inl
new file mode 100644
index 000000000..03b78a8be
--- /dev/null
+++ b/rpcs3/Emu/Io/OrderUpVR_uitree.inl
@@ -0,0 +1,210 @@
+// Order Up VR: the game's own UI, read live from its memory (BLES01470 only).
+//
+// Found in the game's code (EBOOT, see docs/VR_AUDIT.md "Menu system"):
+//  - The menu system is *(u32*)0x0036df0c. Its open menus are a circular list at +0x2c (node: +0 next, +4 the menu).
+//  - A menu's root element is at menu+0x10.
+//  - An element: +0 vtable; +0x14c name hash (~crc32 of the name the scripts give it); +0x50 position (x y z w,
+//    ElementSetPosition); +0x78/+0x7c base width/height (ElementSetBaseDimensions); +0xd0 offset (x y z w);
+//    +0x180 flags (bit 2: hidden, bit 3: needs layout); containers keep their children at +0x18c (a circular list:
+//    node +0 next, +4 child); image elements (vtable 0x343748) keep their texture there instead.
+//  - The scripts build every screen with MenuNewElement{name=, type=sprite/image/text/button/panel/..., pos=, dims=,
+//    image=, focusable=, events={selected=script}}: the names come from those scripts in the player's Chef.wad.
+// Included inside namespace ouvr { namespace { ... } } of OrderUpVR.cpp, after the chef.
+
+namespace uitree
+{
+	using namespace chef;
+
+	// The UI scripts (package, file) that build menus and the kitchen HUD (found by their MenuNewElement calls)
+	constexpr std::pair<u32, u32> ui_scripts[] = {
+		{0x8c524289, 0x7a10e624}, {0x8c524289, 0xa0f78525}, {0x683d2dae, 0x11eeba16}, {0xefcbf845, 0x81265d83},
+		{0x683d2dae, 0x1fa9e7cc}, {0xefcbf845, 0xb1350865}, {0x683d2dae, 0xba6cbc9f}, {0xefcbf845, 0xebb11886},
+		{0xefcbf845, 0x23fafb4d}, {0x8c524289, 0x26ed19d6}, {0x6ce6f2f7, 0xd5f6dc64}, {0x8c524289, 0x011e8ede},
+		{0x683d2dae, 0xd2ad5bc3}, {0x683d2dae, 0x08db88cf},
+	};
+
+	// What each visible game UI element is in VR (its category), and where it is on the game's 1280x720 screen
+	enum category : u8 { C_NONE = 0, C_PLATE, C_TRASH, C_OVEN, C_PROC, C_TICKETS, C_METER, C_LEFT, C_RIGHT, C_MENU };
+	struct elem { f32 x0, y0, x1, y1; f32 rx0, ry0, rx1, ry1; u8 cat, depth; bool btn; };   // btn: a button you press   // own rectangle; its group's rectangle
+	inline std::mutex elems_mutex;
+	inline std::shared_ptr<const std::vector<elem>> elems;   // published (guarded by elems_mutex)
+
+	struct state
+	{
+		std::unordered_map<u32, std::string> names;   // ~crc32(name) -> name
+		bool names_tried = false;
+		u64 last_dump = 0;
+		std::FILE* f = nullptr;
+		bool f_tried = false;
+		u64 last_labels = 0;
+		std::vector<elem> out;
+	};
+	inline state g;
+
+	// Every string in the UI scripts' string pools (the element names among them)
+	void load_names(const std::string& usrdir)
+	{
+		g.names_tried = true;
+		wad_reader w;
+		if (!w.open(usrdir + "Chef.wad")) return;
+		for (const auto& [pkg, file] : ui_scripts)
+		{
+			std::vector<u8> b;
+			if (!w.nested_file(pkg, file, b)) continue;
+			static const char mod[] = "<module>";
+			const auto it = std::search(b.begin(), b.end(), mod, mod + 8);
+			if (it == b.end()) continue;
+			usz p = static_cast<usz>(it - b.begin()) + 9;
+			while (p < b.size())
+			{
+				while (p < b.size() && b[p] == 0) p++;
+				usz e = p;
+				while (e < b.size() && b[e] != 0) e++;
+				if (e > p && e - p < 96)
+				{
+					const std::string s(reinterpret_cast<const char*>(&b[p]), e - p);
+					g.names.emplace(crc_name(s), s);
+				}
+				p = e + 1;
+			}
+		}
+		vr_log("UI tree: %zu names from the game's UI scripts", g.names.size());
+	}
+
+	bool readable(u32 a, u32 n) { return a >= 0x10000 && a < 0xc0000000 &&   /* the game heap lives above 0x30000000 */ vm::check_addr(a, vm::page_readable, n); }
+	u32 rd32(u32 a) { const u8* p = static_cast<const u8*>(vm::base(a)); return rd32be(p); }
+	f32 rdf(u32 a) { return std::bit_cast<f32>(rd32(a)); }
+
+	// The game's element classes (vtables seen in the live tree): panel, image, text, button, sprites
+	bool is_element_vt(u32 vt)
+	{
+		switch (vt)
+		{
+		case 0x342c40: case 0x342e00: case 0x342fc0: case 0x343238: case 0x343748: case 0x343880: case 0x343af0: return true;
+		default: return false;
+		}
+	}
+
+	// What an element is in VR, from its own name or the nearest parent with a telling name
+	u8 category_of(const std::string& name)
+	{
+		std::string n = name;
+		for (char& ch : n) ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+		const auto has = [&](const char* w) { return n.find(w) != std::string::npos; };
+		if (has("trash")) return C_TRASH;
+		if (has("plate") && !has("thermometer") && !has("meal")) return C_PLATE;
+		if (has("processor") && !has("timer")) return C_PROC;
+		if (has("oven") && !has("timer")) return C_OVEN;
+		if (has("order_reel") || has("big_ticket") || has("orderbig")) return C_TICKETS;
+		if (has("meter") || has("power") || has("thermometer")) return C_METER;
+		if (has("asstchef") || has("assistant")) return C_LEFT;
+		if (has("gesture") || has("utensil") || has("spice")) return C_RIGHT;
+		if (has("pause") || has("newspaper") || has("worldmap") || has("frontmenu") || has("mainmenu") || has("endofday") || has("saveload") ||
+			has("payphone") || has("option") || has("menu_") || has("_menu") || has("character") || has("profile") || has("dialog") || has("popup"))
+			return C_MENU;
+		return C_NONE;
+	}
+
+	// A button of a menu, from its name in the game's scripts (the scripts name them for what they do)
+	bool is_button_name(const std::string& name)
+	{
+		std::string n = name;
+		for (char& ch : n) ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+		if (n.find("background") != std::string::npos || n.find("_bg") != std::string::npos || n.find("shadow") != std::string::npos || n.find("title") != std::string::npos) return false;
+		static const char* words[] = {"button", "btn", "option", "item", "choice", "tab", "yes", "no_", "_no", "back", "ok", "confirm", "cancel",
+			"continue", "play", "start", "select", "arrow", "next", "prev", "slot", "quit", "resume", "retry", "restart", "accept", "skip", "icon_", "restaurant", "dish", "recipe"};
+		for (const char* w : words) if (n.find(w) != std::string::npos) return true;
+		if (n.find("district_panel") != std::string::npos || (n.find("_panel") != std::string::npos && n.find("info") == std::string::npos && n.find("worldmap") == std::string::npos && n.find("background") == std::string::npos && n.find("ui_panel") == std::string::npos && n.find("drag") == std::string::npos)) return true;
+		return n == "no";
+	}
+
+	void walk(u32 e, int depth, int& count, bool log, f32 pax, f32 pay, f32 paw, f32 pah, u8 cat, f32 rx0, f32 ry0, f32 rx1, f32 ry1)
+	{
+		if (count > 900 || depth > 14 || !readable(e, 0x1a0)) return;
+		const u32 vt = rd32(e);
+		if (!is_element_vt(vt)) return;
+		count++;
+		const u32 nh = rd32(e + 0x14c);
+		const u8 flags = static_cast<const u8*>(vm::base(e + 0x180))[0];
+		const auto it = g.names.find(nh);
+		const f32 ox = rdf(e + 0x50) + rdf(e + 0xd0), oy = rdf(e + 0x54) + rdf(e + 0xd4);   // its offset in its parent
+		const f32 w = rdf(e + 0x78), h = rdf(e + 0x7c);
+		// Where it is on the screen (checked against the game's draws: the oven at offset -24 in the 1280-wide kitchen bar
+		// is drawn at 1094..1256): a negative offset counts from the parent's right / bottom edge, else from its left / top
+		const f32 x = ox < 0.f ? pax + paw + ox - w : pax + ox;
+		const f32 y = oy < 0.f ? pay + pah + oy - h : pay + oy;
+		if (log) std::fprintf(g.f, "%*s%s [%08x] vt %08x flags %02x%s at %.1f %.1f size %.1f %.1f (offset %.1f %.1f)",
+			depth * 2, "", it != g.names.end() ? it->second.c_str() : "?", nh, vt, flags, (flags & 4) ? " HIDDEN" : "", x, y, w, h, ox, oy);
+		if (flags & 4) { if (log) std::fprintf(g.f, "\n"); return; }   // hidden: neither it nor its children are drawn
+		// a telling name starts a group: this element's rectangle is the group's (it keeps its layout on its VR anchor)
+		if (it != g.names.end())
+		{
+			const u8 c = category_of(it->second);
+			if (c && c != cat && std::isfinite(w) && w > 4.f && h > 4.f) { cat = c; rx0 = x; ry0 = y; rx1 = x + w; ry1 = y + h; }
+		}
+		if (log) std::fprintf(g.f, " cat %d%s\n", cat, it != g.names.end() && is_button_name(it->second) ? " BUTTON" : "");
+		if (std::isfinite(x) && std::isfinite(y) && std::isfinite(w) && std::isfinite(h) && w > 0.5f && h > 0.5f && g.out.size() < 1200)
+		{
+			g.out.push_back({x, y, x + w, y + h, rx0, ry0, rx1, ry1, cat, static_cast<u8>(std::min(depth, 255)), it != g.names.end() && is_button_name(it->second)});
+			// at offset 0 a narrower element may be centred in its parent instead (the ticket reel's picture is): both are matched
+			if (ox == 0.f && w < paw - 1.f && g.out.size() < 1200)
+				g.out.push_back({pax + (paw - w) * 0.5f, y, pax + (paw + w) * 0.5f, y + h, rx0, ry0, rx1, ry1, cat, static_cast<u8>(std::min(depth, 255)), false});
+		}
+		// children: a circular list at +0x18c, only when it holds elements (images keep their texture there)
+		const u32 head = e + 0x18c;
+		u32 node = rd32(head);
+		for (int n = 0; n < 256 && node != head && readable(node, 8); n++)
+		{
+			const u32 child = rd32(node + 4);
+			if (!readable(child, 4) || !is_element_vt(rd32(child))) break;
+			walk(child, depth + 1, count, log, x, y, w, h, cat, rx0, ry0, rx1, ry1);
+			node = rd32(node);
+		}
+	}
+
+	// About 5 times a second while the game runs: the game's visible UI elements with their screen rectangles and what
+	// they are in VR (published for the renderer); in Experimental also the whole tree to log/orderup_ui.log every 3 s
+	void tick(const std::string& usrdir, bool experimental)
+	{
+		if (!g_game_known) return;
+		const u64 now = GetTickCount64();
+		if (now - g.last_labels < 200) return;
+		g.last_labels = now;
+		if (!g.names_tried && !usrdir.empty()) load_names(usrdir);
+		bool log = false;
+		if (experimental && now - g.last_dump >= 3000)
+		{
+			g.last_dump = now;
+			if (!g.f && !g.f_tried) { g.f_tried = true; g.f = std::fopen((fs::get_log_dir() + "orderup_ui.log").c_str(), "w"); }
+			log = g.f && std::ftell(g.f) < 12 * 1024 * 1024;
+		}
+		constexpr u32 sys_ptr = 0x0036df0c;
+		if (!readable(sys_ptr, 4)) return;
+		const u32 sys = rd32(sys_ptr);
+		if (!readable(sys, 0x80)) return;
+		if (log)
+		{
+			SYSTEMTIME t;
+			GetLocalTime(&t);
+			std::fprintf(g.f, "==== %02d:%02d:%02d menu system %08x\n", t.wHour, t.wMinute, t.wSecond, sys);
+		}
+		g.out.clear();
+		const u32 head = sys + 0x2c;
+		u32 node = rd32(head);
+		int count = 0;
+		for (int n = 0; n < 64 && node != head && readable(node, 8); n++)
+		{
+			const u32 menu = rd32(node + 4);
+			if (readable(menu, 0x20))
+			{
+				if (log) std::fprintf(g.f, "-- menu %08x root %08x\n", menu, rd32(menu + 0x10));
+				walk(rd32(menu + 0x10), 1, count, log, 0.f, 0.f, 1280.f, 720.f, C_NONE, 0.f, 0.f, 1280.f, 720.f);
+			}
+			node = rd32(node);
+		}
+		if (log) std::fflush(g.f);
+		auto fresh = std::make_shared<const std::vector<elem>>(g.out);
+		std::lock_guard lock(elems_mutex);
+		elems = std::move(fresh);
+	}
+}
diff --git a/rpcs3/Emu/Io/OrderUpVR_vrui.inl b/rpcs3/Emu/Io/OrderUpVR_vrui.inl
new file mode 100644
index 000000000..e6b1e84e6
--- /dev/null
+++ b/rpcs3/Emu/Io/OrderUpVR_vrui.inl
@@ -0,0 +1,200 @@
+// Order Up VR: the VR UI framework, the 3D side (BLES01470).
+//
+// The game's own UI is read live from its memory (OrderUpVR_uitree.inl); the renderer moves each of the game's HUD
+// pictures to its place in your kitchen (stereo_draw_transform). This file builds the physical things around them:
+//  - the menu board: a wooden board with a real key for every button of the open menu (from the game's UI tree). The
+//    key lights up when you point at it, goes in when you press, and the press goes to that button in the game
+//    (the game's pointer is put on the button's centre, then the game's select button is pressed);
+//  - the plate on the counter, the trash bin by your leg, the oven and the food processor: real objects at your
+//    counter's height, with the game's live picture of each standing on them as their sign; they glow while food you
+//    hold is over them;
+//  - the ticket rail: a steel rail the game's tickets hang from.
+// Everything is in your room (world-locked), sized in metres from your own height.
+//
+// The 3D layer is composited over the game's picture without a shared depth, so nothing here is drawn where a game
+// picture is seen through it: the objects stand in front of and below their signs, keys are frames around buttons.
+//
+// Included inside namespace ouvr { namespace { ... } } of OrderUpVR.cpp, before gfx_render.
+
+namespace vrui
+{
+	const vec3 wood{0.36f, 0.22f, 0.12f}, wood_dark{0.24f, 0.14f, 0.07f}, brass{0.80f, 0.62f, 0.28f}, glow{1.f, 0.86f, 0.35f},
+		go{0.45f, 1.f, 0.55f}, steel{0.70f, 0.72f, 0.76f}, dark{0.16f, 0.17f, 0.18f}, ceramic{0.94f, 0.94f, 0.91f};
+
+	vec3 mix(vec3 a, vec3 b, f32 t) { return a + (b - a) * t; }
+
+	// A rectangular frame around a rectangle (centre c, axes A right, B up, N towards you): bars t thick, d deep
+	void frame(xr_state& xr, vec3 c, vec3 A, vec3 B, vec3 N, f32 hw, f32 hh, f32 t, f32 d, vec3 col)
+	{
+		const vec3 cf = c + N * (d * 0.5f);
+		draw_boxo(xr, cf + B * (hh + t * 0.5f), A, B, N, {2.f * (hw + t), t, d}, col);
+		draw_boxo(xr, cf - B * (hh + t * 0.5f), A, B, N, {2.f * (hw + t), t, d}, col);
+		draw_boxo(xr, cf + A * (hw + t * 0.5f), A, B, N, {t, 2.f * hh, d}, col);
+		draw_boxo(xr, cf - A * (hw + t * 0.5f), A, B, N, {t, 2.f * hh, d}, col);
+	}
+
+	// A ring of short bars (a rim) in the plane of A and B
+	void ring(xr_state& xr, vec3 c, vec3 A, vec3 B, f32 r, f32 thick, vec3 col, int n = 24)
+	{
+		for (int i = 0; i < n; i++)
+		{
+			const f32 a0 = 6.2831853f * i / n, a1 = 6.2831853f * (i + 1) / n;
+			draw_limb(xr, c + (A * std::cos(a0) + B * std::sin(a0)) * r, c + (A * std::cos(a1) + B * std::sin(a1)) * r, thick, thick, col);
+		}
+	}
+
+	// The game's buttons of the open menu, as keys on the board (ndc of the game's screen, y up)
+	void collect_buttons(xr_state& xr, const cam_info& cam)
+	{
+		xr.vr_btns.clear();
+		if (!cam.hud_seen[3] || !xr.mode3d) return;
+		std::shared_ptr<const std::vector<uitree::elem>> el;
+		{
+			std::lock_guard lock(uitree::elems_mutex);
+			el = uitree::elems;
+		}
+		if (!el) return;
+		const hud_region rg = cam.pan_ok[3] ? cam.pan_reg[3] : hud_regions[3];
+		for (const auto& e : *el)
+		{
+			if (!e.btn || (e.cat != uitree::C_MENU && e.cat != uitree::C_NONE)) continue;
+			const f32 w = e.x1 - e.x0, h = e.y1 - e.y0;
+			if (w < 16.f || h < 10.f || w > 1000.f || h > 420.f) continue;
+			const vr_button b{e.x0 / 640.f - 1.f, 1.f - e.y1 / 360.f, e.x1 / 640.f - 1.f, 1.f - e.y0 / 360.f, e.depth};
+			const f32 cx = (b.x0 + b.x1) * 0.5f, cy = (b.y0 + b.y1) * 0.5f;
+			if (std::fabs((cx - rg.cx) / rg.hx) > 1.f || std::fabs((cy - rg.cy) / rg.hy) > 1.f) continue;
+			bool dup = false;
+			for (const auto& o : xr.vr_btns)
+				if (std::fabs(o.x0 - b.x0) + std::fabs(o.x1 - b.x1) + std::fabs(o.y0 - b.y0) + std::fabs(o.y1 - b.y1) < 0.03f) { dup = true; break; }
+			if (!dup) xr.vr_btns.push_back(b);
+			if (xr.vr_btns.size() >= 40) break;
+		}
+		xr.vr_board_rg = rg;
+	}
+
+	// The pointer on the board snaps to the button under it (the press lands on that button in the game)
+	void snap_to_button(xr_state& xr, f32& nx, f32& ny)
+	{
+		xr.btn_hover = -1;
+		for (usz i = 0; i < xr.vr_btns.size(); i++)
+		{
+			const auto& b = xr.vr_btns[i];
+			if (nx < b.x0 - 0.01f || nx > b.x1 + 0.01f || ny < b.y0 - 0.01f || ny > b.y1 + 0.01f) continue;
+			// the smallest button under the pointer (a list item inside a list)
+			if (xr.btn_hover >= 0)
+			{
+				const auto& o = xr.vr_btns[xr.btn_hover];
+				if ((o.x1 - o.x0) * (o.y1 - o.y0) <= (b.x1 - b.x0) * (b.y1 - b.y0)) continue;
+			}
+			xr.btn_hover = static_cast<int>(i);
+		}
+		if (xr.btn_hover >= 0)
+		{
+			const auto& b = xr.vr_btns[xr.btn_hover];
+			nx = (b.x0 + b.x1) * 0.5f;
+			ny = (b.y0 + b.y1) * 0.5f;
+		}
+	}
+
+	// Where your counter is (room space y): standing, from your real floor and height; seated, below your eyes
+	f32 counter_y(const xr_state& xr)
+	{
+		if (!xr.comfort.seated && xr.floor_known) return xr.floor_y + counter_k * (xr.last_head.y - xr.floor_y);
+		return xr.last_head.y - 0.48f;
+	}
+	f32 floor_or(const xr_state& xr, f32 fallback) { return !xr.comfort.seated && xr.floor_known ? xr.floor_y : fallback; }
+
+	void draw_board(xr_state& xr)
+	{
+		if (!xr.vr_pan_ok[3]) return;
+		const hud_panel& pn = xr.vr_pan[3];
+		const vec3 N = normalize(cross(pn.A, pn.B));
+		// The board: a thick wooden frame with a brass edge
+		frame(xr, pn.P, pn.A, pn.B, N, pn.hw + 0.012f, pn.hh + 0.012f, 0.035f, 0.03f, wood);
+		frame(xr, pn.P + N * 0.031f, pn.A, pn.B, N, pn.hw + 0.012f, pn.hh + 0.012f, 0.006f, 0.004f, brass);
+		// Two chains up to the ceiling
+		for (int s = -1; s <= 1; s += 2)
+		{
+			const vec3 top = pn.P + pn.B * (pn.hh + 0.047f) + pn.A * (s * pn.hw * 0.8f);
+			draw_limb(xr, top, top + vec3{0.f, 0.6f, 0.f}, 0.004f, 0.004f, steel);
+		}
+		// The keys
+		const hud_region rg = xr.vr_board_rg;
+		const u64 now = GetTickCount64();
+		for (usz i = 0; i < xr.vr_btns.size(); i++)
+		{
+			const auto& b = xr.vr_btns[i];
+			const f32 u0 = (b.x0 - rg.cx) / rg.hx, u1 = (b.x1 - rg.cx) / rg.hx, v0 = (b.y0 - rg.cy) / rg.hy, v1 = (b.y1 - rg.cy) / rg.hy;
+			const vec3 c = pn.P + pn.A * ((u0 + u1) * 0.5f * pn.hw) + pn.B * ((v0 + v1) * 0.5f * pn.hh) + N * (0.006f * std::min<int>(b.depth, 10));
+			const f32 hw = std::fabs(u1 - u0) * 0.5f * pn.hw + 0.003f, hh = std::fabs(v1 - v0) * 0.5f * pn.hh + 0.003f;
+			const bool hover = xr.btn_hover == static_cast<int>(i);
+			const bool down = hover && xr.btn_pressed;
+			const f32 pulse = hover ? 0.5f + 0.5f * std::sin(now * 0.012f) : 0.f;
+			const vec3 col = down ? go : hover ? mix(brass, glow, 0.6f + 0.4f * pulse) : mix(wood_dark, brass, 0.35f);
+			// raised 12 mm, pushed in to 3 mm while pressed
+			frame(xr, c, pn.A, pn.B, N, hw, hh, hover ? 0.007f : 0.005f, down ? 0.003f : 0.012f, col);
+		}
+	}
+
+	void draw_rail(xr_state& xr)
+	{
+		if (!xr.vr_pan_ok[0]) return;
+		const hud_panel& pn = xr.vr_pan[0];
+		const vec3 N = normalize(cross(pn.A, pn.B));
+		const vec3 top = pn.P + pn.B * (pn.hh + 0.014f) + N * 0.012f;
+		const vec3 a = top - pn.A * (pn.hw + 0.05f), b = top + pn.A * (pn.hw + 0.05f);
+		draw_limb(xr, a, b, 0.009f, 0.009f, steel);
+		// brackets back to the wall, and the clips along the rail
+		for (const vec3 e : {a, b}) draw_limb(xr, e, e - N * 0.06f + vec3{0.f, 0.03f, 0.f}, 0.006f, 0.006f, steel);
+		for (int i = 0; i <= 8; i++)
+		{
+			const vec3 p = top - pn.A * pn.hw + pn.A * (2.f * pn.hw * i / 8.f) + N * 0.004f;
+			draw_boxo(xr, p - pn.B * 0.012f, pn.A, pn.B, N, {0.012f, 0.02f, 0.004f}, dark);
+		}
+	}
+
+	// The plate, the trash bin, the oven and the food processor, standing in front of and below their signs
+	void draw_stations(xr_state& xr, const cam_info& cam)
+	{
+		const u64 now = GetTickCount64();
+		for (int k = 0; k < 4; k++)
+		{
+			const hud_panel& s = xr.spot_room[k];
+			if (!s.on || !cam.spot_seen[k]) continue;
+			const bool hot = xr.over_spot && xr.over_k == k;
+			const bool near_hand = xr.hold_now && dot(xr.hold_hand - s.P, xr.hold_hand - s.P) < 0.35f * 0.35f;
+			const f32 pulse = hot ? 0.5f + 0.5f * std::sin(now * 0.015f) : 0.f;
+			const vec3 hi = hot ? mix(go, vec3{1.f, 1.f, 1.f}, pulse * 0.4f) : near_hand ? glow : vec3{};
+			const bool lit = hot || near_hand;
+			vec3 N = normalize(cross(s.A, s.B));
+			if (k == 0)
+			{
+				// The plate lies flat: a ceramic rim around the game's picture, a wooden board under the rim
+				const f32 r = std::max(s.hw, s.hh) * 1.10f;
+				ring(xr, s.P, s.A, s.B, r, 0.008f, lit ? hi : ceramic);
+				ring(xr, s.P - vec3{0.f, 0.006f, 0.f}, s.A, s.B, r + 0.02f, 0.010f, wood, 28);
+				continue;
+			}
+			// Upright signs (trash, oven, food processor): the game's kitchen already has these things in 3D, so no
+			// solid stand-ins (drawn without depth they covered the counter and your hands). Only a glowing frame
+			// round the sign while food you hold is near or over it.
+			if (lit) frame(xr, s.P, s.A, s.B, N, s.hw, s.hh, hot ? 0.010f : 0.006f, 0.006f, hi);
+		}
+	}
+
+	void draw(xr_state& xr)
+	{
+		if (!xr.mode3d) return;
+		cam_info cam;
+		{
+			std::lock_guard lock(g_state_mutex);
+			cam = g_cam;
+		}
+		// (no wooden board and chains around the game's menus any more: a frame round a flat picture is not VR)
+		if (xr.live3d && xr.mode3d)
+		{
+			if (cam.hud_seen[0]) draw_rail(xr);
+			draw_stations(xr, cam);
+		}
+	}
+}
diff --git a/rpcs3/Emu/RSX/NV47/FW/draw_call.hpp b/rpcs3/Emu/RSX/NV47/FW/draw_call.hpp
index 53ef60aff..d75b5cfea 100644
--- a/rpcs3/Emu/RSX/NV47/FW/draw_call.hpp
+++ b/rpcs3/Emu/RSX/NV47/FW/draw_call.hpp
@@ -231,6 +231,9 @@ namespace rsx
 
 		void reset(rsx::primitive_type type);
 
+		// Order Up VR: the first range, without touching the iteration state
+		const draw_range_t* first_range() const { return draw_command_ranges.empty() ? nullptr : &draw_command_ranges.front(); }
+
 		void begin()
