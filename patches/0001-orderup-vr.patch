+		// Two-bone arm from the shoulder to the wrist, elbow pointing down and out. The arm keeps a person's length for your
+		// size: the hand is always on your controller, and when you reach further than the arm, its shoulder end comes
+		// forward toward the hand (as your shoulder does) instead of the arm stretching or stopping short of the hand.
+		void draw_arm(xr_state& xr, vec3 shoulder, vec3 wrist, vec3 body_right, vec3 body_fwd, f32 side, f32 scale)
+		{
+			const f32 a = 0.30f * scale, b = 0.27f * scale;
+			vec3 d = wrist - shoulder;
+			f32 dist = std::sqrt(dot(d, d));
+			if (dist < 1e-4f) return;
+			vec3 e = d * (1.f / dist);
+			// a long reach: the arm stretches a little first (12%), then its top comes forward with your body (8 cm at most),
+			// then it stretches on: the sleeve stays on your shoulder
+			const f32 reach = (a + b) * 0.999f * 1.12f;
+			if (dist > reach)
+			{
+				vec3 sdir = body_fwd * 0.7f + e * 0.3f;
+				sdir = dot(sdir, sdir) > 1e-4f ? normalize(sdir) : e;
+				shoulder = shoulder + sdir * std::min(dist - reach, 0.08f * scale);
+				d = wrist - shoulder;
+				dist = std::max(std::sqrt(dot(d, d)), 1e-4f);
+				e = d * (1.f / dist);
+				draw_ball(xr, shoulder, 0.047f, c_jacket);   // the sleeve's top
+			}
+			const f32 x = (a * a - b * b + dist * dist) / (2.f * dist);
+			const f32 hh = std::sqrt(std::max(a * a - x * x, 0.f));
+			vec3 pole = vec3{0.f, -1.f, 0.f} + body_right * (side * 0.45f) - body_fwd * 0.2f;
+			pole = pole - e * dot(pole, e);
+			const vec3 bend = dot(pole, pole) > 1e-6f ? normalize(pole) : any_perp(e);
+			const vec3 elbow = shoulder + e * x + bend * hh;
+			const vec3 wrist_end = wrist;
+			draw_limb(xr, shoulder, elbow, 0.047f, 0.042f, c_jacket);
+			const vec3 cuff = elbow + (wrist_end - elbow) * 0.82f;
+			draw_limb(xr, elbow, cuff, 0.042f, 0.037f, c_jacket);
+			draw_limb(xr, cuff, wrist_end, 0.03f, 0.026f, c_skin);
+		}
+
+		void draw_body(xr_state& xr)
+		{
+			const auto& cf = xr.comfort;
+			if (!cf.body) return;
+			const vec3 head = xr.last_head;
+			const vec3 fb{-std::sin(xr.body_yaw), 0.f, -std::cos(xr.body_yaw)};
+			const vec3 rb{-fb.z, 0.f, fb.x};
+			const vec3 up{0.f, 1.f, 0.f};
+			const f32 eye_h = head.y - xr.floor_y;
+			// Body size from your real height when standing; a seated player gets an average-height chef
+			const f32 scale = std::clamp(xr.unit * chef_eye_u / 1.65f, 0.8f, 1.2f);   // the same scale as everything else
+			(void)eye_h;
+			const f32 fem = cf.female ? 1.f : 0.f;
+			const f32 shoulder_w = (0.18f - 0.025f * fem) * scale;
+			const vec3 back = fb * (-0.10f);
+
+			// Chef jacket and apron
+			const vec3 chest = head + up * (-0.40f * scale) + back;
+			const vec3 belly = head + up * (-0.66f * scale) + back;
+			const vec3 hips = head + up * (-0.84f * scale) + back;
+			draw_ellipsoid(xr, chest, rb, up, fb, {(0.19f - 0.02f * fem) * scale, 0.20f * scale, (0.115f + 0.01f * fem) * scale}, c_jacket);
+			draw_ellipsoid(xr, belly, rb, up, fb, {(0.17f - 0.035f * fem) * scale, 0.16f * scale, (0.11f - 0.01f * fem) * scale}, c_jacket);
+			draw_ellipsoid(xr, hips, rb, up, fb, {(0.16f + 0.02f * fem) * scale, 0.10f * scale, 0.11f * scale}, c_pants);
+			// Double row of jacket buttons and a neckerchief
+			for (int row = 0; row < 3; row++)
+				for (int col = -1; col <= 1; col += 2)
+					draw_ball(xr, chest + fb * (0.112f * scale) + up * ((0.08f - row * 0.075f) * scale) + rb * (col * 0.05f * scale), 0.009f, {0.75f, 0.75f, 0.72f});
+			draw_ellipsoid(xr, head + up * (-0.22f * scale) + back + fb * 0.05f, rb, up, fb, {0.06f * scale, 0.03f * scale, 0.05f * scale}, cf.female ? vec3{0.85f, 0.25f, 0.35f} : vec3{0.85f, 0.2f, 0.15f});
+			draw_boxo(xr, belly + fb * (0.105f * scale) + up * (-0.10f * scale), rb, up, fb, {0.30f * scale, 0.46f * scale, 0.012f}, c_apron);
+
+			// Arms
+			for (int hnd = 0; hnd < 2; hnd++)
+			{
+				const f32 side = hnd ? 1.f : -1.f;
+				const vec3 shoulder = head + up * (-0.24f * scale) + back + rb * (side * shoulder_w);
+				draw_ball(xr, shoulder, (0.055f - 0.007f * fem) * scale, c_jacket);
+				if (!xr.hand_valid[hnd]) continue;
+				const hand_geo h = make_hand(xr.hand_pose[hnd], hnd, xr.hand_grip[hnd], xr.hand_trig[hnd]);
+				draw_arm(xr, shoulder, h.wrist, rb, fb, side, scale * (1.f - 0.04f * fem));
+			}
+
+			// Legs: standing (they step when you walk) or seated
+			const f32 thigh = 0.44f * scale, shin = 0.43f * scale;
+			for (int leg = 0; leg < 2; leg++)
+			{
+				const f32 side = leg ? 1.f : -1.f;
+				const vec3 hip = hips + rb * (side * (0.09f + 0.01f * fem) * scale);
+				vec3 knee, foot;
+				if (cf.seated)
+				{
+					knee = hip + fb * thigh + up * 0.02f;
+					foot = knee - up * shin + fb * 0.05f;
+				}
+				else
+				{
+					const f32 ph = xr.walk_phase + (leg ? 3.14159265f : 0.f);
+					const f32 swing = std::sin(ph) * 0.45f * xr.walk_amount;
+					const f32 lift = std::max(0.f, std::cos(ph)) * 0.7f * xr.walk_amount; // knee bends while the leg swings forward
+					const vec3 tdir = up * -std::cos(swing) + fb * std::sin(swing);
+					knee = hip + tdir * thigh;
+					const f32 sa = swing - lift;
+					foot = knee + (up * -std::cos(sa) + fb * std::sin(sa)) * shin;
+				}
+				draw_limb(xr, hip, knee, (0.075f + 0.005f * fem) * scale, 0.058f * scale, c_pants);
+				draw_limb(xr, knee, foot, 0.058f * scale, 0.045f * scale, c_pants);
+				draw_ellipsoid(xr, foot + fb * 0.05f + up * (-0.02f), rb, up, fb, {0.05f, 0.04f, 0.12f}, c_shoe);
+			}
+		}
