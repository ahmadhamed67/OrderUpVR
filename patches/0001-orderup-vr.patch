+		// Copies the newest game frames (if any) into the swapchains: flat frames to the screen, 3D frames to their eye.
+		void upload_frame(xr_state& xr)
+		{
+			for (int slot = 0; slot < 3; slot++)
+			{
+				pending_frame f;
+				{
+					std::lock_guard lock(g_state_mutex);
+					auto& p = g_ready[slot];
+					if (p.px.empty()) continue;
+					f.px.swap(p.px);
+					f.w = p.w; f.h = p.h; f.bgra = p.bgra; f.id = p.id; f.tag = p.tag;
+				}
+				if (!f.w || !f.h || f.px.size() < static_cast<usz>(f.w) * f.h * 4) continue;
+				xr.shown_frame_id = std::max(xr.shown_frame_id, f.id);
+
+				if (slot == 2)
+				{
+					if (xr.swapchain == XR_NULL_HANDLE || xr.sc_w != f.w || xr.sc_h != f.h)
+					{
+						if (!create_swapchain(xr, f.w, f.h)) continue;
+					}
+					if (upload_image(xr, xr.swapchain, xr.images, f.px, f.w, f.bgra, xr.swapchain_is_bgra)) xr.have_image = true;
+					{
+						// Is the flat picture (nearly) black? Loading and fades between kitchens are.
+						u64 lum = 0, n = 0;
+						for (usz i = 0; i + 3 < f.px.size(); i += 4 * 97, n++) lum += f.px[i] + f.px[i + 1] + f.px[i + 2];
+						xr.flat_dark = n && lum / (n * 3) < 24;
+						xr.flat_at = GetTickCount64();
+					}
+					if (live::capturing()) live::grab_pixels(f.px.data(), f.w, f.h, f.bgra, live::g.screen, live::g.screen_w, live::g.screen_h, live::g.screen_ok);
+					continue;
+				}
+
+				const int eye = slot;
+				if (eye == 0 && live::capturing()) { live::grab_pixels(f.px.data(), f.w, f.h, f.bgra, live::g.game, live::g.game_w, live::g.game_h, live::g.game_ok); live::g.game_at = GetTickCount64(); }
+				if (eye == 1 && live::capturing()) live::grab_pixels(f.px.data(), f.w, f.h, f.bgra, live::g.game_r, live::g.game_r_w, live::g.game_r_h, live::g.game_r_ok);
+				if (xr.eye_sc[eye] == XR_NULL_HANDLE || xr.eye_w[eye] != f.w || xr.eye_h[eye] != f.h)
+				{
+					if (!create_eye_swapchain(xr, eye, f.w, f.h)) continue;
+				}
+				const u64 now = GetTickCount64();
+				if (now - xr.last_3d_tick > 20000) xr.eye_has[0] = xr.eye_has[1] = false; // do not pair with a very old image (the eyes catch up on their own: see eyes_apart)
+				if (upload_image(xr, xr.eye_sc[eye], xr.eye_images[eye], f.px, f.w, f.bgra, xr.eye_bgra[eye]))
+				{
+					xr.eye_has[eye] = true;
+					xr.eye_rel[eye] = f.tag.rel;
+					xr.eye_at[eye] = now;
