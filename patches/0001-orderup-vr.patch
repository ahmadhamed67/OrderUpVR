+				if (xr.sign_has)
+				{
+					const vec3 normal{std::sin(xr.screen_yaw), 0.0f, std::cos(xr.screen_yaw)};
+					const f32 sh = xr.sc_w ? xr.screen_width * xr.sc_h / xr.sc_w : xr.screen_width * 9.f / 16.f;
+					const f32 width = std::min(xr.screen_width * 0.9f, 2.6f), height = width * sign_h / sign_w;
+					const vec3 pos = xr.screen_center + vec3{0.f, sh * 0.5f + 0.16f + height * 0.5f, 0.f} + normal * 0.02f;
