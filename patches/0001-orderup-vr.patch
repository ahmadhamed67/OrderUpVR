+		mat4 m_cols(vec3 X, vec3 Y, vec3 Z, vec3 T)
+		{
+			mat4 m;
+			m.m[0] = X.x; m.m[4] = X.y; m.m[8] = X.z;
+			m.m[1] = Y.x; m.m[5] = Y.y; m.m[9] = Y.z;
+			m.m[2] = Z.x; m.m[6] = Z.y; m.m[10] = Z.z;
+			m.m[3] = T.x; m.m[7] = T.y; m.m[11] = T.z;
+			m.m[15] = 1.f;
+			return m;
+		}
+
+		bool make_mesh(ID3D11Device* dev, const std::vector<gvert>& v, const std::vector<u16>& idx, gmesh& out)
+		{
+			D3D11_BUFFER_DESC bd{};
+			bd.Usage = D3D11_USAGE_IMMUTABLE;
+			bd.ByteWidth = static_cast<UINT>(v.size() * sizeof(gvert));
+			bd.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+			D3D11_SUBRESOURCE_DATA sd{v.data()};
+			if (FAILED(dev->CreateBuffer(&bd, &sd, &out.vb))) return false;
+			bd.ByteWidth = static_cast<UINT>(idx.size() * sizeof(u16));
+			bd.BindFlags = D3D11_BIND_INDEX_BUFFER;
+			sd.pSysMem = idx.data();
+			if (FAILED(dev->CreateBuffer(&bd, &sd, &out.ib))) return false;
+			out.count = static_cast<u32>(idx.size());
+			return true;
+		}
+
+		bool gfx_init(xr_state& xr)
+		{
+			auto& g = g_gfx;
+			g.tried = true;
+
+			HMODULE comp = LoadLibraryW(L"d3dcompiler_47.dll");
+			using compile_fn = HRESULT(WINAPI*)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO*, ID3DInclude*, LPCSTR, LPCSTR, UINT, UINT, ID3DBlob**, ID3DBlob**);
+			const auto compile = comp ? reinterpret_cast<compile_fn>(GetProcAddress(comp, "D3DCompile")) : nullptr;
+			if (!compile)
+			{
+				vr_log("Body and hands: the Windows shader compiler (d3dcompiler_47.dll) is not available");
+				return false;
+			}
+			ID3DBlob* vsb = nullptr;
+			ID3DBlob* psb = nullptr;
+			ID3DBlob* err = nullptr;
+			const usz len = std::strlen(gfx_shader);
+			if (FAILED(compile(gfx_shader, len, "orderupvr", nullptr, nullptr, "vs_main", "vs_4_0", 0, 0, &vsb, &err)) ||
+				FAILED(compile(gfx_shader, len, "orderupvr", nullptr, nullptr, "ps_main", "ps_4_0", 0, 0, &psb, &err)))
+			{
+				vr_log("Body and hands: shader compile failed: %s", err ? static_cast<const char*>(err->GetBufferPointer()) : "?");
+				if (err) err->Release();
+				if (vsb) vsb->Release();
+				return false;
+			}
+			auto* dev = xr.device;
+			bool ok = SUCCEEDED(dev->CreateVertexShader(vsb->GetBufferPointer(), vsb->GetBufferSize(), nullptr, &g.vs)) &&
+				SUCCEEDED(dev->CreatePixelShader(psb->GetBufferPointer(), psb->GetBufferSize(), nullptr, &g.ps));
+			const D3D11_INPUT_ELEMENT_DESC layout[] =
+			{
+				{"POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, 0, D3D11_INPUT_PER_VERTEX_DATA, 0},
+				{"NORMAL", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, 12, D3D11_INPUT_PER_VERTEX_DATA, 0},
+			};
+			ok = ok && SUCCEEDED(dev->CreateInputLayout(layout, 2, vsb->GetBufferPointer(), vsb->GetBufferSize(), &g.il));
+			vsb->Release();
+			psb->Release();
+
+			D3D11_BUFFER_DESC cbd{};
+			cbd.ByteWidth = sizeof(cb_data);
+			cbd.Usage = D3D11_USAGE_DEFAULT;
+			cbd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+			ok = ok && SUCCEEDED(dev->CreateBuffer(&cbd, nullptr, &g.cb));
+
+			D3D11_RASTERIZER_DESC rd{};
+			rd.FillMode = D3D11_FILL_SOLID;
+			rd.CullMode = D3D11_CULL_NONE;
+			rd.DepthClipEnable = TRUE;
+			ok = ok && SUCCEEDED(dev->CreateRasterizerState(&rd, &g.rs));
+			D3D11_DEPTH_STENCIL_DESC dd{};
+			dd.DepthEnable = TRUE;
+			dd.DepthWriteMask = D3D11_DEPTH_WRITE_MASK_ALL;
+			dd.DepthFunc = D3D11_COMPARISON_LESS;
+			ok = ok && SUCCEEDED(dev->CreateDepthStencilState(&dd, &g.ds_on));
+			dd.DepthEnable = FALSE;
+			dd.DepthWriteMask = D3D11_DEPTH_WRITE_MASK_ZERO;
+			ok = ok && SUCCEEDED(dev->CreateDepthStencilState(&dd, &g.ds_off));
+
+			// Mirror: the glass marks the stencil, its depth is reset to far, then the reflection draws only there
+			{
+				D3D11_DEPTH_STENCIL_DESC sd{};
+				sd.DepthEnable = TRUE;
+				sd.DepthWriteMask = D3D11_DEPTH_WRITE_MASK_ZERO;
+				sd.DepthFunc = D3D11_COMPARISON_LESS;
+				sd.StencilEnable = TRUE;
+				sd.StencilReadMask = sd.StencilWriteMask = 0xff;
+				sd.FrontFace = {D3D11_STENCIL_OP_KEEP, D3D11_STENCIL_OP_KEEP, D3D11_STENCIL_OP_REPLACE, D3D11_COMPARISON_ALWAYS};
+				sd.BackFace = sd.FrontFace;
+				ok = ok && SUCCEEDED(dev->CreateDepthStencilState(&sd, &g.ds_mask));
+				sd.DepthWriteMask = D3D11_DEPTH_WRITE_MASK_ALL;
+				sd.DepthFunc = D3D11_COMPARISON_ALWAYS;
+				sd.FrontFace = {D3D11_STENCIL_OP_KEEP, D3D11_STENCIL_OP_KEEP, D3D11_STENCIL_OP_KEEP, D3D11_COMPARISON_EQUAL};
+				sd.BackFace = sd.FrontFace;
+				ok = ok && SUCCEEDED(dev->CreateDepthStencilState(&sd, &g.ds_reset));
+				sd.DepthFunc = D3D11_COMPARISON_LESS;
+				ok = ok && SUCCEEDED(dev->CreateDepthStencilState(&sd, &g.ds_inside));
+			}
+
+			// The chef: textured, with your own head cut away in first person
+			{
+				ID3DBlob* cv = nullptr;
+				ID3DBlob* cp = nullptr;
+				ID3DBlob* ce = nullptr;
+				const usz cl = std::strlen(chef_shader);
+				if (SUCCEEDED(compile(chef_shader, cl, "orderupvr_chef", nullptr, nullptr, "vs_main", "vs_4_0", 0, 0, &cv, &ce)) &&
+					SUCCEEDED(compile(chef_shader, cl, "orderupvr_chef", nullptr, nullptr, "ps_main", "ps_4_0", 0, 0, &cp, &ce)))
+				{
+					const D3D11_INPUT_ELEMENT_DESC cl_layout[] =
+					{
+						{"POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, 0, D3D11_INPUT_PER_VERTEX_DATA, 0},
+						{"NORMAL", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, 12, D3D11_INPUT_PER_VERTEX_DATA, 0},
+						{"TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT, 0, 24, D3D11_INPUT_PER_VERTEX_DATA, 0},
+					};
+					bool cok = SUCCEEDED(dev->CreateVertexShader(cv->GetBufferPointer(), cv->GetBufferSize(), nullptr, &g.cvs)) &&
+						SUCCEEDED(dev->CreatePixelShader(cp->GetBufferPointer(), cp->GetBufferSize(), nullptr, &g.cps)) &&
+						SUCCEEDED(dev->CreateInputLayout(cl_layout, 3, cv->GetBufferPointer(), cv->GetBufferSize(), &g.cil));
+					D3D11_BUFFER_DESC ccd{};
+					ccd.ByteWidth = sizeof(chef_cb);
+					ccd.Usage = D3D11_USAGE_DEFAULT;
+					ccd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+					cok = cok && SUCCEEDED(dev->CreateBuffer(&ccd, nullptr, &g.ccb));
+					D3D11_SAMPLER_DESC smp{};
+					smp.Filter = D3D11_FILTER_ANISOTROPIC;
