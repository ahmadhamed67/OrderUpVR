+	void research_constants(u32 program_id, const f32* consts, const u16* ids, usz id_count)
+	{
+		if (program_id != ~0u) return; // replaced by the camera memory research (same log file)
+		static std::mutex mtx;
+		static std::FILE* out = nullptr;
+		static u64 window_end = 0, next_window = 0;
+		static int windows = 0;
+		static std::set<u32> seen;
+
+		const u64 now = GetTickCount64();
+		std::lock_guard lock(mtx);
+		if (!next_window) next_window = now + 30000; // first sample 30 s after the renderer starts
+		if (now >= window_end)
+		{
+			if (now < next_window || windows >= 20) return;
+			window_end = now + 50;
+			next_window = now + 20000;
+			windows++;
+			seen.clear();
+			if (!out)
+			{
+				out = std::fopen((fs::get_log_dir() + "orderup_research.log").c_str(), "w");
+				if (!out) return;
+			}
+			std::fprintf(out, "=== sample %d at %llu ms\n", windows, static_cast<unsigned long long>(now - g_start_tick.load()));
+		}
+		if (!out || !seen.insert(program_id).second || seen.size() > 80) return;
+
+		std::fprintf(out, "prog %u: %zu constants:", program_id, id_count);
+		for (usz i = 0; i < id_count && i < 48; i++) std::fprintf(out, " %u", ids[i]);
+		std::fprintf(out, "\n");
+
+		// 4x4 blocks whose last row or column has a unit-length xyz part: the signature of a perspective camera
+		// (view-projection or model-view-projection) matrix. Logged with all 16 values for offline analysis.
+		for (usz i = 0; i + 3 < id_count; i++)
+		{
+			const u16 k = ids[i];
+			if (k > 464 || ids[i + 1] != k + 1 || ids[i + 2] != k + 2 || ids[i + 3] != k + 3) continue;
+			const f32* m = consts + k * 4;
+			const f32 row = std::sqrt(m[12] * m[12] + m[13] * m[13] + m[14] * m[14]);
+			const f32 col = std::sqrt(m[3] * m[3] + m[7] * m[7] + m[11] * m[11]);
+			const bool r = row > 0.9f && row < 1.1f, c = col > 0.9f && col < 1.1f;
+			if (!r && !c) continue;
+			std::fprintf(out, "  c%u %s:", k, r && c ? "row+col" : r ? "row" : "col");
+			for (int j = 0; j < 16; j++) std::fprintf(out, " %.5g", m[j]);
+			std::fprintf(out, "\n");
+		}
+		std::fflush(out);
+	}
