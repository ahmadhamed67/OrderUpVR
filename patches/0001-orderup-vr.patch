+		// ---- The EXIT button. Reach over your left shoulder and squeeze GRIP: a big red button comes out in your left
+		// hand. GRIP again puts it away (a pop and a puff of cloud). Squeeze it with your right hand for 3 seconds to close
+		// the game.
+		constexpr u64 exit_hold_ms = 1000;   // (the old EXIT sign: hold the trigger on it)
+		constexpr f32 xb_base_r = 0.045f, xb_base_h = 0.03f;   // the white base
+		constexpr f32 xb_cap_r = 0.034f, xb_cap_h = 0.018f;    // the red cap on it
+		constexpr f32 xb_cap_top = xb_base_h + xb_cap_h;      // top of the cap above the base's bottom centre, at rest
+		constexpr f32 xb_travel = 0.010f;                       // how far the cap goes down
+
+		vec3 left_shoulder(const xr_state& xr)
+		{
+			const vec3 fb{-std::sin(xr.body_yaw), 0.f, -std::cos(xr.body_yaw)};
+			const vec3 rb{-fb.z, 0.f, fb.x};
+			return xr.last_head + vec3{0.f, -0.24f, 0.f} + fb * -0.10f - rb * 0.18f;
+		}
+
+		// Where the button sits in the left hand: its centre and its up direction (the controller's top)
+		bool exit_button_frame(const xr_state& xr, vec3& c, vec3& up)
+		{
+			if (!xr.hand_valid[0]) return false;
+			const XrPosef& g = xr.hand_pose[0];
+			up = rotate(g.orientation, {0.f, 1.f, 0.f});
+			c = to_vec(g.position) + up * 0.065f + rotate(g.orientation, {0.f, 0.f, -0.01f});
+			return true;
+		}
+
+		// A short pop, made on the spot (no sound files are shipped): rising when the button comes out, falling when it goes
+		void play_pop(bool out)
+		{
+			static std::vector<u8> wav[2];
+			auto& w = wav[out ? 1 : 0];
+			if (w.empty())
+			{
+				const u32 rate = 22050, n = rate * 18 / 100;
+				w.resize(44 + n * 2);
+				const auto put32 = [&](size_t o, u32 v) { std::memcpy(&w[o], &v, 4); };
+				const auto put16 = [&](size_t o, u16 v) { std::memcpy(&w[o], &v, 2); };
+				std::memcpy(&w[0], "RIFF", 4); put32(4, 36 + n * 2); std::memcpy(&w[8], "WAVEfmt ", 8);
+				put32(16, 16); put16(20, 1); put16(22, 1); put32(24, rate); put32(28, rate * 2); put16(32, 2); put16(34, 16);
+				std::memcpy(&w[36], "data", 4); put32(40, n * 2);
+				u32 seed = 12345;
+				f32 ph = 0.f;
+				for (u32 i = 0; i < n; i++)
+				{
+					const f32 t = static_cast<f32>(i) / rate;
+					const f32 f = out ? 300.f + 900.f * std::min(1.f, t / 0.06f) : 900.f - 700.f * std::min(1.f, t / 0.08f);
+					ph += 6.2831853f * f / rate;
+					seed = seed * 1664525u + 1013904223u;
+					const f32 noise = (static_cast<f32>(seed >> 9) / 4194304.f - 1.f) * std::exp(-t * 90.f);
+					const f32 env = std::min(1.f, t * 400.f) * std::exp(-t * 28.f);
+					const f32 v = (std::sin(ph) * 0.8f + noise * 0.5f) * env;
+					put16(44 + i * 2, static_cast<u16>(static_cast<s16>(std::clamp(v, -1.f, 1.f) * 26000.f)));
+				}
+			}
+			PlaySoundW(reinterpret_cast<LPCWSTR>(w.data()), nullptr, SND_MEMORY | SND_ASYNC | SND_NODEFAULT);
+		}
+
+		void buzz(xr_state& xr, int hand, f32 amplitude, int ms);
+
+		// Every frame (input): take out, put away, squeeze
+		void update_exit_button(xr_state& xr, u64 now_ms)
+		{
+			const bool lg = xr.hand_grip[0] > 0.6f, rg = xr.hand_grip[1] > 0.6f;
+			const bool l_press = lg && !xr.xb_lgrip_prev;
+			xr.xb_lgrip_prev = lg;
+			vec3 c, up;
+			if (!exit_button_frame(xr, c, up)) { xr.xb_squeeze_since = 0; return; }
+			if (xr.xb_out) xr.xb_pos = c;
+			if (l_press)
+			{
+				const vec3 d = to_vec(xr.hand_pose[0].position) - left_shoulder(xr);
+				if (!xr.xb_out && dot(d, d) < 0.26f * 0.26f)
+				{
+					xr.xb_out = true; xr.xb_since = now_ms; xr.xb_pos = c; play_pop(true);
+					vr_log("Exit button: taken out over the left shoulder");
+				}
+				else if (xr.xb_out && now_ms - xr.xb_since > 300)
+				{
+					xr.xb_out = false; xr.xb_puff_tick = now_ms; xr.xb_puff_pos = c; xr.xb_squeeze_since = 0; play_pop(false);
+					vr_log("Exit button: put away");
+				}
+			}
+			// A real push button: the red cap sits on a white base and goes down only as far as your right hand's fingertip
+			// (or palm) pushes it from above. Pushed all the way down (10 mm), it clicks and the game closes at once.
+			xr.xb_depress = 0.f;
+			if (xr.xb_out && xr.hand_valid[1] && now_ms - xr.xb_since > 600)
+			{
+				const hand_geo r = make_hand(xr.hand_pose[1], 1, xr.hand_grip[1], xr.hand_trig[1]);
+				vec3 pts[6];
+				for (int f = 0; f < 5; f++) pts[f] = r.joints[f][3];
+				pts[5] = r.palm;
+				for (const vec3& p : pts)
+				{
+					const vec3 d = p - c;
+					const f32 h = dot(d, up);                      // height above the base's centre
+					const vec3 radial = d - up * h;
+					if (dot(radial, radial) > xb_cap_r * xb_cap_r) continue;   // not over the cap
+					const f32 push = xb_cap_top - (h - 0.008f);     // fingertip radius ~8 mm
+					if (push > 0.f && push < 0.04f) xr.xb_depress = std::max(xr.xb_depress, std::min(push, xb_travel));
+				}
+			}
+			if (xr.xb_depress >= xb_travel * 0.95f && !xr.exit_done)
+			{
+				xr.exit_done = true;
+				play_pop(false);
+				buzz(xr, 1, 1.f, 120);
+				vr_log("Exit: the player pushed the EXIT button down");
+				Emu.CallFromMainThread([] { Emu.Quit(true); });
+				// If the emulator has not closed in 4 seconds, end the process (the launcher sees it closing)
+				std::thread([] { Sleep(4000); vr_log("Exit: closing the process"); TerminateProcess(GetCurrentProcess(), 0); }).detach();
+			}
+			else if (xr.xb_depress > 0.002f && !xr.xb_squeeze_since) { xr.xb_squeeze_since = now_ms; vr_log("Exit button: being pushed"); }
+			else if (xr.xb_depress <= 0.002f) xr.xb_squeeze_since = 0;
+		}
+
+		// Drawn with your hands
+		void draw_exit_button(xr_state& xr)
+		{
+			const u64 now = GetTickCount64();
+			// The puff of cloud where it vanished
+			if (xr.xb_puff_tick && now - xr.xb_puff_tick < 450)
+			{
+				const f32 t = (now - xr.xb_puff_tick) / 450.f;
+				static const vec3 dirs[9] = {{1, 0.3f, 0}, {-1, 0.2f, 0.2f}, {0.2f, 1, 0.1f}, {0, 0.3f, 1}, {0.1f, 0.2f, -1}, {0.7f, 0.7f, 0.5f}, {-0.6f, 0.8f, -0.4f}, {0.6f, -0.3f, -0.6f}, {-0.5f, -0.2f, 0.7f}};
+				for (int i = 0; i < 9; i++)
+				{
+					const f32 r = (0.025f + 0.035f * t) * (1.f - t * t);
+					const f32 grey = 0.92f - 0.05f * (i % 3);
+					draw_ball(xr, xr.xb_puff_pos + normalize(dirs[i]) * (0.03f + 0.09f * t) + vec3{0.f, 0.04f * t, 0.f}, r, {grey, grey, grey + 0.03f});
+				}
+			}
+			if (!xr.xb_out) return;
+			vec3 c, up;
+			if (!exit_button_frame(xr, c, up)) return;
+			// Pops out with a little overshoot
+			const f32 a = std::min(1.f, (now - xr.xb_since) / 220.f);
+			const f32 k = std::max(0.05f, 1.f + 2.70158f * std::pow(a - 1.f, 3.f) + 1.70158f * std::pow(a - 1.f, 2.f));
+			// The label side faces you
+			vec3 toward = xr.last_head - c;
+			toward = toward - up * dot(toward, up);
+			toward = dot(toward, toward) > 1e-6f ? normalize(toward) : any_perp(up);
+			const vec3 side = normalize(cross(up, toward));
+			const f32 R = xb_base_r * k;
+			// The white base, with a darker rim where the cap sits in it
+			draw_limb(xr, c, c + up * (xb_base_h * k), R, R * 0.96f, {0.93f, 0.93f, 0.91f});
+			draw_limb(xr, c + up * (xb_base_h * k), c + up * ((xb_base_h + 0.002f) * k), xb_cap_r * k * 1.08f, xb_cap_r * k * 1.08f, {0.55f, 0.55f, 0.56f});
+			// The red cap: as far down as your finger pushes it
+			const f32 down = std::min(xr.xb_depress, xb_travel);
+			const vec3 c0 = c + up * ((xb_base_h - xb_travel + 0.002f) * k), c1 = c + up * ((xb_cap_top - down) * k);
+			draw_limb(xr, c0, c1, xb_cap_r * k, xb_cap_r * k * 0.97f, {0.82f, 0.06f, 0.05f});
+			draw_ellipsoid(xr, c1, side, up, toward, {xb_cap_r * k * 0.97f, 0.006f * k, xb_cap_r * k * 0.97f}, {0.92f, 0.12f, 0.10f});
+			// "EXIT" in white on a red plate facing you
+			const vec3 pc = c + up * (xb_base_h * 0.5f * k) + toward * (R + 0.003f);
+			draw_boxo(xr, pc, side, up, toward, {0.07f * k, 0.022f * k, 0.004f}, {0.75f, 0.06f, 0.06f});
+			const f32 lh = 0.016f * k, lw = 0.011f * k, bar = 0.0028f * k;
+			const vec3 face = pc + toward * 0.0035f;
+			// You look at the plate from the "toward" side, so your right is -side
+			const vec3 rx = side * -1.f;
+			const auto seg = [&](f32 x0, f32 y0, f32 x1, f32 y1)
+			{
+				const vec3 p0 = face + rx * x0 + up * y0, p1 = face + rx * x1 + up * y1;
+				const vec3 d = p1 - p0;
+				const f32 len = std::sqrt(dot(d, d));
+				const vec3 dx = len > 1e-6f ? d * (1.f / len) : rx, dy = normalize(cross(toward, dx));
+				draw_boxo(xr, (p0 + p1) * 0.5f, dx, dy, toward, {len + bar, bar, 0.002f}, {1.f, 1.f, 1.f});
+			};
+			const f32 h2 = lh * 0.5f, step = lw + 0.005f * k;
+			f32 x0 = -1.5f * step - lw * 0.5f;   // left edge of the E
+			// E
+			seg(x0, -h2, x0, h2); seg(x0, h2, x0 + lw, h2); seg(x0, 0.f, x0 + lw * 0.8f, 0.f); seg(x0, -h2, x0 + lw, -h2);
+			x0 += step;
+			// X
+			seg(x0, -h2, x0 + lw, h2); seg(x0, h2, x0 + lw, -h2);
+			x0 += step;
+			// I
+			seg(x0 + lw * 0.5f, -h2, x0 + lw * 0.5f, h2);
+			x0 += step;
+			// T
+			seg(x0, h2, x0 + lw, h2); seg(x0 + lw * 0.5f, -h2, x0 + lw * 0.5f, h2);
+		}
