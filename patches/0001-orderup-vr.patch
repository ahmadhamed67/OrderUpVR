+		const rsx_vr_state::ring_entry* rv_ring(u64 gen)
+		{
+			const auto& r = g_rv.ring[gen % std::size(g_rv.ring)];
+			return (r.gen == gen && r.enabled) ? &r : nullptr;
+		}
