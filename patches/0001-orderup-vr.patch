+		// Small static images: pointer cursor and laser beam (premultiplied alpha).
+		bool make_static(xr_state& xr, XrSwapchain& sc, u32 w, u32 h, const std::vector<u8>& rgba)
+		{
+			bool bgra = false;
+			const s64 format = pick_format(xr, bgra);
+			if (!format) return false;
+			XrSwapchainCreateInfo info{XR_TYPE_SWAPCHAIN_CREATE_INFO};
+			info.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_SAMPLED_BIT;
+			info.format = format; info.sampleCount = 1; info.width = w; info.height = h; info.faceCount = 1; info.arraySize = 1; info.mipCount = 1;
+			if (!xr_ok(xr, xrCreateSwapchain(xr.session, &info, &sc), "xrCreateSwapchain(static)")) return false;
+			u32 count = 0;
+			xrEnumerateSwapchainImages(sc, 0, &count, nullptr);
+			std::vector<XrSwapchainImageD3D11KHR> imgs(count, XrSwapchainImageD3D11KHR{XR_TYPE_SWAPCHAIN_IMAGE_D3D11_KHR});
+			if (XR_FAILED(xrEnumerateSwapchainImages(sc, count, &count, reinterpret_cast<XrSwapchainImageBaseHeader*>(imgs.data())))) return false;
+			std::vector<u8> px = rgba;
+			if (bgra) for (usz i = 0; i + 3 < px.size(); i += 4) std::swap(px[i], px[i + 2]);
+			u32 index = 0;
+			XrSwapchainImageAcquireInfo acquire{XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+			if (XR_FAILED(xrAcquireSwapchainImage(sc, &acquire, &index))) return false;
+			XrSwapchainImageWaitInfo wait{XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO};
+			wait.timeout = XR_INFINITE_DURATION;
+			const bool ok = XR_SUCCEEDED(xrWaitSwapchainImage(sc, &wait));
+			if (ok) xr.context->UpdateSubresource(imgs[index].texture, 0, nullptr, px.data(), w * 4, 0);
+			XrSwapchainImageReleaseInfo release{XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+			xrReleaseSwapchainImage(sc, &release);
+			return ok;
+		}
+
+		void make_pointer_images(xr_state& xr)
+		{
+			// Cursor: soft white ring with an orange core
+			{
+				constexpr u32 n = 64;
+				std::vector<u8> px(n * n * 4, 0);
+				for (u32 y = 0; y < n; y++) for (u32 x = 0; x < n; x++)
+				{
+					const f32 dx = x + 0.5f - n / 2.f, dy = y + 0.5f - n / 2.f, r = std::sqrt(dx * dx + dy * dy) / (n / 2.f);
+					const f32 ring = std::clamp(1.f - std::fabs(r - 0.78f) / 0.12f, 0.f, 1.f);
+					const f32 core = std::clamp(1.f - r / 0.32f, 0.f, 1.f);
+					const f32 a = std::max(ring * 0.95f, core);
+					const f32 cr = core > ring ? 1.f : 1.f, cg = core > ring ? 0.55f : 1.f, cb = core > ring ? 0.1f : 1.f;
+					u8* p = &px[(y * n + x) * 4];
+					p[0] = static_cast<u8>(cr * a * 255); p[1] = static_cast<u8>(cg * a * 255); p[2] = static_cast<u8>(cb * a * 255); p[3] = static_cast<u8>(a * 255);
+				}
+				xr.cursor_ok = make_static(xr, xr.cursor, n, n, px);
+			}
+			// Laser: thin beam, bright at the hand, fading towards the screen
+			{
+				constexpr u32 w = 256, h = 8;
+				std::vector<u8> px(w * h * 4, 0);
+				for (u32 y = 0; y < h; y++) for (u32 x = 0; x < w; x++)
+				{
+					const f32 along = x / static_cast<f32>(w - 1);
+					const f32 across = 1.f - std::fabs((y + 0.5f) / h * 2.f - 1.f);
+					const f32 a = std::clamp(across * 1.4f, 0.f, 1.f) * (0.75f - 0.6f * along);
+					u8* p = &px[(y * w + x) * 4];
+					p[0] = static_cast<u8>(1.0f * a * 255); p[1] = static_cast<u8>(0.75f * a * 255); p[2] = static_cast<u8>(0.45f * a * 255); p[3] = static_cast<u8>(a * 255);
+				}
+				xr.laser_ok = make_static(xr, xr.laser, w, h, px);
+			}
+		}
+
+		// Quaternion of the rotation whose columns are the given orthonormal axes.
+		XrQuaternionf quat_from_axes(vec3 x, vec3 y, vec3 z)
+		{
+			const f32 tr = x.x + y.y + z.z;
+			XrQuaternionf q;
+			if (tr > 0.f) { const f32 s4 = std::sqrt(tr + 1.f) * 2.f; q = {(y.z - z.y) / s4, (z.x - x.z) / s4, (x.y - y.x) / s4, 0.25f * s4}; }
+			else if (x.x > y.y && x.x > z.z) { const f32 s4 = std::sqrt(1.f + x.x - y.y - z.z) * 2.f; q = {0.25f * s4, (y.x + x.y) / s4, (z.x + x.z) / s4, (y.z - z.y) / s4}; }
+			else if (y.y > z.z) { const f32 s4 = std::sqrt(1.f + y.y - x.x - z.z) * 2.f; q = {(y.x + x.y) / s4, 0.25f * s4, (z.y + y.z) / s4, (z.x - x.z) / s4}; }
+			else { const f32 s4 = std::sqrt(1.f + z.z - x.x - y.y) * 2.f; q = {(z.x + x.z) / s4, (z.y + y.z) / s4, 0.25f * s4, (x.y - y.x) / s4}; }
+			return qnorm(q);
+		}
+
+		bool create_swapchain(xr_state& xr, u32 width, u32 height)
+		{
+			if (xr.swapchain != XR_NULL_HANDLE)
+			{
+				xrDestroySwapchain(xr.swapchain);
+				xr.swapchain = XR_NULL_HANDLE;
+				xr.images.clear();
+				xr.have_image = false;
+			}
+
+			xr.swapchain_format = pick_format(xr, xr.swapchain_is_bgra);
+			if (!xr.swapchain_format) return false;
+
+			XrSwapchainCreateInfo info{XR_TYPE_SWAPCHAIN_CREATE_INFO};
+			info.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_SAMPLED_BIT;
+			info.format = xr.swapchain_format;
+			info.sampleCount = 1;
+			info.width = width;
+			info.height = height;
+			info.faceCount = 1;
+			info.arraySize = 1;
+			info.mipCount = 1;
+			if (!xr_ok(xr, xrCreateSwapchain(xr.session, &info, &xr.swapchain), "xrCreateSwapchain")) return false;
+
+			u32 count = 0;
+			xrEnumerateSwapchainImages(xr.swapchain, 0, &count, nullptr);
+			xr.images.assign(count, XrSwapchainImageD3D11KHR{XR_TYPE_SWAPCHAIN_IMAGE_D3D11_KHR});
+			if (!xr_ok(xr, xrEnumerateSwapchainImages(xr.swapchain, count, &count,
+				reinterpret_cast<XrSwapchainImageBaseHeader*>(xr.images.data())), "xrEnumerateSwapchainImages"))
+			{
+				return false;
+			}
+
+			xr.sc_w = width;
+			xr.sc_h = height;
+			vr_log("Screen swapchain: %ux%u, format %lld, %u images", width, height, static_cast<long long>(xr.swapchain_format), count);
+			return true;
+		}
+
+		bool upload_image(xr_state& xr, XrSwapchain sc, std::vector<XrSwapchainImageD3D11KHR>& images, std::vector<u8>& frame, u32 w, bool src_bgra, bool dst_bgra)
+		{
+			if (src_bgra != dst_bgra)
+			{
+				u8* p = frame.data();
+				for (usz i = 0, n = frame.size() / 4; i < n; i++, p += 4) std::swap(p[0], p[2]);
+			}
+
+			u32 index = 0;
+			XrSwapchainImageAcquireInfo acquire{XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+			if (XR_FAILED(xrAcquireSwapchainImage(sc, &acquire, &index))) return false;
+
+			bool ok = false;
+			XrSwapchainImageWaitInfo wait{XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO};
+			wait.timeout = XR_INFINITE_DURATION;
+			if (XR_SUCCEEDED(xrWaitSwapchainImage(sc, &wait)))
+			{
+				xr.context->UpdateSubresource(images[index].texture, 0, nullptr, frame.data(), w * 4, 0);
+				ok = true;
+			}
+
+			XrSwapchainImageReleaseInfo release{XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+			xrReleaseSwapchainImage(sc, &release);
+			return ok;
+		}
+
+		bool create_eye_swapchain(xr_state& xr, int eye, u32 w, u32 h)
+		{
+			if (xr.eye_sc[eye] != XR_NULL_HANDLE)
+			{
+				xrDestroySwapchain(xr.eye_sc[eye]);
+				xr.eye_sc[eye] = XR_NULL_HANDLE;
+				xr.eye_images[eye].clear();
+				xr.eye_has[eye] = false;
+			}
+			const s64 format = pick_format(xr, xr.eye_bgra[eye]);
+			if (!format) return false;
+			XrSwapchainCreateInfo info{XR_TYPE_SWAPCHAIN_CREATE_INFO};
+			info.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_SAMPLED_BIT;
+			info.format = format; info.sampleCount = 1; info.width = w; info.height = h; info.faceCount = 1; info.arraySize = 1; info.mipCount = 1;
+			if (!xr_ok(xr, xrCreateSwapchain(xr.session, &info, &xr.eye_sc[eye]), "xrCreateSwapchain(eye)")) return false;
+			u32 count = 0;
+			xrEnumerateSwapchainImages(xr.eye_sc[eye], 0, &count, nullptr);
+			xr.eye_images[eye].assign(count, XrSwapchainImageD3D11KHR{XR_TYPE_SWAPCHAIN_IMAGE_D3D11_KHR});
+			if (!xr_ok(xr, xrEnumerateSwapchainImages(xr.eye_sc[eye], count, &count,
+				reinterpret_cast<XrSwapchainImageBaseHeader*>(xr.eye_images[eye].data())), "xrEnumerateSwapchainImages(eye)"))
+			{
+				xrDestroySwapchain(xr.eye_sc[eye]);
+				xr.eye_sc[eye] = XR_NULL_HANDLE;
+				return false;
+			}
+			xr.eye_w[eye] = w;
+			xr.eye_h[eye] = h;
+			vr_log("Eye %d swapchain: %ux%u", eye, w, h);
+			return true;
+		}
