+			{
+				n.held = edges;
+				n.held_since = now;
+				n.held_off = !out.on_screen;
+				n.follow_result = 0;
+				xr.input_tick = now;
+				if (n.held_off) vr_log("Press: %s past the edge of the game's view (pointer %.2f %.2f): finding the station there", edges & 2 ? "GRIP" : "TRIGGER", out.x, out.y);
