+	bool stereo_clear_color(u64 color_key, f32 rgba[4])
+	{
+		if (!g_session_running.load(std::memory_order_relaxed)) return false;
+		auto& s = g_rv;
+		if (!s.begun) rv_begin_frame();
+		if (!s.enabled || (color_key != s.scene_key && !s.is_screen(color_key))) return false;
+		// The key colour: the headset makes it see-through and shows a calm room behind the game
+		rgba[0] = 2.f / 255.f; rgba[1] = 3.f / 255.f; rgba[2] = 5.f / 255.f; rgba[3] = 1.f;
+		return true;
+	}
+
+	int stereo_draw_transform(const f32* consts, bool uses_mvp, u32 surface_w, u32 surface_h, u64 color_key, const u64* tex_keys, u32 tex_count, f32 x[16])
+	{
+		if (!g_session_running.load(std::memory_order_relaxed)) return 0;
+		auto& s = g_rv;
+		if (!s.begun) rv_begin_frame();
+		const u64 gen = s.gen.load();
+
+		if (uses_mvp) s.hv_n = 0;   // vertex positions are only read for flat draws
+		int kind = 0;
+		bool perspective = false;
+		f32 dA = 0.f, dB = 0.f, dsx = 0.f, dsy = 0.f, dcx = 0.f, dcy = 0.f;   // this draw's own projection
+		if (uses_mvp && consts)
+		{
+			// c1..c4 = rows of the model-view-projection matrix
+			const f32* m = consts + 4;
+			const vec3 r0{m[0], m[1], m[2]}, r1{m[4], m[5], m[6]}, r2{m[8], m[9], m[10]}, r3{m[12], m[13], m[14]};
+			const f32 l2 = dot(r3, r3);
+			if (l2 > 1e-8f && std::isfinite(l2) && std::isfinite(m[15]))
+			{
+				perspective = true;
+				// The projection's depth terms survive any model matrix exactly
+				const f32 A = -dot(r2, r3) / l2;
+				const f32 B = m[11] + A * m[15];
+				const auto same = [](f32 a, f32 b) { return std::fabs(a - b) <= 1e-3f * std::fabs(b) + 1e-5f; };
+				const f32 len = std::sqrt(l2);
+				const f32 cx = -dot(r0, r3) / l2, cy = -dot(r1, r3) / l2;
+				const vec3 xr = r0 + r3 * cx, yr = r1 + r3 * cy;
+				const f32 sx = std::sqrt(dot(xr, xr)) / len, sy = std::sqrt(dot(yr, yr)) / len;
