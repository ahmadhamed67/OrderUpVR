+		bool create_eye_swapchain(xr_state& xr, int eye, u32 w, u32 h)
+		{
+			if (xr.eye_sc[eye] != XR_NULL_HANDLE)
+			{
+				xrDestroySwapchain(xr.eye_sc[eye]);
+				xr.eye_sc[eye] = XR_NULL_HANDLE;
+				xr.eye_images[eye].clear();
+				xr.eye_has[eye] = false;
+			}
+			const s64 format = pick_format(xr, xr.eye_bgra[eye]);
+			if (!format) return false;
+			XrSwapchainCreateInfo info{XR_TYPE_SWAPCHAIN_CREATE_INFO};
+			info.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_SAMPLED_BIT;
+			info.format = format; info.sampleCount = 1; info.width = w; info.height = h; info.faceCount = 1; info.arraySize = 1; info.mipCount = 1;
+			if (!xr_ok(xr, xrCreateSwapchain(xr.session, &info, &xr.eye_sc[eye]), "xrCreateSwapchain(eye)")) return false;
+			u32 count = 0;
+			xrEnumerateSwapchainImages(xr.eye_sc[eye], 0, &count, nullptr);
+			xr.eye_images[eye].assign(count, XrSwapchainImageD3D11KHR{XR_TYPE_SWAPCHAIN_IMAGE_D3D11_KHR});
+			if (!xr_ok(xr, xrEnumerateSwapchainImages(xr.eye_sc[eye], count, &count,
+				reinterpret_cast<XrSwapchainImageBaseHeader*>(xr.eye_images[eye].data())), "xrEnumerateSwapchainImages(eye)"))
+			{
+				xrDestroySwapchain(xr.eye_sc[eye]);
+				xr.eye_sc[eye] = XR_NULL_HANDLE;
+				return false;
+			}
+			xr.eye_w[eye] = w;
+			xr.eye_h[eye] = h;
+			vr_log("Eye %d swapchain: %ux%u", eye, w, h);
+			return true;
+		}
+
+		// Copies the newest game frames (if any) into the swapchains: flat frames to the screen, 3D frames to their eye.
+		void upload_frame(xr_state& xr)
+		{
+			for (int slot = 0; slot < 3; slot++)
+			{
+				pending_frame f;
+				{
+					std::lock_guard lock(g_state_mutex);
+					auto& p = g_pending[slot];
+					if (p.px.empty()) continue;
+					f.px.swap(p.px);
+					f.w = p.w; f.h = p.h; f.bgra = p.bgra; f.id = p.id; f.tag = p.tag;
+				}
+				if (!f.w || !f.h || f.px.size() < static_cast<usz>(f.w) * f.h * 4) continue;
+				xr.shown_frame_id = std::max(xr.shown_frame_id, f.id);
+
+				if (slot == 2)
+				{
+					if (xr.swapchain == XR_NULL_HANDLE || xr.sc_w != f.w || xr.sc_h != f.h)
+					{
+						if (!create_swapchain(xr, f.w, f.h)) continue;
+					}
+					if (upload_image(xr, xr.swapchain, xr.images, f.px, f.w, f.bgra, xr.swapchain_is_bgra)) xr.have_image = true;
+					continue;
+				}
+
+				const int eye = slot;
+				if (xr.eye_sc[eye] == XR_NULL_HANDLE || xr.eye_w[eye] != f.w || xr.eye_h[eye] != f.h)
+				{
+					if (!create_eye_swapchain(xr, eye, f.w, f.h)) continue;
+				}
+				const u64 now = GetTickCount64();
+				if (now - xr.last_3d_tick > 400) xr.eye_has[0] = xr.eye_has[1] = false; // do not pair with an old image
+				if (upload_image(xr, xr.eye_sc[eye], xr.eye_images[eye], f.px, f.w, f.bgra, xr.eye_bgra[eye]))
+				{
+					xr.eye_has[eye] = true;
+					xr.eye_rel[eye] = f.tag.rel;
+					xr.eye_fov[eye] = f.tag.fov;
+					xr.mono3d = f.tag.eye == 2;
+					xr.last_3d_tick = now;
+				}
+			}
+		}
