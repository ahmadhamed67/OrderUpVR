+				// The object nearest your hand in 3D (your hand is where the food is in VR); without a hand position, the
+				// one nearest the pointer on the game's screen
+				bool by_hand = s.hand_view_ok;
+				const auto score = [&](const auto& c) { if (!by_hand) return c.nd; const vec3 d = c.o - s.hand_view; return std::sqrt(dot(d, d)); };
+				auto best = std::min_element(s.hold_cands.begin(), s.hold_cands.end(), [&](const auto& a, const auto& b) { return score(a) < score(b); });
