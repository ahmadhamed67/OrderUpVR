+		if (FAILED(f.wic->CreateBitmap(w, h, GUID_WICPixelFormat32bppPBGRA, WICBitmapCacheOnLoad, &bmp))) return false;
+		ID2D1RenderTarget* rt = nullptr;
+		const D2D1_RENDER_TARGET_PROPERTIES props = D2D1::RenderTargetProperties(D2D1_RENDER_TARGET_TYPE_DEFAULT, D2D1::PixelFormat(DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED), 96.f, 96.f);
+		if (FAILED(f.d2d->CreateWicBitmapRenderTarget(bmp, props, &rt))) { rel(bmp); return false; }
+		painter p{rt, f.dw, f.d2d};
