+		frame_tag rv_end_frame(u64 display_key)
+		{
+			auto& s = g_rv;
+			const u64 gen = s.gen.load();
+
+			// Which frame's eye view is in the buffer being shown?
+			frame_tag out{};
+			if (display_key != ~0ull)
+			{
+				u64 g = rv_content_get(display_key);
