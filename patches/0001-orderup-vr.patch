+				const f32 cx = -dot(r0, r3) / l2, cy = -dot(r1, r3) / l2;
+				const vec3 xr = r0 + r3 * cx, yr = r1 + r3 * cy;
+				const f32 sx = std::sqrt(dot(xr, xr)) / len, sy = std::sqrt(dot(yr, yr)) / len;
