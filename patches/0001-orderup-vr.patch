+		constexpr const char* lobby_shader = R"(
+cbuffer C : register(b0) { float4x4 mvp; float4 params; float4 pad; };
+Texture2D tex : register(t0);
+SamplerState smp : register(s0);
+struct VI { float3 p : POSITION; float2 uv : TEXCOORD0; float4 c : COLOR0; };
+struct VO { float4 pos : SV_Position; float2 uv : TEXCOORD0; float4 c : COLOR0; };
+VO vs_main(VI i)
+{
+	VO o;
+	o.pos = mul(float4(i.p, 1), mvp);
+	o.uv = i.uv;
+	o.c = i.c;
+	return o;
+}
+float4 ps_main(VO i) : SV_Target
+{
+	float4 t = tex.Sample(smp, i.uv);
+	// params.x: 0 opaque, 1 cut-out, 2 see-through, 3 glow (added)
+	if (params.x > 0.5 && params.x < 1.5) clip(t.a - 0.5);
+	float3 c = t.rgb * lerp(float3(1, 1, 1), i.c.rgb, 0.85) * params.y;
+	return float4(c, params.x > 1.5 ? t.a * i.c.a : 1);
+}
+)";
