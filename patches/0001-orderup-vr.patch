+		// The game's USRDIR (disc games: /dev_bdvd; folder games are mounted there too)
+		std::string game_usrdir()
+		{
+			std::string d = vfs::get("/dev_bdvd/PS3_GAME/USRDIR/");
+			if (!d.empty() && fs::is_file(d + "Chef.wad")) return d;
+			std::string boot = Emu.GetBoot();
+			for (int up = 0; up < 4 && !boot.empty(); up++)
+			{
+				const usz cut = boot.find_last_of("/\\");
+				if (cut == std::string::npos) break;
+				boot.resize(cut);
+				for (const char* sub : {"/", "/USRDIR/", "/PS3_GAME/USRDIR/"})
+					if (fs::is_file(boot + sub + "Chef.wad")) return boot + sub;
+			}
+			return {};
+		}
