+		// True when this mod version has already finished preparing once on this PC.
+		bool already_prepared() { return persist_get("prepared") == mod_version(); }
+
+		const char* loading_tip(u64 now)
+		{
+			static const char* tips[] =
+			{
+				"Tip: GRIP grabs and holds, TRIGGER selects.",
+				"Tip: to flip, hold GRIP and flick the controller up and over, or flick the thumbstick up.",
+				"Tip: click the left thumbstick to bring the screen back in front of you.",
+				"Tip: hold Left MENU for 2 seconds to see all controls.",
+				"Tip: the hand you press GRIP or TRIGGER with becomes the pointing hand.",
+			};
+			return tips[(now / 8000) % std::size(tips)];
+		}
