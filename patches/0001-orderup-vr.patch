+	bool stereo_clear_color(u64 color_key, f32 rgba[4])
+	{
+		if (!g_session_running.load(std::memory_order_relaxed)) return false;
+		auto& s = g_rv;
+		if (!s.begun) rv_begin_frame();
+		if (!s.enabled || (color_key != s.scene_key && !s.is_screen(color_key))) return false;
+		// The key colour: the headset makes it see-through and shows a calm room behind the game
+		rgba[0] = 2.f / 255.f; rgba[1] = 3.f / 255.f; rgba[2] = 5.f / 255.f; rgba[3] = 1.f;
+		return true;
+	}
+
+	namespace
+	{
+		// The smallest of the game's UI elements that holds most of this flat draw (its vertices' box, in the game's pixels):
+		// the game draws something there. The marks are cleared when a new list of elements comes (rv_begin_frame) and go to
+		// the headset side with each frame (g_drawn): a menu key is only made where the game draws something.
+		void rv_mark_drawn(u32 surface_w, u32 surface_h)
+		{
+			auto& s = g_rv;
+			if (!s.elems || s.drawn.size() != s.elems->size() || !surface_w || !surface_h) return;
+			if (std::max({std::fabs(s.hv_x0), std::fabs(s.hv_x1), std::fabs(s.hv_y0), std::fabs(s.hv_y1)}) <= 1.05f) return;   // not in pixels
+			const f32 kx = 1280.f / static_cast<f32>(surface_w), ky = 720.f / static_cast<f32>(surface_h);
+			const f32 x0 = std::max(std::min(s.hv_x0, s.hv_x1) * kx, 0.f), x1 = std::min(std::max(s.hv_x0, s.hv_x1) * kx, 1280.f);
+			const f32 y0 = std::max(std::min(s.hv_y0, s.hv_y1) * ky, 0.f), y1 = std::min(std::max(s.hv_y0, s.hv_y1) * ky, 720.f);
+			if (x1 - x0 < 1.f || y1 - y0 < 1.f) return;
+			const f32 da = (x1 - x0) * (y1 - y0);
+			const auto& el = *s.elems;
+			int best = -1;
+			f32 best_a = 1e12f;
+			for (usz i = 0; i < el.size(); i++)
+			{
+				const auto& e = el[i];
+				const f32 ix = std::min(x1, e.x1) - std::max(x0, e.x0), iy = std::min(y1, e.y1) - std::max(y0, e.y0);
+				if (ix <= 0.f || iy <= 0.f || ix * iy < 0.8f * da) continue;
+				const f32 ea = (e.x1 - e.x0) * (e.y1 - e.y0);
+				if (ea < best_a) { best_a = ea; best = static_cast<int>(i); }
+			}
+			if (best >= 0 && !s.drawn[best]) { s.drawn[best] = 1; s.drawn_new = true; }
+		}
+	}
