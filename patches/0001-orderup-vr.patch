+					by_hand = false;
+					best = std::min_element(s.hold_cands.begin(), s.hold_cands.end(), [&](const auto& a, const auto& b) { return a.nd < b.nd; });
+				}
+				if (by_hand ? score(*best) < 0.6f : best->nd < 0.15f)
