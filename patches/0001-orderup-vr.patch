+		// Drawn with your hands
+		void draw_exit_button(xr_state& xr)
+		{
+			const u64 now = GetTickCount64();
+			// The puff of cloud where it vanished
+			if (xr.xb_puff_tick && now - xr.xb_puff_tick < 450)
+			{
+				const f32 t = (now - xr.xb_puff_tick) / 450.f;
+				static const vec3 dirs[9] = {{1, 0.3f, 0}, {-1, 0.2f, 0.2f}, {0.2f, 1, 0.1f}, {0, 0.3f, 1}, {0.1f, 0.2f, -1}, {0.7f, 0.7f, 0.5f}, {-0.6f, 0.8f, -0.4f}, {0.6f, -0.3f, -0.6f}, {-0.5f, -0.2f, 0.7f}};
+				for (int i = 0; i < 9; i++)
+				{
+					const f32 r = (0.025f + 0.035f * t) * (1.f - t * t);
+					const f32 grey = 0.92f - 0.05f * (i % 3);
+					draw_ball(xr, xr.xb_puff_pos + normalize(dirs[i]) * (0.03f + 0.09f * t) + vec3{0.f, 0.04f * t, 0.f}, r, {grey, grey, grey + 0.03f});
+				}
+			}
+			if (!xr.xb_out) return;
+			vec3 c, up;
+			if (!exit_button_frame(xr, c, up)) return;
+			// Pops out with a little overshoot
+			const f32 a = std::min(1.f, (now - xr.xb_since) / 220.f);
+			const f32 k = std::max(0.05f, 1.f + 2.70158f * std::pow(a - 1.f, 3.f) + 1.70158f * std::pow(a - 1.f, 2.f));
+			// The label side faces you
+			vec3 toward = xr.last_head - c;
+			toward = toward - up * dot(toward, up);
+			toward = dot(toward, toward) > 1e-6f ? normalize(toward) : any_perp(up);
+			const vec3 side = normalize(cross(up, toward));
+			const f32 R = xb_base_r * k;
+			// The white base, with a darker rim where the cap sits in it
+			draw_limb(xr, c, c + up * (xb_base_h * k), R, R * 0.96f, {0.93f, 0.93f, 0.91f});
+			draw_limb(xr, c + up * (xb_base_h * k), c + up * ((xb_base_h + 0.002f) * k), xb_cap_r * k * 1.08f, xb_cap_r * k * 1.08f, {0.55f, 0.55f, 0.56f});
+			// The red cap: as far down as your finger pushes it, or where its spring has it (a little above its rest while
+			// it springs back up)
+			const f32 down = std::clamp(xr.xb_depress, -xb_over, xb_travel);
+			const vec3 c0 = c + up * ((xb_base_h - xb_travel + 0.002f) * k), c1 = c + up * ((xb_cap_top - down) * k);
+			draw_limb(xr, c0, c1, xb_cap_r * k, xb_cap_r * k * 0.97f, {0.82f, 0.06f, 0.05f});
+			draw_ellipsoid(xr, c1, side, up, toward, {xb_cap_r * k * 0.97f, 0.006f * k, xb_cap_r * k * 0.97f}, {0.92f, 0.12f, 0.10f});
+			// "EXIT" in white on a red plate facing you
+			const vec3 pc = c + up * (xb_base_h * 0.5f * k) + toward * (R + 0.003f);
+			draw_boxo(xr, pc, side, up, toward, {0.07f * k, 0.022f * k, 0.004f}, {0.75f, 0.06f, 0.06f});
+			const f32 lh = 0.016f * k, lw = 0.011f * k, bar = 0.0028f * k;
+			const vec3 face = pc + toward * 0.0035f;
+			// You look at the plate from the "toward" side, so your right is -side
+			const vec3 rx = side * -1.f;
+			const auto seg = [&](f32 x0, f32 y0, f32 x1, f32 y1)
+			{
+				const vec3 p0 = face + rx * x0 + up * y0, p1 = face + rx * x1 + up * y1;
+				const vec3 d = p1 - p0;
+				const f32 len = std::sqrt(dot(d, d));
+				const vec3 dx = len > 1e-6f ? d * (1.f / len) : rx, dy = normalize(cross(toward, dx));
+				draw_boxo(xr, (p0 + p1) * 0.5f, dx, dy, toward, {len + bar, bar, 0.002f}, {1.f, 1.f, 1.f});
+			};
+			const f32 h2 = lh * 0.5f, step = lw + 0.005f * k;
+			f32 x0 = -1.5f * step - lw * 0.5f;   // left edge of the E
+			// E
+			seg(x0, -h2, x0, h2); seg(x0, h2, x0 + lw, h2); seg(x0, 0.f, x0 + lw * 0.8f, 0.f); seg(x0, -h2, x0 + lw, -h2);
+			x0 += step;
+			// X
+			seg(x0, -h2, x0 + lw, h2); seg(x0, h2, x0 + lw, -h2);
+			x0 += step;
+			// I
+			seg(x0 + lw * 0.5f, -h2, x0 + lw * 0.5f, h2);
+			x0 += step;
+			// T
+			seg(x0, h2, x0 + lw, h2); seg(x0 + lw * 0.5f, -h2, x0 + lw * 0.5f, h2);
+		}
+
+		mat4 view_proj(const XrView& v, f32 near_z, f32 far_z, bool rotation_only)
+		{
+			const XrFovf& f = v.fov;
+			const f32 l = std::tan(f.angleLeft), r = std::tan(f.angleRight), u = std::tan(f.angleUp), d = std::tan(f.angleDown);
+			mat4 P;
+			P.m[0] = 2.f / (r - l); P.m[2] = (r + l) / (r - l);
+			P.m[5] = 2.f / (u - d); P.m[6] = (u + d) / (u - d);
+			P.m[10] = far_z / (near_z - far_z); P.m[11] = near_z * far_z / (near_z - far_z);
+			P.m[14] = -1.f;
+			const XrQuaternionf q = v.pose.orientation;
+			const vec3 t = rotation_only ? vec3{0.f, 0.f, 0.f} : to_vec(v.pose.position);
+			const vec3 ax = rotate(q, {1.f, 0.f, 0.f}), ay = rotate(q, {0.f, 1.f, 0.f}), az = rotate(q, {0.f, 0.f, 1.f});
+			mat4 V;
+			V.m[0] = ax.x; V.m[1] = ax.y; V.m[2] = ax.z; V.m[3] = -dot(ax, t);
+			V.m[4] = ay.x; V.m[5] = ay.y; V.m[6] = ay.z; V.m[7] = -dot(ay, t);
+			V.m[8] = az.x; V.m[9] = az.y; V.m[10] = az.z; V.m[11] = -dot(az, t);
+			V.m[15] = 1.f;
+			return mmul(P, V);
+		}
+
+		bool acquire(XrSwapchain sc, u32& index)
+		{
+			XrSwapchainImageAcquireInfo ai{XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+			if (XR_FAILED(xrAcquireSwapchainImage(sc, &ai, &index))) return false;
+			XrSwapchainImageWaitInfo wi{XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO};
+			wi.timeout = XR_INFINITE_DURATION;
+			if (XR_FAILED(xrWaitSwapchainImage(sc, &wi)))
+			{
+				XrSwapchainImageReleaseInfo ri{XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+				xrReleaseSwapchainImage(sc, &ri);
+				return false;
+			}
+			return true;
+		}
+
+		void release(XrSwapchain sc)
+		{
+			XrSwapchainImageReleaseInfo ri{XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+			xrReleaseSwapchainImage(sc, &ri);
+		}
