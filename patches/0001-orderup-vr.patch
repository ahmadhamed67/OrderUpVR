+			// picture there is no station to go to, and the press goes to the game as it is (its minigames do not need the pointer)
+			const f32 px = (out.x * 2.f - 1.f) * std::max(cam.hud_k, 1.f);
+			const bool past_frame = out.x > -3.f && out.x < 4.f && !(out.x == -1.f && out.y == -1.f) && std::fabs(px) > 1.08f &&
+				out.y > -0.2f && out.y < 1.2f;
