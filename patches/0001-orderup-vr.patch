+	void note(const char* fmt, ...)
+	{
+		char buf[512];
+		va_list args;
+		va_start(args, fmt);
+		std::vsnprintf(buf, sizeof(buf), fmt, args);
+		va_end(args);
+		vr_log("%s", buf);
+	}
