+				const u64 t0 = GetTickCount64();
+				const bool ok = chef::load(m, argv[2], fem != 0);
+				std::printf("%s chef: %s, %zu vertices, %zu triangles, texture %ux%u, %llu ms %s\n", fem ? "female" : "male", ok ? "ok" : "FAILED", m.v.size(), m.idx.size() / 3, m.tw, m.th,
+					static_cast<unsigned long long>(GetTickCount64() - t0), m.error.c_str());
+				if (!ok) continue;
+				for (int posed = 0; posed < 2; posed++)
+				{
+					chef::pose_in in;
+					in.scale = 1.f;
+					in.head = {0.f, m.eye_y, m.face_z + 0.03f};
+					in.body_yaw = 3.14159265f;    // facing +z, like the T pose
+					if (posed)
+					{
+						for (int sd = 0; sd < 2; sd++)
+						{
+							in.hand_valid[sd] = true;
+							in.hand[sd].position = {sd == 0 ? 0.25f : -0.25f, m.eye_y - 0.35f, m.face_z + 0.45f};
+							// held naturally: the handle tilts 60 degrees up from pointing forward (+z)
+							in.hand[sd].orientation = qnorm(qmul(yaw_q(3.14159265f), XrQuaternionf{std::sin(0.5236f), 0.f, 0.f, std::cos(0.5236f)}));
+							in.grip[sd] = sd == 0 ? 1.f : 0.f;
+							in.trig[sd] = sd == 0 ? 1.f : 0.f;
+						}
+						in.walk_phase = 1.2f;
+						in.walk_amount = 1.f;
+					}
+					chef::rigid T[chef::P_COUNT];
+					vec3 root; XrQuaternionf rq;
+					chef::solve(m, in, T, root, rq);
+					std::vector<vec3> P, N;
+					chef::skin(m, T, root, rq, in.scale, P, N);
+					std::FILE* f = std::fopen(fmt::format("%s_%s_%s.obj", argv[3], fem ? "female" : "male", posed ? "posed" : "rest").c_str(), "w");
+					if (!f) continue;
+					for (usz i = 0; i < P.size(); i++) std::fprintf(f, "v %f %f %f\nvt %f %f\n", P[i].x, P[i].y, P[i].z, m.v[i].u, m.v[i].v);
+					for (usz i = 0; i + 2 < m.idx.size(); i += 3) std::fprintf(f, "f %u/%u %u/%u %u/%u\n", m.idx[i] + 1, m.idx[i] + 1, m.idx[i + 1] + 1, m.idx[i + 1] + 1, m.idx[i + 2] + 1, m.idx[i + 2] + 1);
+					std::fclose(f);
+				}
+				// face: material ranges and pictures
+				for (int k = 0; k < chef::model::M_COUNT; k++) std::printf(" range %d: %u tris", k, m.range_count[k] / 3);
+				std::printf("\n");
+				for (int k = 0; k < 3; k++)
+					if (m.face_size[k])
+					{
+						std::vector<u8> bgra(m.face_rgba[k]);
+						for (usz i = 0; i + 3 < bgra.size(); i += 4) std::swap(bgra[i], bgra[i + 2]);
+						ui::save_png(fmt::format("%s_%s_face%d.png", argv[3], fem ? "female" : "male", k), bgra.data(), m.face_size[k], m.face_size[k], false);
+					}
+				// parts histogram
+				int hist[chef::P_COUNT]{};
+				for (const auto& x : m.v) hist[x.part[0]]++;
+				for (int k = 0; k < chef::P_COUNT; k++) std::printf(" part %d: %d", k, hist[k]);
+				std::printf("\n");
+			}
+			return 0;
+		}
+		return 1;
+	}
+}
diff --git a/rpcs3/Emu/Io/OrderUpVR.h b/rpcs3/Emu/Io/OrderUpVR.h
new file mode 100644
index 000000000..447bf1b37
--- /dev/null
+++ b/rpcs3/Emu/Io/OrderUpVR.h
@@ -0,0 +1,118 @@
+#pragma once
+#include <functional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Order Up VR: OpenXR bridge for the PS3 game Order Up!! (BLES01470).
+//
+// A dedicated thread owns an OpenXR session (D3D11 binding, independent of the
+// emulator's renderer). The renderer hands it finished game frames, which are
+// shown on a large world-locked virtual screen. The VR controller that aims at
+// that screen becomes the game's PlayStation Move pointer (see cellGem.cpp).
+
+#include "util/types.hpp"
+
+#include <vector>
+
+namespace ouvr
+{
+	struct pointer_state
+	{
+		bool active = false; // VR session is focused and a controller is tracked; use this instead of the mouse
+		bool on_screen = false;
+		f32 x = 0.5f;        // 0..1 across the virtual screen, left to right
+		f32 y = 0.5f;        // 0..1 top to bottom
+		f32 trigger = 0.0f;  // 0..1
+		bool t = false;
+		bool move = false;
+		bool cross = false;
+		bool circle = false;
+		bool square = false;
+		bool triangle = false;
+		bool start = false;
+		bool select = false;
+
+		// Real controller motion, in the emulated PS Eye camera frame (= the virtual screen: x right, y up,
+		// z towards the player). A real PS Move reports the same quantities, so the game's motion gestures work.
+		bool motion = false;
+		bool assist = false;   // the stick-flick flip is playing
+		f32 rq[4] = {0.f, 0.f, 0.f, 1.f}; // rotation beyond aiming (wrist twist, flicking past the screen), x y z w
+		f32 vel[3] = {};       // mm/s
+		f32 accel[3] = {};     // mm/s^2
+		f32 angvel[3] = {};    // rad/s
+		f32 angaccel[3] = {};  // rad/s^2
+		f32 disp[3] = {};      // mm, quick hand movement (slow drift removed)
+		// Real grabbing: the hand's ray in room space (origin + direction), for future 3D item pickup.
+		f32 ray_origin[3] = {};
+		f32 ray_dir[3] = {0.f, 0.f, -1.f};
+		f32 acc_dev[3] = {0.f, 0.f, 1.f}; // accelerometer in device axes, G (gravity included)
+		f32 gyro_dev[3] = {};  // gyroscope in device axes, rad/s
+	};
+
+	// Called by cellSaveData around every save-data operation (begin = true when it starts, false when it ends), so
+	// closing the game from VR waits for a save that is being written instead of cutting it off.
+	void savedata_busy(bool begin);
+
+	// Called by the renderer when a game boots / shuts down.
+	void start();
+	void stop();
+
+	// True while the VR session is running and wants a copy of every presented frame.
+	bool wants_frames();
+
+	// Latest presented game frame, 4 bytes per pixel.
+	// display_key: (location << 32) | offset of the display buffer shown.
+	void submit_frame(std::vector<u8>&& pixels, u32 width, u32 height, bool is_bgra, u64 display_key = ~0ull);
+
+	// The renderer could not present because the desktop game window is minimized or has no size.
+	void report_window_unavailable();
+
+	// Current controller-as-pointer state (thread safe).
+	pointer_state get_pointer();
+
+	// Diagnostics (written to log/orderup_vr.log). trace() counts calls per name and reports them every few seconds.
+	void trace(const char* name);
+
+	// True-VR research: records likely camera/projection matrices from vertex shader constants a few times per session
+	// (log/orderup_research.log). consts = all 468 transform constants (4 floats each), ids = constants the program reads.
+	void research_constants(u32 program_id, const f32* consts, const u16* ids, usz id_count);
+	void note(const char* fmt, ...);
+
+	// True VR (stereo + head tracking), called by the renderer for every draw on the RSX thread.
+	// The game draws every 3D object with one model-view-projection matrix in constants c1..c4; the mod finds the
+	// camera projection in it and re-renders the scene from the headset's eye. consts = the 468 transform constants,
+	// uses_mvp = the vertex program reads c1..c4.
+	// Returns 0 = leave the draw alone, 1 = 3D scene draw, 2 = 2D overlay draw (HUD, menus: placed on a plane in
+	// the 3D world), other values for the other placements (5 = a 3D draw with its own lens, its matrix differs per draw;
+	// 6-9 HUD panels and spots; 16 and up = one value per HUD card and level). For any nonzero value x receives a
+	// row-major 4x4 matrix to apply to the program's clip-space output; the renderer uploads it again when the value changes.
+	// color_key / tex_keys: (location << 32) | offset of the colour target and of the textures the draw reads
+	// (location 0 = local video memory, 1 = main memory). They tell the scene, the copy of it onto the screen
+	// and the HUD apart.
+	// The launcher's mods that change the game's code (config/orderupvr_mods.txt), applied when the program loads
+	void note_game(const std::string& exe_hash);
+	void apply_code_patches(const std::string& exe_hash, const std::function<u8*(u32, u32)>& ptr, std::vector<u32>& applied);
+
+	// The next flat draw's first vertices (position attribute: x y z w each), for placing HUD elements
+	void hud_vertices(const f32* xyzw, u32 count, u32 type, u32 comps);
+	int stereo_draw_transform(const f32* consts, bool uses_mvp, u32 surface_w, u32 surface_h, u64 color_key, const u64* tex_keys, u32 tex_count, f32 x[16]);
+
+	// Clear of a colour target: returns true and the colour to use when the mod replaces it (the empty space around
+	// the game's view becomes see-through in the headset).
+	bool stereo_clear_color(u64 color_key, f32 rgba[4]);
+
+	// The game started a PS Move calibration (it asked the player to press Square and they did).
+	void note_calibration();
+
+	// Changes once per presented frame (the eye being rendered changes); the renderer re-applies the transform then.
+	u64 stereo_generation();
+
+	// A crash report to the live test stream (Experimental), sent before the process ends.
+	void live_fatal(std::string_view text);
+
+	// rows = the renderer's 4x4 viewport (scale/offset) matrix, row-major; it becomes rows * x.
+	void stereo_apply(void* rows, const f32 x[16]);
+	// Developer tools (not used in play): --ouvr-spu-disasm <in> <out> [start] [len]
+	int dev_tool(int argc, char** argv);
+}
diff --git a/rpcs3/Emu/Io/OrderUpVR_chef.inl b/rpcs3/Emu/Io/OrderUpVR_chef.inl
new file mode 100644
index 000000000..02bd4c5d3
--- /dev/null
+++ b/rpcs3/Emu/Io/OrderUpVR_chef.inl
@@ -0,0 +1,900 @@
+// Order Up VR: the game's own chef models, rebuilt at start-up from the player's own game files.
+//
+// The chefs live in USRDIR/Chef.wad (nested, zlib-compressed WADs; files named by CRC32 of their path, without the
+// final inversion). Their triangle lists use Sony's Edge compressed index format, which the game decodes on the SPUs.
+// We run the game's own decoder (from USRDIR/spurs/spu_codef.ppu.sprx, decrypted with RPCS3's own code) in a small
+// SPU interpreter, so nothing of the game is shipped with the mod.
+// Included inside namespace ouvr { namespace { ... } } of OrderUpVR.cpp, after the vec3 helpers.
+
+namespace chef
+{
+	enum class sop : u8 { UNK, A, AH, AHI, AI, AND, ANDBI, ANDHI, ANDI, BI, BR, BRHZ, BRNZ, BRSL, BRZ, CEQ, CEQI, CGT, CGTH, CGTHI, CGTI, CLGT, CLGTI, CNTB, CWD, FSMB, FSMBI, HBR, HBRR, IL, ILA, ILH, LQD, LQR, LQX, MPY, MPYHH, MPYI, OR, ORHI, ORI, ROT, ROTH, ROTHM, ROTHMI, ROTM, ROTMAH, ROTMI, ROTQBY, ROTQBYI, ROTQMBYI, SELB, SF, SFH, SFHI, SFI, SHL, SHLHI, SHLI, SHLQBYI, SHUFB, STQD, STQX };
+	struct sop_entry { u8 magn; u16 value; sop op; };
+	// From RPCS3's SPUOpcodes.h (only what Edge's index decompressor executes)
+	constexpr sop_entry sop_list[] = {{0, 0x40, sop::SF}, {0, 0x41, sop::OR}, {0, 0x48, sop::SFH}, {0, 0x58, sop::ROT}, {0, 0x59, sop::ROTM}, {0, 0x5b, sop::SHL}, {0, 0x5c, sop::ROTH}, {0, 0x5d, sop::ROTHM}, {0, 0x5e, sop::ROTMAH}, {0, 0x79, sop::ROTMI}, {0, 0x7b, sop::SHLI}, {0, 0x7d, sop::ROTHMI}, {0, 0x7f, sop::SHLHI}, {0, 0xc0, sop::A}, {0, 0xc1, sop::AND}, {0, 0xc8, sop::AH}, {0, 0x144, sop::STQX}, {0, 0x1a8, sop::BI}, {0, 0x1ac, sop::HBR}, {0, 0x1b6, sop::FSMB}, {0, 0x1c4, sop::LQX}, {0, 0x1dc, sop::ROTQBY}, {0, 0x1f6, sop::CWD}, {0, 0x1fc, sop::ROTQBYI}, {0, 0x1fd, sop::ROTQMBYI}, {0, 0x1ff, sop::SHLQBYI}, {0, 0x240, sop::CGT}, {0, 0x248, sop::CGTH}, {0, 0x2b4, sop::CNTB}, {0, 0x2c0, sop::CLGT}, {0, 0x3c0, sop::CEQ}, {0, 0x3c4, sop::MPY}, {0, 0x3c6, sop::MPYHH}, {2, 0x40, sop::BRZ}, {2, 0x42, sop::BRNZ}, {2, 0x44, sop::BRHZ}, {2, 0x64, sop::BR}, {2, 0x65, sop::FSMBI}, {2, 0x66, sop::BRSL}, {2, 0x67, sop::LQR}, {2, 0x81, sop::IL}, {2, 0x83, sop::ILH}, {3, 0x4, sop::ORI}, {3, 0x5, sop::ORHI}, {3, 0xc, sop::SFI}, {3, 0xd, sop::SFHI}, {3, 0x14, sop::ANDI}, {3, 0x15, sop::ANDHI}, {3, 0x16, sop::ANDBI}, {3, 0x1c, sop::AI}, {3, 0x1d, sop::AHI}, {3, 0x24, sop::STQD}, {3, 0x34, sop::LQD}, {3, 0x4c, sop::CGTI}, {3, 0x4d, sop::CGTHI}, {3, 0x5c, sop::CLGTI}, {3, 0x74, sop::MPYI}, {3, 0x7c, sop::CEQI}, {4, 0x9, sop::HBRR}, {4, 0x21, sop::ILA}, {7, 0x8, sop::SELB}, {7, 0xb, sop::SHUFB}};
+
+	inline s32 sxb(u32 v, int bits) { v &= (1u << bits) - 1; return (v >> (bits - 1)) ? static_cast<s32>(v) - (1 << bits) : static_cast<s32>(v); }
+	inline u32 rd32be(const u8* p) { return u32{p[0]} << 24 | u32{p[1]} << 16 | u32{p[2]} << 8 | p[3]; }
+	inline u16 rd16be(const u8* p) { return static_cast<u16>(p[0] << 8 | p[1]); }
+	inline u32 rd32le(const u8* p) { return u32{p[3]} << 24 | u32{p[2]} << 16 | u32{p[1]} << 8 | p[0]; }
+	inline f32 rdf32be(const u8* p) { return std::bit_cast<f32>(rd32be(p)); }
+	inline u32 crc_name(const std::string& s) { return static_cast<u32>(crc32(0, reinterpret_cast<const Bytef*>(s.data()), static_cast<uInt>(s.size()))) ^ 0xffffffffu; }
+	inline usz pad16(usz n) { return (n + 15) & ~usz{15}; }
+
+	// ---------------------------------------------------------------- SPU interpreter
+	struct spu_vm
+	{
+		std::vector<u8> ls = std::vector<u8>(0x40000);
+		u8 r[128][16]{};
+		u32 pc = 0;
+		std::array<sop, 2048> table{};
+		u64 steps = 0;
+
+		spu_vm()
+		{
+			for (const auto& e : sop_list)
+				for (u32 i = 0; i < (1u << e.magn); i++) table[(static_cast<u32>(e.value) << e.magn) | i] = e.op;
+		}
+		u32 w(int reg, int i) const { return rd32be(r[reg] + i * 4); }
+		u16 h(int reg, int i) const { return rd16be(r[reg] + i * 2); }
+		static void sw(u8* d, int i, u32 v) { d[i * 4] = static_cast<u8>(v >> 24); d[i * 4 + 1] = static_cast<u8>(v >> 16); d[i * 4 + 2] = static_cast<u8>(v >> 8); d[i * 4 + 3] = static_cast<u8>(v); }
+		static void sh(u8* d, int i, u32 v) { d[i * 2] = static_cast<u8>(v >> 8); d[i * 2 + 1] = static_cast<u8>(v); }
+		u32 w0(int reg) const { return w(reg, 0); }
+
+		template <typename F> void words(int rt, int ra, int rb, F f) { u8 o[16]; for (int i = 0; i < 4; i++) sw(o, i, f(w(ra, i), w(rb, i))); std::memcpy(r[rt], o, 16); }
+		template <typename F> void halfs(int rt, int ra, int rb, F f) { u8 o[16]; for (int i = 0; i < 8; i++) sh(o, i, f(h(ra, i), h(rb, i))); std::memcpy(r[rt], o, 16); }
+		template <typename F> void wordsi(int rt, int ra, F f) { u8 o[16]; for (int i = 0; i < 4; i++) sw(o, i, f(w(ra, i))); std::memcpy(r[rt], o, 16); }
+		template <typename F> void halfsi(int rt, int ra, F f) { u8 o[16]; for (int i = 0; i < 8; i++) sh(o, i, f(h(ra, i))); std::memcpy(r[rt], o, 16); }
+		void splat_w(int rt, u32 v) { for (int i = 0; i < 4; i++) sw(r[rt], i, v); }
+
+		// Runs from start until pc reaches stop_pc. False on an instruction the decoder never uses or a runaway loop.
+		bool run(u32 start, u32 stop_pc)
+		{
+			pc = start;
+			while (pc != stop_pc)
+			{
+				if (++steps > 50'000'000) return false;
+				const u32 i = rd32be(ls.data() + pc);
+				const int rt = i & 0x7f, ra = (i >> 7) & 0x7f, rb = (i >> 14) & 0x7f, rt4 = (i >> 21) & 0x7f, rc = i & 0x7f;
+				const s32 i10 = sxb(i >> 14, 10), i16 = sxb(i >> 7, 16), i7 = sxb(i >> 14, 7);
+				u32 npc = (pc + 4) & 0x3fffc;
+				const auto lsq = [&](u32 a) -> u8* { return ls.data() + (a & 0x3fff0); };
+				const u32 br_t = (pc + static_cast<u32>(i16 << 2)) & 0x3fffc;
+				switch (table[i >> 21])
+				{
+				case sop::LQD: std::memcpy(r[rt], lsq(w0(ra) + static_cast<u32>(i10 << 4)), 16); break;
+				case sop::STQD: std::memcpy(lsq(w0(ra) + static_cast<u32>(i10 << 4)), r[rt], 16); break;
+				case sop::LQX: std::memcpy(r[rt], lsq(w0(ra) + w0(rb)), 16); break;
+				case sop::STQX: std::memcpy(lsq(w0(ra) + w0(rb)), r[rt], 16); break;
+				case sop::LQR: std::memcpy(r[rt], lsq(pc + static_cast<u32>(i16 << 2)), 16); break;
+				case sop::IL: splat_w(rt, static_cast<u32>(i16)); break;
+				case sop::ILH: for (int k = 0; k < 8; k++) sh(r[rt], k, (i >> 7) & 0xffff); break;
+				case sop::ILA: splat_w(rt, (i >> 7) & 0x3ffff); break;
+				case sop::FSMBI: for (int k = 0; k < 16; k++) r[rt][k] = (((i >> 7) & 0xffff) >> (15 - k)) & 1 ? 0xff : 0; break;
+				case sop::FSMB: { const u32 m = w0(ra) & 0xffff; for (int k = 0; k < 16; k++) r[rt][k] = (m >> (15 - k)) & 1 ? 0xff : 0; break; }
+				case sop::A: words(rt, ra, rb, [](u32 a, u32 b) { return a + b; }); break;
+				case sop::AH: halfs(rt, ra, rb, [](u32 a, u32 b) { return a + b; }); break;
+				case sop::SF: words(rt, ra, rb, [](u32 a, u32 b) { return b - a; }); break;
+				case sop::SFH: halfs(rt, ra, rb, [](u32 a, u32 b) { return b - a; }); break;
+				case sop::AI: wordsi(rt, ra, [&](u32 a) { return a + static_cast<u32>(i10); }); break;
+				case sop::AHI: halfsi(rt, ra, [&](u32 a) { return a + static_cast<u32>(i10); }); break;
+				case sop::SFI: wordsi(rt, ra, [&](u32 a) { return static_cast<u32>(i10) - a; }); break;
+				case sop::SFHI: halfsi(rt, ra, [&](u32 a) { return static_cast<u32>(i10) - a; }); break;
+				case sop::AND: { u8 o[16]; for (int k = 0; k < 16; k++) o[k] = r[ra][k] & r[rb][k]; std::memcpy(r[rt], o, 16); break; }
+				case sop::OR: { u8 o[16]; for (int k = 0; k < 16; k++) o[k] = r[ra][k] | r[rb][k]; std::memcpy(r[rt], o, 16); break; }
+				case sop::ANDI: wordsi(rt, ra, [&](u32 a) { return a & static_cast<u32>(i10); }); break;
+				case sop::ANDHI: halfsi(rt, ra, [&](u32 a) { return a & static_cast<u32>(i10); }); break;
+				case sop::ANDBI: { const u8 m = static_cast<u8>((i >> 14) & 0xff); for (int k = 0; k < 16; k++) r[rt][k] = r[ra][k] & m; break; }
+				case sop::ORI: wordsi(rt, ra, [&](u32 a) { return a | static_cast<u32>(i10); }); break;
+				case sop::ORHI: halfsi(rt, ra, [&](u32 a) { return a | static_cast<u32>(i10); }); break;
+				case sop::MPY: words(rt, ra, rb, [](u32 a, u32 b) { return static_cast<u32>(static_cast<s32>(static_cast<s16>(a)) * static_cast<s16>(b)); }); break;
+				case sop::MPYHH: words(rt, ra, rb, [](u32 a, u32 b) { return static_cast<u32>(static_cast<s32>(static_cast<s16>(a >> 16)) * static_cast<s16>(b >> 16)); }); break;
+				case sop::MPYI: wordsi(rt, ra, [&](u32 a) { return static_cast<u32>(static_cast<s32>(static_cast<s16>(a)) * i10); }); break;
+				case sop::SHL: words(rt, ra, rb, [](u32 a, u32 b) { const u32 n = b & 0x3f; return n < 32 ? a << n : 0u; }); break;
+				case sop::SHLI: { const u32 n = (i >> 14) & 0x3f; wordsi(rt, ra, [&](u32 a) { return n < 32 ? a << n : 0u; }); break; }
+				case sop::SHLHI: { const u32 n = (i >> 14) & 0x1f; halfsi(rt, ra, [&](u32 a) { return n < 16 ? a << n : 0u; }); break; }
+				case sop::ROT: words(rt, ra, rb, [](u32 a, u32 b) { const u32 n = b & 31; return n ? (a << n) | (a >> (32 - n)) : a; }); break;
+				case sop::ROTH: halfs(rt, ra, rb, [](u32 a, u32 b) { const u32 n = b & 15; return n ? ((a << n) | (a >> (16 - n))) & 0xffff : a; }); break;
+				case sop::ROTM: words(rt, ra, rb, [](u32 a, u32 b) { const u32 n = (0u - b) & 0x3f; return n < 32 ? a >> n : 0u; }); break;
+				case sop::ROTMI: { const u32 n = static_cast<u32>(-i7) & 0x3f; wordsi(rt, ra, [&](u32 a) { return n < 32 ? a >> n : 0u; }); break; }
+				case sop::ROTHM: halfs(rt, ra, rb, [](u32 a, u32 b) { const u32 n = (0u - b) & 0x1f; return n < 16 ? a >> n : 0u; }); break;
+				case sop::ROTHMI: { const u32 n = static_cast<u32>(-i7) & 0x1f; halfsi(rt, ra, [&](u32 a) { return n < 16 ? a >> n : 0u; }); break; }
+				case sop::ROTMAH: halfs(rt, ra, rb, [](u32 a, u32 b) { const u32 n = std::min((0u - b) & 0x1f, 15u); return static_cast<u32>(static_cast<s32>(static_cast<s16>(a)) >> n); }); break;
+				case sop::ROTQBYI: { const u32 n = (i >> 14) & 15; u8 o[16]; for (u32 k = 0; k < 16; k++) o[k] = r[ra][(k + n) & 15]; std::memcpy(r[rt], o, 16); break; }
+				case sop::ROTQBY: { const u32 n = w0(rb) & 15; u8 o[16]; for (u32 k = 0; k < 16; k++) o[k] = r[ra][(k + n) & 15]; std::memcpy(r[rt], o, 16); break; }
+				case sop::ROTQMBYI: { const u32 n = static_cast<u32>(-i7) & 0x1f; u8 o[16]; for (u32 k = 0; k < 16; k++) o[k] = k >= n ? r[ra][k - n] : 0; std::memcpy(r[rt], o, 16); break; }
+				case sop::SHLQBYI: { const u32 n = (i >> 14) & 0x1f; u8 o[16]; for (u32 k = 0; k < 16; k++) o[k] = k + n < 16 ? r[ra][k + n] : 0; std::memcpy(r[rt], o, 16); break; }
+				case sop::SHUFB:
+				{
+					u8 o[16];
+					for (int k = 0; k < 16; k++)
+					{
+						const u8 x = r[rc][k];
+						if (x & 0x80) o[k] = (x & 0xc0) == 0x80 ? 0x00 : (x & 0xe0) == 0xc0 ? 0xff : 0x80;
+						else { const u32 idx = x & 0x1f; o[k] = idx < 16 ? r[ra][idx] : r[rb][idx - 16]; }
+					}
+					std::memcpy(r[rt4], o, 16);
+					break;
+				}
+				case sop::SELB: { u8 o[16]; for (int k = 0; k < 16; k++) o[k] = static_cast<u8>((r[rc][k] & r[rb][k]) | (~r[rc][k] & r[ra][k])); std::memcpy(r[rt4], o, 16); break; }
+				case sop::CEQ: words(rt, ra, rb, [](u32 a, u32 b) { return a == b ? ~0u : 0u; }); break;
+				case sop::CEQI: wordsi(rt, ra, [&](u32 a) { return a == static_cast<u32>(i10) ? ~0u : 0u; }); break;
+				case sop::CGT: words(rt, ra, rb, [](u32 a, u32 b) { return static_cast<s32>(a) > static_cast<s32>(b) ? ~0u : 0u; }); break;
+				case sop::CGTI: wordsi(rt, ra, [&](u32 a) { return static_cast<s32>(a) > i10 ? ~0u : 0u; }); break;
+				case sop::CGTH: halfs(rt, ra, rb, [](u32 a, u32 b) { return static_cast<s16>(a) > static_cast<s16>(b) ? 0xffffu : 0u; }); break;
+				case sop::CGTHI: halfsi(rt, ra, [&](u32 a) { return static_cast<s16>(a) > i10 ? 0xffffu : 0u; }); break;
+				case sop::CLGT: words(rt, ra, rb, [](u32 a, u32 b) { return a > b ? ~0u : 0u; }); break;
+				case sop::CLGTI: wordsi(rt, ra, [&](u32 a) { return a > static_cast<u32>(i10) ? ~0u : 0u; }); break;
+				case sop::CNTB: for (int k = 0; k < 16; k++) r[rt][k] = static_cast<u8>(std::popcount(r[ra][k])); break;
+				case sop::CWD:
+				{
+					const u32 t = (w0(ra) + static_cast<u32>(i7)) & 0xc;
+					for (int k = 0; k < 16; k++) r[rt][k] = static_cast<u8>(0x10 + k);
+					for (u32 k = 0; k < 4; k++) r[rt][t + k] = static_cast<u8>(k);
+					break;
+				}
+				case sop::BR: npc = br_t; break;
+				case sop::BRSL: std::memset(r[rt], 0, 16); sw(r[rt], 0, (pc + 4) & 0x3fffc); npc = br_t; break;
+				case sop::BRZ: if (w0(rt) == 0) npc = br_t; break;
+				case sop::BRNZ: if (w0(rt) != 0) npc = br_t; break;
+				case sop::BRHZ: if ((w0(rt) & 0xffff) == 0) npc = br_t; break;
+				case sop::BI: npc = w0(ra) & 0x3fffc; break;
+				case sop::HBR: case sop::HBRR: break;
+				default: return false;
+				}
+				pc = npc;
+			}
+			return true;
+		}
+	};
+
+	// Runs the game's Edge index decompressor (job code loaded at LS 0) on one segment's compressed index stream.
+	bool edge_decompress(const std::vector<u8>& job, const u8* cfg16, const u8* stream, usz stream_size, u32 num_indexes, std::vector<u16>& out)
+	{
+		spu_vm vm;
+		if (job.size() > 0x3c000) return false;
+		std::memcpy(vm.ls.data(), job.data(), job.size());
+		constexpr u32 ls_in = 0x20000, ls_ctx = 0x30000;
+		if (stream_size > 0xff00) return false;
+		std::memcpy(vm.ls.data() + ls_in, stream, stream_size);
+		std::memcpy(vm.ls.data() + ls_ctx, cfg16, 16);
+		vm.ls[ls_ctx + 0x190] = static_cast<u8>(num_indexes >> 8);
+		vm.ls[ls_ctx + 0x191] = static_cast<u8>(num_indexes);
+		spu_vm::sw(vm.ls.data() + ls_ctx + 0x17c, 0, 0x2ff00);
+		spu_vm::sw(vm.r[1], 0, 0x3e000);   // stack
+		spu_vm::sw(vm.r[0], 0, 0x3fff0);   // return address: stop here
+		spu_vm::sw(vm.r[3], 0, ls_ctx);
+		spu_vm::sw(vm.r[4], 0, ls_in);
+		if (!vm.run(0x6e60, 0x3fff0)) { if (std::getenv("OUVR_CHEF_DEBUG")) std::fprintf(stderr, "edge: stopped at %05x (%08x) after %llu steps\n", vm.pc, rd32be(vm.ls.data() + vm.pc), static_cast<unsigned long long>(vm.steps)); return false; }
+		const u32 at = rd32be(vm.ls.data() + ls_ctx + 0x50);
+		if (at + num_indexes * 2 > vm.ls.size()) return false;
+		out.resize(num_indexes);
+		for (u32 k = 0; k < num_indexes; k++) out[k] = rd16be(vm.ls.data() + at + k * 2);
+		return true;
+	}
+
+	// ---------------------------------------------------------------- Chef.wad
+	struct wad_entry { u32 off = 0, size = 0; };
+	struct wad_reader
+	{
+		fs::file f;
+		std::unordered_map<u32, wad_entry> table;   // outer files
+
+		static void parse_table(const u8* b, usz len, std::unordered_map<u32, wad_entry>& out, u32& table_size, u32& compressed)
+		{
+			out.clear();
+			if (len < 0x30 || std::memcmp(b, "0DAW", 4) != 0) return;
+			const u32 n = rd32le(b + 8);
+			table_size = rd32le(b + 12);
+			compressed = rd32le(b + 20);
+			if (0x30 + usz{n} * 16 > len) return;
+			const u8* hs = b + 0x30;
+			const u8* ls = b + 0x30 + usz{n} * 8;
+			for (u32 i = 0; i < n; i++)
+			{
+				const u32 hash = rd32le(hs + i * 8), idx = rd32le(hs + i * 8 + 4);
+				if (idx < n) out[hash] = {rd32le(ls + idx * 8), rd32le(ls + idx * 8 + 4)};
+			}
+		}
+
+		bool open(const std::string& path)
+		{
+			if (!f.open(path)) return false;
+			std::vector<u8> head(0x30);
+			if (f.read(head.data(), head.size()) != head.size() || std::memcmp(head.data(), "0DAW", 4) != 0) return false;
+			const u32 tsize = rd32le(head.data() + 12);
+			std::vector<u8> t(tsize);
+			f.seek(0);
+			if (f.read(t.data(), t.size()) != t.size()) return false;
+			u32 ts = 0, comp = 0;
+			parse_table(t.data(), t.size(), table, ts, comp);
+			return !table.empty();
+		}
+
+		// A nested WAD's file table only (cheap: reads its header)
+		bool nested_table(u32 hash, std::unordered_map<u32, wad_entry>& out)
+		{
+			const auto it = table.find(hash);
+			if (it == table.end()) return false;
+			std::vector<u8> head(0x30);
+			f.seek(it->second.off);
+			if (f.read(head.data(), head.size()) != head.size() || std::memcmp(head.data(), "0DAW", 4) != 0) return false;
+			const u32 tsize = rd32le(head.data() + 12);
+			if (tsize > it->second.size) return false;
+			std::vector<u8> t(tsize);
+			f.seek(it->second.off);
+			if (f.read(t.data(), t.size()) != t.size()) return false;
+			u32 ts = 0, comp = 0;
+			parse_table(t.data(), t.size(), out, ts, comp);
+			return true;
+		}
+
+		// One file from inside a nested WAD
+		bool nested_file(u32 wad_hash, u32 file_hash, std::vector<u8>& out)
+		{
+			const auto it = table.find(wad_hash);
+			if (it == table.end()) return false;
+			std::vector<u8> b(it->second.size);
+			f.seek(it->second.off);
+			if (f.read(b.data(), b.size()) != b.size()) return false;
+			std::unordered_map<u32, wad_entry> inner;
+			u32 tsize = 0, comp = 0;
+			parse_table(b.data(), b.size(), inner, tsize, comp);
+			const auto fe = inner.find(file_hash);
+			if (fe == inner.end() || fe->second.off < tsize) return false;
+			std::vector<u8> body;
+			if (comp)
+			{
+				uLongf len = rd32le(b.data() + 24);
+				body.resize(len);
+				if (uncompress(body.data(), &len, b.data() + tsize, static_cast<uLong>(b.size() - tsize)) != Z_OK) return false;
+				body.resize(len);
+			}
+			else body.assign(b.begin() + tsize, b.end());
+			const usz start = fe->second.off - tsize;
+			if (start + fe->second.size > body.size()) return false;
+			out.assign(body.begin() + start, body.begin() + start + fe->second.size);
+			return true;
+		}
+
+		// Finds which nested WAD holds a file
+		u32 find_file(u32 file_hash, std::initializer_list<u32> likely)
+		{
+			std::unordered_map<u32, wad_entry> inner;
+			for (u32 w : likely) if (nested_table(w, inner) && inner.count(file_hash)) return w;
+			for (const auto& [w, e] : table)
+			{
+				if (e.size < 0x30) continue;
+				if (nested_table(w, inner) && inner.count(file_hash)) return w;
+			}
+			return 0;
+		}
+	};
+
+	// ---------------------------------------------------------------- The chef mesh
+	enum part : u8
+	{
+		P_BODY, P_HEAD, P_LEG_L, P_LEG_R,
+		P_UA_L, P_FA_L, P_HAND_L, P_FING_L,   // left arm (the chef's left = +x in the model)
+		P_UA_R, P_FA_R, P_HAND_R, P_FING_R,
+		P_THUMB_L, P_THUMB_R,
+		P_FOOT_L, P_FOOT_R,     // below the knee: shin and foot
+		P_COUNT
+	};
+
+	struct vtx { vec3 p, n; f32 u, v; u8 part[4]; f32 w[4]; };
+
+	struct model
+	{
+		bool ok = false;
+		bool female = false;
+		std::vector<vtx> v;
+		std::vector<u32> idx;
+		std::vector<u8> rgba;              // 1024x1024 body texture
+		u32 tw = 0, th = 0;
+		f32 arm_y = 0.83f, arm_z = 0.09f, arm_tip = 0.96f, eye_y = 1.45f, face_z = 0.29f, top_y = 1.9f, belly_z = 0.3f;
+		vec3 shoulder[2]{}, elbow[2]{}, wrist[2]{}, knuckle[2]{}, thumb[2]{}, neck{};   // [0] left (+x), [1] right (-x)
+		f32 hand_scale = 1.f;              // the cartoon hands are shrunk towards a real hand's size, so they fit around the controller
+		f32 hip_y = 0.36f, knee_y = 0.17f; // leg joints (the chef's short legs)
+		// The face: small parts drawn with their own pictures (transparent around the shape)
+		// M_HEAD: the body picture's triangles on the head (hidden in first person, seen in the mirror)
+		enum { M_BODY, M_EYES, M_MOUTH, M_BROWS, M_HEAD, M_COUNT };
+		u32 range_start[M_COUNT]{}, range_count[M_COUNT]{};
+		std::vector<u8> face_rgba[3];      // eyes open, eyes closed (blink), brows/hair
+		u32 face_size[3]{};
+		std::vector<std::vector<u8>> mouth_rgba;   // mouth pictures: [0] closed, then more and more open (talking)
+		u32 mouth_size = 0;
+		u32 mouth_v0 = 0, mouth_v1 = 0;            // the mouth's vertices (opened by stretching when there is one picture)
+		std::string error;
+	};
+
+	// DXT5 (BC3) -> RGBA8, little-endian blocks like the body texture
+	void decode_dxt5(const u8* d, u32 w, u32 h, std::vector<u8>& out)
+	{
+		out.assign(usz{w} * h * 4, 0);
+		usz p = 0;
+		for (u32 by = 0; by < h; by += 4)
+			for (u32 bx = 0; bx < w; bx += 4, p += 16)
+			{
+				const u8* a = d + p;
+				u8 al[8];
+				al[0] = a[0]; al[1] = a[1];
+				if (al[0] > al[1]) for (int k = 1; k < 7; k++) al[k + 1] = static_cast<u8>(((7 - k) * al[0] + k * al[1]) / 7);
+				else { for (int k = 1; k < 5; k++) al[k + 1] = static_cast<u8>(((5 - k) * al[0] + k * al[1]) / 5); al[6] = 0; al[7] = 255; }
+				u64 abits = 0;
+				for (int k = 0; k < 6; k++) abits |= u64{a[2 + k]} << (8 * k);
+				const u8* c = d + p + 8;
+				const u32 c0 = c[0] | c[1] << 8, c1 = c[2] | c[3] << 8;
+				const u32 bits = c[4] | c[5] << 8 | c[6] << 16 | static_cast<u32>(c[7]) << 24;
+				u8 pal[4][3];
+				const auto ex = [](u32 v, u8* o) { o[0] = static_cast<u8>(((v >> 11) & 31) * 255 / 31); o[1] = static_cast<u8>(((v >> 5) & 63) * 255 / 63); o[2] = static_cast<u8>((v & 31) * 255 / 31); };
+				ex(c0, pal[0]); ex(c1, pal[1]);
+				for (int k = 0; k < 3; k++) { pal[2][k] = static_cast<u8>((2 * pal[0][k] + pal[1][k]) / 3); pal[3][k] = static_cast<u8>((pal[0][k] + 2 * pal[1][k]) / 3); }
+				for (u32 i = 0; i < 16; i++)
+				{
+					const u32 x = bx + i % 4, y = by + i / 4;
+					if (x >= w || y >= h) continue;
+					u8* o = &out[(usz{y} * w + x) * 4];
+					const u32 sel = (bits >> (2 * i)) & 3;
+					o[0] = pal[sel][0]; o[1] = pal[sel][1]; o[2] = pal[sel][2];
+					o[3] = al[(abits >> (3 * i)) & 7];
+				}
+			}
+	}
+
+	// DXT1 (BC1) 1024x1024 -> RGBA8
+	void decode_dxt1(const u8* d, u32 w, u32 h, std::vector<u8>& out)
+	{
+		out.assign(usz{w} * h * 4, 255);
+		usz p = 0;
+		for (u32 by = 0; by < h; by += 4)
+			for (u32 bx = 0; bx < w; bx += 4, p += 8)
+			{
+				const u32 c0 = d[p] | d[p + 1] << 8, c1 = d[p + 2] | d[p + 3] << 8;
+				const u32 bits = rd32le(d + p + 4);
+				u8 pal[4][3];
+				const auto ex = [](u32 c, u8* o) { o[0] = static_cast<u8>(((c >> 11) & 31) * 255 / 31); o[1] = static_cast<u8>(((c >> 5) & 63) * 255 / 63); o[2] = static_cast<u8>((c & 31) * 255 / 31); };
+				ex(c0, pal[0]); ex(c1, pal[1]);
+				for (int k = 0; k < 3; k++)
+				{
+					if (c0 > c1) { pal[2][k] = static_cast<u8>((2 * pal[0][k] + pal[1][k]) / 3); pal[3][k] = static_cast<u8>((pal[0][k] + 2 * pal[1][k]) / 3); }
+					else { pal[2][k] = static_cast<u8>((pal[0][k] + pal[1][k]) / 2); pal[3][k] = 0; }
+				}
+				for (u32 i = 0; i < 16; i++)
+				{
+					const u32 sel = (bits >> (2 * i)) & 3;
+					u8* o = &out[((by + i / 4) * w + bx + i % 4) * 4];
+					o[0] = pal[sel][0]; o[1] = pal[sel][1]; o[2] = pal[sel][2]; o[3] = 255;
+				}
+			}
+	}
+
+	// Builds the mesh from a model blob (Edge segments) using the game's own decoder
+	bool build_mesh(model& m, const std::vector<u8>& B, const std::vector<u8>& job)
+	{
+		m.v.clear(); m.idx.clear();
+		std::vector<u32> idx_by[model::M_COUNT];
+		struct seg_bones { u32 base = 0, nv = 0; bool face = false; std::vector<u8> lbone; std::map<u8, vec3> centroid; };
+		std::vector<seg_bones> segs;
+		for (usz s = 0; s + 0x40 < B.size(); s += 4)
+		{
+			if (B[s] != 0x83 || B[s + 6] != 0x33) continue;
+			const u32 nv = rd16be(&B[s + 8]), ni = rd16be(&B[s + 10]);
+			if (nv < 4 || nv > 4000 || ni % 3 || ni == 0 || ni > 20000) continue;
+			// The face's small parts have their own pictures: eyes (8 vertices), mouth (21), eyebrows and hair (16)
+			const int mat = nv == 8 ? model::M_EYES : nv == 21 ? model::M_MOUTH : nv == 16 ? model::M_BROWS : model::M_BODY;
+			const bool face_part = nv < 100;   // eyes, mouth, brows, nose, chin: all follow the head
+			const u32 isz = rd16be(&B[s + 20]);
+			const u32 tris = ni / 3;
+			std::vector<u16> ix;
+			usz st = 0;
+			for (usz o = s + 16; o + 8 < B.size() && o < s + 0x20000; o += 16)
+			{
+				const u32 n = rd16be(&B[o]), X = rd16be(&B[o + 4]), bits = B[o + 6];
+				if (bits > 16 || X == 0 || X > 4096) continue;
+				const usz tot = 8 + X + (tris * 2 + 7) / 8 + (usz{n} * bits + 7) / 8;
+				if (pad16(tot) != isz || n > ni) continue;
+				if (o + isz > B.size()) break;
+				std::vector<u16> cand;
+				if (!edge_decompress(job, &B[s], &B[o], isz, ni, cand)) continue;
+				u16 mx = 0;
+				for (u16 c : cand) mx = std::max(mx, c);
+				if (mx + 1u != nv) continue;
+				ix = std::move(cand);
+				st = o;
+				break;
+			}
+			if (ix.empty()) continue;
+			const usz po = st + isz;
+			const usz sec = po + pad16(usz{nv} * 12), rsx = sec + pad16(usz{nv} * 24);
+			if (rsx + usz{nv} * 24 > B.size()) continue;
+			// Skin weights: (weight, bone) x 4 per vertex, weights add up to 255
+			usz wo = 0;
+			const usz wstart = rsx + pad16(usz{nv} * 24);
+			for (usz o = wstart; o + usz{nv} * 8 <= B.size() && o < wstart + 0x1000; o += 16)
+			{
+				bool good = true;
+				for (u32 k = 0; k < nv && good; k++) good = B[o + k * 8] + B[o + k * 8 + 2] + B[o + k * 8 + 4] + B[o + k * 8 + 6] == 255;
+				if (good) { wo = o; break; }
+			}
+			if (!wo) continue;
+			const u32 base = static_cast<u32>(m.v.size());
+			if (mat == model::M_MOUTH) { m.mouth_v0 = base; m.mouth_v1 = base + nv; }
+			std::vector<u8> lbone(nv * 4);
+			for (u32 k = 0; k < nv; k++)
+			{
+				vtx x{};
+				x.p = {rdf32be(&B[po + k * 12]), rdf32be(&B[po + k * 12 + 4]), rdf32be(&B[po + k * 12 + 8])};
+				x.n = normalize(vec3{rdf32be(&B[sec + k * 24]), rdf32be(&B[sec + k * 24 + 4]), rdf32be(&B[sec + k * 24 + 8])});
+				x.u = rdf32be(&B[rsx + k * 24 + 16]);
+				x.v = rdf32be(&B[rsx + k * 24 + 20]);
+				for (int j = 0; j < 4; j++) { x.w[j] = B[wo + k * 8 + j * 2] / 255.f; lbone[k * 4 + j] = B[wo + k * 8 + j * 2 + 1]; }
+				if (mat != model::M_BODY) x.p = x.p + x.n * 0.004f;   // face pictures sit just on the skin (no flicker)
+				m.v.push_back(x);
+			}
+			// Classify this segment's local bones by where their vertices are
+			std::map<u8, std::pair<vec3, f32>> acc;
+			for (u32 k = 0; k < nv; k++)
+				for (int j = 0; j < 4; j++)
+				{
+					const f32 wt = m.v[base + k].w[j];
+					if (wt <= 0.f) continue;
+					auto& a = acc[lbone[k * 4 + j]];
+					a.first = a.first + m.v[base + k].p * wt;
+					a.second += wt;
+				}
+			{
+				seg_bones sb;
+				sb.base = base;
+				sb.nv = nv;
+				sb.face = face_part;
+				sb.lbone = std::move(lbone);
+				for (const auto& [b, a] : acc) sb.centroid[b] = a.first * (1.f / std::max(a.second, 1e-6f));
+				segs.push_back(std::move(sb));
+			}
+			// Triangles, wound so their front faces point outwards (along the stored normals)
+			for (u32 t = 0; t + 2 < ix.size(); t += 3)
+			{
+				u32 a = base + ix[t], b = base + ix[t + 1], c = base + ix[t + 2];
+				const vec3 fn = cross(m.v[b].p - m.v[a].p, m.v[c].p - m.v[a].p);
+				if (dot(fn, m.v[a].n + m.v[b].n + m.v[c].n) < 0.f) std::swap(b, c);
+				idx_by[mat].insert(idx_by[mat].end(), {a, b, c});
+			}
+		}
+		if (m.v.empty()) { m.error = "no chef geometry decoded"; return false; }
+
+
+		// Proportions and joints from the T pose
+		f32 ymax = 0.f, armsum = 0.f, zsum = 0.f, tip = 0.f;
+		int armn = 0;
+		for (const auto& x : m.v)
+		{
+			ymax = std::max(ymax, x.p.y);
+			if (std::fabs(x.p.x) > 0.5f && std::fabs(x.p.y - 0.83f) < 0.2f) { armsum += x.p.y; zsum += x.p.z; armn++; tip = std::max(tip, std::fabs(x.p.x)); }
+		}
+		m.top_y = ymax;
+		if (armn) { m.arm_y = armsum / armn; m.arm_z = zsum / armn; }
+		m.arm_tip = tip > 0.6f ? tip : 0.96f;
+		f32 fz = 0.f;
+		for (const auto& x : m.v)
+			if (std::fabs(x.p.y - m.eye_y) < 0.08f && std::fabs(x.p.x) < 0.08f) fz = std::max(fz, x.p.z);
+		m.face_z = fz > 0.1f ? fz : 0.29f;
+		// Bones by where their vertices are in the T pose. The arms are horizontal. Both chefs have a hand bone, a two-bone
+		// thumb (forward of and below the palm) and two two-bone fingers; the male chef's hands are much bigger, so the
+		// joints are placed in proportion to this chef's own arm length.
+		const f32 hand_tip = m.arm_tip;
+		const bool dbg = std::getenv("OUVR_CHEF_DEBUG") != nullptr;
+		const f32 elbow_x = 0.20f + (hand_tip - 0.20f) * 0.30f, wrist_x = 0.20f + (hand_tip - 0.20f) * 0.55f;
+		f32 knuck_x[2] = {hand_tip, hand_tip};
+		vec3 thumb_c[2]{};
+		f32 thumb_x[2] = {9.f, 9.f};
+		for (const auto& sb : segs)
+		{
+			std::map<u8, u8> cls;
+			for (const auto& [b, c] : sb.centroid)
+			{
+				const f32 ax = std::fabs(c.x);
+				const int side = c.x >= 0.f ? 0 : 1;
+				u8 pc = P_BODY;
+				if (std::fabs(c.y - m.arm_y) < 0.14f && ax > 0.17f)
+				{
+					if (ax < elbow_x) pc = side ? P_UA_R : P_UA_L;
+					else if (ax < wrist_x) pc = side ? P_FA_R : P_FA_L;
+					else if (c.y < m.arm_y - 0.025f && c.z > m.arm_z + 0.05f)
+					{
+						pc = side ? P_THUMB_R : P_THUMB_L;
+						if (ax < thumb_x[side]) { thumb_x[side] = ax; thumb_c[side] = c; }
+					}
+					else if (ax > hand_tip - 0.16f)
+					{
+						pc = side ? P_FING_R : P_FING_L;
+						knuck_x[side] = std::min(knuck_x[side], ax);
+					}
+					else pc = side ? P_HAND_R : P_HAND_L;
+				}
+				else if (c.y > 1.05f) pc = P_HEAD;
+				else if (c.y < 0.33f && ax > 0.05f) pc = side ? P_LEG_R : P_LEG_L;
+				if (sb.face) pc = P_HEAD;   // the face's own parts (and the chin) turn with the head
+				cls[b] = pc;
+				if (dbg && ax > 0.5f) std::fprintf(stderr, "bone seg %u b %u -> part %u centroid %.3f %.3f %.3f\n", sb.base, b, pc, c.x, c.y, c.z);
+			}
+			for (u32 k2 = 0; k2 < sb.nv; k2++)
+				for (int j = 0; j < 4; j++)
+				{
+					const auto it = cls.find(sb.lbone[k2 * 4 + j]);
+					m.v[sb.base + k2].part[j] = it != cls.end() ? it->second : P_BODY;
+				}
+		}
+		for (int sd = 0; sd < 2; sd++)
+		{
+			const f32 sx = sd == 0 ? 1.f : -1.f;
+			m.shoulder[sd] = {sx * 0.20f, m.arm_y, m.arm_z};
+			m.elbow[sd] = {sx * elbow_x, m.arm_y, m.arm_z};
+			m.wrist[sd] = {sx * wrist_x, m.arm_y, m.arm_z};
+			m.knuckle[sd] = {sx * (std::min(knuck_x[sd], hand_tip - 0.10f) - 0.03f), m.arm_y, m.arm_z};
+			m.thumb[sd] = thumb_x[sd] < 5.f ? vec3{sx * (thumb_x[sd] - 0.03f), thumb_c[sd].y, thumb_c[sd].z} : vec3{sx * (wrist_x + 0.08f), m.arm_y - 0.03f, m.arm_z + 0.08f};
+		}
+		m.hand_scale = std::clamp(0.24f / std::max(hand_tip - wrist_x, 0.05f), 0.4f, 1.f);
+		if (dbg) std::fprintf(stderr, "joints: elbow %.3f wrist %.3f knuckle %.3f thumb %.3f %.3f %.3f tip %.3f hand scale %.2f arm y %.3f z %.3f\n",
+			elbow_x, wrist_x, m.knuckle[0].x, m.thumb[0].x, m.thumb[0].y, m.thumb[0].z, hand_tip, m.hand_scale, m.arm_y, m.arm_z);
+		// First person: your eyes sit just in front of the chef's belly, so looking down shows the jacket
+		f32 bz = 0.f;
+		for (const auto& x : m.v)
+			if (x.p.y > 0.45f && x.p.y < 1.25f && std::fabs(x.p.x) < 0.25f) bz = std::max(bz, x.p.z);
+		m.belly_z = bz > 0.1f ? bz : m.face_z;
+		m.neck = {0.f, m.arm_y + 0.30f, 0.f};
+		// Knees: the part of each leg below the knee bends on its own
+		{
+			f32 lo = 1e9f, hi = -1e9f;
+			for (const auto& x : m.v)
+				if (x.part[0] == P_LEG_L || x.part[0] == P_LEG_R) { lo = std::min(lo, x.p.y); hi = std::max(hi, x.p.y); }
+			if (hi > lo)
+			{
+				m.hip_y = hi;
+				m.knee_y = lo + (hi - lo) * 0.5f;
+				for (auto& x : m.v)
+					if (x.p.y < m.knee_y)
+						for (int j = 0; j < 4; j++)
+						{
+							if (x.part[j] == P_LEG_L) x.part[j] = P_FOOT_L;
+							else if (x.part[j] == P_LEG_R) x.part[j] = P_FOOT_R;
+						}
+			}
+		}
+		// Head triangles (all three corners on the head) go to their own range: hidden in first person
+		{
+			std::vector<u32> body, head;
+			const auto& src = idx_by[model::M_BODY];
+			for (usz t = 0; t + 2 < src.size(); t += 3)
+			{
+				const bool h = m.v[src[t]].part[0] == P_HEAD && m.v[src[t + 1]].part[0] == P_HEAD && m.v[src[t + 2]].part[0] == P_HEAD;
+				auto& dst = h ? head : body;
+				dst.insert(dst.end(), {src[t], src[t + 1], src[t + 2]});
+			}
+			idx_by[model::M_BODY] = std::move(body);
+			idx_by[model::M_HEAD] = std::move(head);
+		}
+		for (int k = 0; k < model::M_COUNT; k++)
+		{
+			m.range_start[k] = static_cast<u32>(m.idx.size());
+			m.range_count[k] = static_cast<u32>(idx_by[k].size());
+			m.idx.insert(m.idx.end(), idx_by[k].begin(), idx_by[k].end());
+		}
+		m.ok = true;
+		return true;
+	}
+
+	// The chef's 1024x1024 DXT1 body texture, straight from Chef.wad (also used to find out which chef the game uses)
+	bool texture_bytes(const std::string& usrdir, bool female, std::vector<u8>& tex)
+	{
+		wad_reader w;
+		if (!w.open(usrdir + "Chef.wad")) return false;
+		const u32 tex_file = crc_name(fmt::format("images/imgdat/%08x.imgdat.ps3", female ? 0xa486983bu : 0xd9e02c46u));
+		const u32 tw = w.find_file(tex_file, female ? std::initializer_list<u32>{0xf4b0efb0, 0x2a2adcb1} : std::initializer_list<u32>{0x311c75b9, 0x2a2adcb1});
+		return tw && w.nested_file(tw, tex_file, tex) && tex.size() == 1024 * 1024 / 2;
+	}
+
+	// The SPU job with the Edge index decoder, from the game's own SPRX, decrypted with RPCS3's code
+	bool load_job(const std::string& usrdir, std::vector<u8>& job, std::string& err)
+	{
+		fs::file sprx(usrdir + "spurs/spu_codef.ppu.sprx");
+		if (!sprx) { err = "spu_codef.ppu.sprx not found"; return false; }
+		fs::file elf = decrypt_self(sprx);
+		if (!elf) { err = "could not decrypt spu_codef.ppu.sprx"; return false; }
+		std::vector<u8> e = elf.to_vector<u8>();
+		if (e.size() < 0x40 || std::memcmp(e.data(), "\x7f" "ELF", 4) != 0) { err = "spu_codef: not an ELF"; return false; }
+		// ELF64 big-endian: first program header gives the job image
+		const u64 phoff = u64{rd32be(&e[0x20])} << 32 | rd32be(&e[0x24]);
+		if (phoff + 56 > e.size()) { err = "spu_codef: bad program header"; return false; }
+		const u64 off = u64{rd32be(&e[phoff + 8])} << 32 | rd32be(&e[phoff + 12]);
+		const u64 fsz = u64{rd32be(&e[phoff + 32])} << 32 | rd32be(&e[phoff + 36]);
+		if (off + fsz > e.size() || fsz < 0x7000) { err = "spu_codef: bad segment"; return false; }
+		job.assign(e.begin() + off + 0x100, e.begin() + off + fsz);   // the job image starts 0x100 into the segment
+		// The decoder entry we call must be the one this mod was built against
+		if (job.size() < 0x6e64 || rd32be(&job[0x6e60]) != 0x34064185) { err = "spu_codef: unexpected Edge version"; return false; }
+		return true;
+	}
+
+	// Everything needed from the game's files: Chef.wad and the SPU job with the Edge decoder.
+	bool load(model& m, const std::string& usrdir, bool female)
+	{
+		m = {};
+		m.female = female;
+		std::vector<u8> job;
+		if (!load_job(usrdir, job, m.error)) return false;
+		wad_reader w;
+		if (!w.open(usrdir + "Chef.wad")) { m.error = "Chef.wad not readable"; return false; }
+		// Model files and the body texture (texture files are named images/imgdat/<hash>.imgdat.ps3)
+		const u32 model_file = female ? 0xb4162e7e : 0xc3572b34;
+		const u32 tex_file = crc_name(fmt::format("images/imgdat/%08x.imgdat.ps3", female ? 0xa486983bu : 0xd9e02c46u));
+		const u32 mw = w.find_file(model_file, female ? std::initializer_list<u32>{0x3dc1261e, 0x6ce6f2f7} : std::initializer_list<u32>{0xdfaab736});
+		std::vector<u8> blob, tex;
+		if (!mw || !w.nested_file(mw, model_file, blob)) { m.error = "chef model not found"; return false; }
+		const u32 tw = w.find_file(tex_file, female ? std::initializer_list<u32>{0xf4b0efb0, 0x2a2adcb1} : std::initializer_list<u32>{0x311c75b9, 0x2a2adcb1});
+		if (tw && w.nested_file(tw, tex_file, tex) && tex.size() == 1024 * 1024 / 2)
+		{
+			decode_dxt1(tex.data(), 1024, 1024, m.rgba);
+			m.tw = m.th = 1024;
+		}
+		// Face pictures (DXT5, transparent around the shape), from the same material list as the body
+		{
+			const auto picture = [&](u32 name, u32 size, std::vector<u8>& out) -> bool
+			{
+				const u32 fh = crc_name(fmt::format("images/imgdat/%08x.imgdat.ps3", name));
+				const u32 fw = w.find_file(fh, female ? std::initializer_list<u32>{0xf4b0efb0, 0x2a2adcb1} : std::initializer_list<u32>{0x311c75b9, 0x2a2adcb1});
+				std::vector<u8> raw;
+				const usz need = usz{size} * size;
+				if (!fw || !w.nested_file(fw, fh, raw) || raw.size() < need) return false;
+				decode_dxt5(raw.data() + (raw.size() - need), size, size, out);
+				return true;
+			};
+			const u32 names_f[3] = {0xf7a0875a, 0x353348f2, 0xed624c71};   // eyes open, eyes closed, brows/hair
+			const u32 names_m[3] = {0x86731279, 0xe20c7ac9, 0x23ab3ec8};
+			const u32 sizes[3] = {64, 64, 256};
+			for (int k = 0; k < 3; k++) if (picture(female ? names_f[k] : names_m[k], sizes[k], m.face_rgba[k])) m.face_size[k] = sizes[k];
+			// Mouth: closed first, then more and more open. The female chef has one picture (her lips).
+			// Closed first, then more and more open. The female chef's closed mouth is her lips; talking uses the
+			// game's mouth shapes (the male chef's set, the only talking set in the game files)
+			const std::vector<u32> mouths = female ? std::vector<u32>{0xcdced3b7, 0x8873fb45, 0xb3bc8a6a, 0xf4f6cdca} : std::vector<u32>{0x01549426, 0x8873fb45, 0xb3bc8a6a, 0xf4f6cdca};
+			for (u32 h : mouths)
+			{
+				std::vector<u8> px;
+				const u32 fh = crc_name(fmt::format("images/imgdat/%08x.imgdat.ps3", h));
+				// the male shapes live in the male chef's packages: look everywhere
+				const u32 fw = w.find_file(fh, female ? std::initializer_list<u32>{0xf4b0efb0, 0x2a2adcb1, 0x311c75b9} : std::initializer_list<u32>{0x311c75b9, 0x2a2adcb1});
+				std::vector<u8> raw;
+				if (fw && w.nested_file(fw, fh, raw) && raw.size() >= 65536) { decode_dxt5(raw.data() + (raw.size() - 65536), 256, 256, px); m.mouth_rgba.push_back(std::move(px)); }
+			}
+			if (!m.mouth_rgba.empty()) m.mouth_size = 256;
+		}
+		if (std::getenv("OUVR_CHEF_DEBUG"))
+		{
+			int segs = 0;
+			for (usz s = 0; s + 0x40 < blob.size(); s += 4) if (blob[s] == 0x83 && blob[s + 6] == 0x33) segs++;
+			std::fprintf(stderr, "model wad %08x, blob %zu bytes, first %08x, %d segment headers; job %zu bytes\n", mw, blob.size(), blob.size() >= 4 ? rd32be(blob.data()) : 0, segs, job.size());
+		}
+		return build_mesh(m, blob, job);
+	}
+
+	// ---------------------------------------------------------------- Posing
+	// The chef's pose: everything in world space (metres).
+	struct pose_in
+	{
+		vec3 head;                 // eye centre
+		XrQuaternionf head_q{0, 0, 0, 1};
+		f32 body_yaw = 0.f;        // the body faces (-sin, 0, -cos)
+		f32 floor_y = 0.f;
+		f32 scale = 1.f;
+		bool hand_valid[2]{};
+		XrPosef hand[2]{};         // controller grip poses: [0] left, [1] right
+		f32 grip[2]{}, trig[2]{};
+		f32 walk_phase = 0.f, walk_amount = 0.f;   // stepping: phase (radians) and how much (0 standing .. 1 walking)
+		f32 mouth = 0.f;                           // 0 closed .. 1 wide open (your voice)
+		f32 own_shoulders = 0.f;                   // 0: the arms hang from your own shoulders (first person); 1: from the
+		                                           // chef's (the plain diner's mirror, where you see the whole chef)
+	};
+
+	// A person's upper arm (shoulder to elbow) and forearm (elbow to wrist), per metre of eye height
+	constexpr f32 upper_arm_per_eye = 0.199f, forearm_per_eye = 0.156f;
+
+	// Where your own shoulder is (world, metres), worked out from your eyes: your neck is a little below and behind your
+	// eyes (it stays there when you look down or lean), your shoulders are out to its sides, facing where your body
+	// faces. eye_m: your eye height in metres (the size of everything else). sd: 0 left, 1 right.
+	vec3 real_shoulder(vec3 head, XrQuaternionf head_q, f32 body_yaw, f32 eye_m, int sd)
+	{
+		const f32 k = std::clamp(eye_m / 1.6f, 0.7f, 1.3f);
+		const vec3 neck = head - rotate(head_q, vec3{0.f, 0.10f, -0.08f}) * k;   // your eyes: 10 cm above, 8 cm in front of it
+		const vec3 fb{-std::sin(body_yaw), 0.f, -std::cos(body_yaw)};
+		const vec3 rb{-fb.z, 0.f, fb.x};
+		const f32 side = sd == 0 ? -1.f : 1.f;
+		return neck + vec3{0.f, -0.13f * k, 0.f} + rb * (side * 0.17f * k) - fb * (0.02f * k);
+	}
+
+	struct rigid { vec3 c0, c1; XrQuaternionf q{0, 0, 0, 1}; vec3 stretch_dir; f32 stretch = 1.f; f32 scale = 1.f; };
+
+	XrQuaternionf q_from_to(vec3 a, vec3 b)
+	{
+		a = normalize(a); b = normalize(b);
+		const f32 d = dot(a, b);
+		if (d < -0.9999f) { const vec3 ax = normalize(std::fabs(a.x) < 0.9f ? cross(a, {1, 0, 0}) : cross(a, {0, 1, 0})); return {ax.x, ax.y, ax.z, 0.f}; }
+		const vec3 c = cross(a, b);
+		return qnorm({c.x, c.y, c.z, 1.f + d});
+	}
+
+	// Rotation that maps the frame (f0, n0) onto (f1, n1)
+	XrQuaternionf q_frames(vec3 f0, vec3 n0, vec3 f1, vec3 n1)
+	{
+		const XrQuaternionf q1 = q_from_to(f0, f1);
+		const vec3 n0r = rotate(q1, n0);
+		// twist about f1 so n0r lines up with n1 (projected)
+		const vec3 a = normalize(n0r - f1 * dot(n0r, f1)), b = normalize(n1 - f1 * dot(n1, f1));
+		const f32 ang = std::atan2(dot(cross(a, b), f1), dot(a, b));
+		const XrQuaternionf tw{f1.x * std::sin(ang * 0.5f), f1.y * std::sin(ang * 0.5f), f1.z * std::sin(ang * 0.5f), std::cos(ang * 0.5f)};
+		return qnorm(qmul(tw, q1));
+	}
+
+	// Per-part transforms: world = c1 + q * stretch(R_root * s * (p - c0))
+	void solve(const model& m, const pose_in& in, rigid out[P_COUNT], vec3& root, XrQuaternionf& rq)
+	{
+		const f32 s = in.scale;
+		rq = yaw_q(in.body_yaw + 3.14159265f);   // model +z -> where the body faces
+		const vec3 eye_m{0.f, m.eye_y, std::max(m.face_z, m.belly_z) + 0.10f};
+		root = in.head - rotate(rq, eye_m * s);
+		const auto W = [&](vec3 p) { return root + rotate(rq, p * s); };
+		for (int i = 0; i < P_COUNT; i++) out[i] = {{0, 0, 0}, root, rq, {0, 1, 0}, 1.f};
+		// Head turns with yours, about the neck
+		{
+			const XrQuaternionf rel = qnorm(qmul(in.head_q, qconj(yaw_q(in.body_yaw))));
+			out[P_HEAD] = {m.neck, W(m.neck), qnorm(qmul(rel, rq)), {0, 1, 0}, 1.f};
+		}
+		// Walking: each thigh swings about its hip; the knee bends while the leg swings forward, lifting the foot
+		for (int sd = 0; sd < 2; sd++)
+		{
+			const int LG = sd ? P_LEG_R : P_LEG_L, FT = sd ? P_FOOT_R : P_FOOT_L;
+			const f32 hx = sd == 0 ? 0.12f : -0.12f;
+			const vec3 hip{hx, m.hip_y, 0.f}, knee{hx, m.knee_y, 0.f};
+			const f32 ph = in.walk_phase + (sd ? 3.14159265f : 0.f), amt = in.walk_amount;
+			const f32 thigh = std::sin(ph) * 0.30f * amt;                                  // forward (+) and back, a calm step
+			const f32 bend = std::max(0.f, std::sin(ph + 1.2f)) * 0.85f * amt;             // the knee flexes while the leg swings
+			// (the foot then hangs back from the knee: it lifts a little and never kicks up)
+			const vec3 axis = rotate(rq, vec3{1.f, 0.f, 0.f});
+			const auto turn = [&](f32 a) { return XrQuaternionf{axis.x * std::sin(a * 0.5f), axis.y * std::sin(a * 0.5f), axis.z * std::sin(a * 0.5f), std::cos(a * 0.5f)}; };
+			const XrQuaternionf qt = turn(-thigh), qs = turn(-thigh + bend);
+			const vec3 hip_w = W(hip);
+			const vec3 knee_w = hip_w + rotate(qt, rotate(rq, (knee - hip) * s));
+			out[LG] = {hip, hip_w, qnorm(qmul(qt, rq)), {0, 1, 0}, 1.f};
+			out[FT] = {knee, knee_w, qnorm(qmul(qs, rq)), {0, 1, 0}, 1.f};
+		}
+		for (int sd = 0; sd < 2; sd++)
+		{
+			const int UA = sd ? P_UA_R : P_UA_L, FA = sd ? P_FA_R : P_FA_L, HD = sd ? P_HAND_R : P_HAND_L, FG = sd ? P_FING_R : P_FING_L, TH = sd ? P_THUMB_R : P_THUMB_L;
+			const vec3 S_chef = W(m.shoulder[sd]);
+			const vec3 Er = W(m.elbow[sd]), Wr = W(m.wrist[sd]);
+			// The cartoon chef's own bones (its shoulders sit far below and behind your eyes, its arms are short)
+			const f32 L1c = s * std::sqrt(dot(m.elbow[sd] - m.shoulder[sd], m.elbow[sd] - m.shoulder[sd]));
+			const f32 L2c = s * std::sqrt(dot(m.wrist[sd] - m.elbow[sd], m.wrist[sd] - m.elbow[sd]));
+			// Your arm: it starts at your own shoulder and has a person's upper arm and forearm for your eye height, so the
+			// arm you see bends where yours bends and is as long as yours. The chef's sleeves are drawn along it (a fixed
+			// length for you, never pulled longer as you reach). In the plain diner's mirror the arms stay on the chef's own
+			// shoulders, so the chef you see there stays in one piece.
+			const f32 eye_m = s * m.eye_y;
+			const f32 L1 = upper_arm_per_eye * eye_m, L2 = forearm_per_eye * eye_m;
+			const f32 own = std::clamp(in.own_shoulders, 0.f, 1.f);
+			vec3 S = real_shoulder(in.head, in.head_q, in.body_yaw, eye_m, sd) * (1.f - own) + S_chef * own;
+			const vec3 out_dir = normalize(Wr - S_chef);             // T-pose arm direction (outwards)
+			if (!in.hand_valid[sd])
+			{
+				// Arms hang down (the chef's own arm, from the same shoulder as when your hand is tracked)
+				const vec3 down{0.f, -1.f, 0.f};
+				const XrQuaternionf q = q_from_to(out_dir, normalize(down * 0.95f + out_dir * 0.3f));
+				out[UA] = {m.shoulder[sd], S, qnorm(qmul(q, rq)), out_dir, 1.f};
+				const vec3 E = S + rotate(q, Er - S_chef);
+				out[FA] = {m.elbow[sd], E, qnorm(qmul(q, rq)), out_dir, 1.f};
+				const vec3 Wt = S + rotate(q, Wr - S_chef);
+				out[HD] = {m.wrist[sd], Wt, qnorm(qmul(q, rq)), out_dir, 1.f};
+				out[FG] = out[HD];
+				out[FG].c0 = m.wrist[sd];
+				out[TH] = out[HD];
+				continue;
+			}
+			const XrPosef& hp = in.hand[sd];
+			// OpenXR grip pose: -Z runs up the handle through your fist, +X is the left palm's normal (-X the right's).
+			// Your hand's back-of-wrist-to-knuckles direction crosses the handle at about 60 degrees, pointing forward.
+			const f32 hs = m.hand_scale;
+			const vec3 palm = rotate(hp.orientation, {sd == 0 ? 1.f : -1.f, 0.f, 0.f});   // palms face inwards, onto the handle
+			const vec3 fc = normalize(rotate(hp.orientation, {0.f, -0.866f, -0.5f}));        // wrist -> knuckles
+			// The handle sits in the palm: the middle of the chef's palm is beside it, the wrist behind it
+			const f32 palm_mid = 0.5f * std::fabs(m.knuckle[sd].x - m.wrist[sd].x) * s * hs;
+			const vec3 Wt = to_vec(hp.position) - palm * (0.035f * s) - fc * palm_mid;
+			// Two-bone arm: elbow down and out
+			vec3 d = Wt - S;
+			f32 dl = std::sqrt(dot(d, d));
+			if (dl < 1e-4f) { d = out_dir; dl = 1e-4f; }
+			vec3 dir = d * (1.f / dl);
+			// Reaching further than your arm (a long reach, or the controller held out at arm's length): the hand stays on
+			// your controller. The arm first stretches a little (12%: your shoulder guessed a few cm off, an ordinary reach),
+			// then its shoulder end comes forward with your body, at most 8 cm, as your shoulder does when you reach, so the
+			// sleeve never floats off your shoulder; past that the arm stretches. On the chef's own shoulders (the mirror) it
+			// may stretch 30%, then leaves the chef's shoulder toward the hand.
+			const f32 reach = (L1 + L2) * 0.999f * (1.f + std::max(0.3f * own, 0.12f));
+			if (dl > reach)
+			{
+				vec3 sdir = dir;
+				f32 slide = dl - reach;
+				if (own < 0.5f)
+				{
+					const vec3 fwd = rotate(rq, vec3{0.f, 0.f, 1.f});
+					const vec3 m2 = fwd * 0.7f + dir * 0.3f;
+					if (dot(m2, m2) > 1e-4f) sdir = normalize(m2);
+					slide = std::min(slide, 0.08f * std::clamp(eye_m / 1.6f, 0.7f, 1.3f));
+				}
+				S = S + sdir * slide;
+				d = Wt - S;
+				dl = std::max(std::sqrt(dot(d, d)), 1e-4f);
+				dir = d * (1.f / dl);
+			}
+			f32 k = 1.f, a = 0.f, hgt = 0.f;
+			if (dl >= (L1 + L2) * 0.999f) { k = dl / (L1 + L2); a = L1 * k; }   // straight (in the mirror: a little longer)
+			else
+			{
+				a = (L1 * L1 - L2 * L2 + dl * dl) / (2.f * dl);
+				hgt = std::sqrt(std::max(L1 * L1 - a * a, 0.f));
+			}
+			vec3 pole = rotate(rq, vec3{sd == 0 ? 0.5f : -0.5f, -1.f, -0.2f});
+			pole = pole - dir * dot(pole, dir);
+			if (dot(pole, pole) < 1e-6f) pole = rotate(rq, vec3{sd == 0 ? 1.f : -1.f, 0.f, 0.f}) - dir * dot(rotate(rq, vec3{sd == 0 ? 1.f : -1.f, 0.f, 0.f}), dir);
+			pole = normalize(pole);
+			const vec3 E = S + dir * a + pole * hgt;
+			const vec3 ua_dir = normalize(E - S), fa_dir = normalize(Wt - E);
+			const vec3 ua0 = normalize(Er - S_chef), fa0 = normalize(Wr - Er);
+			// (each sleeve is drawn from the chef's bone to your bone's length: the same for you all the time)
+			out[UA] = {m.shoulder[sd], S, qnorm(qmul(q_from_to(ua0, ua_dir), rq)), ua0, std::sqrt(dot(E - S, E - S)) / std::max(L1c, 1e-4f)};
+			out[FA] = {m.elbow[sd], E, qnorm(qmul(q_from_to(fa0, fa_dir), rq)), fa0, std::sqrt(dot(Wt - E, Wt - E)) / std::max(L2c, 1e-4f)};
+			// Hand: the chef's fingers point out of the T pose (outwards), palms down
+			const vec3 f0 = out_dir, n0 = rotate(rq, vec3{0.f, -1.f, 0.f});
+			const XrQuaternionf qh = q_frames(f0, n0, fc, palm);
+			const XrQuaternionf qhr = qnorm(qmul(qh, rq));
+			out[HD] = {m.wrist[sd], Wt, qhr, {0, 1, 0}, 1.f, hs};
+			const auto hand_pt = [&](vec3 p) { return Wt + rotate(qhr, (p - m.wrist[sd]) * (s * hs)); };
+			const auto turn = [](vec3 axis, f32 ang) { return XrQuaternionf{axis.x * std::sin(ang * 0.5f), axis.y * std::sin(ang * 0.5f), axis.z * std::sin(ang * 0.5f), std::cos(ang * 0.5f)}; };
+			// TRIGGER curls the fingers towards the palm, GRIP folds the thumb over; both together make a fist
+			const f32 fcurl = std::clamp(in.trig[sd], 0.f, 1.f) * 1.45f;
+			out[FG] = {m.knuckle[sd], hand_pt(m.knuckle[sd]), qnorm(qmul(turn(normalize(cross(fc, palm)), fcurl), qhr)), {0, 1, 0}, 1.f, hs};
+			const vec3 tdir = rotate(qhr, normalize(vec3{m.thumb[sd].x * 0.6f, 0.f, 0.8f}));   // the thumb points forward and out
+			const f32 tcurl = std::clamp(in.grip[sd], 0.f, 1.f) * 1.1f;
+			out[TH] = {m.thumb[sd], hand_pt(m.thumb[sd]), qnorm(qmul(turn(normalize(cross(tdir, palm)), tcurl), qhr)), {0, 1, 0}, 1.f, hs};
+		}
+	}
+
+	// Skins the model into world positions and normals; mirror = reflect about a plane after posing.
+	void skin(const model& m, const rigid T[P_COUNT], const vec3& root, const XrQuaternionf& rq, f32 s, std::vector<vec3>& pos, std::vector<vec3>& nrm)
+	{
+		pos.resize(m.v.size());
+		nrm.resize(m.v.size());
+		for (usz i = 0; i < m.v.size(); i++)
+		{
+			const vtx& x = m.v[i];
+			vec3 p{}, n{};
+			for (int j = 0; j < 4; j++)
+			{
+				if (x.w[j] <= 0.f) continue;
+				const rigid& t = T[x.part[j]];
+				// T pose offset from this part's pivot, turned into the body's facing, scaled
+				const XrQuaternionf rootq = rq;
+				vec3 o = rotate(rootq, (x.p - t.c0) * (s * t.scale));
+				if (t.stretch != 1.f)
+				{
+					const vec3 sd = t.stretch_dir;   // the bone's rest direction, already in the body's facing
+					o = o + sd * (dot(o, sd) * (t.stretch - 1.f));
+				}
+				// q holds (part rotation * root); undo the root since o is already in the body's facing
+				const XrQuaternionf partq = qnorm(qmul(t.q, qconj(rootq)));
+				p = p + (t.c1 + rotate(partq, o)) * x.w[j];
+				n = n + rotate(t.q, x.n) * x.w[j];
+			}
+			pos[i] = p;
+			nrm[i] = normalize(n);
+		}
+		(void)root;
+	}
+}
diff --git a/rpcs3/Emu/Io/OrderUpVR_interior.inl b/rpcs3/Emu/Io/OrderUpVR_interior.inl
new file mode 100644
index 000000000..e7b3d4dc4
--- /dev/null
+++ b/rpcs3/Emu/Io/OrderUpVR_interior.inl
@@ -0,0 +1,164 @@
+// Order Up VR: every kitchen's interior, read from the player's own game files at start-up (nothing is shipped).
+//
+// Each restaurant package in Chef.wad has a layout file: named placements (name, position, rotation, scale) in the
+// restaurant's own space, which is the game's world space (the game camera's view matrix at 0x003821d8 maps it).
+// The kitchens mark their stations with named nodes on one line along x: cutting_area, grill_01/02, fryer,
+// griddle_01/02 (and cutting board, DeepFryeHook), their floor (*kitchen_floor*, y 0), the counter tops, and in
+// several kitchens the oven and the trash can. The mod measures you and places the VR things against these:
+//  - your real floor is the kitchen's floor (the chef's eyes are 1.45 units above it, yours are your eye height);
+//  - the ticket rail hangs over the far side of the station line, at its own height above the counters;
+//  - the trash and the oven are where the kitchen has them (else beside you, as before).
+// Included inside namespace ouvr { namespace { ... } } of OrderUpVR.cpp, after the lobby.
+
+namespace interior
+{
+	using namespace chef;
+
+	struct inode { std::string name, lower; vec3 pos{}; };
+	struct kitchen
+	{
+		u32 pkg = 0;
+		std::vector<inode> n;
+		vec3 line0{}, line1{};      // the station line's two ends (world)
+		f32 floor_y = 0.f, top_y = 0.9f;
+		int stations = 0;
+	};
+
+	inline std::vector<kitchen> kitchens;   // filled once by the loader thread
+	inline std::atomic<int> state{0};       // 0 not started, 1 loading, 2 ready, 3 failed
+	inline std::thread th;
+
+	inline bool is_station(const std::string& l)
+	{
+		return l == "cutting_area" || l.rfind("grill_0", 0) == 0 || l == "fryer" || l == "fryer2" || l.rfind("griddle_0", 0) == 0 || l == "cutting_area2";
+	}
+
+	void load_all(std::string usrdir)
+	{
+		wad_reader w;
+		if (!w.open(usrdir + "Chef.wad")) { state = 3; vr_log("Interior: Chef.wad not readable"); return; }
+		std::vector<kitchen> out;
+		for (const auto& [h, e] : w.table)
+		{
+			lobby::package pkg;
+			if (!pkg.read(w, h)) continue;
+			for (const auto& [fh, fe] : pkg.table)
+			{
+				const auto m = pkg.file(fh);
+				if (m.size() < 64) continue;
+				if (rd32be(&m[0]) != 1 || rd32be(&m[4]) != 0) continue;
+				if (!(m[12] < 64 && ((m[13] >= 'A' && m[13] <= 'z') || (m[12] == 0 && m[14] >= 'A' && m[14] <= 'z')))) continue;
+				kitchen k;
+				k.pkg = h;
+				usz p = 12;
+				bool first = true;
+				while (p + 42 < m.size())
+				{
+					u32 len;
+					if (first) { len = m[p]; p += 1; first = false; }
+					else { len = u32{m[p]} << 8 | m[p + 1]; p += 2; }
+					if (!len || p + len + 40 > m.size()) break;
+					inode nd;
+					nd.name.assign(reinterpret_cast<const char*>(&m[p]), len - 1);
+					while (!nd.name.empty() && (nd.name.back() == '\t' || nd.name.back() == ' ')) nd.name.pop_back();
+					p += len;
+					nd.pos = {rdf32be(&m[p]), rdf32be(&m[p + 4]), rdf32be(&m[p + 8])};
+					p += 40;
+					nd.lower = nd.name;
+					for (char& c : nd.lower) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+					k.n.push_back(std::move(nd));
+				}
+				// a kitchen: its stations on a line
+				f32 x0 = 1e9f, x1 = -1e9f;
+				vec3 a{}, b{};
+				for (const auto& nd : k.n)
+				{
+					if (!is_station(nd.lower) || nd.lower == "cutting_area2" || nd.lower == "fryer2") continue;
+					k.stations++;
+					if (nd.pos.x < x0) { x0 = nd.pos.x; a = nd.pos; }
+					if (nd.pos.x > x1) { x1 = nd.pos.x; b = nd.pos; }
+				}
+				if (k.stations < 2) continue;
+				k.line0 = a; k.line1 = b;
+				for (const auto& nd : k.n)
+					if (nd.lower.find("kitchen_floor") != std::string::npos || nd.lower.find("kitchenfloor") != std::string::npos) { k.floor_y = nd.pos.y; break; }
+				// the counter top nearest the station line (its height is the counter's)
+				f32 best = 1e9f;
+				const vec3 mid = (a + b) * 0.5f;
+				for (const auto& nd : k.n)
+				{
+					if (nd.lower.find("countertop") == std::string::npos && nd.lower.find("counter_top") == std::string::npos) continue;
+					const vec3 d = nd.pos - mid;
+					const f32 dd = d.x * d.x + d.z * d.z;
+					if (dd < best && nd.pos.y > k.floor_y + 0.3f && nd.pos.y < k.floor_y + 1.6f) { best = dd; k.top_y = nd.pos.y; }
+				}
+				out.push_back(std::move(k));
+			}
+		}
+		for (const auto& k : out)
+			vr_log("Interior: kitchen %08x, %d stations from %.1f,%.1f,%.1f to %.1f,%.1f,%.1f, floor %.2f, counter top %.2f, %zu named things",
+				k.pkg, k.stations, k.line0.x, k.line0.y, k.line0.z, k.line1.x, k.line1.y, k.line1.z, k.floor_y, k.top_y, k.n.size());
+		kitchens = std::move(out);
+		state = kitchens.empty() ? 3 : 2;
+		vr_log("Interior: %zu kitchens read from the game files", kitchens.size());
+	}
+
+	void start(const std::string& usrdir)
+	{
+		if (state.load() != 0 || usrdir.empty()) return;
+		state = 1;
+		th = std::thread(load_all, usrdir);
+		th.detach();
+	}
+
+	// The kitchen you were last placed against (place_screen sets it when its floor agreed with the game camera). Several
+	// kitchens share the same space in the game files, so a look point a little to the side could pick another one each
+	// time: the height, the ticket rail and the stations would each be measured against a different kitchen. This one is
+	// kept unless another kitchen is clearly nearer (1.5 units) to where the camera looks.
+	inline std::atomic<u32> sticky{0};
+
+	// The kitchen the game shows: the one whose station line is nearest to where the camera looks
+	const kitchen* pick(vec3 look, f32* dist = nullptr)
+	{
+		if (state.load() != 2) return nullptr;
+		const kitchen* best = nullptr;
+		const kitchen* kept = nullptr;
+		f32 bd = 1e9f, kd = 1e9f;
+		const u32 keep = sticky.load();
+		for (const auto& k : kitchens)
+		{
+			// distance from the look point to the station segment
+			const vec3 ab = k.line1 - k.line0, ap = look - k.line0;
+			const f32 t = std::clamp(dot(ap, ab) / std::max(dot(ab, ab), 1e-6f), 0.f, 1.f);
+			const vec3 d = look - (k.line0 + ab * t);
+			const f32 dd = std::sqrt(dot(d, d));
+			if (dd < bd) { bd = dd; best = &k; }
+			if (keep && k.pkg == keep && dd < kd) { kd = dd; kept = &k; }
+		}
+		// the kitchen already recognised stays (restaurants share coordinates: when the camera turns to the dining room, another
+		// restaurant's station row can be nearer its look point); only a clear match of another kitchen replaces it
+		if (kept && kd < 12.f && !(bd < 1.0f && kd > 2.5f)) { best = kept; bd = kd; }
+		if (kept && best == kept) { if (dist) *dist = bd; return best; }
+		if (dist) *dist = bd;
+		return bd < 6.f ? best : nullptr;
+	}
+
+	// The nearest named thing whose name has one of the words (and none of the excluded ones), within reach of the line
+	const inode* find(const kitchen& k, std::initializer_list<const char*> words, std::initializer_list<const char*> not_words = {}, f32 within = 12.f)
+	{
+		const vec3 mid = (k.line0 + k.line1) * 0.5f;
+		const inode* best = nullptr;
+		f32 bd = within * within;
+		for (const auto& nd : k.n)
+		{
+			bool hit = false;
+			for (const char* w : words) if (nd.lower.find(w) != std::string::npos) { hit = true; break; }
+			for (const char* w : not_words) if (nd.lower.find(w) != std::string::npos) { hit = false; break; }
+			if (!hit) continue;
+			const vec3 d = nd.pos - mid;
+			const f32 dd = dot(d, d);
+			if (dd < bd) { bd = dd; best = &nd; }
+		}
+		return best;
+	}
+}
diff --git a/rpcs3/Emu/Io/OrderUpVR_live.inl b/rpcs3/Emu/Io/OrderUpVR_live.inl
new file mode 100644
index 000000000..3bc7941f0
--- /dev/null
+++ b/rpcs3/Emu/Io/OrderUpVR_live.inl
@@ -0,0 +1,783 @@
+// Order Up VR: live test stream (Experimental). While you play, the mod sends what happens straight to the developer's
+// Sentry project, so testing needs no log zips:
+//  - every line the mod logs and the 4-per-second track (head, hands, buttons, pointer, HUD), batched every second
+//    as Sentry Logs;
+//  - a small JPEG of what your left eye sees (the room, the game's picture re-rendered for your eye, your body and
+//    hands; the game's flat picture as an inset) every 2.5 seconds and right after every press or grab.
+// Switched off with "live=off" in config/orderupvr_live.txt (the launcher's switch). Nothing is recorded but the game,
+// the mod's own state and the views above; no microphone sound, no files.
+// Included inside namespace ouvr { namespace { ... } } of OrderUpVR.cpp, after the UI helpers.
+
+namespace live
+{
+	constexpr const wchar_t* host = L"o4512473892126720.ingest.de.sentry.io";
+	constexpr const wchar_t* path = L"/api/4512479065604176/envelope/";
+	constexpr const char* key = "c21ff38a7be0ea8e7db3111f51e60ddb";   // the approved-testers key (0.18.3+); the old key of 0.17.1-0.18.2 is switched off in Sentry
+
+	void log(const char* level, const std::string& body, const char* kind, f64 at = 0.0);
+	void state_line(const std::string& line);
+
+	struct state
+	{
+		std::atomic<int> on{-1};          // -1 not decided, 0 off, 1 on
+		std::mutex m;
+		std::condition_variable cv;
+		std::vector<std::string> logs;    // JSON log items waiting for the next batch
+		std::deque<std::string> out;      // envelopes waiting to be sent
+		std::thread th;
+		std::atomic<bool> stop{false};
+		std::atomic<int> posting{0};      // the sender is sending an envelope right now
+		std::string session;              // this run's id (Sentry trace id)
+		u64 last_flush = 0, last_frame = 0, frames = 0, sent = 0, failed = 0;
+		std::atomic<bool> want_frame{false};
+		u64 want_since = 0;
+		std::string last_track;   // the newest track line, sent with every picture
+		std::string frame_reason;
+	std::string note;          // extra state for the picture's summary (what the mod decided: live_state_note)
+		std::atomic<u64> game_at{0};   // when the left eye's game picture in the capture was taken (a stale one shows its age)
+	std::vector<u8> game_r; u32 game_r_w = 0, game_r_h = 0; bool game_r_ok = false;   // the right eye's game picture
+		// the captured layers (left eye)
+		std::vector<u8> env, body, game, screen;   // RGBA8
+		u32 env_w = 0, env_h = 0, body_w = 0, body_h = 0, game_w = 0, game_h = 0, screen_w = 0, screen_h = 0;
+		bool env_ok = false, body_ok = false, game_ok = false, screen_ok = false;
+		// Where the game's flat picture is seen by the left eye (the big screen, or the menu stand within reach): its centre
+		// and half axes (right, up) in the eye's view space, and the eye's field of view (tangents), so the picture shows it
+		// there and not only as the small inset
+		bool quad_on = false;
+		vec3 quad_c{}, quad_a{}, quad_b{};
+		f32 fov_l = -1.f, fov_r = 1.f, fov_u = 1.f, fov_d = -1.f;
+		ID3D11Texture2D* st_env = nullptr;
+		ID3D11Texture2D* st_body = nullptr;
+	};
+	inline state g;
+
+	std::string hex(u64 a, u64 b)
+	{
+		char s[40];
+		std::snprintf(s, sizeof(s), "%016llx%016llx", static_cast<unsigned long long>(a), static_cast<unsigned long long>(b));
+		return s;
+	}
+
+	std::string esc(const std::string& in)
+	{
+		std::string o;
+		o.reserve(in.size() + 8);
+		for (unsigned char c : in)
+		{
+			if (c == '"' || c == '\\') { o += '\\'; o += static_cast<char>(c); }
+			else if (c == '\n') o += "\\n";
+			else if (c == '\r') {}
+			else if (c == '\t') o += "\\t";
+			else if (c < 0x20) { char b[8]; std::snprintf(b, sizeof(b), "\\u%04x", c); o += b; }
+			else o += static_cast<char>(c);
+		}
+		return o;
+	}
+
+	f64 now_s()
+	{
+		FILETIME ft;
+		GetSystemTimeAsFileTime(&ft);
+		const u64 t = (u64{ft.dwHighDateTime} << 32 | ft.dwLowDateTime) - 116444736000000000ull;
+		return static_cast<f64>(t) / 1e7;
+	}
+
+	bool post(const std::string& body)
+	{
+		static HINTERNET ses = nullptr, con = nullptr;
+		if (!ses) ses = WinHttpOpen(L"orderupvr-live/1.0", WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY, WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
+		if (ses && !con) con = WinHttpConnect(ses, host, INTERNET_DEFAULT_HTTPS_PORT, 0);
+		if (!con) return false;
+		HINTERNET req = WinHttpOpenRequest(con, L"POST", path, nullptr, WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE);
+		if (!req) return false;
+		WinHttpSetTimeouts(req, 5000, 5000, 10000, 10000);
+		const std::wstring hdr = L"Content-Type: application/x-sentry-envelope\r\nX-Sentry-Auth: Sentry sentry_version=7, sentry_client=orderupvr-live/1.0, sentry_key=" +
+			std::wstring(key, key + std::strlen(key)) + L"\r\n";
+		bool ok = WinHttpSendRequest(req, hdr.c_str(), static_cast<DWORD>(-1L), const_cast<char*>(body.data()), static_cast<DWORD>(body.size()), static_cast<DWORD>(body.size()), 0) &&
+			WinHttpReceiveResponse(req, nullptr);
+		if (ok)
+		{
+			DWORD code = 0, len = sizeof(code);
+			WinHttpQueryHeaders(req, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, WINHTTP_HEADER_NAME_BY_INDEX, &code, &len, WINHTTP_NO_HEADER_INDEX);
+			ok = code >= 200 && code < 300;
+		}
+		WinHttpCloseHandle(req);
+		return ok;
+	}
+
+	void sender()
+	{
+		while (!g.stop)
+		{
+			std::string env;
+			{
+				std::unique_lock lock(g.m);
+				g.cv.wait_for(lock, std::chrono::milliseconds(500), [] { return g.stop.load() || !g.out.empty(); });
+				if (g.out.empty()) continue;
+				env = std::move(g.out.front());
+				g.out.pop_front();
+				g.posting = 1;
+			}
+			if (post(env)) g.sent++;
+			else if (!post(env)) g.failed++;   // one retry
+			g.posting = 0;
+		}
+	}
+
+	void start_tap();
+
+	// Decided once per run: Experimental channel, and not switched off in the launcher
+	// ---- Who may stream: only testers the owner approved. The launcher writes the player's tester key (key=...) into
+	// config/orderupvr_live.txt (Experimental only). The mod hashes it (SHA-256) and looks for the hash in the approved list
+	// published in the project's repository (testers.txt, one hash per line). No key, an unknown key, no internet, or the
+	// Stable channel: nothing is ever sent. The keys themselves are never published; approving or removing a tester is an
+	// edit of that list, no new release.
+	inline std::atomic<int> approved{-1};   // -1 not checked yet / checking, 0 no, 1 yes
+
+	std::string sha256_hex(const std::string& in)
+	{
+		BCRYPT_ALG_HANDLE alg = nullptr;
+		BCRYPT_HASH_HANDLE h = nullptr;
+		u8 out[32]{};
+		bool ok = BCRYPT_SUCCESS(BCryptOpenAlgorithmProvider(&alg, BCRYPT_SHA256_ALGORITHM, nullptr, 0)) &&
+			BCRYPT_SUCCESS(BCryptCreateHash(alg, &h, nullptr, 0, nullptr, 0, 0)) &&
+			BCRYPT_SUCCESS(BCryptHashData(h, reinterpret_cast<PUCHAR>(const_cast<char*>(in.data())), static_cast<ULONG>(in.size()), 0)) &&
+			BCRYPT_SUCCESS(BCryptFinishHash(h, out, sizeof(out), 0));
+		if (h) BCryptDestroyHash(h);
+		if (alg) BCryptCloseAlgorithmProvider(alg, 0);
+		if (!ok) return {};
+		static const char* d = "0123456789abcdef";
+		std::string r;
+		for (u8 b : out) { r += d[b >> 4]; r += d[b & 15]; }
+		return r;
+	}
+
+	// The approved list (https://raw.githubusercontent.com/ahmadhamed67/OrderUpVR/main/testers.txt)
+	std::string fetch_testers()
+	{
+		std::string body;
+		HINTERNET ses = WinHttpOpen(L"orderupvr-live/1.0", WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY, WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
+		if (!ses) return body;
+		if (HINTERNET con = WinHttpConnect(ses, L"raw.githubusercontent.com", INTERNET_DEFAULT_HTTPS_PORT, 0))
+		{
+			if (HINTERNET req = WinHttpOpenRequest(con, L"GET", L"/ahmadhamed67/OrderUpVR/main/testers.txt", nullptr, WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE))
+			{
+				WinHttpSetTimeouts(req, 5000, 5000, 8000, 8000);
+				if (WinHttpSendRequest(req, WINHTTP_NO_ADDITIONAL_HEADERS, 0, WINHTTP_NO_REQUEST_DATA, 0, 0, 0) && WinHttpReceiveResponse(req, nullptr))
+				{
+					DWORD code = 0, len = sizeof(code);
+					WinHttpQueryHeaders(req, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, WINHTTP_HEADER_NAME_BY_INDEX, &code, &len, WINHTTP_NO_HEADER_INDEX);
+					DWORD n = 0;
+					while (code == 200 && WinHttpQueryDataAvailable(req, &n) && n && body.size() < 256 * 1024)
+					{
+						std::string chunk(n, '\0');
+						DWORD got = 0;
+						if (!WinHttpReadData(req, chunk.data(), n, &got) || !got) break;
+						body.append(chunk.data(), got);
+					}
+				}
+				WinHttpCloseHandle(req);
+			}
+			WinHttpCloseHandle(con);
+		}
+		WinHttpCloseHandle(ses);
+		return body;
+	}
+
+	bool enabled(const std::string& channel)
+	{
+		int v = g.on.load();
+		if (v >= 0) return v == 1;
+		if (approved.load() == -2) return false;   // the check is running
+		if (approved.load() == -1)
+		{
+			std::string key;
+			if (channel == "beta")
+				for (const std::string& p : {fs::get_config_dir(true) + "orderupvr_live.txt", fs::get_config_dir() + "orderupvr_live.txt"})
+					if (std::FILE* f = std::fopen(p.c_str(), "r"))
+					{
+						char line[2048] = {};
+						while (std::fgets(line, sizeof(line), f))
+							if (std::strncmp(line, "keyp=", 5) == 0)
+							{
+								// the key, encrypted by the launcher for this Windows user (DPAPI): only this user on this PC can read it
+								std::string b64 = line + 5;
+								while (!b64.empty() && (b64.back() == '\n' || b64.back() == '\r' || b64.back() == ' ')) b64.pop_back();
+								DWORD n = 0;
+								if (CryptStringToBinaryA(b64.c_str(), 0, CRYPT_STRING_BASE64, nullptr, &n, nullptr, nullptr) && n && n < 4096)
+								{
+									std::vector<BYTE> blob(n);
+									if (CryptStringToBinaryA(b64.c_str(), 0, CRYPT_STRING_BASE64, blob.data(), &n, nullptr, nullptr))
+									{
+										static const char ent[] = "OrderUpVR tester key v1";
+										DATA_BLOB in{n, blob.data()}, entropy{static_cast<DWORD>(sizeof(ent) - 1), reinterpret_cast<BYTE*>(const_cast<char*>(ent))}, out{};
+										if (CryptUnprotectData(&in, nullptr, &entropy, nullptr, nullptr, CRYPTPROTECT_UI_FORBIDDEN, &out))
+										{
+											key.assign(reinterpret_cast<const char*>(out.pbData), out.cbData);
+											SecureZeroMemory(out.pbData, out.cbData);
+											LocalFree(out.pbData);
+										}
+									}
+								}
+							}
+						std::fclose(f);
+						break;
+					}
+			if (key.size() < 8) { approved = 0; g.on = 0; return false; }
+			approved = -2;
+			std::thread([key]
+			{
+				const std::string mine = sha256_hex(key);
+				const std::string list = fetch_testers();
+				bool ok = false;
+				if (!mine.empty())
+				{
+					usz p = 0;
+					while (p < list.size())
+					{
+						usz e = list.find('\n', p);
+						if (e == std::string::npos) e = list.size();
+						std::string ln = list.substr(p, e - p);
+						while (!ln.empty() && (ln.back() == '\r' || ln.back() == ' ')) ln.pop_back();
+						if (ln == mine) { ok = true; break; }
+						p = e + 1;
+					}
+				}
+				approved = ok ? 1 : 0;
+			}).detach();
+			return false;
+		}
+		bool on = approved.load() == 1 && channel == "beta";
+		LARGE_INTEGER pc;
+		QueryPerformanceCounter(&pc);
+		g.session = hex(GetTickCount64() ^ (u64{GetCurrentProcessId()} << 40), static_cast<u64>(pc.QuadPart) * 0x9e3779b97f4a7c15ull);
+		g.on = on ? 1 : 0;
+		if (on) { g.th = std::thread(sender); g.th.detach(); g_log_hook = [](const char* line) { log("info", line, "mod"); state_line(line); }; start_tap(); }
+		// The lines logged before now (the start-up, the comfort settings, the first height): sent with when they were logged
+		std::vector<std::pair<u64, std::string>> early;
+		{
+			std::lock_guard lock(g_log_mutex);
+			early.swap(g_early_lines);
+			g_early_open = false;
+		}
+		if (on)
+		{
+			const u64 tk = GetTickCount64();
+			const f64 ws = now_s();
+			for (const auto& [t, line] : early)
+			{
+				log("info", "(before the stream) " + line, "mod", ws - static_cast<f64>(tk - t) / 1000.0);
+				state_line(line);
+			}
+		}
+		return on;
+	}
+
+	// ---- Crashes and freezes: the emulator's own log (warnings and worse) is kept, errors are streamed, and a fatal
+	// error or a frozen game sends a report at once (synchronously: the process may be about to end)
+	inline std::mutex tail_m;
+	inline std::deque<std::string> tail;   // the emulator's newest warning/error lines
+
+	struct emu_tap final : logs::listener
+	{
+		void log(u64, const logs::message& msg, std::string_view prefix, std::string_view text) override
+		{
+			const auto lv = static_cast<logs::level>(msg);
+			if (lv > logs::level::warning) return;
+			std::string line = std::string(lv <= logs::level::fatal ? "F " : lv == logs::level::error ? "E " : "W ") + msg->name + ": " + std::string(prefix) + std::string(text);
+			if (line.size() > 600) line.resize(600);
+			{
+				std::lock_guard lock(tail_m);
+				tail.push_back(line);
+				if (tail.size() > 300) tail.pop_front();
+			}
+			if (lv <= logs::level::error) live::log(lv <= logs::level::fatal ? "fatal" : "error", line, "emu");
+		}
+	};
+	inline emu_tap* tap = nullptr;
+	void start_tap() { if (!tap) { tap = new emu_tap; logs::listener::add(tap); } }
+
+	void flush_logs();
+
+	// A report event (crash or freeze) with the emulator's log tail attached, sent now
+	void report(const char* kind, const std::string& text)
+	{
+		if (g.on.load() != 1) return;
+		static std::atomic<int> sent{0};
+		if (sent.fetch_add(1) >= 3) return;
+		std::string t;
+		{
+			std::lock_guard lock(tail_m);
+			for (const auto& s : tail) { t += s; t += '\n'; }
+		}
+		t += "\nlast track: " + g.last_track + g.note + "\n";
+		char ts[32];
+		std::snprintf(ts, sizeof(ts), "%.3f", now_s());
+		const std::string id = hex(GetTickCount64() * 0x9e3779b97f4a7c15ull ^ 0xc4a5, sent.load() * 2654435761ull ^ g.frames);
+		std::string first = text.substr(0, text.find('\n'));
+		if (first.size() > 120) first.resize(120);
+		const std::string ev = std::string("{\"event_id\":\"") + id + "\",\"timestamp\":" + ts + ",\"platform\":\"native\",\"level\":\"fatal\",\"logger\":\"" + kind + "\","
+			"\"message\":{\"formatted\":\"" + esc(std::string(kind) + ": " + text) + "\"},"
+			"\"tags\":{\"session\":\"" + g.session + "\",\"kind\":\"" + kind + "\"},"
+			"\"contexts\":{\"trace\":{\"trace_id\":\"" + g.session + "\",\"span_id\":\"" + id.substr(0, 16) + "\"}},"
+			"\"fingerprint\":[\"" + kind + "\",\"" + esc(first) + "\"]}";
+		std::string env = "{\"event_id\":\"" + id + "\"}\n{\"type\":\"event\",\"length\":" + std::to_string(ev.size()) + "}\n" + ev +
+			"\n{\"type\":\"attachment\",\"length\":" + std::to_string(t.size()) + ",\"filename\":\"emulator_log_tail.txt\",\"content_type\":\"text/plain\"}\n" + t + "\n";
+		// everything still waiting first (the last seconds of logs), then the report itself
+		flush_logs();
+		std::deque<std::string> pending;
+		{
+			std::lock_guard lock(g.m);
+			pending.swap(g.out);
+		}
+		for (auto& e : pending) post(e);
+		post(env);
+	}
+
+	// Called by the emulator's fatal error handler (crashes, access violations, fatal asserts)
+	void fatal(std::string_view text) { report("crash", std::string(text)); }
+
+	// The game picture stopped changing for 8 s while the headset shows the game: a freeze report (once per freeze)
+	void watch(u64 game_frame)
+	{
+		if (g.on.load() != 1) return;
+		static u64 last = 0, since = 0;
+		static bool reported = false;
+		const u64 now = GetTickCount64();
+		if (game_frame != last) { last = game_frame; since = now; reported = false; return; }
+		if (!reported && since && game_frame && now - since > 8000)
+		{
+			reported = true;
+			char m[96];
+			std::snprintf(m, sizeof(m), "the game picture has not changed for %.0f s (frame %llu)", (now - since) / 1000.0, static_cast<unsigned long long>(game_frame));
+			report("freeze", m);
+		}
+	}
+
+	// Any mod log line (vr_log) and the track: one Sentry log item each
+	void log(const char* level, const std::string& body, const char* kind, f64 at)
+	{
+		if (g.on.load() != 1) return;
+		char ts[32];
+		std::snprintf(ts, sizeof(ts), "%.3f", at > 0.0 ? at : now_s());
+		std::string item = std::string("{\"timestamp\":") + ts + ",\"trace_id\":\"" + g.session + "\",\"level\":\"" + level + "\",\"body\":\"" + esc(body) +
+			"\",\"attributes\":{\"kind\":{\"value\":\"" + kind + "\",\"type\":\"string\"},\"session\":{\"value\":\"" + g.session + "\",\"type\":\"string\"}}}";
+		std::lock_guard lock(g.m);
+		if (g.logs.size() < 4000) g.logs.push_back(std::move(item));
+	}
+
+	void flush_logs()
+	{
+		std::vector<std::string> items;
+		{
+			std::lock_guard lock(g.m);
+			items.swap(g.logs);
+		}
+		if (items.empty()) return;
+		std::string payload = "{\"items\":[";
+		for (usz i = 0; i < items.size(); i++) { if (i) payload += ','; payload += items[i]; }
+		payload += "]}";
+		std::string env = "{}\n{\"type\":\"log\",\"item_count\":" + std::to_string(items.size()) +
+			",\"content_type\":\"application/vnd.sentry.items.log+json\",\"length\":" + std::to_string(payload.size()) + "}\n" + payload + "\n";
+		std::lock_guard lock(g.m);
+		if (g.out.size() < 64) g.out.push_back(std::move(env));
+		g.cv.notify_one();
+	}
+
+	// ---- The mod's one-off decisions as their own events (logger "state", level info), so they can be found again with
+	// search_issue_events (Sentry's log search cannot filter by text): how you were measured and placed, which kitchen,
+	// the UI tree, the stations. One issue per kind (its fingerprint). At most one event per kind every 2 s (the UI tree
+	// every 10 s): a burst keeps its newest line, sent when the time is up with how many came in between; a line the same
+	// as the last one sent of its kind is only counted. At most 300 per session.
+	struct state_kind
+	{
+		const char* prefix;
+		const char* key;
+		u64 gap;
+		int cap = 80;           // at most this many of the kind per session
+		u64 last = 0;
+		int sent = 0;
+		std::string last_text, pending;
+		int between = 0;
+	};
+	inline std::mutex state_m;
+	inline state_kind state_kinds[] = {
+		{"Interior:", "interior", 2000}, {"Height", "height", 2000}, {"Camera height", "height", 2000}, {"Restaurant floor", "height", 2000},
+		{"Recentred", "recentred", 2000}, {"Stand:", "recentred", 2000},{"UI tree:", "uitree", 10000, 40}, {"Stations:", "stations", 2000}, {"Comfort", "comfort", 2000},
+		{"Order Up VR starting", "start", 2000}, {"OpenXR runtime", "runtime", 2000}, {"Quick setup", "setup", 2000}, {"Start: ", "start", 2000}, {"Cards:", "cards", 2000}, {"Menu keys", "menu", 2000},
+		{"Board:", "boards", 1000, 60},   // picking up and putting down the rail, the stand, the shelf and the clipboard
+		{"Exit", "exit", 500, 40},        // the EXIT button: taken out, pushed, let go, the full press that closes the game
+	};
+	inline std::atomic<int> state_sent{0};
+
+	void send_state(const char* key, const std::string& text)
+	{
+		const int nr = state_sent.fetch_add(1) + 1;
+		if (nr > 300) return;
+		char ts[32];
+		std::snprintf(ts, sizeof(ts), "%.3f", now_s());
+		const std::string id = hex(GetTickCount64() * 0x2545f4914f6cdd1dull ^ static_cast<u64>(nr), static_cast<u64>(nr) * 0x9e3779b97f4a7c15ull ^ 0x57a7e);
+		std::string msg = "state " + std::string(key) + ": " + text;
+		if (msg.size() > 4000) msg.resize(4000);
+		const std::string ev = std::string("{\"event_id\":\"") + id + "\",\"timestamp\":" + ts + ",\"platform\":\"native\",\"level\":\"info\",\"logger\":\"state\","
+			"\"message\":{\"formatted\":\"" + esc(msg) + "\"},"
+			"\"tags\":{\"session\":\"" + g.session + "\",\"kind\":\"" + key + "\"},"
+			"\"contexts\":{\"trace\":{\"trace_id\":\"" + g.session + "\",\"span_id\":\"" + id.substr(0, 16) + "\"}},"
+			"\"fingerprint\":[\"state\",\"" + key + "\"]}";
+		std::string env = "{\"event_id\":\"" + id + "\"}\n{\"type\":\"event\",\"length\":" + std::to_string(ev.size()) + "}\n" + ev + "\n";
+		std::lock_guard lock(g.m);
+		if (g.out.size() < 64) g.out.push_back(std::move(env));
+		g.cv.notify_one();
+	}
+
+	// Every mod log line comes here (from any thread): the decisions go out as state events
+	void state_line(const std::string& line)
+	{
+		if (g.on.load() != 1) return;
+		for (auto& k : state_kinds)
+		{
+			if (line.rfind(k.prefix, 0) != 0) continue;
+			std::string out;
+			const char* key = k.key;
+			{
+				std::lock_guard lock(state_m);
+				const u64 now = GetTickCount64();
+				if (line == k.last_text) { k.between++; return; }
+				if (k.sent >= k.cap) return;
+				if (k.last && now - k.last < k.gap) { k.pending = line; k.between++; return; }
+				k.sent++;
+				k.last = now;
+				k.last_text = line;
+				out = k.between ? line + " (" + std::to_string(k.between) + " more lines of this kind before)" : line;
+				k.between = 0;
+				k.pending.clear();
+			}
+			send_state(key, out);
+			return;
+		}
+	}
+
+	// A burst's newest line, once its time is up (called once per headset frame)
+	void flush_state()
+	{
+		for (auto& k : state_kinds)
+		{
+			std::string out;
+			{
+				std::lock_guard lock(state_m);
+				if (k.pending.empty() || GetTickCount64() - k.last < k.gap || k.sent >= k.cap) continue;
+				k.sent++;
+				k.last = GetTickCount64();
+				k.last_text = k.pending;
+				out = k.pending + " (newest of " + std::to_string(k.between) + " lines of this kind)";
+				k.between = 0;
+				k.pending.clear();
+			}
+			send_state(k.key, out);
+		}
+	}
+
+	// Ask for a picture now (a press, a grab, a recentre), at most one every 1.5 s
+	void request_frame(const char* reason)
+	{
+		if (g.on.load() != 1) return;
+		const u64 now = GetTickCount64();
+		if (now - g.last_frame < 1500) return;
+		g.frame_reason = reason;
+		g.want_since = now;
+		g.want_frame = true;
+	}
+
+	// ---- capture (headset thread): the layers of the left eye
+	void grab_texture(ID3D11Device* dev, ID3D11DeviceContext* ctx, ID3D11Texture2D* src, ID3D11Texture2D*& st, std::vector<u8>& out, u32& w, u32& h, bool& ok)
+	{
+		ok = false;
+		if (!src) return;
+		D3D11_TEXTURE2D_DESC d{};
+		src->GetDesc(&d);
+		if (d.SampleDesc.Count != 1) return;
+		if (st)
+		{
+			D3D11_TEXTURE2D_DESC sd{};
+			st->GetDesc(&sd);
+			if (sd.Width != d.Width || sd.Height != d.Height || sd.Format != d.Format) { st->Release(); st = nullptr; }
+		}
+		if (!st)
+		{
+			D3D11_TEXTURE2D_DESC sd = d;
+			sd.MipLevels = 1; sd.ArraySize = 1; sd.Usage = D3D11_USAGE_STAGING; sd.BindFlags = 0; sd.CPUAccessFlags = D3D11_CPU_ACCESS_READ; sd.MiscFlags = 0;
+			if (FAILED(dev->CreateTexture2D(&sd, nullptr, &st))) { st = nullptr; return; }
+		}
+		ctx->CopySubresourceRegion(st, 0, 0, 0, 0, src, 0, nullptr);
+		D3D11_MAPPED_SUBRESOURCE ms{};
+		if (FAILED(ctx->Map(st, 0, D3D11_MAP_READ, 0, &ms))) return;
+		const bool bgra = d.Format == DXGI_FORMAT_B8G8R8A8_UNORM || d.Format == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB || d.Format == DXGI_FORMAT_B8G8R8A8_TYPELESS;
+		const bool rgba = d.Format == DXGI_FORMAT_R8G8B8A8_UNORM || d.Format == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB || d.Format == DXGI_FORMAT_R8G8B8A8_TYPELESS;
+		if (bgra || rgba)
+		{
+			// a quarter-size copy is plenty for the picture
+			w = d.Width / 4; h = d.Height / 4;
+			out.resize(usz{w} * h * 4);
+			for (u32 y = 0; y < h; y++)
+			{
+				const u8* row = static_cast<const u8*>(ms.pData) + usz{y} * 4 * ms.RowPitch;
+				for (u32 x = 0; x < w; x++)
+				{
+					const u8* p = row + usz{x} * 16;
+					u8* o = &out[(usz{y} * w + x) * 4];
+					o[0] = bgra ? p[2] : p[0]; o[1] = p[1]; o[2] = bgra ? p[0] : p[2]; o[3] = p[3];
+				}
+			}
+			ok = true;
+		}
+		ctx->Unmap(st, 0);
+	}
+
+	// a CPU picture the mod already has (the game's eye picture, the big screen)
+	void grab_pixels(const u8* px, u32 sw, u32 sh, bool bgra, std::vector<u8>& out, u32& w, u32& h, bool& ok)
+	{
+		const u32 step = sw > 1200 ? 4 : 2;
+		w = sw / step; h = sh / step;
+		out.resize(usz{w} * h * 4);
+		for (u32 y = 0; y < h; y++)
+			for (u32 x = 0; x < w; x++)
+			{
+				const u8* p = px + (usz{y} * step * sw + usz{x} * step) * 4;
+				u8* o = &out[(usz{y} * w + x) * 4];
+				o[0] = bgra ? p[2] : p[0]; o[1] = p[1]; o[2] = bgra ? p[0] : p[2]; o[3] = p[3];
+			}
+		ok = true;
+	}
+
+	bool capturing() { return g.want_frame.load(); }
+
+	// sample a layer at (u, v) in 0..1
+	const u8* at(const std::vector<u8>& img, u32 w, u32 h, f32 u, f32 v)
+	{
+		const u32 x = std::min(w - 1, static_cast<u32>(u * w)), y = std::min(h - 1, static_cast<u32>(v * h));
+		return &img[(usz{y} * w + x) * 4];
+	}
+
+	bool jpeg(const std::vector<u8>& rgb, u32 w, u32 h, std::string& out)
+	{
+		CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+		IWICImagingFactory* f = nullptr;
+		if (FAILED(CoCreateInstance(CLSID_WICImagingFactory, nullptr, CLSCTX_INPROC_SERVER, IID_PPV_ARGS(&f)))) return false;
+		IStream* s = nullptr;
+		IWICBitmapEncoder* enc = nullptr;
+		IWICBitmapFrameEncode* fr = nullptr;
+		IPropertyBag2* props = nullptr;
+		bool ok = SUCCEEDED(CreateStreamOnHGlobal(nullptr, TRUE, &s)) && SUCCEEDED(f->CreateEncoder(GUID_ContainerFormatJpeg, nullptr, &enc)) &&
+			SUCCEEDED(enc->Initialize(s, WICBitmapEncoderNoCache)) && SUCCEEDED(enc->CreateNewFrame(&fr, &props));
+		if (ok)
+		{
+			PROPBAG2 opt{};
+			opt.pstrName = const_cast<LPOLESTR>(L"ImageQuality");
+			VARIANT v;
+			VariantInit(&v);
+			v.vt = VT_R4;
+			v.fltVal = 0.7f;
+			props->Write(1, &opt, &v);
+			WICPixelFormatGUID pf = GUID_WICPixelFormat24bppBGR;
+			ok = SUCCEEDED(fr->Initialize(props)) && SUCCEEDED(fr->SetSize(w, h)) && SUCCEEDED(fr->SetPixelFormat(&pf)) && pf == GUID_WICPixelFormat24bppBGR &&
+				SUCCEEDED(fr->WritePixels(h, w * 3, static_cast<UINT>(rgb.size()), const_cast<BYTE*>(rgb.data()))) && SUCCEEDED(fr->Commit()) && SUCCEEDED(enc->Commit());
+		}
+		if (ok)
+		{
+			HGLOBAL hg = nullptr;
+			ok = SUCCEEDED(GetHGlobalFromStream(s, &hg));
+			STATSTG stt{};
+			if (ok && SUCCEEDED(s->Stat(&stt, STATFLAG_NONAME)))
+			{
+				const void* p = GlobalLock(hg);
+				out.assign(static_cast<const char*>(p), static_cast<usz>(stt.cbSize.QuadPart));
+				GlobalUnlock(hg);
+			}
+			else ok = false;
+		}
+		if (props) props->Release();
+		if (fr) fr->Release();
+		if (enc) enc->Release();
+		if (s) s->Release();
+		f->Release();
+		return ok && !out.empty();
+	}
+
+	// Put the left eye's layers together (room, game picture, body/hands; the game's flat picture as an inset),
+	// and send it with a one-line summary
+	void send_frame(const std::string& summary)
+	{
+		g.want_frame = false;
+		g.last_frame = GetTickCount64();
+		const u32 W = 640, H = std::max<u32>(320, g.env_ok && g.env_w ? W * g.env_h / g.env_w : 680);
+		std::vector<u8> rgb(usz{W} * H * 3, 0);
+		// the flat picture's plane (eye view space)
+		const bool quad = g.quad_on && g.screen_ok && g.screen_w && g.screen_h;
+		const vec3 qn = cross(g.quad_a, g.quad_b);
+		const f32 qa2 = std::max(dot(g.quad_a, g.quad_a), 1e-8f), qb2 = std::max(dot(g.quad_b, g.quad_b), 1e-8f), qcn = dot(g.quad_c, qn);
+		for (u32 y = 0; y < H; y++)
+			for (u32 x = 0; x < W; x++)
+			{
+				const f32 u = (x + 0.5f) / W, v = (y + 0.5f) / H;
+				f32 c[3] = {12.f, 12.f, 16.f};
+				const auto over = [&](const u8* p, bool use_alpha)
+				{
+					const f32 a = use_alpha ? p[3] / 255.f : 1.f;
+					for (int k = 0; k < 3; k++) c[k] = c[k] * (1.f - a) + p[k] * a;
+				};
+				if (g.env_ok) over(at(g.env, g.env_w, g.env_h, u, v), false);
+				if (quad)
+				{
+					// this pixel's ray from the eye, where it meets the flat picture's quad
+					const vec3 ray{g.fov_l + u * (g.fov_r - g.fov_l), g.fov_u - v * (g.fov_u - g.fov_d), -1.f};
+					const f32 den = dot(ray, qn);
+					if (std::fabs(den) > 1e-8f)
+					{
+						const f32 t = qcn / den;
+						const vec3 d = ray * t - g.quad_c;
+						const f32 s = dot(d, g.quad_a) / qa2, r = dot(d, g.quad_b) / qb2;
+						if (t > 0.f && std::fabs(s) <= 1.f && std::fabs(r) <= 1.f) over(at(g.screen, g.screen_w, g.screen_h, (s + 1.f) * 0.5f, (1.f - r) * 0.5f), false);
+					}
+				}
+				if (g.game_ok) over(at(g.game, g.game_w, g.game_h, u, v), true);
+				if (g.body_ok) over(at(g.body, g.body_w, g.body_h, u, v), true);
+				u8* o = &rgb[(usz{y} * W + x) * 3];
+				o[0] = static_cast<u8>(std::clamp(c[2], 0.f, 255.f)); o[1] = static_cast<u8>(std::clamp(c[1], 0.f, 255.f)); o[2] = static_cast<u8>(std::clamp(c[0], 0.f, 255.f));
+			}
+		// the right eye's game picture, top right (both eyes must show the same thing)
+		if (g.game_r_ok && g.game_r_w)
+		{
+			const u32 iw = W / 4, ih = iw * g.game_r_h / g.game_r_w;
+			for (u32 y = 0; y < ih && y + 4 < H; y++)
+				for (u32 x = 0; x < iw; x++)
+				{
+					const u8* p = at(g.game_r, g.game_r_w, g.game_r_h, (x + 0.5f) / iw, (y + 0.5f) / ih);
+					u8* o = &rgb[(usz{4 + y} * W + (W - iw - 4 + x)) * 3];
+					o[0] = p[2]; o[1] = p[1]; o[2] = p[0];
+				}
+		}
+		// the game's own flat picture, bottom right
+		if (g.screen_ok && g.screen_w)
+		{
+			const u32 iw = W / 3, ih = iw * g.screen_h / g.screen_w;
+			for (u32 y = 0; y < ih && y + 4 < H; y++)
+				for (u32 x = 0; x < iw; x++)
+				{
+					const u8* p = at(g.screen, g.screen_w, g.screen_h, (x + 0.5f) / iw, (y + 0.5f) / ih);
+					u8* o = &rgb[(usz{H - ih - 4 + y} * W + (W - iw - 4 + x)) * 3];
+					o[0] = p[2]; o[1] = p[1]; o[2] = p[0];
+				}
+		}
+		std::string jpg;
+		if (!jpeg(rgb, W, H, jpg)) return;
+		g.frames++;
+		char ts[32];
+		std::snprintf(ts, sizeof(ts), "%.3f", now_s());
+		const std::string id = hex(GetTickCount64() * 2654435761ull ^ g.frames, g.frames * 0x9e3779b97f4a7c15ull ^ g.sent);
+		const std::string ev = std::string("{\"event_id\":\"") + id + "\",\"timestamp\":" + ts + ",\"platform\":\"native\",\"level\":\"info\",\"logger\":\"view\","
+			"\"message\":{\"formatted\":\"" + esc("view " + std::to_string(g.frames) + " (" + g.frame_reason + "): " + summary) + "\"},"
+			"\"tags\":{\"session\":\"" + g.session + "\",\"reason\":\"" + esc(g.frame_reason) + "\"},"
+			"\"contexts\":{\"trace\":{\"trace_id\":\"" + g.session + "\",\"span_id\":\"" + id.substr(0, 16) + "\"}},"
+			"\"fingerprint\":[\"view-frame\"]}";
+		std::string env = "{\"event_id\":\"" + id + "\"}\n{\"type\":\"event\",\"length\":" + std::to_string(ev.size()) + "}\n" + ev +
+			"\n{\"type\":\"attachment\",\"length\":" + std::to_string(jpg.size()) + ",\"filename\":\"view.jpg\",\"content_type\":\"image/jpeg\"}\n";
+		env += jpg;
+		env += "\n";
+		std::lock_guard lock(g.m);
+		if (g.out.size() < 64) g.out.push_back(std::move(env));
+		g.cv.notify_one();
+	}
+
+	// Once per headset frame: batches the logs every second, asks for a picture every 2.5 s
+	void tick(const std::string& channel)
+	{
+		if (!enabled(channel)) return;
+		const u64 now = GetTickCount64();
+		if (now - g.last_flush >= 1000) { g.last_flush = now; flush_logs(); }
+		flush_state();
+		if (!g.want_frame && now - g.last_frame >= 2500) { g.frame_reason = "timer"; g.want_since = now; g.want_frame = true; }
+	}
+
+	// After the headset frame: send the picture once its layers are in (or after 300 ms with what there is)
+	void after_frame(bool live3d)
+	{
+		if (g.on.load() != 1 || !g.want_frame) return;
+		const bool have = (g.env_ok || g.body_ok) && (g.game_ok || !live3d);
+		if (!have && GetTickCount64() - g.want_since < 300) return;
+		if (!live3d) g.game_ok = g.game_r_ok = false;   // outside the 3D scene the eye pictures are not shown
+		// how old the game picture in this capture is (the newest is kept: a stale one is told apart from a frozen eye)
+		std::string pic;
+		if (g.game_ok)
+		{
+			const u64 ga = g.game_at.load();
+			char b[48];
+			std::snprintf(b, sizeof(b), " | pic %llu ms old", ga ? static_cast<unsigned long long>(std::min<u64>(GetTickCount64() - ga, 999999)) : 999999ull);
+			pic = b;
+		}
+		send_frame(g.last_track + g.note + pic);
+		// the newest eye pictures are kept: a stale eye shows stale (its age is in the summary), not as an empty view
+		g.env_ok = g.body_ok = g.screen_ok = false;
+	}
+
+	// The game closes at once (the EXIT button): the log lines and decisions not sent yet go out now, ahead of any
+	// pictures still waiting, and this waits for them at most max_ms (the process ends right after)
+	void flush_now(u64 max_ms)
+	{
+		if (g.on.load() != 1) return;
+		// a burst's newest line still waiting for its turn goes too
+		for (auto& k : state_kinds)
+		{
+			std::string out;
+			{
+				std::lock_guard lock(state_m);
+				if (k.pending.empty() || k.sent >= k.cap) continue;
+				k.sent++;
+				k.last = GetTickCount64();
+				k.last_text = k.pending;
+				out = k.pending;
+				k.between = 0;
+				k.pending.clear();
+			}
+			send_state(k.key, out);
+		}
+		usz before = 0;
+		{
+			std::lock_guard lock(g.m);
+			// pictures waiting to go are dropped: there is no time for them
+			for (auto it = g.out.begin(); it != g.out.end();)
+			{
+				if (it->find("\"filename\":\"view.jpg\"") != std::string::npos) it = g.out.erase(it);
+				else ++it;
+			}
+			before = g.out.size();
+		}
+		flush_logs();
+		{
+			// the newest log lines (the press itself) first
+			std::lock_guard lock(g.m);
+			if (g.out.size() > before && before > 0) std::rotate(g.out.begin(), g.out.end() - 1, g.out.end());
+			g.cv.notify_one();
+		}
+		const u64 t0 = GetTickCount64();
+		while (GetTickCount64() - t0 < max_ms)
+		{
+			{
+				std::lock_guard lock(g.m);
+				if (g.out.empty() && !g.posting.load()) break;
+			}
+			Sleep(10);
+		}
+	}
+
+	void shutdown()
+	{
+		if (g.on.load() == 1)
+		{
+			flush_logs();
+			// give the queue a moment to empty
+			for (int i = 0; i < 20; i++) { { std::lock_guard lock(g.m); if (g.out.empty()) break; } Sleep(100); }
+		}
+		if (g.st_env) { g.st_env->Release(); g.st_env = nullptr; }
+		if (g.st_body) { g.st_body->Release(); g.st_body = nullptr; }
+	}
+}
diff --git a/rpcs3/Emu/Io/OrderUpVR_lobby.inl b/rpcs3/Emu/Io/OrderUpVR_lobby.inl
new file mode 100644
index 000000000..28a8b0576
--- /dev/null
+++ b/rpcs3/Emu/Io/OrderUpVR_lobby.inl
@@ -0,0 +1,577 @@
+// Order Up VR: the lobby is one of the game's own restaurants, rebuilt at start-up from the player's own game files
+// (nothing of the game is shipped with the mod).
+//
+// Each restaurant package inside Chef.wad holds:
+//  - the scene: a model file (u32 1, u32 material count) with a material table (0x240 each), a node table (0x60 each:
+//    local bounds, the node's name hash = ~crc32(lowercase name), its number of mesh parts) and the mesh parts. Every
+//    part is two Edge segments (drawn, then a shadow copy). A segment: a 16-byte header (flags, vertex and index
+//    counts, sizes), the compressed index stream (decoded by the game's own SPU decoder, see the chef), positions (f32 x3)
+//    and an attribute stream (24 bytes: colour RGBA + UV, or 36 bytes: normal + colour + UV). The part's material is
+//    named 0x198 bytes before its segment.
+//  - the layout: (u32 1, u32 0, u32 count) then records of name, position, rotation (quaternion x y z w) and scale.
+//  - material files (u32 2, u32 count): each material lists its pictures (width, height, DXT1/DXT5, image id).
+//  - the pictures live in another package: images/imgdat/<id>.imgdat.ps3 (raw DXT blocks).
+// Included inside namespace ouvr { namespace { ... } } of OrderUpVR.cpp, after the chef.
+
+namespace lobby
+{
+	using namespace chef;
+
+	struct vert { f32 p[3]; f32 uv[2]; f32 c[4]; };
+	struct batch { u32 first = 0, count = 0; int tex = -1; u8 blend = 0; };   // blend: 0 opaque, 1 cut-out, 2 alpha, 3 additive
+	// kind: how the picture is drawn, read from its own alpha: 0 solid, 1 cut-out (a clear on/off mask), 2 see-through
+	struct picture { u32 w = 0, h = 0; std::vector<u8> rgba; u8 kind = 0; };
+
+	struct restaurant
+	{
+		bool ok = false;
+		std::string name, error, info;
+		std::vector<vert> v;
+		std::vector<u32> idx;
+		std::vector<batch> batches;
+		std::vector<picture> pics;
+		vec3 spawn{};          // where you stand (restaurant space, on its floor)
+		f32 facing = 0.f;      // the direction the menu board is in (radians about y; 0 = -z)
+		f32 board_dist = 3.f;  // free floor towards the board
+	};
+
+	// The restaurants with a dining room (package hash in Chef.wad, name)
+	struct place_def { u32 wad; const char* name; bool lobby; };   // lobby: checked to look right where you stand
+	constexpr place_def places[] = {
+		{0xcca045da, "Gravy Chug kitchen", false}, {0x2d1cd440, "El Fuego", true}, {0xb95ae814, "Stuffolini", false},
+		{0xbaa69b86, "Chez Haute", true}, {0x906a2b6d, "Kung Fusion", true}, {0x4a13fc83, "Burger joint", false},
+		{0xbdad35ad, "Gravy Chug", true},
+	};
+
+	// A whole nested package, decompressed once
+	struct package
+	{
+		std::unordered_map<u32, wad_entry> table;
+		std::vector<u8> body;
+		u32 tsize = 0;
+		bool read(wad_reader& w, u32 hash)
+		{
+			const auto it = w.table.find(hash);
+			if (it == w.table.end()) return false;
+			std::vector<u8> b(it->second.size);
+			w.f.seek(it->second.off);
+			if (w.f.read(b.data(), b.size()) != b.size()) return false;
+			u32 comp = 0;
+			wad_reader::parse_table(b.data(), b.size(), table, tsize, comp);
+			if (table.empty()) return false;
+			if (comp)
+			{
+				uLongf len = rd32le(b.data() + 24);
+				body.resize(len);
+				if (uncompress(body.data(), &len, b.data() + tsize, static_cast<uLong>(b.size() - tsize)) != Z_OK) return false;
+				body.resize(len);
+			}
+			else body.assign(b.begin() + tsize, b.end());
+			return true;
+		}
+		std::span<const u8> file(u32 h) const
+		{
+			const auto it = table.find(h);
+			if (it == table.end() || it->second.off < tsize) return {};
+			const usz s = it->second.off - tsize;
+			if (s + it->second.size > body.size()) return {};
+			return {body.data() + s, it->second.size};
+		}
+	};
+
+	inline u32 name_hash(std::string s)
+	{
+		for (char& c : s) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+		return crc_name(s);
+	}
+
+	struct xform { vec3 pos{}; XrQuaternionf rot{0, 0, 0, 1}; vec3 scale{1, 1, 1}; };
+
+	struct tex_ref { u32 w = 0, h = 0, fmt = 0, image = 0, size = 0; };
+
+	// Material files: material hash -> its first picture
+	void parse_materials(std::span<const u8> m, std::unordered_map<u32, tex_ref>& out)
+	{
+		usz p = 8;
+		while (p + 8 <= m.size())
+		{
+			const u32 h = rd32be(&m[p]), size = rd32be(&m[p + 4]);
+			if (size < 0x30 || p + 8 + size > m.size()) break;
+			const u8* blk = &m[p + 8];
+			for (usz c = 0; c + 4 <= size; c += 4)
+			{
+				const u32 n = rd32be(blk + c);
+				if (n < 1 || n > 16 || c + 4 + usz{n} * 0x28 > size) continue;
+				bool good = true;
+				for (u32 i = 0; i < n && good; i++)
+				{
+					const u8* e = blk + c + 4 + i * 0x28;
+					const u32 w = rd32be(e + 16), hh = rd32be(e + 20);
+					good = w && hh && !(w & (w - 1)) && !(hh & (hh - 1)) && w <= 4096 && hh <= 4096;
+				}
+				if (!good) continue;
+				const u8* e = blk + c + 4;
+				out[h] = {rd32be(e + 16), rd32be(e + 20), rd32be(e + 24), rd32be(e + 32), rd32be(e + 36)};
+				break;
+			}
+			p += 8 + size;
+		}
+	}
+
+	vec3 qrot(const XrQuaternionf& q, vec3 v) { return rotate(q, v); }
+
+	bool load(restaurant& r, const std::string& usrdir, int pick)
+	{
+		r = {};
+		std::vector<u8> job;
+		if (!load_job(usrdir, job, r.error)) return false;
+		wad_reader w;
+		if (!w.open(usrdir + "Chef.wad")) { r.error = "Chef.wad not readable"; return false; }
+		const place_def& pd = places[pick % std::size(places)];
+		r.name = pd.name;
+		package pkg;
+		if (!pkg.read(w, pd.wad)) { r.error = "restaurant package not found"; return false; }
+
+		// Find the scene (the biggest model with many materials), the layout and the material files
+		std::span<const u8> scene, layout;
+		std::vector<std::span<const u8>> mat_files;
+		std::unordered_map<u32, tex_ref> mats;
+		for (const auto& [fh, e] : pkg.table)
+		{
+			const auto m = pkg.file(fh);
+			if (m.size() < 16) continue;
+			const u32 a = rd32be(&m[0]), b = rd32be(&m[4]);
+			if (a == 1 && b > 20 && b < 1000 && m.size() > scene.size()) scene = m;
