+	int stereo_draw_transform(const f32* consts, bool uses_mvp, u32 surface_w, u32 surface_h, u64 color_key, const u64* tex_keys, u32 tex_count, f32 x[16])
+	{
+		if (!g_session_running.load(std::memory_order_relaxed)) return 0;
+		auto& s = g_rv;
+		if (!s.begun) rv_begin_frame();
+		const u64 gen = s.gen.load();
+
+		if (uses_mvp) s.hv_n = 0;   // vertex positions are only read for flat draws
+		int kind = 0;
+		bool perspective = false;
+		f32 dA = 0.f, dB = 0.f, dsx = 0.f, dsy = 0.f, dcx = 0.f, dcy = 0.f;   // this draw's own projection
+		if (uses_mvp && consts)
+		{
+			// c1..c4 = rows of the model-view-projection matrix
+			const f32* m = consts + 4;
+			const vec3 r0{m[0], m[1], m[2]}, r1{m[4], m[5], m[6]}, r2{m[8], m[9], m[10]}, r3{m[12], m[13], m[14]};
