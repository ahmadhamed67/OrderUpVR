+					{xr.trigger, to_path(xr, "/user/hand/right/input/trigger/value")},
+					{xr.squeeze, to_path(xr, "/user/hand/left/input/squeeze/value")},
+					{xr.squeeze, to_path(xr, "/user/hand/right/input/squeeze/value")},
+					{xr.stick_click, to_path(xr, "/user/hand/left/input/thumbstick/click")},
+					{xr.stick_click, to_path(xr, "/user/hand/right/input/thumbstick/click")},
+					{xr.stick, to_path(xr, "/user/hand/left/input/thumbstick")},
+					{xr.stick, to_path(xr, "/user/hand/right/input/thumbstick")},
+					{xr.btn_a, to_path(xr, "/user/hand/right/input/a/click")},
+					{xr.btn_b, to_path(xr, "/user/hand/right/input/b/click")},
