+				const f32 d = 57.29578f;
+				scalar(K_ANGLE + 0, yaw, 2e-4f, false, 0.035f, false);
+				scalar(K_ANGLE + 1, -yaw, 2e-4f, false, 0.035f, false);
+				scalar(K_ANGLE + 2, yaw * d, 0.012f, false, 2.f, false);
+				scalar(K_ANGLE + 3, -yaw * d, 0.012f, false, 2.f, false);
+				scalar(K_ANGLE + 4, yaw2, 2e-4f, false, 0.035f, false);
+				scalar(K_ANGLE + 5, yaw2 * d, 0.012f, false, 2.f, false);
+				scalar(K_ANGLE + 6, yaw3, 2e-4f, false, 0.035f, false);
+				scalar(K_ANGLE + 7, yaw3 * d, 0.012f, false, 2.f, false);
+				scalar(K_ANGLE + 8, pitch, 2e-4f, false, 0.035f, false);
+				scalar(K_ANGLE + 9, -pitch, 2e-4f, false, 0.035f, false);
+				scalar(K_ANGLE + 10, pitch * d, 0.012f, false, 2.f, false);
+				scalar(K_ANGLE + 11, -pitch * d, 0.012f, false, 2.f, false);
+			}
+			// Camera position from a 4x4 matrix candidate that already followed the camera
+			{
+				std::lock_guard lock(m.mtx);
+				for (const auto& c : m.cands)
+				{
+					if (c.type >= 2 || c.stride != 4 || c.hits < 3 || c.misses > c.hits) continue;
+					if (!vm::check_addr(c.addr, vm::page_readable, 64)) continue;
+					f32 tr[3];
+					for (int k = 0; k < 3; k++) tr[k] = c.type == 0 ? rdf(c.addr + (k * 4 + 3) * 4) : rdf(c.addr + (12 + k) * 4);
+					// view matrix: t = -R c  ->  c = -R^T t ; world matrix: the translation is the position
