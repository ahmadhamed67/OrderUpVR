+		// True when this mod version has already finished preparing once on this PC.
+		bool already_prepared() { return persist_get("prepared") == mod_version(); }
+
+		const wchar_t* loading_tip(u64 now)
+		{
+			static const wchar_t* tips[] =
+			{
+				L"GRIP grabs and holds. TRIGGER chooses.",
+				L"To flip, hold GRIP and flick your wrist up. Or flick the thumbstick up.",
+				L"Click the left thumbstick to bring everything back in front of you.",
+				L"Hold the left MENU button for 2 seconds to see all controls.",
+				L"In the kitchen, just turn your head toward the next station.",
+				L"There's a mirror on the diner's left wall. Say hi to your chef.",
+			};
+			return tips[(now / 8000) % std::size(tips)];
