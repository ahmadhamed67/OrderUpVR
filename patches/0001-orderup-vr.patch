+	namespace
+	{
+		// The headset eye's projection, with the game's own depth mapping (A, B) so depth testing behaves the same.
+		mat4 eye_projection(const XrFovf& fov, f32 A, f32 B)
+		{
+			const f32 l = std::tan(fov.angleLeft), r = std::tan(fov.angleRight), u = std::tan(fov.angleUp), d = std::tan(fov.angleDown);
+			mat4 p;
+			p.m[0] = 2.f / (r - l); p.m[2] = (r + l) / (r - l);
+			p.m[5] = 2.f / (u - d); p.m[6] = (u + d) / (u - d);
+			p.m[10] = A; p.m[11] = B;
+			p.m[14] = -1.f;
+			return p;
+		}
+
+		mat4 level_mat(vec3 up)
+		{
+			mat4 L;
+			const vec3 axes[3] = {{1.f, 0.f, 0.f}, {0.f, 1.f, 0.f}, {0.f, 0.f, 1.f}};
+			for (int j = 0; j < 3; j++)
+			{
+				const vec3 c = level(up, axes[j]);
+				L.m[j] = c.x; L.m[4 + j] = c.y; L.m[8 + j] = c.z;
+			}
+			L.m[15] = 1.f;
+			return L;
+		}
+
+		// Real grabbing, once per game frame: pick what was grabbed (from last frame's candidates), and where your hand is
+		// in the game camera's space this frame
+		void rv_hold_frame(const view_snapshot& v)
+		{
+			auto& s = g_rv;
+			const bool was = s.holding;
+			s.holding = v.holding && v.mode3d;
+			s.hand_local = v.hand_local;
+			s.ptr_nx = v.ptr_nx;
+			s.ptr_ny = v.ptr_ny;
+			if (!s.holding || v.hold_id != s.hold_id)
+			{
+				// Let go (or a new grip): forget what was in your hand
+				if (was && s.hold_picked) vr_log("Grab: let go (%u parts were in your hand)", static_cast<u32>(s.held.size()));
+				s.held.clear();
+				s.hold_picked = false;
+				s.hold_cands.clear();
+				s.hand_view_ok = false;
+				s.hold_logged = false;
+				s.grab_state = 0;
+				s.hold_id = v.hold_id;
+				if (!s.holding) return;
+			}
+			const f32 unit_m = std::max(v.unit, 0.05f);
+			if (!s.hold_picked && !s.hold_cands.empty() && s.hand_view_ok)
+			{
+				// What you grabbed, from what the game drew last frame (only what is on the game's own screen: the game can only
+				// pick up what its pointer can reach). In this order:
+				// 1. Touched: the thing nearest your grab point, within 32 cm (your hand is where the food is in VR); a thing right
+				//    in the line from your eyes through your hand counts a little nearer than one beside it (the counter under the
+				//    food has its middle near your hand too)
+				// 2. Seen right behind your hand (within 7 degrees, farther than your hand): what you see your hand over, when the
+				//    food is out of reach (your eyes are not where the game camera is, so the game's pointer is no help there)
+				// 3. Under the game's pointer (within 0.12 of the screen)
+				const vec3 eh = s.hand_view - s.eye_view;
+				const f32 eh_len = std::sqrt(dot(eh, eh));
+				const vec3 eh_dir = eh_len > 1e-4f ? eh * (1.f / eh_len) : vec3{0.f, 0.f, -1.f};
+				const f32 reach_u = 0.32f / unit_m;
+				// (within what the game's own camera frames: the wide view shows more than the game's pointer can reach)
+				const f32 lens_k = std::max(s.hud_k, 1.f);
+				const auto on_game_screen = [&](const rsx_vr_state::hold_cand& c) { return std::fabs(c.nx) * lens_k < 1.f && std::fabs(c.ny) * lens_k < 1.f; };
+				int how = 0;
+				const rsx_vr_state::hold_cand* best = nullptr;
+				f32 best_s = 1e30f, best_d = 0.f;
+				for (const auto& c : s.hold_cands)
+				{
+					if (!on_game_screen(c)) continue;
+					const vec3 d = c.o - s.hand_view;
+					const f32 d3 = std::sqrt(dot(d, d));
+					if (d3 >= reach_u) continue;
+					const vec3 eo = c.o - s.eye_view;
+					const f32 along = dot(eo, eh_dir);
+					const vec3 side = eo - eh_dir * along;
+					const f32 sc = d3 + 0.5f * std::sqrt(dot(side, side));
+					if (sc < best_s) { best_s = sc; best = &c; best_d = d3; how = 1; }
+				}
+				if (!best && eh_len * unit_m > 0.12f)
+				{
+					const f32 cos_max = std::cos(7.f * 0.01745329f);
+					f32 best_c = cos_max;
+					for (const auto& c : s.hold_cands)
+					{
+						if (!on_game_screen(c)) continue;
+						const vec3 eo = c.o - s.eye_view;
+						const f32 l = std::sqrt(dot(eo, eo));
+						if (l < eh_len * 0.8f || l < 1e-4f) continue;
+						const f32 cs = dot(eo, eh_dir) / l;
+						// (nearly as well lined up and nearer: the nearer one, the front thing you see)
+						if (cs > best_c + 0.0005f || (best && cs > best_c - 0.0005f && l < best_d))
+						{
+							best_c = std::max(cs, best_c);
+							best = &c;
+							best_d = l;
+							how = 2;
+						}
+					}
+				}
+				if (!best)
+				{
+					for (const auto& c : s.hold_cands)
+					{
+						if (!on_game_screen(c) || c.nd >= 0.12f) continue;
+						if (!best || c.nd < best->nd) { best = &c; how = 3; }
+					}
+				}
+				if (best)
+				{
+					const vec3 o = best->o;
+					for (const auto& c : s.hold_cands)
+					{
+						const vec3 d = c.o - o;
+						if (dot(d, d) < 0.35f * 0.35f && s.held.size() < 8) s.held.push_back({c.tex, c.o, d, c.o, false});
+					}
+					const vec3 dh = o - s.hand_view;
+					vr_log("Grab: %zu parts in your hand (%s, %.0f cm from your hand, at %.2f %.2f on the game's screen, %.2f units from its camera)", s.held.size(),
+						how == 1 ? "touched" : how == 2 ? "seen behind your hand" : "under the game's pointer", std::sqrt(dot(dh, dh)) * unit_m * 100.f,
+						best->nx, best->ny, -o.z);
+					s.hold_picked = true;
+					s.grab_state = 1;
+					s.grab_nx = best->nx;
+					s.grab_ny = best->ny;
+				}
+				else
+				{
+					// Nothing yet: it keeps looking while you hold GRIP (closing your hand first and then reaching into the food works)
+					s.grab_state = 2;
+					if (!s.hold_logged)
+					{
+						f32 nd = 1e30f, sd = 1e30f;
+						for (const auto& c : s.hold_cands)
+						{
+							const vec3 d = c.o - s.hand_view;
+							nd = std::min(nd, std::sqrt(dot(d, d)));
+							sd = std::min(sd, c.nd);
+						}
+						vr_log("Grab: nothing at your hand to hold yet (nearest thing %.0f cm from your hand, %.2f from the game's pointer on its screen; %zu things drawn)",
+							nd * unit_m * 100.f, sd, s.hold_cands.size());
+						s.hold_logged = true;
+					}
+				}
+			}
+			s.hold_cands.clear();
+			// Your hand and your eyes: room -> player frame -> levelled anchor space -> this frame's game camera space
+			const vec3 up_here = s.anchored ? s.up_a : (s.have_up ? s.up : vec3{0.f, 1.f, 0.f});
+			const mat4 Dinv = rigid_inv(s.Dpred);
+			const auto to_view = [&](vec3 local)
+			{
+				const vec3 pp = rotate(qconj(yaw_q(v.player_yaw)), local - v.player_pos) * (1.f / unit_m);
+				const vec3 a = level(up_here, pp, -1.f);
+				return s.anchored ? xform(Dinv, a) : a;
+			};
+			s.hand_view = to_view(s.hand_local);
+			s.eye_view = to_view((to_vec(v.eye[0].position) + to_vec(v.eye[1].position)) * 0.5f);
+			// (your hand may be behind the game camera when you stand ahead of it: food seen behind your hand is still found)
+			s.hand_view_ok = std::isfinite(s.hand_view.x + s.hand_view.y + s.hand_view.z) && std::isfinite(s.eye_view.x + s.eye_view.y + s.eye_view.z);
+		}
+
+		// This frame's card with that category and that rectangle on the game's 1280x720 screen
+		rsx_vr_state::lay_card* rv_find_card(u8 cat, f32 x0, f32 y0, f32 x1, f32 y1)
+		{
+			for (auto& l : g_rv.lay)
+				if (l.cat == cat && std::fabs(l.x0 - x0) < 0.5f && std::fabs(l.y0 - y0) < 0.5f && std::fabs(l.x1 - x1) < 0.5f && std::fabs(l.y1 - y1) < 0.5f) return &l;
+			return nullptr;
+		}
+
+		// The game's HUD cards this frame, from its UI tree: each card's rectangle on the game's screen and where it is in your
+		// kitchen. The order tickets hang from the rail at their place along the reel, tilted toward you and swaying a little;
+		// the assistants' portraits stand in a row on their stand and the gesture, utensil and spice cards on the shelf (a plank
+		// higher when a row is full), in the game's own order (top to bottom, left to right); the recipe card is on the
+		// clipboard in your left hand, or stands on the counter. Each card keeps its own shape; small ones are shown a little
+		// bigger than on the big screen and big ones a little smaller, so every card can be read and pressed at arm's length.
+		void rv_layout_cards()
+		{
+			auto& s = g_rv;
+			s.lay.clear();
+			if (!s.elems) return;
+			const f32 now_s = static_cast<f32>(GetTickCount64() % 3600000ull);
+			for (const auto& e : *s.elems)
+			{
+				const u8 c = e.cat;
+				const bool ticket = c == uitree::C_TICKETS;
+				if (!ticket && c != uitree::C_LEFT && c != uitree::C_RIGHT && c != uitree::C_RECIPE) continue;
+				// the card: a ticket is one direct child of the reel (the reel's own band is not a card); the others are their
+				// whole group (one assistant with the timer bar and the ingredient they cook, one gesture card, the recipe card)
+				f32 x0 = e.rx0, y0 = e.ry0, x1 = e.rx1, y1 = e.ry1;
+				int depth0 = e.depth;
+				if (ticket)
+				{
+					if (e.kx1 - e.kx0 <= 4.f || e.rx1 - e.rx0 <= 4.f) continue;
+					if (std::fabs(e.kx0 - e.rx0) < 1.f && std::fabs(e.kx1 - e.rx1) < 1.f && std::fabs(e.ky0 - e.ry0) < 1.f && std::fabs(e.ky1 - e.ry1) < 1.f) continue;
+					x0 = e.kx0; y0 = e.ky0; x1 = e.kx1; y1 = e.ky1;
+					depth0 = e.kdepth;
+				}
+				if (!(x1 - x0 > 4.f && y1 - y0 > 4.f) || !std::isfinite(x0 + y0 + x1 + y1)) continue;
+				if (auto* l = rv_find_card(c, x0, y0, x1, y1)) { l->depth0 = std::min(l->depth0, depth0); continue; }
+				if (s.lay.size() >= static_cast<usz>(max_cards)) break;
+				rsx_vr_state::lay_card n{};
+				n.cat = c;
+				n.x0 = x0; n.y0 = y0; n.x1 = x1; n.y1 = y1;
+				n.depth0 = depth0;
+				n.c.kr = {(x0 + x1) / 1280.f - 1.f, 1.f - (y0 + y1) / 720.f, (x1 - x0) / 1280.f, (y1 - y0) / 720.f};
+				n.c.panel = static_cast<s8>(ticket ? 0 : c == uitree::C_RIGHT ? 2 : 1);
+				n.c.holder = static_cast<u8>(ticket ? 0 : c == uitree::C_LEFT ? 1 : c == uitree::C_RIGHT ? 2 : s.clip_in_hand ? 3 : 4);
+				if (ticket && s.panels[0].on)
+				{
+					// hanging from the steel rail on a clip at its place along the reel, the reel's scale on both axes
+					const hud_panel& pn = s.panels[0];
+					const f32 mpp = 2.f * pn.hw / std::max(e.rx1 - e.rx0, 1.f);   // metres per screen pixel along the rail
+					const f32 cw = (x1 - x0) * mpp, ch = (y1 - y0) * mpp;
+					const vec3 N = normalize(cross(pn.A, pn.B));
+					const f32 kcx = (x0 + x1) * 0.5f;
+					const vec3 hinge = pn.P - pn.A * pn.hw + pn.A * ((kcx - e.rx0) * mpp) + pn.B * pn.hh - pn.B * ((y0 - e.ry0) * mpp) + N * 0.012f;
+					const f32 tilt = 0.22f + 0.035f * std::sin(now_s * 0.0013f + kcx * 0.05f);
+					const vec3 B2 = pn.B * std::cos(tilt) - N * std::sin(tilt);
+					n.c.pn.on = true;
+					n.c.pn.A = pn.A;
+					n.c.pn.B = B2;
+					n.c.pn.hw = cw * 0.5f;
+					n.c.pn.hh = ch * 0.5f;
+					n.c.pn.P = hinge - B2 * n.c.pn.hh;
+				}
+				s.lay.push_back(n);
+			}
+			// The stand, the shelf and the clipboard
+			for (int hk = 0; hk < 3; hk++)
+			{
+				const hud_panel& h = s.holders[hk];
+				const u8 cat = hk == 0 ? uitree::C_LEFT : hk == 1 ? uitree::C_RIGHT : uitree::C_RECIPE;
+				std::vector<rsx_vr_state::lay_card*> v;
+				for (auto& l : s.lay) if (l.cat == cat) v.push_back(&l);
+				if (v.empty() || !h.on || h.hw <= 0.f) continue;
+				std::stable_sort(v.begin(), v.end(), [](const rsx_vr_state::lay_card* a, const rsx_vr_state::lay_card* b) { return a->y0 != b->y0 ? a->y0 < b->y0 : a->x0 < b->x0; });
+				const vec3 N = normalize(cross(h.A, h.B));
+				if (hk == 2)
+				{
+					// the recipe card: as big as fits on the clipboard, in its middle (on its default spot on the counter: standing
+					// on its bottom edge; in a hand, carried or put down somewhere by you: the holder's pose is the card's middle)
+					f32 off = 0.f;
+					for (auto* l : v)
+					{
+						const f32 w = l->x1 - l->x0, ht = l->y1 - l->y0;
+						const f32 mpp = std::min(2.f * h.hw / w, 2.f * h.hh / ht);
+						hud_panel& cd = l->c.pn;
+						cd.on = true;
+						cd.A = h.A;
+						cd.B = h.B;
+						cd.hw = w * mpp * 0.5f;
+						cd.hh = ht * mpp * 0.5f;
+						cd.P = (s.clip_in_hand || s.clip_centred ? h.P : h.P + h.B * cd.hh) + h.A * off;
+						off += 2.f * cd.hw + 0.02f;
+					}
+					continue;
+				}
+				// a row of cards standing on the stand's ledge / the shelf's plank, leaning back a little, centred; a full row
+				// goes on: the next cards stand a plank higher
+				const f32 lean = hk == 0 ? 0.16f : 0.12f, gap = 0.025f, max_w = 2.f * h.hw, box = hk == 0 ? 0.15f : 0.13f;
+				const vec3 B2 = h.B * std::cos(lean) - N * std::sin(lean);
+				const vec3 N2 = normalize(cross(h.A, B2));
+				const auto mpp_of = [&](const rsx_vr_state::lay_card& l) { return std::clamp(box / std::max(l.x1 - l.x0, l.y1 - l.y0), 0.0006f, 0.0012f); };
+				f32 base = 0.f;
+				usz i = 0;
+				while (i < v.size())
+				{
+					usz j = i;
+					f32 row_w = 0.f, row_h = 0.f;
+					while (j < v.size())
+					{
+						const f32 mpp = mpp_of(*v[j]);
+						const f32 cw = (v[j]->x1 - v[j]->x0) * mpp;
+						if (j > i && row_w + gap + cw > max_w) break;
+						row_w += (j > i ? gap : 0.f) + cw;
+						row_h = std::max(row_h, (v[j]->y1 - v[j]->y0) * mpp);
+						j++;
+					}
+					f32 x = -row_w * 0.5f;
+					for (usz k = i; k < j; k++)
+					{
+						rsx_vr_state::lay_card& l = *v[k];
+						const f32 mpp = mpp_of(l);
+						hud_panel& cd = l.c.pn;
+						cd.on = true;
+						cd.A = h.A;
+						cd.B = B2;
+						cd.hw = (l.x1 - l.x0) * mpp * 0.5f;
+						cd.hh = (l.y1 - l.y0) * mpp * 0.5f;
+						cd.P = h.P + h.A * (x + cd.hw) + h.B * base + B2 * cd.hh + N2 * 0.004f;
+						x += 2.f * cd.hw + gap;
+					}
+					base += row_h * std::cos(lean) + (hk == 0 ? 0.03f : 0.05f);
+					i = j;
+				}
+			}
+		}
+
+		void rv_begin_frame()
+		{
+			auto& s = g_rv;
+			s.begun = true;
+			s.cam_this_frame = false;
+			s.x3_ready = s.x2_ready = s.x2b_ready = false;
+			s.n3 = s.n2 = s.n0 = s.n2b = s.n5 = 0;
+			s.votes.clear();
+			s.depths.clear();
+			s.fp_set = false;
+			s.tag = {};
+			s.tainted.clear();
+			if (s.scene_key != ~0ull) s.tainted.push_back(s.scene_key);
+			s.composite_this = ~0ull;
+
+			view_snapshot v;
+			{
+				std::lock_guard lock(g_state_mutex);
+				v = g_views;
+			}
+			s.unit = v.unit;
+			s.hud_dist = v.hud_dist;
+			s.room_on = v.room;
+			s.input_tick = v.input_tick;
+			s.cinema_pref = v.cinema;
+			s.wide_pref = v.wide;
+			for (int k = 0; k < 4; k++) s.panels[k] = v.panels[k];
+			for (int k = 0; k < 4; k++) { s.hud_seen[k] = s.hud_cnt[k]; s.hud_cnt[k] = 0; }
+			rv_hold_frame(v);
+			for (int k = 0; k < 4; k++) { s.spots[k] = v.spots[k]; s.spot_seen[k] = s.spot_cnt[k] > 0; s.spot_cnt[k] = 0; }
+			{
+				std::lock_guard lock(uitree::elems_mutex);
+				s.elems = uitree::elems;
+			}
+			// A menu or dialog is open: from the game's UI tree and what the game draws (vrui::update_menu; not from what the menu
+			// panel drew last frame: that kept itself on)
+			s.menu_open = v.menu_open && s.elems;
+			s.menu_tree = v.menu_tree && s.elems;
+			if (s.menu_open)
+			{
+				// the part of the screen its menus and dialogs cover (the pieces there go onto the menu panel, the rest of the
+				// HUD stays where it is)
+				s.menu_x0 = s.menu_y0 = 1e9f;
+				s.menu_x1 = s.menu_y1 = -1e9f;
+				const auto& el = *s.elems;
+				for (usz i = 0; i < el.size(); i++)
+					if (uitree::menu_root(el, i) || uitree::dialog_card(el[i]))
+					{
