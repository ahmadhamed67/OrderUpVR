+		// A panel between your room and the player frame (the game's world)
+		hud_panel to_pf_impl(const xr_state& xr, hud_panel p)
+		{
+			const XrQuaternionf inv = qconj(yaw_q(xr.player_yaw));
+			p.P = to_player(xr, p.P); p.A = rotate(inv, p.A); p.B = rotate(inv, p.B);
+			return p;
+		}
+		hud_panel from_pf_impl(const xr_state& xr, hud_panel p)
+		{
+			const XrQuaternionf q = yaw_q(xr.player_yaw);
+			p.P = from_player(xr, p.P); p.A = rotate(q, p.A); p.B = rotate(q, p.B);
+			return p;
+		}
+
+		// The HUD cards' holders, placed with the HUD where you are placed: the assistants' stand on the counter at your left,
+		// the shelf on the counter at your right (both beside you, clear of the plate, the bin, the oven and the food processor
+		// in front, and within reach), and the recipe card's spot on the counter in front of you, a little to the right of the
+		// plate (where it stands while your left hand is not tracked or holds the EXIT button). Each faces you.
+		void place_holders(xr_state& xr, vec3 head, vec3 fwd, vec3 right)
+		{
+			const f32 cy = vrui::counter_y(xr);
+			const auto put = [&](int k, f32 f, f32 r, f32 up, f32 hw, f32 hh)
+			{
+				vec3 p = head + fwd * f + right * r;
