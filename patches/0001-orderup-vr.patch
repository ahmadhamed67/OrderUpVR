+		// Lip sync: the PC's default microphone (your headset's, when it is the default). Only the loudness is used,
+		// nothing is recorded or stored.
+		struct mic_t
+		{
+			std::thread th;
+			std::atomic<bool> stop{false};
+			std::atomic<f32> level{0.f};    // 0..1
+			bool started = false;
+			f32 open = 0.f;
+		};
+		mic_t g_mic;
+
+		void mic_thread()
+		{
+			WAVEFORMATEX fmt{};
+			fmt.wFormatTag = WAVE_FORMAT_PCM; fmt.nChannels = 1; fmt.nSamplesPerSec = 16000; fmt.wBitsPerSample = 16;
+			fmt.nBlockAlign = 2; fmt.nAvgBytesPerSec = 32000;
+			HWAVEIN h = nullptr;
+			if (waveInOpen(&h, WAVE_MAPPER, &fmt, 0, 0, CALLBACK_NULL) != MMSYSERR_NOERROR) { vr_log("Lip sync: no microphone available"); return; }
+			constexpr int nbuf = 4, samples = 320;   // 20 ms each
+			std::vector<std::vector<s16>> data(nbuf, std::vector<s16>(samples));
+			WAVEHDR hdr[nbuf]{};
+			for (int i = 0; i < nbuf; i++)
+			{
+				hdr[i].lpData = reinterpret_cast<LPSTR>(data[i].data());
+				hdr[i].dwBufferLength = samples * 2;
+				waveInPrepareHeader(h, &hdr[i], sizeof(WAVEHDR));
+				waveInAddBuffer(h, &hdr[i], sizeof(WAVEHDR));
+			}
+			waveInStart(h);
+			vr_log("Lip sync: listening to the default microphone (loudness only)");
+			while (!g_mic.stop)
+			{
+				bool any = false;
+				for (int i = 0; i < nbuf; i++)
+				{
+					if (!(hdr[i].dwFlags & WHDR_DONE)) continue;
+					any = true;
+					f64 sum = 0;
+					const u32 n = hdr[i].dwBytesRecorded / 2;
+					for (u32 k = 0; k < n; k++) sum += static_cast<f64>(data[i][k]) * data[i][k];
+					const f64 rms = n ? std::sqrt(sum / n) / 32768.0 : 0.0;
+					const f64 db = 20.0 * std::log10(std::max(rms, 1e-6));
+					g_mic.level = static_cast<f32>(std::clamp((db + 46.0) / 26.0, 0.0, 1.0));   // about -46 dB silent .. -20 dB loud
+					hdr[i].dwFlags &= ~WHDR_DONE;
+					waveInAddBuffer(h, &hdr[i], sizeof(WAVEHDR));
+				}
+				if (!any) std::this_thread::sleep_for(std::chrono::milliseconds(5));
+			}
+			waveInReset(h);
+			for (int i = 0; i < nbuf; i++) waveInUnprepareHeader(h, &hdr[i], sizeof(WAVEHDR));
+			waveInClose(h);
+		}
+
+		void mic_shutdown()
+		{
+			g_mic.stop = true;
+			if (g_mic.th.joinable()) g_mic.th.join();
+			g_mic.started = false;
+			g_mic.stop = false;
+		}
+
+		// How open the chef's mouth is right now: quick to open, a little slower to close
+		f32 mic_mouth(xr_state& xr)
+		{
+			if (!xr.comfort.lipsync) { if (g_mic.started) mic_shutdown(); g_mic.open = 0.f; return 0.f; }
+			if (!g_mic.started) { g_mic.started = true; g_mic.th = std::thread(mic_thread); }
+			const f32 target = g_mic.level.load();
+			g_mic.open += (target - g_mic.open) * (target > g_mic.open ? 0.6f : 0.25f);
+			return g_mic.open;
+		}
+
+		// Which chef the game uses: the game puts the chef's body texture into video memory when it is about to draw
+		// that chef (career start, cutscenes). Every few seconds the mod looks for pieces of both chefs' textures
+		// there; when only one is found, your body becomes that chef. Until then (lobby, main menu) it is the male chef.
+		struct chef_detect_t
+		{
+			std::thread th;
+			std::atomic<bool> busy{false};
+			std::atomic<int> chosen{0};       // 0 male, 1 female
+			std::atomic<bool> found{false};   // the game has shown a career's chef (until then: the menu chef setting)
+			bool sig_tried = false;
+			std::vector<std::vector<u8>> sig[2];
+			u64 last = 0;
+			int scans = 0;
+			bool logged_found = false;
+		};
+		chef_detect_t g_detect;
+
+		void chef_detect_shutdown()
+		{
+			if (g_detect.th.joinable()) g_detect.th.join();
+		}
+
+		void chef_detect_tick()
+		{
+			auto& d = g_detect;
+			const u64 now = GetTickCount64();
+			if (d.busy || now - d.last < 2000) return;
+			d.last = now;
+			if (d.th.joinable()) d.th.join();
+			if (!d.sig_tried)
+			{
+				const std::string dir = game_usrdir();
+				if (dir.empty()) return;   // the game is not booted yet: try again later
+				d.sig_tried = true;
+				std::vector<u8> tex[2];
+				const bool ok = chef::texture_bytes(dir, false, tex[0]) && chef::texture_bytes(dir, true, tex[1]);
+				for (int f = 0; f < 2 && ok; f++)
+				{
+					// The most detailed pieces of this chef's picture (8 DXT blocks) that the other chef's picture lacks
+					std::vector<std::pair<int, usz>> cand;
+					for (usz off = 0x1000; off + 64 < tex[f].size(); off += 0x800)
+					{
+						bool seen[256]{};
+						int distinct = 0;
+						for (usz k = 0; k < 64; k++) if (!seen[tex[f][off + k]]) { seen[tex[f][off + k]] = true; distinct++; }
+						cand.emplace_back(distinct, off);
+					}
+					std::sort(cand.begin(), cand.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+					const auto& other = tex[f ^ 1];
+					for (const auto& [dn, off] : cand)
+					{
+						if (d.sig[f].size() >= 6 || dn < 8) break;
+						const auto b = tex[f].begin() + off, e = b + 64;
+						if (std::search(other.begin(), other.end(), std::boyer_moore_horspool_searcher(b, e)) != other.end()) continue;
+						d.sig[f].emplace_back(b, e);
+					}
+				}
+				vr_log("Chef: looking for the game's chef textures (%zu male and %zu female pieces)", d.sig[0].size(), d.sig[1].size());
+			}
+			if (d.sig[0].empty() || d.sig[1].empty()) return;
+			d.busy = true;
+			d.th = std::thread([]
+			{
+				auto& dd = g_detect;
+				int hits[2]{};
+				// One pass over video memory (RSX local memory, mapped for the whole game): DXT blocks are 8-byte
+				// aligned, so each aligned 8 bytes is looked up among the pieces' first blocks
+				std::unordered_map<u64, std::pair<int, int>> first;   // first 8 bytes -> (chef, piece)
+				for (int f = 0; f < 2; f++)
+					for (int k = 0; k < static_cast<int>(dd.sig[f].size()); k++)
+					{
+						u64 v;
+						std::memcpy(&v, dd.sig[f][k].data(), 8);
+						first[v] = {f, k};
+					}
+				std::vector<bool> quick(65536);   // a fast first check on the low 16 bits
+				for (const auto& [v, fk] : first) quick[v & 0xffff] = true;
+				bool seen[2][8]{};
+				for (u32 base = 0xC0000000u; base < 0xD0000000u; base += 0x100000u)
+				{
+					if (!vm::check_addr(base, vm::page_readable, 0x100000u)) continue;
+					const u8* mem = static_cast<const u8*>(vm::base(base));
+					constexpr usz len = 0x100000u;
+					for (usz o = 0; o + 64 <= len; o += 8)
+					{
+						u64 v;
+						std::memcpy(&v, mem + o, 8);
+						if (!quick[v & 0xffff]) continue;
+						const auto it = first.find(v);
+						if (it == first.end()) continue;
+						const auto [f, k] = it->second;
+						if (!seen[f][k] && std::memcmp(mem + o, dd.sig[f][k].data(), 64) == 0) { seen[f][k] = true; hits[f]++; }
+					}
+				}
+				const int was = dd.chosen.load();
+				// One chef clearly present (a profile's chef stays in video memory while its career is shown)
+				if (hits[1] >= 2 && hits[1] > hits[0] + 1) { dd.chosen = 1; dd.found = true; }
+				else if (hits[0] >= 2 && hits[0] > hits[1] + 1) { dd.chosen = 0; dd.found = true; }
+				const bool found_now = dd.found.load();
+				if (dd.chosen.load() != was || dd.scans++ == 0 || (found_now && !dd.logged_found))
+				{
+					vr_log("Chef: the game uses the %s chef%s (texture pieces found: male %d, female %d)", dd.chosen.load() ? "female" : "male", found_now ? "" : " (not seen yet: your menu chef)", hits[0], hits[1]);
+					if (found_now) dd.logged_found = true;
+				}
+				dd.busy = false;
+			});
+		}
+
+		void chef_release_gpu()
+		{
+			auto& g = g_gfx;
+			for (auto** p : {reinterpret_cast<IUnknown**>(&g.cvb), reinterpret_cast<IUnknown**>(&g.cib), reinterpret_cast<IUnknown**>(&g.csrv), reinterpret_cast<IUnknown**>(&g.ctex)})
+				if (*p) { (*p)->Release(); *p = nullptr; }
+			for (int k = 0; k < 3; k++)
+			{
+				if (g.fsrv[k]) { g.fsrv[k]->Release(); g.fsrv[k] = nullptr; }
+				if (g.ftex[k]) { g.ftex[k]->Release(); g.ftex[k] = nullptr; }
+			}
+			for (int k = 0; k < 4; k++)
+			{
+				if (g.msrv[k]) { g.msrv[k]->Release(); g.msrv[k] = nullptr; }
+				if (g.mtex[k]) { g.mtex[k]->Release(); g.mtex[k] = nullptr; }
+			}
+			g.mouth_n = 0;
+			g.chef_gpu = false;
+		}
+
+		struct chef_gpu_vertex { f32 p[3]; f32 n[3]; f32 uv[2]; };
+
+		// Once per headset frame: load (in the background), upload, and pose the chef to your head and hands.
+		void chef_tick(xr_state& xr)
+		{
+			auto& c = g_chef;
+			auto& g = g_gfx;
+			c.posed = false;
+			if (xr.live3d) chef_detect_tick();   // never on menus: the load menu shows the default (male) chef
+			// Your body is your profile's chef once the game has shown it (a female profile gives a female body); until then
+			// (main menu, lobby) the menu chef from the launcher
+			const int want = !xr.comfort.body ? -1 : g_detect.found.load() ? g_detect.chosen.load() : (xr.comfort.menu_female ? 1 : 0);
+			if (want >= 0) xr.comfort.female = want == 1;   // the simple body too (proportions, neckerchief)
+			if (want < 0 || !g.cvs || c.state == 1) return;
+			if (want != c.which)
+			{
+				if (c.th.joinable()) c.th.join();
+				chef_release_gpu();
+				c.which = want;
+				c.state = 1;
+				const std::string dir = game_usrdir();
+				c.th = std::thread([dir, want]
+				{
+					auto& cc = g_chef;
+					const u64 t0 = GetTickCount64();
+					const bool ok = !dir.empty() && chef::load(cc.m, dir, want == 1);
+					vr_log("Chef: %s the %s chef from the game files%s%s (%zu vertices, %zu triangles, texture %ux%u, %llu ms)", ok ? "rebuilt" : "could not rebuild",
+						want ? "female" : "male", dir.empty() ? ": game folder not found" : "", ok ? "" : (": " + cc.m.error).c_str(), cc.m.v.size(), cc.m.idx.size() / 3,
+						cc.m.tw, cc.m.th, static_cast<unsigned long long>(GetTickCount64() - t0));
+					cc.state = ok ? 2 : 3;
+				});
+				return;
+			}
+			if (c.state != 2) return;
+			const auto& m = c.m;
+			if (!g.chef_gpu)
+			{
+				auto* dev = xr.device;
+				D3D11_BUFFER_DESC bd{};
+				bd.ByteWidth = static_cast<UINT>(m.idx.size() * 4);
+				bd.Usage = D3D11_USAGE_IMMUTABLE;
+				bd.BindFlags = D3D11_BIND_INDEX_BUFFER;
+				D3D11_SUBRESOURCE_DATA sd{m.idx.data()};
+				bool ok = SUCCEEDED(dev->CreateBuffer(&bd, &sd, &g.cib));
+				bd.ByteWidth = static_cast<UINT>(m.v.size() * sizeof(chef_gpu_vertex));
+				bd.Usage = D3D11_USAGE_DYNAMIC;
+				bd.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+				bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+				ok = ok && SUCCEEDED(dev->CreateBuffer(&bd, nullptr, &g.cvb));
+				static const u8 white[4] = {255, 255, 255, 255};
+				const bool have_tex = !m.rgba.empty();
+				D3D11_TEXTURE2D_DESC td{};
+				td.Width = have_tex ? m.tw : 1;
+				td.Height = have_tex ? m.th : 1;
+				td.MipLevels = have_tex ? 0 : 1;
+				td.ArraySize = 1;
+				td.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+				td.SampleDesc.Count = 1;
+				td.Usage = D3D11_USAGE_DEFAULT;
+				td.BindFlags = D3D11_BIND_SHADER_RESOURCE | (have_tex ? D3D11_BIND_RENDER_TARGET : 0);
+				td.MiscFlags = have_tex ? D3D11_RESOURCE_MISC_GENERATE_MIPS : 0;
+				ok = ok && SUCCEEDED(dev->CreateTexture2D(&td, nullptr, &g.ctex));
+				if (ok) xr.context->UpdateSubresource(g.ctex, 0, nullptr, have_tex ? m.rgba.data() : white, (have_tex ? m.tw : 1) * 4, 0);
+				ok = ok && SUCCEEDED(dev->CreateShaderResourceView(g.ctex, nullptr, &g.csrv));
+				if (ok && have_tex) xr.context->GenerateMips(g.csrv);
+				// The face's pictures
+				const auto picture = [&](const std::vector<u8>& px, u32 size, ID3D11Texture2D*& t, ID3D11ShaderResourceView*& v)
+				{
+					if (!size || px.size() < usz{size} * size * 4) return;
+					D3D11_TEXTURE2D_DESC fd{};
+					fd.Width = fd.Height = size;
+					fd.MipLevels = 1; fd.ArraySize = 1; fd.Format = DXGI_FORMAT_R8G8B8A8_UNORM; fd.SampleDesc.Count = 1;
+					fd.Usage = D3D11_USAGE_IMMUTABLE; fd.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+					D3D11_SUBRESOURCE_DATA fsd{px.data(), size * 4, 0};
+					if (SUCCEEDED(dev->CreateTexture2D(&fd, &fsd, &t))) dev->CreateShaderResourceView(t, nullptr, &v);
+				};
+				for (int k = 0; k < 3 && ok; k++) picture(m.face_rgba[k], m.face_size[k], g.ftex[k], g.fsrv[k]);
+				for (usz k = 0; k < m.mouth_rgba.size() && k < 4 && ok; k++) { picture(m.mouth_rgba[k], m.mouth_size, g.mtex[k], g.msrv[k]); if (g.msrv[k]) g.mouth_n = static_cast<u32>(k + 1); }
+				if (!ok) { vr_log("Chef: could not upload the chef to the GPU"); chef_release_gpu(); c.state = 3; return; }
+				g.cidx = static_cast<u32>(m.idx.size());
+				g.cnv = static_cast<u32>(m.v.size());
+				g.chef_gpu = true;
+			}
+
+			// Pose: the chef's eyes are yours; its arms reach for your controllers
+			chef::pose_in in;
+			in.head = xr.last_head;
+			in.head_q = xr.views_valid ? xr.views[0].pose.orientation : XrQuaternionf{0, 0, 0, 1};
+			in.body_yaw = xr.body_yaw;
+			in.floor_y = xr.floor_y;
+			in.scale = std::clamp(xr.unit, 0.6f, 1.5f);   // the same scale as the restaurant and the lobby (crouching no longer shrinks you)
+			for (int sd = 0; sd < 2; sd++)
+			{
+				in.hand_valid[sd] = xr.hand_valid[sd];
+				in.hand[sd] = xr.hand_pose[sd];
+				in.grip[sd] = xr.hand_grip[sd];
+				in.trig[sd] = xr.hand_trig[sd];
+			}
+			in.walk_phase = xr.walk_phase;
+			in.walk_amount = xr.walk_amount;
+			chef::rigid T[chef::P_COUNT];
+			vec3 root;
+			XrQuaternionf rq;
+			chef::solve(m, in, T, root, rq);
+			static std::vector<vec3> P, N;
+			chef::skin(m, T, root, rq, in.scale, P, N);
+			c.mouth = mic_mouth(xr);
+			if (false && m.mouth_rgba.size() == 1 && c.mouth > 0.02f && m.mouth_v1 > m.mouth_v0)
+			{
+				// One mouth picture (the female chef's lips): open by stretching it up and down
+				vec3 mc{};
+				for (u32 i = m.mouth_v0; i < m.mouth_v1; i++) mc = mc + P[i];
+				mc = mc * (1.f / (m.mouth_v1 - m.mouth_v0));
+				const vec3 up = rotate(T[chef::P_HEAD].q, vec3{0.f, 1.f, 0.f});
+				for (u32 i = m.mouth_v0; i < m.mouth_v1; i++)
+				{
+					const vec3 d = P[i] - mc;
+					P[i] = P[i] + up * (dot(d, up) * 1.6f * c.mouth);
+				}
+			}
+			D3D11_MAPPED_SUBRESOURCE ms{};
+			if (FAILED(xr.context->Map(g.cvb, 0, D3D11_MAP_WRITE_DISCARD, 0, &ms))) return;
+			auto* out = static_cast<chef_gpu_vertex*>(ms.pData);
+			for (usz i = 0; i < m.v.size(); i++)
+				out[i] = {{P[i].x, P[i].y, P[i].z}, {N[i].x, N[i].y, N[i].z}, {m.v[i].u, m.v[i].v}};
+			xr.context->Unmap(g.cvb, 0);
+			c.scale = in.scale;
+			c.eye_w = in.head;
+			c.posed = true;
+		}
+
+		// Draws the posed chef. clip_r > 0 cuts away a sphere around your eyes (first person).
+		void chef_draw(xr_state& xr, const mat4& vp, vec3 eye, f32 clip_r)
+		{
+			auto& g = g_gfx;
+			auto& c = g_chef;
+			if (!g.chef_gpu || !c.posed) return;
+			auto* ctx = xr.context;
+			chef_cb cb{};
+			std::memcpy(cb.vp, vp.m, sizeof(cb.vp));
+			cb.eye[0] = eye.x; cb.eye[1] = eye.y; cb.eye[2] = eye.z;
+			cb.clip[0] = c.eye_w.x; cb.clip[1] = c.eye_w.y; cb.clip[2] = c.eye_w.z; cb.clip[3] = clip_r;
+			cb.pad[0] = c.eye_w.y - 0.32f * c.scale;   // cut height: just above the chef's shoulders
+			cb.tint[0] = cb.tint[1] = cb.tint[2] = cb.tint[3] = 1.f;
+			ctx->UpdateSubresource(g.ccb, 0, nullptr, &cb, 0, 0);
+			ctx->IASetInputLayout(g.cil);
+			ctx->VSSetShader(g.cvs, nullptr, 0);
+			ctx->PSSetShader(g.cps, nullptr, 0);
+			ctx->VSSetConstantBuffers(0, 1, &g.ccb);
+			ctx->PSSetConstantBuffers(0, 1, &g.ccb);
+			ctx->PSSetShaderResources(0, 1, &g.csrv);
+			ctx->PSSetSamplers(0, 1, &g.csmp);
+			const UINT stride = sizeof(chef_gpu_vertex), offset = 0;
+			ctx->IASetVertexBuffers(0, 1, &g.cvb, &stride, &offset);
+			ctx->IASetIndexBuffer(g.cib, DXGI_FORMAT_R32_UINT, 0);
+			const auto& m = c.m;
+			ctx->DrawIndexed(m.range_count[chef::model::M_BODY], m.range_start[chef::model::M_BODY], 0);
+			// First person (clip_r > 0): your own head and face are not drawn, so nothing covers your eyes.
+			// In the mirror: the head, and the face with eyes that blink, brows, and a mouth that moves when you talk.
+			if (clip_r <= 0.f)
+			{
+				ctx->DrawIndexed(m.range_count[chef::model::M_HEAD], m.range_start[chef::model::M_HEAD], 0);
+				const u64 now = GetTickCount64();
+				const bool blink = (now % 4300) < 140;
+				const auto face = [&](int mat, ID3D11ShaderResourceView* v)
+				{
+					if (!m.range_count[mat] || !v) return;
+					ctx->PSSetShaderResources(0, 1, &v);
+					ctx->DrawIndexed(m.range_count[mat], m.range_start[mat], 0);
+				};
+				face(chef::model::M_EYES, blink && g.fsrv[1] ? g.fsrv[1] : g.fsrv[0]);
+				face(chef::model::M_BROWS, g.fsrv[2]);
+				if (g.mouth_n)
+				{
+					const f32 o = c.mouth;
+					u32 k = o < 0.12f ? 0 : o < 0.4f ? 1 : o < 0.7f ? 2 : 3;
+					face(chef::model::M_MOUTH, g.msrv[std::min(k, g.mouth_n - 1)]);
+				}
+			}
+			// back to the plain shapes pipeline
+			ID3D11ShaderResourceView* none = nullptr;
+			ctx->PSSetShaderResources(0, 1, &none);
+			ctx->IASetInputLayout(g.il);
+			ctx->VSSetShader(g.vs, nullptr, 0);
+			ctx->PSSetShader(g.ps, nullptr, 0);
+			ctx->VSSetConstantBuffers(0, 1, &g.cb);
+			ctx->PSSetConstantBuffers(0, 1, &g.cb);
+		}
+
+		// ---- The lobby: one of the game's own restaurants around the menu board (rebuilt from the game files at start-up)
+		struct lobby_runtime
+		{
+			std::thread th;
+			std::atomic<int> state{0};   // 0 not started, 1 loading, 2 ready, 3 failed
+			lobby::restaurant r;
+		};
+		lobby_runtime g_lobby;
+
+		void lobby_shutdown()
+		{
+			if (g_lobby.th.joinable()) g_lobby.th.join();
+		}
+
+		// Background load (once per run), then the upload to the GPU on the headset thread
+		void lobby_tick(xr_state& xr)
+		{
+			auto& g = g_gfx;
+			if (g_lobby.state == 0)
+			{
+				const std::string dir = game_usrdir();
+				if (dir.empty()) return;
+				g_lobby.state = 1;
+				int good[std::size(lobby::places)], n = 0;
+				for (int k = 0; k < static_cast<int>(std::size(lobby::places)); k++) if (lobby::places[k].lobby) good[n++] = k;
+				const int pick = good[(GetTickCount64() / 7) % n];
+				g_lobby.th = std::thread([dir, pick]
+				{
+					const u64 t0 = GetTickCount64();
+					const bool ok = lobby::load(g_lobby.r, dir, pick);
+					const auto& r = g_lobby.r;
+					vr_log("Lobby: %s %s from the game files%s%s (%zu vertices, %zu triangles, %zu batches, %zu pictures, stand at %.1f %.1f %.1f facing %.0f deg, %.1f m free, %llu ms)",
+						ok ? "rebuilt" : "could not rebuild", r.name.c_str(), ok ? "" : ": ", ok ? "" : r.error.c_str(), r.v.size(), r.idx.size() / 3, r.batches.size(), r.pics.size(),
+						r.spawn.x, r.spawn.y, r.spawn.z, r.facing * 57.29578f, r.board_dist, static_cast<unsigned long long>(GetTickCount64() - t0));
+					g_lobby.state = ok ? 2 : 3;
+				});
+				return;
+			}
+			if (g_lobby.state != 2 || g.lobby_gpu || g.lobby_failed || !g.lvs) return;
+			const auto& r = g_lobby.r;
+			auto* dev = xr.device;
+			D3D11_BUFFER_DESC bd{};
+			bd.Usage = D3D11_USAGE_IMMUTABLE;
+			bd.ByteWidth = static_cast<UINT>(r.v.size() * sizeof(lobby::vert));
+			bd.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+			D3D11_SUBRESOURCE_DATA sd{r.v.data()};
+			bool ok = SUCCEEDED(dev->CreateBuffer(&bd, &sd, &g.lvb));
+			bd.ByteWidth = static_cast<UINT>(r.idx.size() * 4);
+			bd.BindFlags = D3D11_BIND_INDEX_BUFFER;
+			sd.pSysMem = r.idx.data();
+			ok = ok && SUCCEEDED(dev->CreateBuffer(&bd, &sd, &g.lib));
+			g.lsrv.assign(r.pics.size(), nullptr);
+			g.ltex.assign(r.pics.size(), nullptr);
+			for (usz k = 0; k < r.pics.size() && ok; k++)
+			{
+				const auto& p = r.pics[k];
+				if (p.rgba.empty()) continue;
+				D3D11_TEXTURE2D_DESC td{};
+				td.Width = p.w; td.Height = p.h; td.MipLevels = 0; td.ArraySize = 1;
+				td.Format = DXGI_FORMAT_R8G8B8A8_UNORM; td.SampleDesc.Count = 1; td.Usage = D3D11_USAGE_DEFAULT;
+				td.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+				td.MiscFlags = D3D11_RESOURCE_MISC_GENERATE_MIPS;
+				if (FAILED(dev->CreateTexture2D(&td, nullptr, &g.ltex[k]))) continue;
+				xr.context->UpdateSubresource(g.ltex[k], 0, nullptr, p.rgba.data(), p.w * 4, 0);
+				if (SUCCEEDED(dev->CreateShaderResourceView(g.ltex[k], nullptr, &g.lsrv[k]))) xr.context->GenerateMips(g.lsrv[k]);
+			}
+			if (!ok) { vr_log("Lobby: could not upload the restaurant to the GPU"); g.lobby_failed = true; return; }
+			g.lobby_gpu = true;
+		}
+
+		// Draws the restaurant around the menu board: you stand on its freest floor, the board in its longest view.
+		// False when it is not ready (the plain diner is drawn instead).
+		bool lobby_draw(xr_state& xr)
+		{
+			auto& g = g_gfx;
+			if (!g.lobby_gpu) return false;
+			const auto& r = g_lobby.r;
+			auto* ctx = xr.context;
+			const vec3 normal{std::sin(xr.screen_yaw), 0.f, std::cos(xr.screen_yaw)};
+			// Seated: you see the restaurant as if standing (its floor 1.6 m below your eyes, measured when the board was
+			// placed), otherwise it towers over you. Standing: your real floor.
+			const f32 eyes = xr.screen_center.y + 0.10f;
+			const f32 k = xr.unit;   // one scale: your chef body, this lobby and the game's restaurant
+			const f32 floor = xr.comfort.seated || !xr.floor_known ? eyes - chef_eye_u * k : xr.floor_y;
+			vec3 A = xr.screen_center + normal * xr.screen_distance;
+			A.y = floor;
+			const f32 d = xr.screen_yaw - r.facing;
+			const f32 c = std::cos(d) * k, s = std::sin(d) * k;
+			mat4 M;
+			M.m[0] = c; M.m[2] = s;
+			M.m[5] = k;
+			M.m[8] = -s; M.m[10] = c;
+			M.m[3] = A.x - (c * r.spawn.x + s * r.spawn.z);
+			M.m[7] = A.y - k * r.spawn.y;
+			M.m[11] = A.z - (-s * r.spawn.x + c * r.spawn.z);
+			M.m[15] = 1.f;
+			lobby_cb cb{};
+			const mat4 mvp = mmul(g.vp, M);
+			std::memcpy(cb.mvp, mvp.m, sizeof(cb.mvp));
+			cb.params[1] = 1.f;
+			ctx->IASetInputLayout(g.lil);
+			ctx->VSSetShader(g.lvs, nullptr, 0);
+			ctx->PSSetShader(g.lps, nullptr, 0);
+			ctx->VSSetConstantBuffers(0, 1, &g.lcb);
+			ctx->PSSetConstantBuffers(0, 1, &g.lcb);
+			ctx->PSSetSamplers(0, 1, &g.lsmp);
+			const UINT stride = sizeof(lobby::vert), offset = 0;
+			ctx->IASetVertexBuffers(0, 1, &g.lvb, &stride, &offset);
+			ctx->IASetIndexBuffer(g.lib, DXGI_FORMAT_R32_UINT, 0);
+			ctx->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+			int cur = -1;
+			for (const auto& b : r.batches)
+			{
+				if (b.tex < 0 || b.tex >= static_cast<int>(g.lsrv.size()) || !g.lsrv[b.tex]) continue;
+				if (b.blend != cur)
+				{
+					cur = b.blend;
+					cb.params[0] = static_cast<f32>(cur);
+					ctx->UpdateSubresource(g.lcb, 0, nullptr, &cb, 0, 0);
+					const f32 bf[4] = {0, 0, 0, 0};
+					ctx->OMSetBlendState(cur == 2 ? g.bs_alpha : cur == 3 ? g.bs_add : nullptr, bf, 0xffffffff);
+					ctx->OMSetDepthStencilState(cur >= 2 ? g.ds_nowrite : g.ds_on, 0);
+				}
+				ctx->PSSetShaderResources(0, 1, &g.lsrv[b.tex]);
+				ctx->DrawIndexed(b.count, b.first, 0);
+			}
+			// back to the plain shapes pipeline
+			const f32 bf[4] = {0, 0, 0, 0};
+			ctx->OMSetBlendState(nullptr, bf, 0xffffffff);
+			ctx->OMSetDepthStencilState(g.ds_on, 0);
+			ID3D11ShaderResourceView* none = nullptr;
+			ctx->PSSetShaderResources(0, 1, &none);
+			ctx->IASetInputLayout(g.il);
+			ctx->VSSetShader(g.vs, nullptr, 0);
+			ctx->PSSetShader(g.ps, nullptr, 0);
+			ctx->VSSetConstantBuffers(0, 1, &g.cb);
+			ctx->PSSetConstantBuffers(0, 1, &g.cb);
+			return true;
+		}
