+		// The hand around the controller's grip pose. Fingers curl with GRIP (middle, ring, little) and TRIGGER (index).
+		struct hand_geo
+		{
+			vec3 palm, L, n, t, wrist, grab;
+			vec3 joints[5][4];
+			f32 rad[5];
+			XrQuaternionf q;
+			vec3 pos;
+			f32 side;
+		};
+
+		hand_geo make_hand(const XrPosef& g, int hand, f32 grip, f32 trig)
+		{
+			hand_geo h{};
+			const f32 s = hand ? 1.f : -1.f; // right = +1
+			h.side = s;
+			h.q = g.orientation;
+			h.pos = to_vec(g.position);
+			const auto W = [&](vec3 v) { return h.pos + rotate(h.q, v); };   // grip space -> LOCAL (points)
+			const auto R = [&](vec3 v) { return rotate(h.q, v); };           // directions
+
+			const vec3 n_g{-s, 0.f, 0.f};                      // palm faces the handle
+			const vec3 L_g = normalize({0.f, -0.55f, -0.83f});  // wrist -> fingertips, forward and down
+			vec3 t_g = normalize(cross(n_g, L_g));
+			if (t_g.y < 0.f) t_g = t_g * -1.f;                  // towards the thumb
+			const vec3 palm_g{s * 0.028f, -0.005f, 0.025f};
+
+			h.L = R(L_g); h.n = R(n_g); h.t = R(t_g);
+			h.palm = W(palm_g);
+			h.wrist = h.palm - h.L * 0.075f;
+			h.grab = h.palm + h.L * 0.065f;
+
+			const f32 curl_idx = std::clamp(trig, 0.08f, 1.f), curl = std::clamp(grip, 0.12f, 1.f);
+			const f32 spread[4] = {0.025f, 0.008f, -0.009f, -0.025f};
+			const f32 seg[4][3] = {{0.042f, 0.026f, 0.020f}, {0.046f, 0.029f, 0.021f}, {0.043f, 0.027f, 0.020f}, {0.035f, 0.021f, 0.018f}};
+			const f32 radius[4] = {0.0095f, 0.0098f, 0.0093f, 0.0085f};
+			const vec3 k = normalize(cross(h.L, h.n));
+			for (int f = 0; f < 4; f++)
+			{
+				const f32 c = f == 0 ? curl_idx : curl;
+				vec3 p = h.palm + h.L * 0.042f + h.t * spread[f];
+				h.joints[f][0] = p;
+				f32 ang = 0.f;
+				const f32 bend[3] = {1.35f, 1.6f, 1.1f};
+				for (int j = 0; j < 3; j++)
+				{
+					ang += c * bend[j];
+					const vec3 dir = h.L * std::cos(ang) + h.n * std::sin(ang); // rotate L towards the palm about k
+					(void)k;
+					p = p + dir * seg[f][j];
+					h.joints[f][j + 1] = p;
+				}
+				h.rad[f] = radius[f];
+			}
+			// Thumb: rests on the controller face, presses down a little with GRIP
+			{
+				const f32 c = 0.25f + 0.55f * curl;
+				vec3 p = h.palm + h.t * 0.03f - h.L * 0.015f + h.n * 0.012f;
+				const vec3 d0 = normalize(h.L * 0.55f + h.t * 0.55f + h.n * 0.35f);
+				h.joints[4][0] = p;
+				const f32 seg_t[3] = {0.034f, 0.03f, 0.024f};
+				f32 ang = 0.f;
+				for (int j = 0; j < 3; j++)
+				{
+					ang += c * 0.5f;
+					const vec3 dir = normalize(d0 * std::cos(ang) + h.n * std::sin(ang));
+					p = p + dir * seg_t[j];
+					h.joints[4][j + 1] = p;
+				}
+				h.rad[4] = 0.011f;
+			}
+			return h;
+		}
+
+		const vec3 c_skin{0.86f, 0.66f, 0.52f}, c_jacket{0.93f, 0.93f, 0.91f}, c_apron{0.22f, 0.33f, 0.55f},
+			c_pants{0.13f, 0.13f, 0.15f}, c_shoe{0.07f, 0.06f, 0.06f};
+
+		void draw_hand(xr_state& xr, const hand_geo& h)
+		{
+			draw_ellipsoid(xr, h.palm, h.L, h.t, h.n, {0.048f, 0.043f, 0.017f}, c_skin);
+			draw_limb(xr, h.wrist, h.palm - h.L * 0.02f, 0.024f, 0.026f, c_skin);
+			for (int f = 0; f < 5; f++)
+			{
+				for (int j = 0; j < 3; j++)
+				{
+					const f32 r0 = h.rad[f] * (1.f - 0.12f * j), r1 = h.rad[f] * (1.f - 0.12f * (j + 1));
+					draw_limb(xr, h.joints[f][j], h.joints[f][j + 1], r0, r1, c_skin);
+				}
+			}
+		}
