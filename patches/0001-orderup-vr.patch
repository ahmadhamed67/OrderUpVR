+			n.prev_grip = gdown;
+			if (!tdown) { n.dead &= ~1; n.clamp &= ~1; }
+			if (!gdown) { n.dead &= ~2; n.clamp &= ~2; }
+			if (n.buzz2_at && now >= n.buzz2_at) { buzz(xr, n.buzz2_hand, 0.25f, 45); n.buzz2_at = 0; }
+			const bool in3d = xr.live3d && xr.mode3d && cam.valid && cam.room && out.active && !xr.chooser_active;
+			// (the left GRIP that takes out or puts away the EXIT button, and the hand pushing it, are not presses for the game)
+			bool exit_grip = hand == 1 && xr.xb_squeeze_since;
+			if (hand == 0 && g_edge && xr.hand_valid[0]) exit_grip = xr.xb_out || exit_zone(xr, true);
