+		void update_input(xr_state& xr, XrTime time, f32 dt)
+		{
+			pointer_state out;
+
+			// Head pose (used to place the screen)
+			XrSpaceLocation head{XR_TYPE_SPACE_LOCATION};
+			if (XR_SUCCEEDED(xrLocateSpace(xr.view_space, xr.local_space, time, &head)) &&
+				(head.locationFlags & XR_SPACE_LOCATION_POSITION_VALID_BIT) && (head.locationFlags & XR_SPACE_LOCATION_ORIENTATION_VALID_BIT))
+			{
+				xr.last_head = to_vec(head.pose.position);
+				xr.last_forward = rotate(head.pose.orientation, {0.0f, 0.0f, -1.0f});
+				if (!xr.screen_placed) place_screen(xr);
+			}
+
+			if (xr.session_state == XR_SESSION_STATE_FOCUSED)
+			{
+				XrActiveActionSet active{xr.action_set, XR_NULL_PATH};
+				XrActionsSyncInfo sync{XR_TYPE_ACTIONS_SYNC_INFO};
+				sync.countActiveActionSets = 1;
+				sync.activeActionSets = &active;
+				xrSyncActions(xr.session, &sync);
+
+				const f32 trig[2] = {get_float(xr, xr.trigger, 0), get_float(xr, xr.trigger, 1)};
+				const f32 grip[2] = {get_float(xr, xr.squeeze, 0), get_float(xr, xr.squeeze, 1)};
+
+				// The hand that pulls its trigger or grip while the other one is idle becomes the pointer hand.
+				const int other = 1 - xr.active_hand;
+				// (a hand carrying a board is idle for this: its GRIP is the board's)
+				const f32 press_other = std::max(trig[other], grip[other]),
+					press_active = std::max(trig[xr.active_hand], xr.grip_block[xr.active_hand] ? 0.f : grip[xr.active_hand]);
+				// (not the left GRIP over your shoulder that takes out or puts away the EXIT button, nor the left hand holding it)
+				const bool exit_left = other == 0 && (xr.xb_out || xr.xb_arm_since || (grip[0] > 0.5f && exit_zone(xr, true)));
+				// (nor a hand closing on a board's frame, or carrying a board: that GRIP takes the board, not food)
+				const bool board_other = xr.grip_block[other] || (xr.board_hover[other] >= 0 && grip[other] > 0.5f && trig[other] < 0.5f);
+				if (press_other > 0.5f && press_active < 0.2f && !exit_left && !board_other)
+				{
+					xr.active_hand = other;
+					vr_log("Pointer hand: %s", other ? "right" : "left");
+				}
+				const int hand = xr.active_hand;
+
+				// Hands for the body: grip poses, finger curl
+				for (int h = 0; h < 2; h++)
+				{
+					XrSpaceLocation gl{XR_TYPE_SPACE_LOCATION};
+					xr.hand_valid[h] = xr.grip_space[h] != XR_NULL_HANDLE && XR_SUCCEEDED(xrLocateSpace(xr.grip_space[h], xr.local_space, time, &gl)) &&
+						(gl.locationFlags & XR_SPACE_LOCATION_POSITION_VALID_BIT) && (gl.locationFlags & XR_SPACE_LOCATION_ORIENTATION_VALID_BIT);
+					if (xr.hand_valid[h])
+					{
+						xr.hand_pose[h] = gl.pose;
+						xr.hand_ray_origin[h] = to_vec(gl.pose.position);
+						xr.hand_ray_dir[h] = normalize(rotate(gl.pose.orientation, vec3{0.f, 0.f, -1.f}));
+					}
+					xr.hand_grip[h] = grip[h];
+					xr.hand_trig[h] = trig[h];
+				}
+				// The boards you can pick up: a GRIP closing on a board's frame takes it (and that GRIP never reaches the game)
+				update_boards(xr, grip, GetTickCount64());
+				// Floor height (for the legs) and the body turning after the head
+				if (xr.stage_space != XR_NULL_HANDLE)
+				{
+					XrSpaceLocation sl{XR_TYPE_SPACE_LOCATION};
+					if (XR_SUCCEEDED(xrLocateSpace(xr.stage_space, xr.local_space, time, &sl)) && (sl.locationFlags & XR_SPACE_LOCATION_POSITION_VALID_BIT))
+					{
+						xr.floor_y = sl.pose.position.y;
+						if (!xr.floor_known || xr.floor_src != 1)
+						{
+							xr.floor_since = GetTickCount64();
+							vr_log("Height (auto): the headset gives your floor, %.2f m below your eyes", xr.last_head.y - xr.floor_y);
+						}
+						xr.floor_known = true;
+						xr.floor_src = 1;
+					}
+				}
+				// No floor from the headset (no guardian / stage space): your hands find it. The lowest a controller has been
+				// (when you reach down and touch the floor, it is right there) counts once it is more than 1.1 m below your eyes.
+				// Only while the controller is in your hand (it moved in the last half second): a controller lying still on a
+				// table or on the floor while you put the headset on is not your floor.
