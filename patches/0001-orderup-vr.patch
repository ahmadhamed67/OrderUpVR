+				s.hold_picked = true;
+			}
+			s.hold_cands.clear();
+			// Your hand: room -> player frame -> levelled anchor space -> this frame's game camera space
+			const vec3 pp = rotate(qconj(yaw_q(v.player_yaw)), s.hand_local - v.player_pos) * (1.f / std::max(v.unit, 0.05f));
