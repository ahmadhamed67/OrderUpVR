+				g_cam.still = s.still;
+				g_cam.moves = s.moves;
+				g_cam.cinema = s.cinema;
+				g_cam.hud_k = s.hud_k;
+				g_cam.n2 = s.n2;
+				g_cam.auto_unit = s.auto_unit;
