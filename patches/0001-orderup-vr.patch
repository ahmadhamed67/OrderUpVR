+					{xr.btn_a, to_path(xr, "/user/hand/right/input/menu/click")},
+				};
+				XrInteractionProfileSuggestedBinding suggested{XR_TYPE_INTERACTION_PROFILE_SUGGESTED_BINDING};
+				suggested.interactionProfile = to_path(xr, "/interaction_profiles/khr/simple_controller");
+				suggested.suggestedBindings = bindings;
+				suggested.countSuggestedBindings = static_cast<u32>(std::size(bindings));
+				xr_ok(xr, xrSuggestInteractionProfileBindings(xr.instance, &suggested), "suggest bindings (simple)");
+			}
+
+			for (int hand = 0; hand < 2; hand++)
+			{
+				XrActionSpaceCreateInfo info{XR_TYPE_ACTION_SPACE_CREATE_INFO};
+				info.action = xr.aim;
+				info.subactionPath = xr.hand_path[hand];
+				info.poseInActionSpace.orientation.w = 1.0f;
+				if (!xr_ok(xr, xrCreateActionSpace(xr.session, &info, &xr.aim_space[hand]), "xrCreateActionSpace")) return false;
+			}
+
+			XrSessionActionSetsAttachInfo attach{XR_TYPE_SESSION_ACTION_SETS_ATTACH_INFO};
+			attach.countActionSets = 1;
+			attach.actionSets = &xr.action_set;
+			return xr_ok(xr, xrAttachSessionActionSets(xr.session, &attach), "xrAttachSessionActionSets");
+		}
+
+		// Picks an 8-bit colour format the runtime supports. Returns 0 if none.
+		s64 pick_format(xr_state& xr, bool& is_bgra)
+		{
+			u32 count = 0;
+			xrEnumerateSwapchainFormats(xr.session, 0, &count, nullptr);
+			std::vector<s64> formats(count);
+			if (!xr_ok(xr, xrEnumerateSwapchainFormats(xr.session, count, &count, formats.data()), "xrEnumerateSwapchainFormats")) return 0;
+
+			// The images are gamma encoded, so prefer sRGB formats.
+			const struct { DXGI_FORMAT format; bool bgra; } wanted[] =
+			{
+				{DXGI_FORMAT_R8G8B8A8_UNORM_SRGB, false},
+				{DXGI_FORMAT_B8G8R8A8_UNORM_SRGB, true},
+				{DXGI_FORMAT_R8G8B8A8_UNORM, false},
+				{DXGI_FORMAT_B8G8R8A8_UNORM, true},
+			};
+			for (const auto& w : wanted)
+			{
+				if (std::find(formats.begin(), formats.end(), static_cast<s64>(w.format)) != formats.end())
+				{
+					is_bgra = w.bgra;
+					return w.format;
+				}
+			}
+			vr_log("ERROR: the VR runtime offers no 8-bit RGBA swapchain format");
+			return 0;
+		}
+
+		// RPCS3's own first-start preparation progress (the same numbers its progress dialog shows).
+		bool get_progress(u32& percent, std::string& text, u32& done, u32& total)
+		{
+			const u32 ftotal = g_progr_ftotal, ptotal = g_progr_ptotal, pdone = g_progr_pdone;
+			const u64 ftotal_bits = g_progr_ftotal_bits, fknown_bits = g_progr_fknown_bits;
+			if (!ftotal && !ptotal) return false;
+			const bool use_bits = fknown_bits && ftotal_bits;
+			const u64 known = use_bits ? fknown_bits : ftotal;
+			const u64 all = std::max<u64>(ptotal, 1) * std::max<u64>(use_bits ? ftotal_bits : ftotal, 1) / std::max<u64>(known, 1);
+			percent = pdone >= all ? 100 : static_cast<u32>(pdone * 100 / all);
+			text = std::string(g_progr_text);
+			done = pdone;
+			total = ptotal;
+			return true;
+		}
+
+		// What the status panel should say right now. Empty = the game picture is live, no panel.
+		// A first line "@progress=N" makes the panel draw a progress bar at N percent.
+		std::string panel_message()
+		{
+			const u64 now = GetTickCount64();
+
+			static u64 progress_since = 0;
+			static u32 logged_percent = 1000;
+			u32 percent = 0, done = 0, total = 0;
+			std::string what;
+			if (get_progress(percent, what, done, total))
+			{
+				if (!progress_since) progress_since = now;
+				if (percent / 5 != logged_percent / 5) { vr_log("Progress: %u%% %s (%u of %u)", percent, what.c_str(), done, total); logged_percent = percent; }
+
+				// While the game picture is already live, RPCS3 draws its own progress on it; do not cover it.
+				const u64 live_frame = g_last_frame_tick.load();
+				if (live_frame && now - live_frame < 3000) return {};
+
+				char eta[96] = "";
+				const u64 elapsed = (now - progress_since) / 1000;
+				if (percent >= 3 && percent < 100 && elapsed >= 10)
+				{
+					const u64 left = elapsed * (100 - percent) / percent;
+					if (left >= 90) std::snprintf(eta, sizeof(eta), "About %llu minutes left.", static_cast<unsigned long long>((left + 30) / 60));
+					else std::snprintf(eta, sizeof(eta), "Less than 2 minutes left.");
+				}
+				char buf[768];
+				std::snprintf(buf, sizeof(buf),
+					"@progress=%u\nPreparing the game for this PC:  %u%%\n%s%s\n\nThis happens only on the first start and after an update. %s",
+					percent, percent, what.empty() ? "Compiling" : what.c_str(),
+					total ? (" (" + std::to_string(done) + " of " + std::to_string(total) + ")").c_str() : "", eta);
+				return buf;
+			}
+			progress_since = 0;
+			const u64 last_frame = g_last_frame_tick.load();
+			const u64 no_window = g_window_unavailable_tick.load();
+
+			if (last_frame && now - last_frame < 3000) return {};
+
+			if (no_window && now - no_window < 2000)
+			{
+				return "The game window on the PC is minimized.\n\nRestore the Order Up!! window on the PC (click it in the taskbar). "
+					"The headset can only show the game while that window is open.";
+			}
+			if (last_frame)
+			{
+				return "Waiting for the game picture...\n\nThe game is busy loading.\nIf this stays for minutes, close the game and press Collect logs in the launcher.";
+			}
+
+			const u64 secs = (now - g_start_tick.load()) / 1000;
+			char buf[512];
+			std::snprintf(buf, sizeof(buf),
+				"Starting Order Up!!...   %llu s\n\nThe first start after an update prepares the game for this PC and can take a few minutes. "
+				"Later starts are quick.\n\nThe game also opens in a window on the PC monitor. Keep that window open.",
+				static_cast<unsigned long long>(secs));
+			return buf;
+		}
+
+		// Draws the panel text with GDI and uploads it to the panel swapchain.
+		void draw_panel(xr_state& xr, const std::string& text)
+		{
+			if (xr.panel == XR_NULL_HANDLE)
+			{
+				const s64 format = pick_format(xr, xr.panel_is_bgra);
+				if (!format) return;
+
+				XrSwapchainCreateInfo info{XR_TYPE_SWAPCHAIN_CREATE_INFO};
+				info.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_SAMPLED_BIT;
+				info.format = format;
+				info.sampleCount = 1;
+				info.width = panel_w;
+				info.height = panel_h;
+				info.faceCount = 1;
+				info.arraySize = 1;
+				info.mipCount = 1;
+				if (!xr_ok(xr, xrCreateSwapchain(xr.session, &info, &xr.panel), "xrCreateSwapchain(panel)")) return;
+
+				u32 count = 0;
+				xrEnumerateSwapchainImages(xr.panel, 0, &count, nullptr);
+				xr.panel_images.assign(count, XrSwapchainImageD3D11KHR{XR_TYPE_SWAPCHAIN_IMAGE_D3D11_KHR});
+				if (!xr_ok(xr, xrEnumerateSwapchainImages(xr.panel, count, &count,
+					reinterpret_cast<XrSwapchainImageBaseHeader*>(xr.panel_images.data())), "xrEnumerateSwapchainImages(panel)"))
+				{
+					xrDestroySwapchain(xr.panel);
+					xr.panel = XR_NULL_HANDLE;
+					return;
+				}
+			}
+
+			HDC dc = CreateCompatibleDC(nullptr);
+			BITMAPINFO bmi{};
+			bmi.bmiHeader.biSize = sizeof(bmi.bmiHeader);
+			bmi.bmiHeader.biWidth = panel_w;
+			bmi.bmiHeader.biHeight = -static_cast<LONG>(panel_h); // top-down
+			bmi.bmiHeader.biPlanes = 1;
+			bmi.bmiHeader.biBitCount = 32;
+			bmi.bmiHeader.biCompression = BI_RGB;
+			void* bits = nullptr;
+			HBITMAP bmp = CreateDIBSection(dc, &bmi, DIB_RGB_COLORS, &bits, nullptr, 0);
+			if (!bmp || !bits)
+			{
+				DeleteDC(dc);
+				return;
+			}
+			HGDIOBJ old_bmp = SelectObject(dc, bmp);
+
+			RECT all{0, 0, static_cast<LONG>(panel_w), static_cast<LONG>(panel_h)};
+			HBRUSH bg = CreateSolidBrush(RGB(24, 26, 32));
+			FillRect(dc, &all, bg);
+			DeleteObject(bg);
+			RECT bar{0, 0, static_cast<LONG>(panel_w), 10};
+			HBRUSH accent = CreateSolidBrush(RGB(242, 108, 36));
+			FillRect(dc, &bar, accent);
+			DeleteObject(accent);
+
+			SetBkMode(dc, TRANSPARENT);
+			HFONT title = CreateFontW(64, 0, 0, 0, FW_BOLD, 0, 0, 0, DEFAULT_CHARSET, 0, 0, ANTIALIASED_QUALITY, 0, L"Segoe UI");
+			HFONT body = CreateFontW(34, 0, 0, 0, FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET, 0, 0, ANTIALIASED_QUALITY, 0, L"Segoe UI");
+
+			HGDIOBJ old_font = SelectObject(dc, title);
+			SetTextColor(dc, RGB(242, 108, 36));
+			RECT rt{48, 36, static_cast<LONG>(panel_w) - 48, 120};
+			DrawTextW(dc, L"ORDER UP VR", -1, &rt, DT_LEFT | DT_TOP | DT_SINGLELINE);
+
+			// Optional progress bar
+			std::string msg_body = text;
+			int bar_percent = -1;
+			if (msg_body.rfind("@progress=", 0) == 0)
+			{
+				bar_percent = std::clamp(std::atoi(msg_body.c_str() + 10), 0, 100);
+				const usz nl = msg_body.find('\n');
+				msg_body = nl == std::string::npos ? std::string() : msg_body.substr(nl + 1);
+			}
+			if (bar_percent >= 0)
+			{
+				const LONG x0 = 48, x1 = static_cast<LONG>(panel_w) - 48, y0 = static_cast<LONG>(panel_h) - 74, y1 = y0 + 22;
+				HBRUSH track = CreateSolidBrush(RGB(52, 58, 70));
+				HBRUSH fill = CreateSolidBrush(RGB(255, 138, 0));
+				HGDIOBJ old_pen = SelectObject(dc, GetStockObject(NULL_PEN));
+				HGDIOBJ old_brush = SelectObject(dc, track);
+				RoundRect(dc, x0, y0, x1, y1, 22, 22);
+				const LONG xf = x0 + (x1 - x0) * bar_percent / 100;
+				if (xf > x0 + 22)
+				{
+					SelectObject(dc, fill);
+					RoundRect(dc, x0, y0, xf, y1, 22, 22);
+				}
+				SelectObject(dc, old_brush);
+				SelectObject(dc, old_pen);
+				DeleteObject(track);
+				DeleteObject(fill);
+			}
+
+			wchar_t wide[1024]{};
+			MultiByteToWideChar(CP_UTF8, 0, msg_body.c_str(), -1, wide, 1023);
+			SelectObject(dc, body);
+			SetTextColor(dc, RGB(235, 235, 240));
+			RECT rb{48, 130, static_cast<LONG>(panel_w) - 48, static_cast<LONG>(panel_h) - 30};
+			DrawTextW(dc, wide, -1, &rb, DT_LEFT | DT_TOP | DT_WORDBREAK);
+
+			SelectObject(dc, old_font);
+			DeleteObject(title);
+			DeleteObject(body);
+			GdiFlush();
+
+			// GDI gives BGRX; set alpha and swap to RGBA when needed.
+			u8* px = static_cast<u8*>(bits);
+			for (u32 i = 0; i < panel_w * panel_h; i++, px += 4)
+			{
+				if (!xr.panel_is_bgra) std::swap(px[0], px[2]);
+				px[3] = 255;
+			}
+
+			u32 index = 0;
+			XrSwapchainImageAcquireInfo acquire{XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+			if (XR_SUCCEEDED(xrAcquireSwapchainImage(xr.panel, &acquire, &index)))
+			{
+				XrSwapchainImageWaitInfo wait{XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO};
+				wait.timeout = XR_INFINITE_DURATION;
+				if (XR_SUCCEEDED(xrWaitSwapchainImage(xr.panel, &wait)))
+				{
+					xr.context->UpdateSubresource(xr.panel_images[index].texture, 0, nullptr, bits, panel_w * 4, 0);
+					xr.panel_has_image = true;
+				}
+				XrSwapchainImageReleaseInfo release{XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+				xrReleaseSwapchainImage(xr.panel, &release);
+			}
+
+			SelectObject(dc, old_bmp);
+			DeleteObject(bmp);
+			DeleteDC(dc);
+		}
+
+		bool create_swapchain(xr_state& xr, u32 width, u32 height)
+		{
+			if (xr.swapchain != XR_NULL_HANDLE)
+			{
+				xrDestroySwapchain(xr.swapchain);
+				xr.swapchain = XR_NULL_HANDLE;
+				xr.images.clear();
+				xr.have_image = false;
+			}
+
+			xr.swapchain_format = pick_format(xr, xr.swapchain_is_bgra);
+			if (!xr.swapchain_format) return false;
+
+			XrSwapchainCreateInfo info{XR_TYPE_SWAPCHAIN_CREATE_INFO};
+			info.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_SAMPLED_BIT;
+			info.format = xr.swapchain_format;
+			info.sampleCount = 1;
+			info.width = width;
+			info.height = height;
+			info.faceCount = 1;
+			info.arraySize = 1;
+			info.mipCount = 1;
+			if (!xr_ok(xr, xrCreateSwapchain(xr.session, &info, &xr.swapchain), "xrCreateSwapchain")) return false;
+
+			u32 count = 0;
+			xrEnumerateSwapchainImages(xr.swapchain, 0, &count, nullptr);
+			xr.images.assign(count, XrSwapchainImageD3D11KHR{XR_TYPE_SWAPCHAIN_IMAGE_D3D11_KHR});
+			if (!xr_ok(xr, xrEnumerateSwapchainImages(xr.swapchain, count, &count,
+				reinterpret_cast<XrSwapchainImageBaseHeader*>(xr.images.data())), "xrEnumerateSwapchainImages"))
+			{
+				return false;
+			}
+
+			xr.sc_w = width;
+			xr.sc_h = height;
+			vr_log("Screen swapchain: %ux%u, format %lld, %u images", width, height, static_cast<long long>(xr.swapchain_format), count);
+			return true;
+		}
+
+		// Copies the newest game frame (if any) into the swapchain.
+		void upload_frame(xr_state& xr)
+		{
+			std::vector<u8> frame;
+			u32 w = 0, h = 0;
+			bool bgra = false;
+			{
+				std::lock_guard lock(g_state_mutex);
+				if (g_frame_id == xr.shown_frame_id || g_frame.empty()) return;
+				frame.swap(g_frame);
+				w = g_frame_w;
+				h = g_frame_h;
+				bgra = g_frame_bgra;
+				xr.shown_frame_id = g_frame_id;
+			}
+
+			if (!w || !h || frame.size() < static_cast<usz>(w) * h * 4) return;
+
+			if (xr.swapchain == XR_NULL_HANDLE || xr.sc_w != w || xr.sc_h != h)
+			{
+				if (!create_swapchain(xr, w, h)) return;
+			}
+
+			if (bgra != xr.swapchain_is_bgra)
+			{
+				u8* p = frame.data();
+				for (usz i = 0, n = static_cast<usz>(w) * h; i < n; i++, p += 4) std::swap(p[0], p[2]);
+			}
+
+			u32 index = 0;
+			XrSwapchainImageAcquireInfo acquire{XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+			if (XR_FAILED(xrAcquireSwapchainImage(xr.swapchain, &acquire, &index))) return;
+
+			XrSwapchainImageWaitInfo wait{XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO};
+			wait.timeout = XR_INFINITE_DURATION;
+			if (XR_SUCCEEDED(xrWaitSwapchainImage(xr.swapchain, &wait)))
+			{
+				xr.context->UpdateSubresource(xr.images[index].texture, 0, nullptr, frame.data(), w * 4, 0);
+				xr.have_image = true;
+			}
+
+			XrSwapchainImageReleaseInfo release{XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+			xrReleaseSwapchainImage(xr.swapchain, &release);
+		}
+
+		f32 get_float(xr_state& xr, XrAction action, int hand)
