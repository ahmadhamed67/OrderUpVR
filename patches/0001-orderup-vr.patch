+				}
+			}
+			m.last_target = t;
+
+			// Is the picture still? (the first 3D draw of the frame did not change)
+			f32 diff = 0.f;
+			for (int i = 0; i < 16; i++) diff = std::max(diff, std::fabs(fp[i] - m.fp_prev[i]));
+			const bool still = diff < 1e-5f;
+
+			const u64 now = GetTickCount64();
+
+			// A running experiment: did the picture react?
+			if (!m.exp.empty())
+			{
+				m.exp_frames++;
+				const bool reacted = diff > 1e-4f;
+				if (reacted || m.exp_frames >= 8)
+				{
+					int rewritten = 0;
+					for (const auto& w : m.exp)
+					{
+						bool over = false;
+						for (usz i = 0; i < w.neu.size(); i++) over |= rd(w.addr + static_cast<u32>(i) * 4) != w.neu[i];
+						if (over) { rewritten++; continue; }
+						if (vm::check_addr(w.addr, vm::page_writable, static_cast<u32>(w.orig.size() * 4)))
+							for (usz i = 0; i < w.orig.size(); i++) *static_cast<u32*>(vm::base(w.addr + static_cast<u32>(i) * 4)) = _byteswap_ulong(w.orig[i]);
+					}
+					std::vector<std::pair<u32, int>> keys;
+					for (const auto& w : m.exp) keys.emplace_back(w.addr, w.type);
+					const int frames = m.exp_frames;
+					const bool group = m.exp_group, from_half = m.exp_from_half;
