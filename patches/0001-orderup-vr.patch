+	// Mods offered in the launcher. "Unlock all restaurants": the game's one "is this restaurant locked?" check
+	// (0x000c00a4, used by Quick Play, the map and the scripts) answers "no". Your save is not changed.
+	void note_game(const std::string& exe_hash)
+	{
+		g_game_known = exe_hash == "PPU-c3913dc2ab47a1d91cb6d2384a4d1df3235b11cf";
+	}
+
+	void apply_code_patches(const std::string& exe_hash, const std::function<u8*(u32, u32)>& ptr, std::vector<u32>& applied)
+	{
+		if (exe_hash != "PPU-c3913dc2ab47a1d91cb6d2384a4d1df3235b11cf") return;   // Order Up!! (EU, BLES01470) only
+		g_game_known = true;
+		std::map<std::string, std::string> kv;
+		for (const std::string& path : {fs::get_config_dir(true) + "orderupvr_mods.txt", fs::get_config_dir() + "orderupvr_mods.txt"})
+		{
+			if (std::FILE* f = std::fopen(path.c_str(), "r"))
+			{
+				char line[128];
+				while (std::fgets(line, sizeof(line), f))
+				{
+					std::string l(line);
+					while (!l.empty() && (l.back() == 10 || l.back() == 13 || l.back() == 32)) l.pop_back();
+					if (const usz eq = l.find('='); eq != std::string::npos) kv[l.substr(0, eq)] = l.substr(eq + 1);
+				}
+				std::fclose(f);
+				break;
+			}
+		}
+		// Crash guard (always on): the kitchen start code (0x92f78) looks an item up by id (0x9e638, a list search that
+		// gives null when the id is missing, as for a restaurant opened before its career unlocks it) and hands the result
+		// to 0x9e068, which reads 0x10(r31) from it: an access violation, the emulator freezes ("PS3 application has likely
+		// crashed", 2026-11-24 14:23:59 at 0x92fd0). 0x9e068 now returns 0 at once for null, the answer it already gives
+		// for "nothing there" (its caller then skips that step). Room for the check: its own "cmpwi r4,0 / beq" tests a
+		// constant (r4 = 0x32b430) and never branches, so the prologue moves down two words over it. 2 callers, no branch
+		// lands inside the moved words.
+		{
+			static const u32 was[22] = {0xf821ff41, 0x7c0802a6, 0xf80100d0, 0xfbe100b8, 0x607f0000, 0x3c600037, 0x8063b430, 0x8063000c, 0x3063002c, 0x78630020, 0x3c800033,
+				0x3084b430, 0xfbc100b0, 0xfba100a8, 0xfb8100a0, 0xfb610098, 0xfb410090, 0xfb210088, 0xfb010080, 0xfae10078, 0x2c040000, 0x41820100};
+			bool same = true;
+			for (u32 k = 0; k < 22 && same; k++)
+			{
+				const u8* p = ptr(0x9e068 + k * 4, 4);
+				same = p && static_cast<u32>(p[0] << 24 | p[1] << 16 | p[2] << 8 | p[3]) == was[k];
+			}
+			if (same)
+			{
+				for (u32 k = 0; k < 22; k++)
+				{
+					const u32 v = k == 0 ? 0x2c030000u : k == 1 ? 0x4d820020u : was[k - 2];   // cmpwi r3,0 ; beqlr ; the prologue
+					u8* p = ptr(0x9e068 + k * 4, 4);
+					p[0] = static_cast<u8>(v >> 24); p[1] = static_cast<u8>(v >> 16); p[2] = static_cast<u8>(v >> 8); p[3] = static_cast<u8>(v);
+					applied.push_back(0x9e068 + k * 4);
+				}
+			}
+			vr_log("Fix: kitchen start crash guard %s", same ? "applied" : "not applied (unexpected game code)");
+		}
+		// Safety net (always on): this game reads through null pointers when something it looks for is not there (a
+		// restaurant or the competition opened in a state the game did not expect): the emulator froze ("PS3 application
+		// has likely crashed", 2026-11-24 14:23 and 15:13, in the competition's arena). The page under the program
+		// (0x0-0xFFFF: nothing of the game lives there, it starts at 0x10000) becomes read-only zeros, so such a read finds
+		// "nothing" (0), which the game's own checks then handle, instead of stopping the emulation. Writes there still stop.
+		{
+			bool ok = false;
+			if (!vm::check_addr(0))
+				if (const auto blk = vm::map(0, 0x10000, 0))
+					ok = blk->falloc(0, 0x10000, nullptr, vm::alloc_unwritable);
+			vr_log("Fix: zero page under the program %s", ok ? "mapped (null reads give 0)" : "not mapped");
+		}
+		if (kv["enabled"] == "off") return;
+		const auto write = [&](u32 addr, u32 expect, u32 value) -> bool
+		{
+			u8* p = ptr(addr, 4);
+			if (!p) return false;
+			const u32 cur = static_cast<u32>(p[0] << 24 | p[1] << 16 | p[2] << 8 | p[3]);
+			if (cur != expect) return false;
+			p[0] = static_cast<u8>(value >> 24); p[1] = static_cast<u8>(value >> 16); p[2] = static_cast<u8>(value >> 8); p[3] = static_cast<u8>(value);
+			applied.push_back(addr);
+			return true;
+		};
+		if (kv["unlock_restaurants"] == "on")
+		{
+			// li r3,0 ; blr  (was: lbz r5,0x12(r3) ; cmpwi r5,0)
+			const bool ok = write(0x000c00a4, 0x88a30012, 0x38600000) && write(0x000c00a8, 0x2c050000, 0x4e800020);
+			vr_log("Mods: unlock all restaurants %s", ok ? "applied" : "could not be applied (unexpected game code)");
+		}
+	}
