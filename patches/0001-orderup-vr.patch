+		// The 3D scene transform (frame's own eye) or the 2D overlay transform (the eye of the frame whose scene
+		// picture is in the target, so the HUD lines up with it).
+		bool rv_build(bool scene, u64 gen, bool backdrop = false)
+		{
+			auto& s = g_rv;
+			const auto& c = s.cam;
+			const auto* r = rv_ring(gen);
+			if (!r) return false;
+			if (scene ? s.x3_ready : backdrop ? (s.x2b_ready && s.x2b_gen == gen) : (s.x2_ready && s.x2_gen == gen)) return true;
+			// Levelled with world up as seen from where you stand (the anchor camera; the current camera when not in room mode)
+			const vec3 up_here = s.anchored ? s.up_a : (s.have_up ? s.up : vec3{0.f, 1.f, 0.f});
+			const mat4 base = mmul(mmul(eye_projection(r->tag.fov, c.A, c.B), r->E), level_mat(up_here));
+			// Room mode: the 3D scene (and backdrops) move back by how far the game camera moved since the anchor
+			const mat4 room = s.anchored ? mmul(base, s.Dpred) : base;
+			if (scene)
+			{
+				// Undo the game's projection, then view from the eye with the eye's projection
+				mat4 P;
+				P.m[0] = c.sx; P.m[2] = c.cx; P.m[5] = c.sy; P.m[6] = c.cy; P.m[10] = c.A; P.m[11] = c.B; P.m[14] = -1.f;
+				mat4 Pi;
+				if (!minv(P, Pi)) return false;
+				s.X3 = mmul(room, Pi);
+				s.P = P;
+				s.Pi = Pi;
+				s.x3_ready = true;
+			}
+			else
+			{
+				// 2D: a flat plane that exactly fills the game camera's view. The HUD and menus float at a comfortable
+				// distance; backdrops (drawn before the 3D scene) sit just inside the far plane, behind everything.
+				const f32 far_plane = (c.A + 1.f) < -1e-4f ? c.B / (c.A + 1.f) : 60.f;
+				// The HUD (tickets, timers, the pause menu) floats at a fixed, comfortable distance at its natural size,
+				// even while the game's field of view is widened
+				const f32 D = backdrop ? std::clamp(far_plane * 0.9f, 2.f, 200.f) : std::max(s.hud_dist / s.unit, c.B / c.A * 1.2f);
+				const f32 k = backdrop ? 1.f : s.hud_k * 0.8f;   // natural size, a little bigger so the tickets read well
+				const f32 hsx = c.sx * k, hsy = c.sy * k, hcx = c.cx, hcy = c.cy;
+				mat4 S2;
+				S2.m[0] = D / hsx; S2.m[3] = D * hcx / hsx;
+				S2.m[5] = D / hsy; S2.m[7] = D * hcy / hsy;
+				S2.m[11] = -D;
+				S2.m[15] = 1.f;
+				if (backdrop) { s.X2b = mmul(room, S2); s.x2b_ready = true; s.x2b_gen = gen; }
+				else { s.X2 = mmul(base, S2); s.x2_ready = true; s.x2_gen = gen; }
+			}
+			return true;
+		}
+
+		// Wide view. The game's cameras keep their field of view (degrees) in float property records (0x30 bytes): the
+		// value at +0x0c, the camera object at +0x04, the property type 0x00344d60 at +0x20. The camera object holds the
+		// same value at +0x64, after its position stored twice (+0x44 and +0x54) with 1.0 after each.
+		u32 rd32(u32 a) { return _byteswap_ulong(*static_cast<const u32*>(vm::base(a))); }
+		f32 rdf32(u32 a) { return std::bit_cast<f32>(rd32(a)); }
+		void wrf32(u32 a, f32 v) { *static_cast<u32*>(vm::base(a)) = _byteswap_ulong(std::bit_cast<u32>(v)); }
+
+		void fov_scan()
+		{
+			auto& s = g_rv;
+			const usz before = s.fovs.size();
+			for (u32 page = 0x30000000u; page < 0x40000000u; page += 0x10000u)
+			{
+				if (!vm::check_addr(page, vm::page_readable | vm::page_writable, 0x10000u)) continue;
+				for (u32 a = page; a + 0x30 <= page + 0x10000u; a += 0x10)
+				{
+					if (rd32(a + 0x20) != 0x00344d60u) continue;
+					const f32 v = rdf32(a + 0x0c);
+					if (!(v >= 5.f && v <= 100.f)) continue;
+					const u32 node = rd32(a + 0x04);
+					if (node < 0x10000u || !vm::check_addr(node, vm::page_readable, 0x70)) continue;
+					if (rdf32(node + 0x50) != 1.f || rdf32(node + 0x60) != 1.f) continue;
+					if (rd32(node + 0x44) != rd32(node + 0x54) || rd32(node + 0x48) != rd32(node + 0x58) || rd32(node + 0x4c) != rd32(node + 0x5c)) continue;
+					const f32 nf = rdf32(node + 0x64);
+					if (!(nf >= 5.f && nf <= 120.f)) continue;
+					if (std::find_if(s.fovs.begin(), s.fovs.end(), [&](const auto& r) { return r.addr == a; }) != s.fovs.end()) continue;
+					s.fovs.push_back({a, v, -1.f});
+				}
+			}
+			if (s.fovs.size() != before) vr_log("Wide view: found %zu camera field-of-view settings (%zu new)", s.fovs.size(), s.fovs.size() - before);
+		}
+
+		f32 widen(f32 deg)
+		{
+			const f32 t = std::tan(deg * 0.00872665f);
+			// at most 80 degrees tall: wider makes the game drop most of the restaurant (seen in 0.13.5: 275 -> 27 draws)
+			return std::max(deg, 2.f * std::atan(std::min(t * 2.4f, std::tan(0.698f))) * 57.29578f);
+		}
+
+		void fov_update()
+		{
+			auto& s = g_rv;
+			const bool want = s.wide_pref && s.enabled && s.want3d && !s.cinema;
+			const u64 now = GetTickCount64();
+			if (want && now - s.fov_scan_tick > (s.fovs.empty() ? 4000u : 20000u))
+			{
+				s.fov_scan_tick = now;
+				fov_scan();
+			}
+			f32 k_best = 1.f, err_best = 1e9f;
+			for (auto& r : s.fovs)
+			{
+				if (!vm::check_addr(r.addr, vm::page_readable | vm::page_writable, 0x30) || rd32(r.addr + 0x20) != 0x00344d60u) { r.addr = 0; continue; }
+				const f32 cur = rdf32(r.addr + 0x0c);
+				if (r.written < 0.f || std::fabs(cur - r.written) > 1e-3f) r.orig = cur;   // the game set a new value
+				const f32 target = want ? widen(r.orig) : r.orig;
+				if (std::fabs(cur - target) > 1e-4f) wrf32(r.addr + 0x0c, target);
+				r.written = target;
+				// Which camera is drawing now: its widened value gives the measured picture size
+				if (want && s.cam.valid)
+				{
+					const f32 sy_t = 1.f / std::tan(target * 0.00872665f);
+					const f32 e = std::fabs(sy_t - s.cam.sy) / s.cam.sy;
+					if (e < err_best) { err_best = e; k_best = std::tan(target * 0.00872665f) / std::tan(r.orig * 0.00872665f); }
+				}
+			}
+			std::erase_if(s.fovs, [](const auto& r) { return r.addr == 0; });
+			s.hud_k = want && err_best < 0.02f ? k_best : 1.f;
+			if (want != s.wide_on)
+			{
+				s.wide_on = want;
+				vr_log("Wide view: %s (%zu cameras)", want ? "on, the game draws the restaurant around you" : "off, the game's own field of view", s.fovs.size());
+			}
+			if (!s.want3d && !s.fovs.empty() && !want) s.fovs.clear();   // left the scene: values restored above
+		}
+
+		// From where the restaurant's things are around you: the walls for walking (most things lie inside them) and the
+		// world scale (the game camera sits at the chef's eye height above the floor, the lowest things).
+		void update_place()
+		{
+			auto& s = g_rv;
+			if (s.things.size() < 40) return;
+			std::vector<f32> xs, ys, zs;
+			for (const auto& t : s.things) { xs.push_back(t.x); ys.push_back(t.y); zs.push_back(t.z); }
+			const auto pct = [](std::vector<f32> v, f32 p) { auto it = v.begin() + static_cast<std::ptrdiff_t>((v.size() - 1) * p); std::nth_element(v.begin(), it, v.end()); return *it; };
+			const f32 cam_h = -pct(ys, 0.05f);
+			s.floor_lev = -cam_h;
+			if (cam_h > 1.f && cam_h < 14.f && std::fabs(cam_h - s.auto_unit) > 0.05f)
+			{
+				// (auto_unit now remembers the camera height last logged; the scale comes from your eyes)
+				vr_log("Restaurant floor: the game camera sits %.2f units above it (%.2f above the chef's eyes)", cam_h, cam_h - chef_eye_u);
+				s.auto_unit = cam_h;
+			}
+			// Walls: where nearly all of the restaurant's things are (the outermost 1% left out), at least 2 m each way
+			const f32 two_m = 2.f / std::max(s.unit, 0.05f);
+			s.bx0 = std::min(pct(xs, 0.01f), -two_m);
+			s.bx1 = std::max(pct(xs, 0.99f), two_m);
+			s.bz0 = std::min(pct(zs, 0.01f), -two_m);
+			s.bz1 = std::max(pct(zs, 0.99f), two_m * 0.5f);
+			s.bounds = true;
+			vr_log("Walls: the restaurant reaches %.1f to %.1f m sideways and %.1f to %.1f m front to back (%zu things)",
+				s.bx0 * s.unit, s.bx1 * s.unit, s.bz0 * s.unit, s.bz1 * s.unit, s.things.size());
+		}
+
+		// Eye view of the anchor camera's space for a frame (the HUD panels live there, not in the moving room)
+		bool rv_base(u64 gen, mat4& out)
+		{
+			auto& s = g_rv;
+			const auto* r = rv_ring(gen);
+			if (!r) return false;
+			const vec3 up_here = s.anchored ? s.up_a : (s.have_up ? s.up : vec3{0.f, 1.f, 0.f});
+			out = mmul(mmul(eye_projection(r->tag.fov, s.cam.A, s.cam.B), r->E), level_mat(up_here));
+			return true;
+		}
+
+		// Maps one region of the game's screen onto a panel: clip (x, y, -, w) -> camera view (game units)
+		mat4 hud_panel_matrix(const hud_region& rg, const hud_panel& pn)
+		{
+			auto& s = g_rv;
+			const vec3 up_here = s.anchored ? s.up_a : (s.have_up ? s.up : vec3{0.f, 1.f, 0.f});
+			const f32 iu = 1.f / std::max(s.unit, 0.01f);
+			const vec3 P = level(up_here, pn.P * iu, -1.f), A = level(up_here, pn.A, -1.f), B = level(up_here, pn.B, -1.f);
+			const vec3 cx = A * (pn.hw * iu / rg.hx), cy = B * (pn.hh * iu / rg.hy);
+			const vec3 cw = P - cx * rg.cx - cy * rg.cy;
+			mat4 M;
+			M.m[0] = cx.x; M.m[1] = cy.x; M.m[3] = cw.x;
+			M.m[4] = cx.y; M.m[5] = cy.y; M.m[7] = cw.y;
+			M.m[8] = cx.z; M.m[9] = cy.z; M.m[11] = cw.z;
+			M.m[15] = 1.f;
+			return M;
+		}
+
+		// A 3D draw with its own lens settings (the doneness meters, effects drawn with a separate camera): undo its
+		// own projection, then view from the eye like the scene (same room placement)
+		bool rv_build_own(u64 gen, f32 A, f32 B, f32 sx, f32 sy, f32 cx, f32 cy, mat4& out)
+		{
+			auto& s = g_rv;
+			const auto* r = rv_ring(gen);
+			if (!r) return false;
+			const vec3 up_here = s.anchored ? s.up_a : (s.have_up ? s.up : vec3{0.f, 1.f, 0.f});
+			const mat4 base = mmul(mmul(eye_projection(r->tag.fov, A, B), r->E), level_mat(up_here));
+			const mat4 room = s.anchored ? mmul(base, s.Dpred) : base;
+			mat4 P;
+			P.m[0] = sx; P.m[2] = cx; P.m[5] = sy; P.m[6] = cy; P.m[10] = A; P.m[11] = B; P.m[14] = -1.f;
+			mat4 Pi;
+			if (!minv(P, Pi)) return false;
+			out = mmul(room, Pi);
+			return true;
+		}
+
+		// Room mode. The game camera's motion between two frames (V_now = M * V_before) is found from objects that did
+		// not move: their view-space transforms differ by exactly M. The camera's rotation change comes from the
+		// rotation most scenery shares; the shift is the value most objects agree on. D (current view -> anchor view)
+		// then keeps the kitchen still in the room, so a station change shows the new station where it really is.
+		void rv_room_update(bool have_R, const vec3 R[3])
+		{
+			auto& s = g_rv;
+			const auto reset = [&]()
+			{
+				s.D = s.Dpred = s.step_inv = ident();
+				s.fails = 0;
+				s.still = 0;
+			};
+			const auto finish = [&]()
+			{
+				s.up_a = normalize(xdir(s.D, s.up));
+				s.vms_prev.swap(s.vms);
+				if (have_R) { for (int i = 0; i < 3; i++) s.R_prev[i] = R[i]; }
+				s.have_R_prev = have_R;
+			};
+			const u64 now = GetTickCount64();
+			const bool passive = now - s.input_tick > 3000;   // you pressed nothing lately: camera moves are the game's
+			const auto clear_place = [&]()
+			{
+				s.things.clear();
+				s.things_frames = 0;
+				s.bounds = false;
+				s.hud_depth = 0.f;
+				s.in_move = false;
+			};
+			const auto start_cinema = [&](const char* why)
+			{
+				if (s.cinema || !s.cinema_pref) return;
+				s.cinema = true;
+				s.cinema_since = now;
+				s.cinema_count++;
+				vr_log("Cutscene: %s, playing it on the big screen", why);
+			};
+			if (!s.room_on || !s.want3d || !have_R)
+			{
+				if (s.anchored) { reset(); s.anchored = false; clear_place(); }
+				if (!s.want3d && s.cinema) { s.cinema = false; vr_log("Cutscene: over (no 3D scene)"); }
+				finish();
+				return;
+			}
+			if (!s.cinema_pref && s.cinema) { s.cinema = false; reset(); clear_place(); }
+			if (!s.anchored)
+			{
+				reset();
+				clear_place();
+				s.anchored = true;
+				vr_log("Room: the kitchen is now fixed in your room");
+				finish();
+				return;
+			}
+			if (!s.have_R_prev || s.vms_prev.empty() || s.vms.empty()) { finish(); return; }
+
+			// Rotation change: rows of R are the view axes, so dR = R_now * R_before^T
+			f32 dR[9];
+			for (int i = 0; i < 3; i++)
+				for (int j = 0; j < 3; j++) dR[i * 3 + j] = dot(R[i], s.R_prev[j]);
+
+			// Pair objects across the two frames (draw order, allowing a few draws added or culled) and keep the
+			// pairs whose rotation changed exactly by dR; each gives a candidate shift.
+			std::vector<vec3> best;
+			for (int shift = -3; shift <= 3; shift++)
+			{
+				std::vector<vec3> cand;
+				const int np = static_cast<int>(s.vms_prev.size()), nc = static_cast<int>(s.vms.size());
+				for (int i = 0; i < np && cand.size() < 256; i++)
+				{
+					const int j = i + shift;
+					if (j < 0 || j >= nc) continue;
+					const auto& p = s.vms_prev[i].m;
+					const auto& c = s.vms[j].m;
+					const f32 scale = std::max(1.f, std::sqrt(c[0] * c[0] + c[1] * c[1] + c[2] * c[2]));
+					bool ok = true;
+					for (int a = 0; a < 3 && ok; a++)
+						for (int k = 0; k < 3 && ok; k++)
+						{
+							const f32 want = dR[a * 3] * p[k] + dR[a * 3 + 1] * p[4 + k] + dR[a * 3 + 2] * p[8 + k];
+							ok = std::fabs(want - c[a * 4 + k]) <= 3e-3f * scale;
+						}
+					if (!ok) continue;
+					const vec3 tp{p[3], p[7], p[11]}, tc{c[3], c[7], c[11]};
+					const vec3 rt{dR[0] * tp.x + dR[1] * tp.y + dR[2] * tp.z, dR[3] * tp.x + dR[4] * tp.y + dR[5] * tp.z, dR[6] * tp.x + dR[7] * tp.y + dR[8] * tp.z};
+					cand.push_back(tc - rt);
+				}
+				if (cand.size() > best.size()) best.swap(cand);
+			}
+			// The shift most pairs agree on (moving objects disagree)
+			int top = -1, top_n = 0;
+			for (usz i = 0; i < best.size(); i++)
+			{
+				int n = 0;
+				for (const auto& b : best)
+				{
+					const vec3 d = b - best[i];
+					if (dot(d, d) < 0.02f * 0.02f) n++;
+				}
+				if (n > top_n) { top_n = n; top = static_cast<int>(i); }
+			}
+			if (top >= 0 && top_n >= 4 && top_n * 10 >= static_cast<int>(best.size()) * 3)
+			{
+				vec3 sum{};
+				int n = 0;
+				for (const auto& b : best)
+				{
+					const vec3 d = b - best[top];
+					if (dot(d, d) < 0.02f * 0.02f) { sum = sum + b; n++; }
+				}
+				const vec3 dt = sum * (1.f / n);
+				mat4 M;
+				for (int i = 0; i < 3; i++)
+					for (int j = 0; j < 3; j++) M.m[i * 4 + j] = dR[i * 3 + j];
+				M.m[3] = dt.x; M.m[7] = dt.y; M.m[11] = dt.z; M.m[15] = 1.f;
+				const mat4 Minv = rigid_inv(M);
+				mat4 Dn = mmul(s.D, Minv);
+				// Keep the rotation exact (no slow drift)
+				{
+					vec3 x{Dn.m[0], Dn.m[4], Dn.m[8]}, y{Dn.m[1], Dn.m[5], Dn.m[9]};
+					x = normalize(x);
+					y = normalize(y - x * dot(x, y));
+					const vec3 z = cross(x, y);
+					Dn.m[0] = x.x; Dn.m[4] = x.y; Dn.m[8] = x.z;
+					Dn.m[1] = y.x; Dn.m[5] = y.y; Dn.m[9] = y.z;
+					Dn.m[2] = z.x; Dn.m[6] = z.y; Dn.m[10] = z.z;
+				}
+				const vec3 pe{Dn.m[3] - s.Dpred.m[3], Dn.m[7] - s.Dpred.m[7], Dn.m[11] - s.Dpred.m[11]};
+				s.pred_err = std::max(s.pred_err, std::sqrt(dot(pe, pe)));
+				const f32 rot_change = std::fabs(dR[0] - 1.f) + std::fabs(dR[4] - 1.f) + std::fabs(dR[8] - 1.f);
+				const bool still = dot(dt, dt) < 1e-6f && rot_change < 1e-5f;
+				if (still) s.still++;
+				else { s.still = 0; s.moves++; }
+				s.D = Dn;
+				s.step_inv = Minv;
+				s.Dpred = still ? Dn : mmul(Dn, Minv);
+				// A long camera move you did not ask for (a fly-through) is a cutscene
+				const bool real_move = dot(dt, dt) * s.unit * s.unit > 0.004f * 0.004f || rot_change > 2e-4f;
+				if (real_move && !s.in_move) { s.in_move = true; s.move_start = Dn; }
+				if (s.in_move)
+				{
+					const mat4 rel = mmul(rigid_inv(s.move_start), Dn);
+					const f32 dist = std::sqrt(rel.m[3] * rel.m[3] + rel.m[7] * rel.m[7] + rel.m[11] * rel.m[11]) * s.unit;
+					const f32 ang = std::acos(std::clamp((rel.m[0] + rel.m[5] + rel.m[10] - 1.f) * 0.5f, -1.f, 1.f));
+					if (passive && !s.cinema && (dist > 1.5f || ang > 0.8f)) start_cinema("the camera flies through the restaurant");
+					if (s.still >= 6) s.in_move = false;
+				}
+				if (s.cinema && s.still >= 75 && now - s.cinema_since > 1500)
+				{
+					// The camera has settled: back inside the game, with the kitchen fixed around you from here
+					s.cinema = false;
+					vr_log("Cutscene: over after %.1f s, back inside the game", (now - s.cinema_since) / 1000.0);
+					reset();
+					clear_place();
+					finish();
+					return;
+				}
+				// Where the restaurant's things are, seen from where you stand (for the walls and the world scale)
+				if (still && !s.cinema && s.things_frames < 90 && s.still % 5 == 0)
+				{
+					s.things_frames++;
+					for (const auto& v : s.vms)
+					{
+						if (s.things.size() >= 6000) break;
+						const vec3 t{v.m[3], v.m[7], v.m[11]};
+						const vec3 lp = level(s.up_a, xform(s.D, t));
+						if (dot(lp, lp) < 40.f * 40.f) s.things.push_back(lp);
+					}
+					if (s.things_frames == 6 || s.things_frames == 40) { update_place(); if (s.things_frames == 6) s.place_id++; }
+				}
+				// The HUD distance: the nearest things in the middle of the view, kept while at a station
+				if (still && s.still >= 18 && !s.near_depths.empty())
+				{
+					std::vector<f32> nd = s.near_depths;
+					auto q = nd.begin() + nd.size() / 5;
+					std::nth_element(nd.begin(), q, nd.end());
+					const f32 want = *q * 0.92f;
+					if (s.hud_depth <= 0.f || std::fabs(want - s.hud_depth) > 0.3f * s.hud_depth) s.hud_depth = want;
+				}
+				s.fails = 0;
+				s.solved++;
+				s.matched += top_n;
+				const vec3 away{s.D.m[3], s.D.m[7], s.D.m[11]};
+				if (dot(away, away) > 60.f * 60.f)
+				{
+					vr_log("Room: the game camera went far away; the kitchen is fixed again where you stand");
+					s.resets++;
+					reset();
+				}
+			}
+			else if (++s.fails <= 3)
+			{
+				// Not sure this frame (few objects in common): continue the motion
+				s.D = s.Dpred;
+				s.still = 0;
+			}
+			else
+			{
+				// A camera cut to somewhere unrelated: start again from here
+				if (s.fails == 4)
+				{
+					s.resets++;
+					vr_log("Room: camera cut (%zu objects, %d agreed); the kitchen is fixed again where you stand", best.size(), top_n);
+					if (passive) start_cinema("camera cut");
+					clear_place();
+				}
+				reset();
+				s.fails = 4;
+				if (s.cinema) s.cinema_since = now;
+			}
+			finish();
+		}
