+		bool create_session(xr_state& xr)
+		{
+			XrGraphicsBindingD3D11KHR binding{XR_TYPE_GRAPHICS_BINDING_D3D11_KHR};
+			binding.device = xr.device;
+
+			XrSessionCreateInfo info{XR_TYPE_SESSION_CREATE_INFO};
+			info.next = &binding;
+			info.systemId = xr.system;
+			if (!xr_ok(xr, xrCreateSession(xr.instance, &info, &xr.session), "xrCreateSession")) return false;
+
+			XrReferenceSpaceCreateInfo space{XR_TYPE_REFERENCE_SPACE_CREATE_INFO};
+			space.poseInReferenceSpace.orientation.w = 1.0f;
+			space.referenceSpaceType = XR_REFERENCE_SPACE_TYPE_LOCAL;
+			if (!xr_ok(xr, xrCreateReferenceSpace(xr.session, &space, &xr.local_space), "xrCreateReferenceSpace(LOCAL)")) return false;
+			space.referenceSpaceType = XR_REFERENCE_SPACE_TYPE_VIEW;
+			if (!xr_ok(xr, xrCreateReferenceSpace(xr.session, &space, &xr.view_space), "xrCreateReferenceSpace(VIEW)")) return false;
+			space.referenceSpaceType = XR_REFERENCE_SPACE_TYPE_STAGE;
+			if (XR_FAILED(xrCreateReferenceSpace(xr.session, &space, &xr.stage_space))) xr.stage_space = XR_NULL_HANDLE;
+			return true;
+		}
