+		bool xr_ok(xr_state& xr, XrResult res, const char* what)
+		{
+			if (XR_SUCCEEDED(res)) return true;
+			char buf[XR_MAX_RESULT_STRING_SIZE] = "?";
+			if (xr.instance != XR_NULL_HANDLE) xrResultToString(xr.instance, res, buf);
+			vr_log("ERROR: %s failed: %s (%d)", what, buf, static_cast<int>(res));
+			return false;
+		}
+
+		XrPath to_path(xr_state& xr, const char* str)
+		{
+			XrPath path = XR_NULL_PATH;
+			xrStringToPath(xr.instance, str, &path);
+			return path;
+		}
+
+		XrAction make_action(xr_state& xr, const char* name, XrActionType type, bool per_hand)
+		{
+			XrActionCreateInfo info{XR_TYPE_ACTION_CREATE_INFO};
+			std::snprintf(info.actionName, sizeof(info.actionName), "%s", name);
+			std::snprintf(info.localizedActionName, sizeof(info.localizedActionName), "%s", name);
+			info.actionType = type;
+			if (per_hand)
+			{
+				info.countSubactionPaths = 2;
+				info.subactionPaths = xr.hand_path;
+			}
+			XrAction action = XR_NULL_HANDLE;
+			xr_ok(xr, xrCreateAction(xr.action_set, &info, &action), name);
+			return action;
+		}
+
+		bool create_instance(xr_state& xr)
+		{
+			const char* extensions[] = {XR_KHR_D3D11_ENABLE_EXTENSION_NAME};
+
+			XrInstanceCreateInfo info{XR_TYPE_INSTANCE_CREATE_INFO};
+			std::snprintf(info.applicationInfo.applicationName, sizeof(info.applicationInfo.applicationName), "OrderUpVR");
+			std::snprintf(info.applicationInfo.engineName, sizeof(info.applicationInfo.engineName), "RPCS3");
+			info.applicationInfo.applicationVersion = 1;
+			info.applicationInfo.engineVersion = 1;
+			info.applicationInfo.apiVersion = XR_MAKE_VERSION(1, 0, 0);
+			info.enabledExtensionCount = 1;
+			info.enabledExtensionNames = extensions;
+
+			const XrResult res = xrCreateInstance(&info, &xr.instance);
+			if (XR_FAILED(res))
+			{
+				vr_log("No usable OpenXR runtime (xrCreateInstance returned %d). Running flat.", static_cast<int>(res));
+				return false;
+			}
+
+			XrInstanceProperties props{XR_TYPE_INSTANCE_PROPERTIES};
+			if (XR_SUCCEEDED(xrGetInstanceProperties(xr.instance, &props)))
+			{
+				vr_log("OpenXR runtime: %s %u.%u.%u", props.runtimeName, XR_VERSION_MAJOR(props.runtimeVersion),
+					XR_VERSION_MINOR(props.runtimeVersion), XR_VERSION_PATCH(props.runtimeVersion));
+				// SteamVR keeps the left MENU button for its own menu: pause moves to both stick clicks
+				g_steamvr = std::strstr(props.runtimeName, "SteamVR") != nullptr;
+				if (g_steamvr) vr_log("SteamVR: pause is both stick clicks together (the left MENU opens the Steam menu)");
+			}
+			return true;
+		}
+
+		// Waits for a headset; returns false if asked to stop first.
+		bool wait_for_system(xr_state& xr)
+		{
+			XrSystemGetInfo info{XR_TYPE_SYSTEM_GET_INFO};
+			info.formFactor = XR_FORM_FACTOR_HEAD_MOUNTED_DISPLAY;
+
+			bool logged = false;
+			while (!g_stop)
+			{
+				const XrResult res = xrGetSystem(xr.instance, &info, &xr.system);
+				if (XR_SUCCEEDED(res))
+				{
+					XrSystemProperties props{XR_TYPE_SYSTEM_PROPERTIES};
+					if (XR_SUCCEEDED(xrGetSystemProperties(xr.instance, xr.system, &props)))
+					{
+						vr_log("Headset: %s", props.systemName);
+					}
+					return true;
+				}
+				if (!logged)
+				{
+					vr_log("No headset available yet (xrGetSystem returned %d). Waiting...", static_cast<int>(res));
+					logged = true;
+				}
+				std::this_thread::sleep_for(std::chrono::seconds(2));
+			}
+			return false;
+		}
