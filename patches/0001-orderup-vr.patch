+	namespace
+	{
+		// The headset eye's projection, with the game's own depth mapping (A, B) so depth testing behaves the same.
+		mat4 eye_projection(const XrFovf& fov, f32 A, f32 B)
+		{
+			const f32 l = std::tan(fov.angleLeft), r = std::tan(fov.angleRight), u = std::tan(fov.angleUp), d = std::tan(fov.angleDown);
+			mat4 p;
+			p.m[0] = 2.f / (r - l); p.m[2] = (r + l) / (r - l);
+			p.m[5] = 2.f / (u - d); p.m[6] = (u + d) / (u - d);
+			p.m[10] = A; p.m[11] = B;
+			p.m[14] = -1.f;
+			return p;
+		}
+
+		mat4 level_mat(vec3 up)
+		{
+			mat4 L;
+			const vec3 axes[3] = {{1.f, 0.f, 0.f}, {0.f, 1.f, 0.f}, {0.f, 0.f, 1.f}};
+			for (int j = 0; j < 3; j++)
+			{
+				const vec3 c = level(up, axes[j]);
+				L.m[j] = c.x; L.m[4 + j] = c.y; L.m[8 + j] = c.z;
+			}
+			L.m[15] = 1.f;
+			return L;
+		}
+
+		void rv_begin_frame()
+		{
+			auto& s = g_rv;
+			s.begun = true;
+			s.cam_this_frame = false;
+			s.x3_ready = s.x2_ready = s.x2b_ready = false;
+			s.n3 = s.n2 = s.n0 = s.n2b = 0;
+			s.votes.clear();
+			s.depths.clear();
+			s.fp_set = false;
+			s.tag = {};
+			s.tainted.clear();
+			if (s.scene_key != ~0ull) s.tainted.push_back(s.scene_key);
+			s.composite_this = ~0ull;
+
+			view_snapshot v;
+			{
+				std::lock_guard lock(g_state_mutex);
+				v = g_views;
+			}
+			s.unit = v.unit;
+			s.hud_dist = v.hud_dist;
+			s.room_on = v.room;
+			s.vms.clear();
+			s.enabled = v.valid && v.mode3d && s.want3d;
+			if (!s.enabled) return;
+
+			XrPosef pose;
+			XrFovf fov;
+			if (v.stereo)
+			{
+				// Alternate eyes every frame; the headset shows each eye's newest image from where it was rendered.
+				const int e = static_cast<int>(s.eye_flip & 1);
+				pose = v.eye[e];
+				fov = v.fov[e];
+				s.tag.eye = e;
+			}
+			else
+			{
+				const auto& a = v.eye[0];
+				const auto& b = v.eye[1];
+				pose.position = {(a.position.x + b.position.x) * 0.5f, (a.position.y + b.position.y) * 0.5f, (a.position.z + b.position.z) * 0.5f};
+				pose.orientation = qnorm({a.orientation.x + b.orientation.x, a.orientation.y + b.orientation.y, a.orientation.z + b.orientation.z, a.orientation.w + b.orientation.w});
+				fov.angleLeft = std::min(v.fov[0].angleLeft, v.fov[1].angleLeft);
+				fov.angleRight = std::max(v.fov[0].angleRight, v.fov[1].angleRight);
+				fov.angleUp = std::max(v.fov[0].angleUp, v.fov[1].angleUp);
+				fov.angleDown = std::min(v.fov[0].angleDown, v.fov[1].angleDown);
+				s.tag.eye = 2;
+			}
+			// Keep the field of view sane (the game picture has a fixed number of pixels)
+			const auto cl = [](f32 a) { return std::clamp(a, -0.9f, 0.9f); };
+			fov = {cl(fov.angleLeft), cl(fov.angleRight), cl(fov.angleUp), cl(fov.angleDown)};
+
+			// Eye relative to the player frame (= where the game camera sits in the room)
+			const XrQuaternionf py = yaw_q(v.player_yaw);
+			const vec3 rel_p = rotate(qconj(py), to_vec(pose.position) - v.player_pos);
+			const XrQuaternionf rel_q = qnorm(qmul(qconj(py), pose.orientation));
+			s.tag.rel.position = {rel_p.x, rel_p.y, rel_p.z};
+			s.tag.rel.orientation = rel_q;
+			s.tag.fov = fov;
+
+			// World -> eye, in game units
+			const vec3 t = rel_p * (1.f / s.unit);
+			const vec3 ax = rotate(rel_q, {1.f, 0.f, 0.f}), ay = rotate(rel_q, {0.f, 1.f, 0.f}), az = rotate(rel_q, {0.f, 0.f, 1.f});
+			mat4 E;
+			E.m[0] = ax.x; E.m[1] = ax.y; E.m[2] = ax.z; E.m[3] = -dot(ax, t);
+			E.m[4] = ay.x; E.m[5] = ay.y; E.m[6] = ay.z; E.m[7] = -dot(ay, t);
+			E.m[8] = az.x; E.m[9] = az.y; E.m[10] = az.z; E.m[11] = -dot(az, t);
+			E.m[15] = 1.f;
+			s.E = E;
+
+			auto& r = s.ring[s.gen.load() % std::size(s.ring)];
+			r.gen = s.gen.load();
+			r.tag = s.tag;
+			r.E = E;
+			r.enabled = true;
+		}
+
+		const rsx_vr_state::ring_entry* rv_ring(u64 gen)
+		{
+			const auto& r = g_rv.ring[gen % std::size(g_rv.ring)];
+			return (r.gen == gen && r.enabled) ? &r : nullptr;
+		}
+
+		u64 rv_content_get(u64 key)
+		{
+			for (const auto& c : g_rv.content) if (c.key == key) return c.gen;
+			return 0;
+		}
+
+		void rv_content_set(u64 key, u64 gen)
+		{
+			auto& s = g_rv;
+			for (auto& c : s.content) if (c.key == key) { c.gen = gen; return; }
+			// Replace the oldest
+			auto* oldest = &s.content[0];
+			for (auto& c : s.content) if (c.gen < oldest->gen) oldest = &c;
+			*oldest = {key, gen};
+		}
+
+		// The 3D scene transform (frame's own eye) or the 2D overlay transform (the eye of the frame whose scene
+		// picture is in the target, so the HUD lines up with it).
+		bool rv_build(bool scene, u64 gen, bool backdrop = false)
+		{
+			auto& s = g_rv;
+			const auto& c = s.cam;
+			const auto* r = rv_ring(gen);
+			if (!r) return false;
+			if (scene ? s.x3_ready : backdrop ? (s.x2b_ready && s.x2b_gen == gen) : (s.x2_ready && s.x2_gen == gen)) return true;
+			// Levelled with world up as seen from where you stand (the anchor camera; the current camera when not in room mode)
+			const vec3 up_here = s.anchored ? s.up_a : (s.have_up ? s.up : vec3{0.f, 1.f, 0.f});
+			const mat4 base = mmul(mmul(eye_projection(r->tag.fov, c.A, c.B), r->E), level_mat(up_here));
+			// Room mode: the 3D scene (and backdrops) move back by how far the game camera moved since the anchor
+			const mat4 room = s.anchored ? mmul(base, s.Dpred) : base;
+			if (scene)
+			{
+				// Undo the game's projection, then view from the eye with the eye's projection
+				mat4 P;
+				P.m[0] = c.sx; P.m[2] = c.cx; P.m[5] = c.sy; P.m[6] = c.cy; P.m[10] = c.A; P.m[11] = c.B; P.m[14] = -1.f;
+				mat4 Pi;
+				if (!minv(P, Pi)) return false;
+				s.X3 = mmul(room, Pi);
+				s.x3_ready = true;
+			}
+			else
+			{
+				// 2D: a flat plane that exactly fills the game camera's view. The HUD and menus float at a comfortable
+				// distance; backdrops (drawn before the 3D scene) sit just inside the far plane, behind everything.
+				const f32 far_plane = (c.A + 1.f) < -1e-4f ? c.B / (c.A + 1.f) : 60.f;
+				const f32 D = backdrop ? std::clamp(far_plane * 0.9f, 2.f, 200.f) : std::max({s.hud_dist / s.unit, c.B / c.A * 1.2f, s.depth * 0.9f});
+				mat4 S2;
+				S2.m[0] = D / c.sx; S2.m[3] = D * c.cx / c.sx;
+				S2.m[5] = D / c.sy; S2.m[7] = D * c.cy / c.sy;
+				S2.m[11] = -D;
+				S2.m[15] = 1.f;
+				if (backdrop) { s.X2b = mmul(room, S2); s.x2b_ready = true; s.x2b_gen = gen; }
+				else { s.X2 = mmul(base, S2); s.x2_ready = true; s.x2_gen = gen; }
+			}
+			return true;
+		}
+
+		// Room mode. The game camera's motion between two frames (V_now = M * V_before) is found from objects that did
+		// not move: their view-space transforms differ by exactly M. The camera's rotation change comes from the
+		// rotation most scenery shares; the shift is the value most objects agree on. D (current view -> anchor view)
+		// then keeps the kitchen still in the room, so a station change shows the new station where it really is.
+		void rv_room_update(bool have_R, const vec3 R[3])
+		{
+			auto& s = g_rv;
+			const auto reset = [&]()
+			{
+				s.D = s.Dpred = s.step_inv = ident();
+				s.fails = 0;
+				s.still = 0;
+			};
+			const auto finish = [&]()
+			{
+				s.up_a = normalize(xdir(s.D, s.up));
+				s.vms_prev.swap(s.vms);
+				if (have_R) { for (int i = 0; i < 3; i++) s.R_prev[i] = R[i]; }
+				s.have_R_prev = have_R;
+			};
+			if (!s.room_on || !s.want3d || !have_R)
+			{
+				if (s.anchored) { reset(); s.anchored = false; }
+				finish();
+				return;
+			}
+			if (!s.anchored)
+			{
+				reset();
+				s.anchored = true;
+				vr_log("Room: the kitchen is now fixed in your room");
+				finish();
+				return;
+			}
+			if (!s.have_R_prev || s.vms_prev.empty() || s.vms.empty()) { finish(); return; }
+
+			// Rotation change: rows of R are the view axes, so dR = R_now * R_before^T
+			f32 dR[9];
+			for (int i = 0; i < 3; i++)
+				for (int j = 0; j < 3; j++) dR[i * 3 + j] = dot(R[i], s.R_prev[j]);
+
+			// Pair objects across the two frames (draw order, allowing a few draws added or culled) and keep the
+			// pairs whose rotation changed exactly by dR; each gives a candidate shift.
+			std::vector<vec3> best;
+			for (int shift = -3; shift <= 3; shift++)
+			{
+				std::vector<vec3> cand;
+				const int np = static_cast<int>(s.vms_prev.size()), nc = static_cast<int>(s.vms.size());
+				for (int i = 0; i < np && cand.size() < 256; i++)
+				{
+					const int j = i + shift;
+					if (j < 0 || j >= nc) continue;
+					const auto& p = s.vms_prev[i].m;
+					const auto& c = s.vms[j].m;
+					const f32 scale = std::max(1.f, std::sqrt(c[0] * c[0] + c[1] * c[1] + c[2] * c[2]));
+					bool ok = true;
+					for (int a = 0; a < 3 && ok; a++)
+						for (int k = 0; k < 3 && ok; k++)
+						{
+							const f32 want = dR[a * 3] * p[k] + dR[a * 3 + 1] * p[4 + k] + dR[a * 3 + 2] * p[8 + k];
+							ok = std::fabs(want - c[a * 4 + k]) <= 3e-3f * scale;
+						}
+					if (!ok) continue;
+					const vec3 tp{p[3], p[7], p[11]}, tc{c[3], c[7], c[11]};
+					const vec3 rt{dR[0] * tp.x + dR[1] * tp.y + dR[2] * tp.z, dR[3] * tp.x + dR[4] * tp.y + dR[5] * tp.z, dR[6] * tp.x + dR[7] * tp.y + dR[8] * tp.z};
+					cand.push_back(tc - rt);
+				}
+				if (cand.size() > best.size()) best.swap(cand);
+			}
+			// The shift most pairs agree on (moving objects disagree)
+			int top = -1, top_n = 0;
+			for (usz i = 0; i < best.size(); i++)
+			{
+				int n = 0;
+				for (const auto& b : best)
+				{
+					const vec3 d = b - best[i];
+					if (dot(d, d) < 0.02f * 0.02f) n++;
+				}
+				if (n > top_n) { top_n = n; top = static_cast<int>(i); }
+			}
+			if (top >= 0 && top_n >= 4 && top_n * 10 >= static_cast<int>(best.size()) * 3)
+			{
+				vec3 sum{};
+				int n = 0;
+				for (const auto& b : best)
+				{
+					const vec3 d = b - best[top];
+					if (dot(d, d) < 0.02f * 0.02f) { sum = sum + b; n++; }
+				}
+				const vec3 dt = sum * (1.f / n);
+				mat4 M;
+				for (int i = 0; i < 3; i++)
+					for (int j = 0; j < 3; j++) M.m[i * 4 + j] = dR[i * 3 + j];
+				M.m[3] = dt.x; M.m[7] = dt.y; M.m[11] = dt.z; M.m[15] = 1.f;
+				const mat4 Minv = rigid_inv(M);
+				mat4 Dn = mmul(s.D, Minv);
+				// Keep the rotation exact (no slow drift)
+				{
+					vec3 x{Dn.m[0], Dn.m[4], Dn.m[8]}, y{Dn.m[1], Dn.m[5], Dn.m[9]};
+					x = normalize(x);
+					y = normalize(y - x * dot(x, y));
+					const vec3 z = cross(x, y);
+					Dn.m[0] = x.x; Dn.m[4] = x.y; Dn.m[8] = x.z;
+					Dn.m[1] = y.x; Dn.m[5] = y.y; Dn.m[9] = y.z;
+					Dn.m[2] = z.x; Dn.m[6] = z.y; Dn.m[10] = z.z;
+				}
+				const vec3 pe{Dn.m[3] - s.Dpred.m[3], Dn.m[7] - s.Dpred.m[7], Dn.m[11] - s.Dpred.m[11]};
+				s.pred_err = std::max(s.pred_err, std::sqrt(dot(pe, pe)));
+				const f32 rot_change = std::fabs(dR[0] - 1.f) + std::fabs(dR[4] - 1.f) + std::fabs(dR[8] - 1.f);
+				const bool still = dot(dt, dt) < 1e-6f && rot_change < 1e-5f;
+				if (still) s.still++;
+				else { s.still = 0; s.moves++; }
+				s.D = Dn;
+				s.step_inv = Minv;
+				s.Dpred = still ? Dn : mmul(Dn, Minv);
+				s.fails = 0;
+				s.solved++;
+				s.matched += top_n;
+				const vec3 away{s.D.m[3], s.D.m[7], s.D.m[11]};
+				if (dot(away, away) > 60.f * 60.f)
+				{
+					vr_log("Room: the game camera went far away; the kitchen is fixed again where you stand");
+					s.resets++;
+					reset();
+				}
+			}
+			else if (++s.fails <= 3)
+			{
+				// Not sure this frame (few objects in common): continue the motion
+				s.D = s.Dpred;
+				s.still = 0;
+			}
+			else
+			{
+				// A camera cut to somewhere unrelated: start again from here
+				if (s.fails == 4) { s.resets++; vr_log("Room: camera cut (%zu objects, %d agreed); the kitchen is fixed again where you stand", best.size(), top_n); }
+				reset();
+				s.fails = 4;
+			}
+			finish();
+		}
+
+		frame_tag rv_end_frame(u64 display_key)
+		{
+			auto& s = g_rv;
+			const u64 gen = s.gen.load();
+
+			// Which frame's eye view is in the buffer being shown?
+			frame_tag out{};
+			if (display_key != ~0ull)
+			{
+				u64 g = rv_content_get(display_key);
+				if (!g && (display_key == s.scene_key || s.enabled)) g = gen; // not tracked: assume this frame (as 0.6.0 did)
+				if (const auto* r = g ? rv_ring(g) : nullptr)
+				{
+					out = r->tag;
+					const u64 age = gen - g;
+					s.lat_hist[std::min<u64>(age, 3)]++;
+				}
+			}
+
+			// World up: the direction most scenery agrees on
+			if (!s.votes.empty())
+			{
+				const auto best = std::max_element(s.votes.begin(), s.votes.end(), [](const auto& a, const auto& b) { return a.n < b.n; });
+				// Camera memory research: the view rotation is the rotation most unrotated scenery shows
+				if (s.want3d && best->n >= 3)
+				{
+					const vec3 R[3] = {best->rx, best->ry, best->rz};
+					mr_frame(true, R, s.cam.sx, s.cam.sy, s.fp, s.fp_set);
+				}
+				if (best->n >= 3 && best->n * 3 >= s.n3)
+				{
+					const vec3 u = normalize(best->sum);
+					if (!s.have_up || dot(u, s.up) < 0.99f) s.up = u;    // camera cut: follow at once
+					else s.up = normalize(s.up * 0.8f + u * 0.2f);
+					s.have_up = true;
+				}
+			}
+			// Room mode: how far has the game camera moved since the anchor?
+			{
+				const bool have_R = !s.votes.empty() && std::max_element(s.votes.begin(), s.votes.end(), [](const auto& a, const auto& b) { return a.n < b.n; })->n >= 3;
+				vec3 R[3]{};
+				if (have_R)
+				{
+					const auto best = std::max_element(s.votes.begin(), s.votes.end(), [](const auto& a, const auto& b) { return a.n < b.n; });
+					R[0] = best->rx; R[1] = best->ry; R[2] = best->rz;
+				}
+				rv_room_update(have_R, R);
+			}
+
+			// Typical distance of things in view
+			if (s.depths.size() >= 3)
+			{
+				auto mid = s.depths.begin() + s.depths.size() / 2;
+				std::nth_element(s.depths.begin(), mid, s.depths.end());
+				const f32 med = *mid;
+				if (std::fabs(med - s.depth) > 0.5f * s.depth) s.depth = med;
+				else s.depth += (med - s.depth) * 0.1f;
+			}
+			if (s.composite_this != ~0ull) s.composite_key = s.composite_this;
+			if (display_key != ~0ull) s.display_key = display_key;
+			s.add_screen(s.composite_this);
+			s.add_screen(display_key);
+			if (s.n3) s.add_screen(s.scene_key);
+
+			// Is the game showing a 3D scene? (menus and loading screens are flat)
+			if (s.n3 >= 10) { s.frames_with++; s.frames_without = 0; }
+			else if (++s.frames_without >= 30) s.frames_with = 0;
+			const bool want = s.frames_with >= 3;
+			if (want != s.want3d)
+			{
+				s.want3d = want;
+				vr_log("True VR: game %s a 3D scene", want ? "shows" : "no longer shows");
+			}
+
+			{
+				std::lock_guard lock(g_state_mutex);
+				g_cam.valid = s.cam.valid && s.want3d;
+				g_cam.sx = s.cam.sx; g_cam.sy = s.cam.sy; g_cam.cx = s.cam.cx; g_cam.cy = s.cam.cy;
+				g_cam.up = s.have_up ? s.up : vec3{0.f, 1.f, 0.f};
+				g_cam.depth = s.depth;
+				g_cam.room = s.anchored;
+				g_cam.D = s.anchored ? s.D : ident();
+				g_cam.up_a = s.anchored ? s.up_a : g_cam.up;
+				g_cam.still = s.still;
+				g_cam.moves = s.moves;
+			}
+
+			s.tot3 += s.n3; s.tot2 += s.n2; s.tot2b += s.n2b; s.tot0 += s.n0; s.frames++;
+			const u64 now = GetTickCount64();
+			if (now - s.last_log > 15000)
+			{
+				const auto pf = [&](u64 v) { return static_cast<unsigned long long>(v / std::max<u64>(s.frames, 1)); };
+				vr_log("True VR: %s, shown eye=%d, per frame 3D=%llu 2D=%llu (+%llu backdrop) other=%llu; camera %s sx=%.3f sy=%.3f A=%.4f B=%.4f; up (%.2f %.2f %.2f); depth %.2f; "
+					"scene 0x%llx composite 0x%llx shown 0x%llx; picture age 0:%llu 1:%llu 2:%llu more:%llu",
+					s.enabled ? "rendering for the headset" : "flat", out.eye, pf(s.tot3), pf(s.tot2), pf(s.tot2b), pf(s.tot0), s.cam.valid ? "found" : "not found",
+					s.cam.sx, s.cam.sy, s.cam.A, s.cam.B, s.up.x, s.up.y, s.up.z, s.depth,
+					static_cast<unsigned long long>(s.scene_key), static_cast<unsigned long long>(s.composite_key), static_cast<unsigned long long>(display_key),
+					static_cast<unsigned long long>(s.lat_hist[0]), static_cast<unsigned long long>(s.lat_hist[1]),
+					static_cast<unsigned long long>(s.lat_hist[2]), static_cast<unsigned long long>(s.lat_hist[3]));
+				if (s.anchored)
+				{
+					vr_log("Room: camera moved %.2f m from where you stand (%.1f deg), %llu frames solved with %.0f objects each, worst guess off by %.1f cm, %llu re-anchors",
+						std::sqrt(s.D.m[3] * s.D.m[3] + s.D.m[7] * s.D.m[7] + s.D.m[11] * s.D.m[11]) * s.unit, std::acos(std::clamp((s.D.m[0] + s.D.m[5] + s.D.m[10] - 1.f) * 0.5f, -1.f, 1.f)) * 57.29578f,
+						static_cast<unsigned long long>(s.solved), s.solved ? static_cast<double>(s.matched) / s.solved : 0.0, s.pred_err * s.unit * 100.f, static_cast<unsigned long long>(s.resets));
+					s.solved = s.matched = 0;
+					s.pred_err = 0.f;
+				}
+				s.last_log = now;
+				s.tot3 = s.tot2 = s.tot2b = s.tot0 = s.frames = 0;
+				for (auto& h : s.lat_hist) h = 0;
+			}
+
+			s.begun = false;
+			if (s.n3 > 0) s.eye_flip++;   // the game may show one picture twice: switch eyes per new picture
+			s.gen++;
+			return out;
+		}
+	}
+
+	// ---------------------------------------------------------------- camera memory research
+	// Finds where the game keeps its camera in PS3 memory while the player plays normally:
+	//  1. search memory for the camera rotation and field of view the renderer sees this frame;
+	//  2. keep only places that follow the camera when it moves or zooms;
+	//  3. confirm: change one place for a moment while the view is still and see if the picture moves, then restore it.
+	// Everything goes to log/orderup_research.log for the next step (steering the game's own camera).
+	namespace
+	{
+		u32 rd(u32 addr) { return _byteswap_ulong(*static_cast<const u32*>(vm::base(addr))); }
+		f32 rdf(u32 addr) { return std::bit_cast<f32>(rd(addr)); }
+		void wrf(u32 addr, f32 v) { *static_cast<u32*>(vm::base(addr)) = _byteswap_ulong(std::bit_cast<u32>(v)); }
+
+		// Every form the game might keep its camera in. Types 0..3 are 3x3 rotations (strided rows),
+		// types 10+ are "kinds": short runs of 1..4 floats compared value by value.
+		constexpr int mr_kinds = 40;
+
+		struct mr_kind
+		{
+			int n = 0;               // floats in the run (0 = not searched this time)
+			f32 v[4]{};
+			f32 tol = 0.f;           // absolute, or relative when rel
+			bool rel = false;
+			bool negok = false;      // the run may also be stored negated (quaternions)
+			int comp = 0;            // which float an experiment changes
+			f32 step = 0.f;          // experiment: add this (or multiply when mul)
+			bool mul = false;
+		};
+
+		struct mr_target
+		{
+			f32 m[4][9];
+			mr_kind k[mr_kinds];     // type 10 + i
+		};
+
+		struct mr_cand
+		{
+			u32 addr = 0;
+			int type = 0;        // 0..3 matrix layout, 10+ kind
+			int stride = 4;      // floats between matrix rows
+			int hits = 0, misses = 0;
+			int tests = 0, effects = 0;
+		};
+
+		// Kind numbers (type - 10)
+		enum : int
+		{
+			K_FOV = 0,           // 10 values, 0..9
+			K_POS_VIEW = 10, K_POS_WORLD = 11,
+			K_FWD = 12, K_BACK = 13,
+			K_QUAT = 14,         // 14..17: xyzw, xyzw of the inverse, wxyz, wxyz of the inverse
+			K_ANGLE = 20,        // 20..31: yaw/pitch in several conventions
+			K_END = 32,
+		};
+
+		const char* mr_type_name(int t)
+		{
+			static const char* m[] = {"view rows", "view transposed", "view rows (-z)", "view transposed (-z)"};
+			static const char* k[K_END] = {"projection sy", "projection sx", "1/sy (tan half fov y)", "1/sx", "fov y rad", "fov y deg", "half fov y rad", "half fov y deg", "fov x rad", "fov x deg",
+				"camera position (view)", "camera position (world matrix)", "forward vector", "backward vector",
+				"quaternion xyzw", "quaternion xyzw (inverse)", "quaternion wxyz", "quaternion wxyz (inverse)", "", "",
+				"yaw rad", "yaw rad (negated)", "yaw deg", "yaw deg (negated)", "yaw rad (+180)", "yaw deg (+180)", "yaw rad (other axis)", "yaw deg (other axis)",
+				"pitch rad", "pitch rad (negated)", "pitch deg", "pitch deg (negated)"};
+			if (t < 4) return m[t];
+			if (t >= 10 && t < 10 + K_END) return k[t - 10];
+			return "?";
+		}
+
+		bool mr_is_scalar(int type) { return (type >= 10 + K_FOV && type < 10 + K_POS_VIEW) || (type >= 10 + K_ANGLE && type < 10 + K_END); }
+
+		struct mr_write
+		{
+			u32 addr = 0;
+			int type = 0;
+			std::vector<u32> orig, neu;
+		};
+
+		struct mem_research
+		{
+			std::mutex mtx;                 // guards cands, log
+			std::vector<mr_cand> cands;
+			std::FILE* log = nullptr;
+			std::thread scan_thread;
+			std::atomic<bool> scanning{false};
+			u64 next_scan = 0;
+			int scans = 0;
+
+			// RSX-thread only
+			f32 fp_prev[16]{};
+			int fp_stable = 0;
+			u64 frame = 0;
+			std::vector<mr_write> exp;       // the running experiment (one candidate, or a group of values)
+			bool exp_group = false, exp_from_half = false;
+			int exp_frames = 0;
+			std::vector<std::pair<u32, int>> suspects, other_half;   // group narrowing down
+			u64 next_exp = 0;
+			int experiments = 0;
+			mr_target last_target{};
+
+			// Memory capture: two pictures of memory with the camera somewhere else, kept for offline analysis
+			std::atomic<int> snap_state{0};  // 0 none, 1 taking A, 2 have A, 3 taking B, 4 done
+			std::vector<u32> snap_pages;
+			std::vector<u8> snap_data;
+			f32 cam_a[27]{};                 // R (9), sx, sy, first 3D draw (16)
+			vec3 fwd_a{};
+			u64 snap_a_time = 0;
+		};
+		mem_research g_mr;
+
+		void mr_shutdown()
+		{
+			if (g_mr.scan_thread.joinable()) g_mr.scan_thread.join();
+		}
+
+		void mr_log(const char* fmt, ...)
+		{
+			std::lock_guard lock(g_mr.mtx);
+			if (!g_mr.log)
+			{
+				g_mr.log = std::fopen((fs::get_log_dir() + "orderup_research.log").c_str(), "w");
+				if (!g_mr.log) return;
+			}
+			va_list args;
+			va_start(args, fmt);
+			std::vfprintf(g_mr.log, fmt, args);
+			va_end(args);
+			std::fputc('\n', g_mr.log);
+			std::fflush(g_mr.log);
+		}
+
+		bool near_eq(f32 a, f32 b, f32 tol) { return std::fabs(a - b) <= tol; }
+
+		f32 kind_tol(const mr_kind& k, f32 v, f32 loosen) { return (k.rel ? std::max(2e-5f, std::fabs(v) * k.tol) : k.tol) * loosen; }
+
+		bool mr_match_kind(u32 a, const mr_kind& k, f32 loosen)
+		{
+			for (int sign = 1; sign >= -1; sign -= 2)
+			{
+				if (sign < 0 && !k.negok) break;
+				bool ok = true;
+				for (int i = 0; i < k.n && ok; i++)
+				{
+					const f32 want = k.v[i] * static_cast<f32>(sign);
+					ok = near_eq(rdf(a + i * 4), want, kind_tol(k, want, loosen));
+				}
+				if (ok) return true;
+			}
+			return false;
+		}
+
+		void mr_scan(mr_target t)
+		{
+			const u64 started = GetTickCount64();
+			std::vector<mr_cand> found;
+			int n_mat = 0, n_scalar = 0, n_vec = 0;
+			usz pages = 0;
+
+			// A zero word can only start a match when the wanted first value is zero too (for example a
+			// forward vector with x = 0); single zero values are never searched, memory is full of them.
+			bool zero_m[4]{};
+			for (int v = 0; v < 4; v++) zero_m[v] = std::fabs(t.m[v][0]) <= 2e-3f;
+			bool zero_k[mr_kinds]{};
+			for (int i = 0; i < mr_kinds; i++)
+			{
+				auto& k = t.k[i];
+				if (k.n == 1 && std::fabs(k.v[0]) <= kind_tol(k, k.v[0], 1.f) * 4.f) k.n = 0;
+				zero_k[i] = k.n > 1 && std::fabs(k.v[0]) <= kind_tol(k, k.v[0], 1.f);
+			}
+
+			for (u64 page = 0x00010000; page < 0x40000000; page += 4096)
+			{
+				if (g_stop) break;
+				if (!vm::check_addr(static_cast<u32>(page), vm::page_readable, 4096)) continue;
+				pages++;
+				const bool next_ok = vm::check_addr(static_cast<u32>(page + 4096), vm::page_readable, 4096);
+				for (u32 off = 0; off < 4096; off += 4)
+				{
+					const u32 a = static_cast<u32>(page) + off;
+					const f32 f = rdf(a);
+					if (!std::isfinite(f) || std::fabs(f) > 400.f) continue;
+					const bool zero = f == 0.f;
+					// Matrices: the first value must match one of the layouts, then the rest is checked
+					for (int v = 0; v < 4; v++)
+					{
+						if (zero ? !zero_m[v] : !near_eq(f, t.m[v][0], 2e-3f)) continue;
+						for (int stride : {3, 4})
+						{
+							if (off + (2 * stride + 3) * 4 > 4096 && !next_ok) continue;
+							bool ok = true;
+							for (int r = 0; r < 3 && ok; r++)
+								for (int c = 0; c < 3 && ok; c++)
+									ok = near_eq(rdf(a + (r * stride + c) * 4), t.m[v][r * 3 + c], 2e-3f);
+							if (ok && n_mat < 300) { found.push_back({a, v, stride}); n_mat++; }
+						}
+					}
+					// Single values and short runs
+					for (int i = 0; i < mr_kinds; i++)
+					{
+						const auto& k = t.k[i];
+						if (!k.n || (zero && !zero_k[i])) continue;
+						if (!zero && !near_eq(f, k.v[0], kind_tol(k, k.v[0], 1.f)) && !(k.negok && near_eq(f, -k.v[0], kind_tol(k, k.v[0], 1.f)))) continue;
+						if (off + k.n * 4 > 4096 && !next_ok) continue;
+						if (!mr_match_kind(a, k, 1.f)) continue;
+						int& count = k.n == 1 ? n_scalar : n_vec;
+						if (count < (k.n == 1 ? 3000 : 600)) { found.push_back({a, 10 + i, 0}); count++; }
+					}
+				}
+			}
+
+			std::lock_guard lock(g_mr.mtx);
+			int added = 0;
+			for (const auto& c : found)
+			{
+				auto it = std::find_if(g_mr.cands.begin(), g_mr.cands.end(), [&](const mr_cand& x) { return x.addr == c.addr && x.type == c.type; });
+				if (it != g_mr.cands.end()) it->hits++;
+				else if (g_mr.cands.size() < 5000) { g_mr.cands.push_back(c); g_mr.cands.back().hits = 1; added++; }
+			}
+			if (g_mr.log)
+			{
+				std::fprintf(g_mr.log, "scan %d: %zu readable pages, %d rotation / %d value / %d vector matches (%d new, %zu kept), %llu ms\n", g_mr.scans, pages, n_mat, n_scalar, n_vec, added,
+					g_mr.cands.size(), static_cast<unsigned long long>(GetTickCount64() - started));
+				std::fflush(g_mr.log);
+			}
+			g_mr.scanning = false;
+		}
+
+		bool mr_matches_now(const mr_cand& c, const mr_target& t)
+		{
+			if (!vm::check_addr(c.addr, vm::page_readable, 48)) return false;
+			if (c.type < 4)
+			{
+				for (int r = 0; r < 3; r++)
+					for (int k = 0; k < 3; k++)
+						if (!near_eq(rdf(c.addr + (r * c.stride + k) * 4), t.m[c.type][r * 3 + k], 3e-3f)) return false;
+				return true;
+			}
+			const auto& k = t.k[c.type - 10];
+			return k.n && mr_match_kind(c.addr, k, 2.5f);
+		}
+
+		void mr_dump(u32 addr)
+		{
+			std::string line;
+			for (int i = -16; i < 32; i++)
+			{
+				const u32 a = addr + i * 4;
+				if (!vm::check_addr(a, vm::page_readable, 4)) continue;
+				char b[64];
+				const u32 w = rd(a);
+				std::snprintf(b, sizeof(b), "%s%+d:%08x(%.5g)", i % 8 == 0 ? "\n    " : " ", i * 4, w, std::bit_cast<f32>(w));
+				line += b;
+			}
+			mr_log("  memory around 0x%08x:%s", addr, line.c_str());
+		}
+
+		// Memory capture A: a copy of all readable game memory while the camera is still.
+		void mr_snapshot_a()
+		{
+			auto& m = g_mr;
+			m.snap_pages.clear();
+			for (u64 page = 0x00010000; page < 0x40000000 && !g_stop; page += 4096)
+				if (vm::check_addr(static_cast<u32>(page), vm::page_readable, 4096)) m.snap_pages.push_back(static_cast<u32>(page));
+			// This build has no exception handling, so check free memory first: copy A, copy B of the changed
+			// pages (at most as big) and 1 GB to spare.
+			const u64 need = static_cast<u64>(m.snap_pages.size()) * 4096;
+			MEMORYSTATUSEX ms{};
+			ms.dwLength = sizeof(ms);
+			if (!GlobalMemoryStatusEx(&ms) || ms.ullAvailPhys < need * 2 + (1ull << 30))
+			{
+				mr_log("memory capture A: skipped, %llu MB free and %llu MB needed", static_cast<unsigned long long>(ms.ullAvailPhys >> 20), static_cast<unsigned long long>((need * 2 + (1ull << 30)) >> 20));
+				m.snap_pages.clear(); m.snap_pages.shrink_to_fit();
+				m.snap_state = 4;
+				m.scanning = false;
+				return;
+			}
+			m.snap_data.resize(need);
+			for (usz i = 0; i < m.snap_pages.size(); i++)
+				if (vm::check_addr(m.snap_pages[i], vm::page_readable, 4096)) std::memcpy(&m.snap_data[i * 4096], vm::base(m.snap_pages[i]), 4096);
+			mr_log("memory capture A: %zu pages (%zu MB) with the camera in its first position", m.snap_pages.size(), m.snap_data.size() >> 20);
+			m.snap_state = 2;
+			m.scanning = false;
+		}
+
+		// Memory capture B: with the camera somewhere else, keep the pages that changed (where any form of
+		// the camera must be) and the pages holding field-of-view values, both versions, for offline analysis.
+		void mr_snapshot_b(mr_target t, std::array<f32, 27> cam_b)
+		{
+			auto& m = g_mr;
+			struct pick { usz index; u32 addr; int score; bool fov; std::vector<u8> b; };
+			std::vector<pick> changed, fov;
+			std::vector<u8> buf(4096);
+			for (usz i = 0; i < m.snap_pages.size() && !g_stop; i++)
+			{
+				const u32 addr = m.snap_pages[i];
+				if (!vm::check_addr(addr, vm::page_readable, 4096)) continue;
+				std::memcpy(buf.data(), vm::base(addr), 4096);
+				const u8* a = &m.snap_data[i * 4096];
+				int floats = 0;
+				bool has_fov = false;
+				for (int w = 0; w < 1024; w++)
+				{
+					u32 be;
+					std::memcpy(&be, &buf[w * 4], 4);
+					const f32 f = std::bit_cast<f32>(_byteswap_ulong(be));
+					const f32 af = std::fabs(f);
+					if (std::isfinite(f) && af > 1e-4f && af < 1e5f) floats++;
+					for (int k = 0; k < 10 && !has_fov; k++)
+						if (t.k[K_FOV + k].n && near_eq(f, t.k[K_FOV + k].v[0], kind_tol(t.k[K_FOV + k], t.k[K_FOV + k].v[0], 1.f))) has_fov = true;
+				}
+				const bool diff = std::memcmp(a, buf.data(), 4096) != 0;
+				if (diff && floats >= 128) changed.push_back({i, addr, floats, false, buf});
+				else if (has_fov && floats >= 64) fov.push_back({i, addr, floats, true, buf});
+			}
+			std::sort(changed.begin(), changed.end(), [](const pick& x, const pick& y) { return x.score > y.score; });
+			if (changed.size() > 1800) changed.resize(1800);
+			std::sort(fov.begin(), fov.end(), [](const pick& x, const pick& y) { return x.score > y.score; });
+			if (fov.size() > 200) fov.resize(200);
+			changed.insert(changed.end(), fov.begin(), fov.end());
+			std::sort(changed.begin(), changed.end(), [](const pick& x, const pick& y) { return x.addr < y.addr; });
+
+			// File: "OUVRCAM1", u32 pages, camera A (27 floats), camera B (27 floats), then per page:
+			// u32 address, u32 flags (1 = changed, 2 = holds field-of-view values), 4096 bytes before, 4096 bytes after.
+			// Floats in the header are little-endian; page bytes are raw PS3 memory (big-endian). The whole thing is zlib-compressed.
+			std::vector<u8> raw;
+			auto put = [&](const void* p, usz n) { raw.insert(raw.end(), static_cast<const u8*>(p), static_cast<const u8*>(p) + n); };
+			put("OUVRCAM1", 8);
+			const u32 count = static_cast<u32>(changed.size());
+			put(&count, 4);
+			put(m.cam_a, sizeof(m.cam_a));
+			put(cam_b.data(), sizeof(f32) * 27);
+			for (const auto& p : changed)
+			{
+				const u32 flags = p.fov ? 2u : 1u;
+				put(&p.addr, 4);
+				put(&flags, 4);
+				put(&m.snap_data[p.index * 4096], 4096);
+				put(p.b.data(), 4096);
+			}
+			uLongf zlen = compressBound(static_cast<uLong>(raw.size()));
+			std::vector<u8> z(zlen);
+			bool ok = compress2(z.data(), &zlen, raw.data(), static_cast<uLong>(raw.size()), 6) == Z_OK;
+			if (ok)
+			{
+				if (std::FILE* f = std::fopen((fs::get_log_dir() + "orderup_camdump.bin.z").c_str(), "wb"))
+				{
+					ok = std::fwrite(z.data(), 1, zlen, f) == zlen;
+					std::fclose(f);
+				}
+				else ok = false;
+			}
+			mr_log("memory capture B: %u pages kept (%zu changed with the camera, %zu with field-of-view values), %s %.1f MB",
+				count, static_cast<usz>(count) - fov.size(), fov.size(), ok ? "saved" : "FAILED to save", zlen / 1048576.0);
+			m.snap_pages.clear(); m.snap_pages.shrink_to_fit();
+			m.snap_data.clear(); m.snap_data.shrink_to_fit();
+			m.snap_state = 4;
+			m.scanning = false;
+		}
+
+		bool mr_make_write(const mr_cand& c, const mr_target& t, mr_write& w)
+		{
+			const u32 n = c.type < 4 ? static_cast<u32>(2 * c.stride + 3) : static_cast<u32>(t.k[c.type - 10].n);
+			if (!n || !vm::check_addr(c.addr, vm::page_writable, n * 4)) return false;
+			w.addr = c.addr;
+			w.type = c.type;
+			w.orig.resize(n);
+			for (u32 i = 0; i < n; i++) w.orig[i] = rd(c.addr + i * 4);
+			if (c.type < 4)
+			{
+				// Turn the stored rotation by 2 degrees about the vertical axis
+				const f32 cs = std::cos(0.035f), sn = std::sin(0.035f);
+				for (int r = 0; r < 3; r++)
+				{
+					const u32 ra = c.addr + r * c.stride * 4;
+					const f32 x = rdf(ra), z = rdf(ra + 8);
+					wrf(ra, x * cs + z * sn);
+					wrf(ra + 8, -x * sn + z * cs);
+				}
+			}
+			else
+			{
+				const auto& k = t.k[c.type - 10];
+				const u32 a = c.addr + k.comp * 4;
+				wrf(a, k.mul ? rdf(a) * k.step : rdf(a) + k.step);
+			}
+			w.neu.resize(n);
+			for (u32 i = 0; i < n; i++) w.neu[i] = rd(c.addr + i * 4);
+			return true;
+		}
+
+		mr_cand* mr_find(u32 addr, int type)
+		{
+			auto it = std::find_if(g_mr.cands.begin(), g_mr.cands.end(), [&](const mr_cand& x) { return x.addr == addr && x.type == type; });
+			return it == g_mr.cands.end() ? nullptr : &*it;
+		}
+
+		// Called once per frame from the renderer with this frame's camera (R = rows of the view rotation).
+		void mr_frame(bool have_r, const vec3 R[3], f32 sx, f32 sy, const f32* fp, bool fp_valid)
+		{
+			auto& m = g_mr;
+			m.frame++;
+			if (!have_r || !fp_valid) { m.fp_stable = 0; return; }
+
+			// The camera this frame, in every form the game might use
+			mr_target t{};
+			for (int r = 0; r < 3; r++)
+			{
+				const f32 row[3] = {R[r].x, R[r].y, R[r].z};
+				for (int c = 0; c < 3; c++)
+				{
+					t.m[0][r * 3 + c] = row[c];
+					t.m[1][c * 3 + r] = row[c];
+					t.m[2][r * 3 + c] = r == 2 ? -row[c] : row[c];
+					t.m[3][c * 3 + r] = r == 2 ? -row[c] : row[c];
+				}
+			}
+			auto scalar = [&](int i, f32 v, f32 tol, bool rel, f32 step, bool mul)
+			{
+				auto& k = t.k[i];
+				k.n = 1; k.v[0] = v; k.tol = tol; k.rel = rel; k.step = step; k.mul = mul;
+			};
+			auto run = [&](int i, int n, const f32* v, f32 tol, bool negok, int comp, f32 step)
+			{
+				auto& k = t.k[i];
+				k.n = n; std::copy(v, v + n, k.v); k.tol = tol; k.negok = negok; k.comp = comp; k.step = step;
+			};
+			// Field of view
+			const f32 fy = 2.f * std::atan(1.f / sy), fx = 2.f * std::atan(1.f / sx);
+			const f32 fovs[10] = {sy, sx, 1.f / sy, 1.f / sx, fy, fy * 57.29578f, fy * 0.5f, fy * 28.64789f, fx, fx * 57.29578f};
+			for (int i = 0; i < 10; i++) scalar(K_FOV + i, fovs[i], 2e-5f, true, 1.04f, true);
+			// Direction the camera looks (view z is backwards)
+			const vec3 back = R[2], fwd = R[2] * -1.f;
+			const f32 fv[3] = {fwd.x, fwd.y, fwd.z}, bv[3] = {back.x, back.y, back.z};
+			run(K_FWD, 3, fv, 2e-3f, false, 0, 0.03f);
+			run(K_BACK, 3, bv, 2e-3f, false, 0, 0.03f);
+			// Quaternions of the view rotation and of the camera's own rotation (its inverse)
+			{
+				const f32 a00 = R[0].x, a01 = R[0].y, a02 = R[0].z, a10 = R[1].x, a11 = R[1].y, a12 = R[1].z, a20 = R[2].x, a21 = R[2].y, a22 = R[2].z;
+				f32 qw, qx, qy, qz;
+				const f32 tr = a00 + a11 + a22;
+				if (tr > 0.f) { const f32 s = std::sqrt(tr + 1.f) * 2.f; qw = 0.25f * s; qx = (a21 - a12) / s; qy = (a02 - a20) / s; qz = (a10 - a01) / s; }
+				else if (a00 > a11 && a00 > a22) { const f32 s = std::sqrt(1.f + a00 - a11 - a22) * 2.f; qw = (a21 - a12) / s; qx = 0.25f * s; qy = (a01 + a10) / s; qz = (a02 + a20) / s; }
+				else if (a11 > a22) { const f32 s = std::sqrt(1.f + a11 - a00 - a22) * 2.f; qw = (a02 - a20) / s; qx = (a01 + a10) / s; qy = 0.25f * s; qz = (a12 + a21) / s; }
+				else { const f32 s = std::sqrt(1.f + a22 - a00 - a11) * 2.f; qw = (a10 - a01) / s; qx = (a02 + a20) / s; qy = (a12 + a21) / s; qz = 0.25f * s; }
+				const f32 q0[4] = {qx, qy, qz, qw}, q1[4] = {-qx, -qy, -qz, qw}, q2[4] = {qw, qx, qy, qz}, q3[4] = {qw, -qx, -qy, -qz};
+				run(K_QUAT + 0, 4, q0, 2e-3f, true, 0, 0.03f);
+				run(K_QUAT + 1, 4, q1, 2e-3f, true, 0, 0.03f);
+				run(K_QUAT + 2, 4, q2, 2e-3f, true, 1, 0.03f);
+				run(K_QUAT + 3, 4, q3, 2e-3f, true, 1, 0.03f);
+			}
+			// Yaw and pitch angles
+			{
+				const f32 yaw = std::atan2(fwd.x, fwd.z), yaw2 = std::atan2(-fwd.x, -fwd.z), yaw3 = std::atan2(fwd.z, fwd.x);
