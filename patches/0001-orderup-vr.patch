+					s.hold_cands.push_back({tex, o, std::hypot(nx - s.ptr_nx, ny - s.ptr_ny), nx, ny});
+				}
+			}
+			else if (s.hand_view_ok)
+			{
+				for (auto& h : s.held)
+				{
+					const vec3 d = o - h.o;
+					if (h.tex != tex || dot(d, d) > 1.2f * 1.2f) continue;
+					h.o = o;   // found again this frame
+					// Only what the game itself carries (it follows your pointer) goes to your hand: a counter or plate the
+					// game does not let you pick up stays where it is
+					if (!h.carried) { const vec3 mv = o - h.o0; h.carried = dot(mv, mv) > 0.05f * 0.05f; }
+					if (!h.carried) break;
+					const vec3 delta = s.hand_view + h.off - o;
+					mat4 T = ident();
+					T.m[3] = delta.x; T.m[7] = delta.y; T.m[11] = delta.z;
+					const mat4 X = mmul(s.X3, mmul(s.P, mmul(T, s.Pi)));
+					std::memcpy(x, X.m, sizeof(f32) * 16);
+					s.held_drawn++;
+					return kind;
+				}
+			}
+		}
+		std::memcpy(x, (kind == 1 ? s.X3 : kind == 3 ? s.X2b : s.X2).m, sizeof(f32) * 16);
+		return kind;
+	}
+
+	void hud_vertices(const f32* p, u32 n, u32 type, u32 comps)
+	{
+		auto& s = g_rv;
+		s.hv_n = n; s.hv_type = type; s.hv_comps = comps;
+		if (!n) return;
+		s.hv_x0 = s.hv_x1 = p[0]; s.hv_y0 = s.hv_y1 = p[1]; s.hv_z = p[2]; s.hv_w = p[3];
+		for (u32 i = 1; i < n; i++)
+		{
+			s.hv_x0 = std::min(s.hv_x0, p[i * 4]); s.hv_x1 = std::max(s.hv_x1, p[i * 4]);
+			s.hv_y0 = std::min(s.hv_y0, p[i * 4 + 1]); s.hv_y1 = std::max(s.hv_y1, p[i * 4 + 1]);
+		}
+	}
