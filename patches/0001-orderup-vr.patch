+		// Small persistent state (config/orderupvr_state.txt): first-session controls card, prepared mod version.
+		std::map<std::string, std::string> g_persist;
+		std::mutex g_persist_mutex;
+
+		std::string persist_path() { return fs::get_config_dir() + "orderupvr_state.txt"; }
+		// Files the launcher writes (settings, channel): <emulator>/config/ (RPCS3's config dir on Windows is the emulator
+		// folder itself, so look in its config subfolder first), then next to the emulator
+		std::FILE* open_launcher_file(const char* name)
+		{
+			if (std::FILE* f = std::fopen((fs::get_config_dir(true) + name).c_str(), "r")) return f;
+			return std::fopen((fs::get_config_dir() + name).c_str(), "r");
+		}
+
+		void persist_load()
+		{
+			std::lock_guard lock(g_persist_mutex);
+			g_persist.clear();
+			if (std::FILE* f = std::fopen(persist_path().c_str(), "r"))
+			{
+				char line[512];
+				while (std::fgets(line, sizeof(line), f))
+				{
+					std::string l(line);
+					while (!l.empty() && (l.back() == '\n' || l.back() == '\r')) l.pop_back();
+					const usz eq = l.find('=');
+					if (eq != std::string::npos) g_persist[l.substr(0, eq)] = l.substr(eq + 1);
+				}
+				std::fclose(f);
+			}
+		}
+
+		std::string persist_get(const std::string& key)
+		{
+			std::lock_guard lock(g_persist_mutex);
+			const auto it = g_persist.find(key);
+			return it == g_persist.end() ? std::string() : it->second;
+		}
+
+		void persist_set(const std::string& key, const std::string& value)
+		{
+			std::lock_guard lock(g_persist_mutex);
+			if (g_persist[key] == value) return;
+			g_persist[key] = value;
+			if (std::FILE* f = std::fopen(persist_path().c_str(), "w"))
+			{
+				for (const auto& [k, v] : g_persist) std::fprintf(f, "%s=%s\n", k.c_str(), v.c_str());
+				std::fclose(f);
+			}
+		}
+
+		std::string mod_version()
+		{
+			const char* v = std::getenv("ORDERUP_VR_MODVERSION");
+			return v && *v ? v : "dev";
+		}
