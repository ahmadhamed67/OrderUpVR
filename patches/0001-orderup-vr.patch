+			xr.flats_draw = xr.flats;
+			// Now your body and hands, above every flat picture added so far, and then the pointer's laser and cursor above them
+			if (drew && layer_count < 16) layers[layer_count++] = reinterpret_cast<const XrCompositionLayerBaseHeader*>(&body_layer);
+			for (u32 i = 0; i < card_count && layer_count < 16; i++) layers[layer_count++] = card_layers[i];
+			for (u32 i = 0; i < top_count && layer_count < 16; i++) layers[layer_count++] = top_layers[i];
+
+			// Comfort vignette: darkens the edges of your view while the stick moves or turns you
+			if (frame_state.shouldRender && xr.comfort.vignette && xr.moving && xr.live3d)
+			{
+				if (!xr.vignette_tried)
+				{
+					xr.vignette_tried = true;
+					constexpr u32 n = 256;
+					std::vector<u8> px(n * n * 4, 0);
+					for (u32 y = 0; y < n; y++) for (u32 x = 0; x < n; x++)
+					{
+						const f32 dx = (x + 0.5f) / n * 2.f - 1.f, dy = (y + 0.5f) / n * 2.f - 1.f;
+						const f32 r = std::sqrt(dx * dx + dy * dy);
+						const f32 a = std::clamp((r - 0.42f) / 0.38f, 0.f, 1.f);
+						px[(y * n + x) * 4 + 3] = static_cast<u8>(a * a * (3.f - 2.f * a) * 255.f);
+					}
+					xr.vignette_ok = make_static(xr, xr.vignette, n, n, px);
+				}
+				if (xr.vignette_ok)
+				{
+					vig.layerFlags = XR_COMPOSITION_LAYER_BLEND_TEXTURE_SOURCE_ALPHA_BIT;
+					vig.space = xr.view_space;
+					vig.eyeVisibility = XR_EYE_VISIBILITY_BOTH;
+					vig.subImage.swapchain = xr.vignette;
+					vig.subImage.imageRect.extent = {256, 256};
+					vig.pose.orientation.w = 1.f;
+					vig.pose.position = {0.f, 0.f, -0.25f};
+					vig.size = {0.95f, 0.95f};
+					layers[layer_count++] = reinterpret_cast<const XrCompositionLayerBaseHeader*>(&vig);
+				}
+			}
+			if (!xr.live3d) xr.moving = false;
+
+			// The EXIT button was pressed all the way: nothing is shown any more, the headset goes black at once while the
+			// process ends
+			const bool quitting = g_quit_now.load();
+			if (quitting) layer_count = 0;
+
+			XrFrameEndInfo end{XR_TYPE_FRAME_END_INFO};
+			end.displayTime = frame_state.predictedDisplayTime;
+			end.environmentBlendMode = XR_ENVIRONMENT_BLEND_MODE_OPAQUE;
+			end.layerCount = layer_count;
+			end.layers = layer_count ? layers : nullptr;
+			xrEndFrame(xr.session, &end);
+			xr.frames++;
+			if (quitting) g_quit_black_frames.fetch_add(1);
+		}
+
+		void destroy(xr_state& xr)
+		{
+			g_session_running = false;
+			{
+				std::lock_guard lock(g_state_mutex);
+				g_pointer = {};
+			}
+			if (xr.swapchain != XR_NULL_HANDLE) xrDestroySwapchain(xr.swapchain);
+			if (xr.panel != XR_NULL_HANDLE) xrDestroySwapchain(xr.panel);
+			if (xr.help != XR_NULL_HANDLE) xrDestroySwapchain(xr.help);
+			if (xr.sign != XR_NULL_HANDLE) xrDestroySwapchain(xr.sign);
+			if (xr.cursor != XR_NULL_HANDLE) xrDestroySwapchain(xr.cursor);
+			if (xr.laser != XR_NULL_HANDLE) xrDestroySwapchain(xr.laser);
+			for (auto sc : xr.eye_sc) if (sc != XR_NULL_HANDLE) xrDestroySwapchain(sc);
+			if (xr.calib != XR_NULL_HANDLE) xrDestroySwapchain(xr.calib);
+			if (xr.vignette != XR_NULL_HANDLE) xrDestroySwapchain(xr.vignette);
+			gfx_destroy();
+			{
+				std::lock_guard lock(g_state_mutex);
+				g_views = {};
+				g_cam = {};
+				for (auto& p : g_pending) p = {};
+				for (auto& p : g_ready) p = {};
+			}
+			if (xr.session != XR_NULL_HANDLE) xrDestroySession(xr.session);
+			if (xr.instance != XR_NULL_HANDLE) xrDestroyInstance(xr.instance);
+			if (xr.context) xr.context->Release();
+			if (xr.device) xr.device->Release();
+			xr = {};
+		}
+
+		// ------------------------------------------------------------- headset simulator (developer testing)
+		// ORDERUP_VR_SIM=<folder>: no headset needed. A virtual head looks where <folder>/sim.txt says
+		// ("yaw pitch x z mode3d shot": degrees, metres, 1/0, a number that asks for pictures when it changes) and the
+		// game renders for it exactly as for a headset. Each eye's newest picture and the flat picture are saved as
+		// PNG (the see-through background in magenta), with state.txt describing what the mod measured.
+		void sim_save(const std::string& dir, const char* name, const pending_frame& f)
+		{
+			if (f.px.empty() || !f.w || !f.h) return;
+			std::vector<u8> px(f.px);
+			const int ri = f.bgra ? 2 : 0, bi = f.bgra ? 0 : 2;
+			for (usz i = 0; i + 3 < px.size(); i += 4)
+			{
+				u8* q = &px[i];
+				const bool key = q[ri] >= 1 && q[ri] <= 3 && q[1] >= 2 && q[1] <= 4 && q[bi] >= 4 && q[bi] <= 6;
+				u8 r = q[ri], g = q[1], b = q[bi];
+				if (key) { r = 255; g = 0; b = 255; }
+				q[0] = b; q[1] = g; q[2] = r; q[3] = 255;
+			}
+			ui::save_png(dir + name, px.data(), f.w, f.h, false);
+		}
+
+		void sim_main(const std::string& dir)
+		{
+			vr_log("Simulator: no headset, pictures go to %s", dir.c_str());
+			g_session_running = true;
+			const vec3 head0{0.f, 1.6f, 0.f};
+			std::string last_shot;
+			u64 last_auto = 0;
+			int auto_n = 0;
+			while (!g_stop)
+			{
+				f32 yaw = 0.f, pitch = 0.f, x = 0.f, z = 0.f;
+				int mode3d = 1;
+				char shot[64] = "";
+				if (std::FILE* f = std::fopen((dir + "sim.txt").c_str(), "r"))
+				{
+					std::fscanf(f, "%f %f %f %f %d %63s", &yaw, &pitch, &x, &z, &mode3d, shot);
+					std::fclose(f);
+				}
+				const XrQuaternionf q = qnorm(qmul(yaw_q(yaw * 0.01745329f), XrQuaternionf{std::sin(pitch * 0.00872665f), 0.f, 0.f, std::cos(pitch * 0.00872665f)}));
+				const vec3 right = rotate(q, {1.f, 0.f, 0.f});
+				const vec3 head{head0.x + x, head0.y, head0.z + z};
+				pointer_state fake;
+				const bool pressing = read_fake_pointer(fake) && (fake.t || fake.move || fake.cross || fake.circle || fake.square || fake.triangle || fake.start);
+				{
+					std::lock_guard lock(g_state_mutex);
+					g_views.valid = true;
+					for (int e = 0; e < 2; e++)
+					{
+						const vec3 p = head + right * (e ? 0.032f : -0.032f);
+						g_views.eye[e].position = {p.x, p.y, p.z};
+						g_views.eye[e].orientation = q;
+						g_views.fov[e] = {-0.80f, 0.80f, 0.75f, -0.80f};
+					}
+					g_views.player_pos = head0;
+					g_views.player_yaw = 0.f;
+					g_views.unit = seated_eye_m / chef_eye_u;
+					g_views.mode3d = mode3d != 0;
+					g_views.stereo = true;
+					g_views.hud_dist = 1.5f;
+					g_views.room = true;
+					if (pressing) g_views.input_tick = GetTickCount64();
+					g_views.cinema = true;
+					g_views.wide = std::getenv("ORDERUP_VR_NARROW") == nullptr;
+					g_views.fixed_unit = false;
+				}
+				const u64 now = GetTickCount64();
+				const bool asked = shot[0] && last_shot != shot;
+				if (asked || now - last_auto > 10000)
+				{
+					const std::string tag = asked ? std::string(shot) : "auto" + std::to_string(auto_n++ % 6);
+					last_shot = shot;
+					last_auto = now;
+					pending_frame f[3];
+					cam_info c;
+					{
+						std::lock_guard lock(g_state_mutex);
+						for (int i = 0; i < 3; i++) f[i] = g_pending[i];
+						c = g_cam;
+					}
+					sim_save(dir, (tag + "_eye0.png").c_str(), f[0]);
+					sim_save(dir, (tag + "_eye1.png").c_str(), f[1]);
+					sim_save(dir, (tag + "_flat.png").c_str(), f[2]);
+					if (std::FILE* st = std::fopen((dir + tag + "_state.txt").c_str(), "w"))
+					{
+						const auto& r = g_rv;
+						std::fprintf(st, "yaw %.1f pitch %.1f pos %.2f %.2f mode3d %d\ncamera %s room %d cinema %d still %d moves %llu depth %.2f auto_unit %.3f\n"
+							"bounds %d x %.1f..%.1f z %.1f..%.1f (game units)\nper frame 3D %d 2D %d backdrop %d other %d, want3d %d enabled %d\n"
+							"eye0 %ux%u eye1 %ux%u flat %ux%u\n",
+							yaw, pitch, x, z, mode3d, c.valid ? "found" : "not found", c.room, c.cinema, c.still, static_cast<unsigned long long>(c.moves), c.depth, c.auto_unit,
+							c.bounds, c.bx0, c.bx1, c.bz0, c.bz1, r.n3, r.n2, r.n2b, r.n0, r.want3d, r.enabled, f[0].w, f[0].h, f[1].w, f[1].h, f[2].w, f[2].h);
+						std::fclose(st);
+					}
+				}
+				// Memory: <folder>/peek "addr len" -> peek.txt (big-endian floats), find "lo hi" -> find.txt (float addresses),
+				// poke "addr value" writes a float (to try a change and look at the result)
+				static u64 last_mem = 0;
+				if (now - last_mem > 250)
+				{
+					last_mem = now;
+					const auto take = [&](const char* name, std::string& line) -> bool
+					{
+						std::FILE* f = std::fopen((dir + name).c_str(), "r");
+						if (!f) return false;
+						char buf[256] = "";
+						std::fgets(buf, sizeof(buf), f);
+						std::fclose(f);
+						fs::remove_file(dir + name);
+						line = buf;
+						return true;
+					};
+					const auto rdf = [](u32 a) { return std::bit_cast<f32>(_byteswap_ulong(*static_cast<const u32*>(vm::base(a)))); };
+					std::string line;
+					if (take("peek", line))
+					{
+						u32 a = 0, n = 0;
+						std::sscanf(line.c_str(), "%x %x", &a, &n);
+						if (std::FILE* o = std::fopen((dir + "peek.txt").c_str(), "w"))
+						{
+							for (u32 k = 0; k < n; k += 4)
+							{
+								if (!vm::check_addr(a + k, vm::page_readable, 4)) { std::fprintf(o, "%08x ----\n", a + k); continue; }
+								const u32 raw = _byteswap_ulong(*static_cast<const u32*>(vm::base(a + k)));
+								std::fprintf(o, "%08x %08x %g\n", a + k, raw, rdf(a + k));
+							}
+							std::fclose(o);
+						}
+					}
+					if (take("find", line))
+					{
+						f32 lo = 0.f, hi = 0.f;
+						std::sscanf(line.c_str(), "%f %f", &lo, &hi);
+						if (std::FILE* o = std::fopen((dir + "find.txt").c_str(), "w"))
+						{
+							int hits = 0;
+							for (u64 page = 0x10000; page < 0x40000000 && hits < 4000; page += 0x10000)
+							{
+								if (!vm::check_addr(static_cast<u32>(page), vm::page_readable, 0x10000)) continue;
+								for (u32 k = 0; k < 0x10000 && hits < 4000; k += 4)
+								{
+									const f32 v = rdf(static_cast<u32>(page) + k);
+									if (v >= lo && v <= hi) { std::fprintf(o, "%08x %g\n", static_cast<u32>(page) + k, v); hits++; }
+								}
+							}
+							std::fclose(o);
+						}
+					}
+					if (take("poke", line))
+					{
+						u32 a = 0;
+						f32 v = 0.f;
+						if (std::sscanf(line.c_str(), "%x %f", &a, &v) == 2 && vm::check_addr(a, vm::page_writable, 4))
+						{
+							*static_cast<u32*>(vm::base(a)) = _byteswap_ulong(std::bit_cast<u32>(v));
+							vr_log("Simulator: wrote %g at 0x%08x", v, a);
+						}
+					}
+				}
+				std::this_thread::sleep_for(std::chrono::milliseconds(12));
+			}
+			g_session_running = false;
+		}
+
+		void thread_main()
+		{
+			vr_log("Order Up VR starting (title %s)", Emu.GetTitleID().c_str());
+
+			xr_state xr;
+			{
+				std::map<std::string, std::string> kv;
+				if (std::FILE* f = open_launcher_file("orderupvr_channel.txt"))
+				{
+					char line[128];
+					while (std::fgets(line, sizeof(line), f))
+					{
+						std::string l(line);
+						while (!l.empty() && (l.back() == 10 || l.back() == 13 || l.back() == 32)) l.pop_back();
+						if (const usz eq = l.find('='); eq != std::string::npos) kv[l.substr(0, eq)] = l.substr(eq + 1);
+					}
+					std::fclose(f);
+				}
+				// No channel file: treat as Stable (true VR stays locked); developers set ORDERUP_VR_CHANNEL=beta
+				xr.channel = "stable";
+				if (const char* e = std::getenv("ORDERUP_VR_CHANNEL"); e && *e) xr.channel = e;
+				if (kv.count("channel")) xr.channel = kv["channel"];
+				xr.truevr_ok = xr.channel == "beta" && (!kv.count("truevr") || kv["truevr"] == "1");
+				vr_log("Channel: %s, true VR %s", xr.channel.c_str(), xr.truevr_ok ? "available" : "not available yet");
+			}
+			// No question after PLAY: Experimental is true VR, Stable the big screen. The card after PLAY is the quick setup of
+			// the VR settings, until "don't show this again" (the launcher can bring it back: orderupvr_setup_again.txt)
+			xr.mode3d = xr.truevr_ok;
+			xr.chooser_hover = -1;
+			{
+				const std::string again = fs::get_config_dir(true) + "orderupvr_setup_again.txt";
+				if (fs::is_file(again)) { persist_set("setup_hide", "0"); fs::remove_file(again); }
+				std::map<std::string, std::string> kv;
+				read_kv("orderupvr_comfort.txt", kv);
+				read_kv("orderupvr_comfort_vr.txt", kv);
+				for (const auto& o : setup_table()) xr.setup_vals[o.key] = kv.count(o.key) ? kv[o.key] : std::string(o.def);
+				xr.setup_step = 0;
+				xr.setup_hide = false;
+				xr.chooser_active = persist_get("setup_hide") != "1";
+				vr_log("Start: %s; quick setup %s", xr.mode3d ? "true VR" : "the big screen", xr.chooser_active ? "shown" : "hidden (don't show again)");
+			}
+			xr.stereo = persist_get("stereo") != "0";
+			xr.pointing_laser = persist_get("pointing") == "laser";
+			xr.lower = 0.f;   // the old right-stick height offset is gone: recenter sets your height
+			xr.fixed_unit = false;   // (an old hand-set "worldscale" is ignored: one scale from your eyes keeps body, lobby and game in step)
+			vr_log("True VR settings: view %s, %s, %.4f m per game unit", xr.mode3d ? "inside the game" : "big screen",
+				xr.stereo ? "stereo" : "mono", xr.unit);
+			if (const char* sim_dir = std::getenv("ORDERUP_VR_SIM"); sim_dir && *sim_dir)
+			{
+				std::string d = sim_dir;
+				if (d.back() != '/' && d.back() != '\\') d += '/';
+				sim_main(d);
+				vr_log("Order Up VR stopped (simulator)");
+				return;
+			}
+			if (create_instance(xr) && wait_for_system(xr) && create_device(xr) && create_session(xr) && create_actions(xr))
+			{
+				if (bool b = false; pick_format(xr, b)) g_dst_bgra = b;
+				g_prep_thread = std::thread(prep_main);
+				vr_log("VR session created. Waiting for the headset to become ready.");
+				while (!g_stop)
+				{
+					if (!poll_events(xr)) break;
+
+					if (g_session_running)
+					{
+						run_frame(xr);
+					}
+					else
+					{
+						write_status(xr);
+						std::this_thread::sleep_for(std::chrono::milliseconds(100));
+					}
+				}
+
+				if (g_session_running)
+				{
+					xrRequestExitSession(xr.session);
+				}
+			}
+
+			g_frame_cv.notify_all();
+			if (g_prep_thread.joinable())
+			{
+				const bool was_stop = g_stop.exchange(true);
+				g_frame_cv.notify_all();
+				g_prep_thread.join();
+				g_stop = was_stop;
+			}
+			destroy(xr);
+			vr_log("Order Up VR stopped");
+		}
+	}
+
+	void start()
+	{
+		if (g_thread.joinable()) return;
+
+		const char* any_title = std::getenv("ORDERUP_VR_ANY_TITLE");
+		if (Emu.GetTitleID() != target_title && !(any_title && *any_title == '1')) return;
+
+		if (const char* enabled = std::getenv("ORDERUP_VR"); enabled && *enabled == '0')
+		{
+			vr_log("Disabled by ORDERUP_VR=0");
+			return;
+		}
+
+		g_stop = false;
+		persist_load();
+		g_start_tick = GetTickCount64();
+		g_last_frame_tick = 0;
+		g_window_unavailable_tick = 0;
+		g_calib_tick = 0;
+		g_rv.begun = false;
+		g_rv.enabled = false;
+		g_rv.want3d = false;
+		g_rv.frames_with = g_rv.frames_without = 0;
+		g_rv.cam = {};
+		g_rv.have_up = false;
+		g_rv.depth = 3.5f;
+		g_rv.scene_key = g_rv.composite_key = g_rv.display_key = ~0ull;
+		for (auto& k : g_rv.screens) k = ~0ull;
+		for (auto& c : g_rv.content) c = {};
+		for (auto& r : g_rv.ring) r = {};
+		g_thread = std::thread(thread_main);
+	}
+
+	void stop()
+	{
+		if (!g_thread.joinable()) return;
+		g_stop = true;
+		g_thread.join();
+		mr_shutdown();
+	}
+
+	bool wants_frames()
+	{
+		return g_session_running.load(std::memory_order_relaxed);
+	}
