+		// PlayStation button shapes floating over the Quest buttons: X = pink square, Y = green triangle,
+		// A = blue cross, B = red circle.
+		void draw_button_labels(xr_state& xr, const hand_geo& h, int hand)
+		{
+			const auto W = [&](vec3 v) { return h.pos + rotate(h.q, v); };
+			const vec3 ax = rotate(h.q, {1.f, 0.f, 0.f}), ay = rotate(h.q, {0.f, 1.f, 0.f}), az = rotate(h.q, {0.f, 0.f, 1.f});
+			const f32 s = h.side;
+			const f32 sz = 0.0065f, bar = 0.0016f;
+			// Two labels: the lower button (A / X) and the upper one (B / Y)
+			const vec3 centres[2] = {W({-s * 0.006f, 0.052f, -0.018f}), W({s * 0.004f, 0.052f, -0.044f})};
+			for (int b = 0; b < 2; b++)
+			{
+				const vec3 c = centres[b];
+				const int shape = hand ? (b == 0 ? 0 : 1) : (b == 0 ? 2 : 3); // 0 cross, 1 circle, 2 square, 3 triangle
+				const auto seg = [&](f32 x0, f32 z0, f32 x1, f32 z1, vec3 col)
+				{
+					const vec3 a = c + ax * x0 + az * z0, e = c + ax * x1 + az * z1;
+					const vec3 d = e - a;
+					const f32 len = std::sqrt(dot(d, d));
+					const vec3 dx = d * (1.f / std::max(len, 1e-5f)), dz = normalize(cross(ay, dx));
+					draw_boxo(xr, (a + e) * 0.5f, dx, ay, dz, {len + bar, bar, bar}, col);
+				};
+				if (shape == 0)
+				{
+					const vec3 col{0.45f, 0.62f, 0.98f};
+					seg(-sz, -sz, sz, sz, col); seg(-sz, sz, sz, -sz, col);
+				}
+				else if (shape == 1)
+				{
+					const vec3 col{0.98f, 0.36f, 0.36f};
+					for (int i = 0; i < 12; i++)
+					{
+						const f32 a0 = 6.2831853f * i / 12, a1 = 6.2831853f * (i + 1) / 12;
+						seg(std::cos(a0) * sz, std::sin(a0) * sz, std::cos(a1) * sz, std::sin(a1) * sz, col);
+					}
+				}
+				else if (shape == 2)
+				{
+					const vec3 col{0.96f, 0.45f, 0.78f};
+					seg(-sz, -sz, sz, -sz, col); seg(sz, -sz, sz, sz, col); seg(sz, sz, -sz, sz, col); seg(-sz, sz, -sz, -sz, col);
+				}
+				else
+				{
+					const vec3 col{0.25f, 0.88f, 0.66f};
+					const f32 tx = sz * 0.95f;
+					seg(0.f, -sz, tx, sz * 0.7f, col); seg(tx, sz * 0.7f, -tx, sz * 0.7f, col); seg(-tx, sz * 0.7f, 0.f, -sz, col);
+				}
+			}
+		}
