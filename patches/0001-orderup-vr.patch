+		ID3D11RenderTargetView* gfx_rtv(xr_state& xr, ID3D11Texture2D* tex)
+		{
+			auto& g = g_gfx;
+			if (const auto it = g.rtv.find(tex); it != g.rtv.end()) return it->second;
+			D3D11_RENDER_TARGET_VIEW_DESC rd{};
+			rd.Format = g.fmt;
+			rd.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2D;
+			ID3D11RenderTargetView* v = nullptr;
+			if (FAILED(xr.device->CreateRenderTargetView(tex, &rd, &v))) return nullptr;
+			g.rtv[tex] = v;
+			return v;
+		}
+
+		void gfx_draw(xr_state& xr, const gmesh& m, const mat4& model, vec3 color, f32 env = 0.f)
+		{
+			auto& g = g_gfx;
+			cb_data cb{};
+			const mat4 mvp = mmul(g.vp, model);
+			std::memcpy(cb.mvp, mvp.m, sizeof(cb.mvp));
+			std::memcpy(cb.model, model.m, sizeof(cb.model));
+			cb.color[0] = color.x; cb.color[1] = color.y; cb.color[2] = color.z; cb.color[3] = 1.f;
+			cb.params[0] = env;
+			cb.params[1] = g.pattern_size.x; cb.params[2] = g.pattern_size.y; cb.params[3] = g.pattern_size.z;
+			xr.context->UpdateSubresource(g.cb, 0, nullptr, &cb, 0, 0);
+			const UINT stride = sizeof(gvert), offset = 0;
+			xr.context->IASetVertexBuffers(0, 1, &m.vb, &stride, &offset);
+			xr.context->IASetIndexBuffer(m.ib, DXGI_FORMAT_R16_UINT, 0);
+			xr.context->DrawIndexed(m.count, 0, 0);
+		}
+
+		vec3 any_perp(vec3 d)
+		{
+			const vec3 a = std::fabs(d.y) < 0.9f ? vec3{0.f, 1.f, 0.f} : vec3{1.f, 0.f, 0.f};
+			return normalize(cross(d, a));
+		}
+
+		void draw_ball(xr_state& xr, vec3 c, f32 r, vec3 col)
+		{
+			gfx_draw(xr, g_gfx.sphere, m_cols({r, 0, 0}, {0, r, 0}, {0, 0, r}, c), col);
+		}
+
+		void draw_limb(xr_state& xr, vec3 a, vec3 b, f32 ra, f32 rb, vec3 col)
+		{
+			const vec3 d = b - a;
+			const f32 len = std::sqrt(dot(d, d));
+			if (len < 1e-4f) { draw_ball(xr, a, ra, col); return; }
+			const vec3 y = d * (1.f / len), x = any_perp(y), z = cross(x, y);
+			const f32 r = (ra + rb) * 0.5f;
+			gfx_draw(xr, g_gfx.cyl, m_cols(x * r, d, z * r, a), col);
+			draw_ball(xr, a, ra, col);
+			draw_ball(xr, b, rb, col);
+		}
+
+		void draw_ellipsoid(xr_state& xr, vec3 c, vec3 ax, vec3 ay, vec3 az, vec3 size, vec3 col)
+		{
+			gfx_draw(xr, g_gfx.sphere, m_cols(ax * size.x, ay * size.y, az * size.z, c), col);
+		}
