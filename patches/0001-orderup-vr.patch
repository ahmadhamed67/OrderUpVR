+// Order Up VR: the game's own UI, read live from its memory (BLES01470 only).
+//
+// Found in the game's code (EBOOT, see docs/VR_AUDIT.md "Menu system"):
+//  - The menu system is *(u32*)0x0036df0c. Its open menus are a circular list at +0x2c (node: +0 next, +4 the menu).
+//  - A menu's root element is at menu+0x10.
+//  - An element: +0 vtable; +0x14c name hash (~crc32 of the name the scripts give it); +0x50 position (x y z w,
+//    ElementSetPosition); +0x78/+0x7c base width/height (ElementSetBaseDimensions); +0xd0 offset (x y z w);
+//    +0x180 flags (bit 2: hidden, bit 3: needs layout); containers keep their children at +0x18c (a circular list:
+//    node +0 next, +4 child); image elements (vtable 0x343748) keep their texture there instead.
+//  - The scripts build every screen with MenuNewElement{name=, type=sprite/image/text/button/panel/..., pos=, dims=,
+//    image=, focusable=, events={selected=script}}: the names come from those scripts in the player's Chef.wad.
+// Included inside namespace ouvr { namespace { ... } } of OrderUpVR.cpp, after the chef.
+
+namespace uitree
+{
+	using namespace chef;
+
+	// The UI scripts (package, file) that build menus and the kitchen HUD (found by their MenuNewElement calls)
+	constexpr std::pair<u32, u32> ui_scripts[] = {
+		{0x8c524289, 0x7a10e624}, {0x8c524289, 0xa0f78525}, {0x683d2dae, 0x11eeba16}, {0xefcbf845, 0x81265d83},
+		{0x683d2dae, 0x1fa9e7cc}, {0xefcbf845, 0xb1350865}, {0x683d2dae, 0xba6cbc9f}, {0xefcbf845, 0xebb11886},
+		{0xefcbf845, 0x23fafb4d}, {0x8c524289, 0x26ed19d6}, {0x6ce6f2f7, 0xd5f6dc64}, {0x8c524289, 0x011e8ede},
+		{0x683d2dae, 0xd2ad5bc3}, {0x683d2dae, 0x08db88cf},
+	};
+
+	// What each visible game UI element is in VR (its category), and where it is on the game's 1280x720 screen
+	// C_RECIPE: the big order card with the recipe steps (ticket_reel.csl create_big_ticket: orderbig, orderbig_ticket)
+	enum category : u8 { C_NONE = 0, C_PLATE, C_TRASH, C_OVEN, C_PROC, C_TICKETS, C_METER, C_LEFT, C_RIGHT, C_MENU, C_RECIPE };
+	struct elem { f32 x0, y0, x1, y1; f32 rx0, ry0, rx1, ry1; u8 cat, depth; bool btn; f32 kx0 = 0, ky0 = 0, kx1 = 0, ky1 = 0; u8 kdepth = 0;
+		s16 parent = -1; bool dup = false, named = false; u32 vt = 0; };   // k: its card (one ticket of the reel)   // btn: a button you press   // own rectangle; its group's rectangle
+	// parent: the element it sits in (its index in the list, -1: a menu's root); dup: the centred copy of the element before it
+	// (see walk); named: the game's scripts name it; vt: its class in the game (panel, image, text, button...)
+	inline std::mutex elems_mutex;
+	inline std::shared_ptr<const std::vector<elem>> elems;   // published (guarded by elems_mutex)
+
+	struct state
+	{
+		std::unordered_map<u32, std::string> names;   // ~crc32(name) -> name
+		bool names_tried = false;
+		u64 last_dump = 0;
