+	namespace
+	{
+		// The headset eye's projection, with the game's own depth mapping (A, B) so depth testing behaves the same.
+		mat4 eye_projection(const XrFovf& fov, f32 A, f32 B)
+		{
+			const f32 l = std::tan(fov.angleLeft), r = std::tan(fov.angleRight), u = std::tan(fov.angleUp), d = std::tan(fov.angleDown);
+			mat4 p;
+			p.m[0] = 2.f / (r - l); p.m[2] = (r + l) / (r - l);
+			p.m[5] = 2.f / (u - d); p.m[6] = (u + d) / (u - d);
+			p.m[10] = A; p.m[11] = B;
+			p.m[14] = -1.f;
+			return p;
+		}
+
+		mat4 level_mat(vec3 up)
+		{
+			mat4 L;
+			const vec3 axes[3] = {{1.f, 0.f, 0.f}, {0.f, 1.f, 0.f}, {0.f, 0.f, 1.f}};
+			for (int j = 0; j < 3; j++)
+			{
+				const vec3 c = level(up, axes[j]);
+				L.m[j] = c.x; L.m[4 + j] = c.y; L.m[8 + j] = c.z;
+			}
+			L.m[15] = 1.f;
+			return L;
+		}
+
+		// Real grabbing, once per game frame: pick what was grabbed (from last frame's candidates), and where your hand is
+		// in the game camera's space this frame
+		void rv_hold_frame(const view_snapshot& v)
+		{
+			auto& s = g_rv;
+			const bool was = s.holding;
+			s.holding = v.holding && v.mode3d;
+			s.hand_local = v.hand_local;
+			s.ptr_nx = v.ptr_nx;
+			s.ptr_ny = v.ptr_ny;
+			if (!s.holding)
+			{
+				if (was && s.hold_picked) vr_log("Grab: let go (%u parts were in your hand)", static_cast<u32>(s.held.size()));
