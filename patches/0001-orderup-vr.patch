+}
+
+#endif
+
+#include "Emu/Cell/SPUDisAsm.h"
+#include "Emu/Cell/PPUDisAsm.h"
+
+namespace ouvr
+{
+	// Developer tools, run from the command line; never used during play.
+	int dev_tool(int argc, char** argv)
+	{
+		const std::string cmd = argv[1];
+		if (cmd == "--ouvr-spu-disasm" && argc >= 4)
+		{
+			std::FILE* in = std::fopen(argv[2], "rb");
+			if (!in) return 2;
+			std::vector<u8> data(0x40000);
+			const usz n = std::fread(data.data(), 1, data.size(), in);
+			std::fclose(in);
+			const u32 start = argc > 4 ? static_cast<u32>(std::strtoul(argv[4], nullptr, 0)) : 0;
+			const u32 len = argc > 5 ? static_cast<u32>(std::strtoul(argv[5], nullptr, 0)) : static_cast<u32>(n);
+			std::FILE* out = std::fopen(argv[3], "w");
+			if (!out) return 3;
+			SPUDisAsm dis(cpu_disasm_mode::normal, data.data(), 0);
+			for (u32 pc = start & ~3u; pc < start + len && pc + 4 <= n; pc += 4)
+			{
+				dis.disasm(pc);
+				std::fprintf(out, "%05x: %08x  %s\n", pc, static_cast<u32>(data[pc] << 24 | data[pc + 1] << 16 | data[pc + 2] << 8 | data[pc + 3]), dis.last_opcode.c_str());
+			}
+			std::fclose(out);
+			return 0;
+		}
+		if (cmd == "--ouvr-ppu-disasm" && argc >= 6)
+		{
+			// PPU disassembly of a decrypted ELF (program segments placed at their addresses): <elf> <out> <start> <length>
+			std::FILE* in = std::fopen(argv[2], "rb");
+			if (!in) return 2;
+			std::vector<u8> elf;
+			{
+				std::fseek(in, 0, SEEK_END);
+				elf.resize(std::ftell(in));
+				std::fseek(in, 0, SEEK_SET);
+				std::fread(elf.data(), 1, elf.size(), in);
+				std::fclose(in);
+			}
+			const auto be64 = [&](usz o) { u64 v = 0; for (int k = 0; k < 8; k++) v = v << 8 | elf[o + k]; return v; };
+			const auto be16 = [&](usz o) { return static_cast<u32>(elf[o] << 8 | elf[o + 1]); };
+			std::vector<u8> image(0x400000);
+			const u64 phoff = be64(0x20);
+			for (u32 i = 0; i < be16(0x38); i++)
+			{
+				const usz o = phoff + i * 56;
+				if ((elf[o] << 24 | elf[o + 1] << 16 | elf[o + 2] << 8 | elf[o + 3]) != 1) continue;
+				const u64 off = be64(o + 8), va = be64(o + 16), fsz = be64(o + 32);
+				if (va + fsz <= image.size() && off + fsz <= elf.size()) std::memcpy(image.data() + va, elf.data() + off, fsz);
+			}
+			const u32 start = static_cast<u32>(std::strtoul(argv[4], nullptr, 0)), len = static_cast<u32>(std::strtoul(argv[5], nullptr, 0));
+			std::FILE* out = std::fopen(argv[3], "w");
+			if (!out) return 3;
+			PPUDisAsm dis(cpu_disasm_mode::normal, image.data());
+			for (u32 pc = start & ~3u; pc < start + len && pc + 4 <= image.size(); pc += 4)
+			{
+				dis.disasm(pc);
+				std::fprintf(out, "%08x: %08x  %s\n", pc, static_cast<u32>(image[pc] << 24 | image[pc + 1] << 16 | image[pc + 2] << 8 | image[pc + 3]), dis.last_opcode.c_str());
+			}
+			std::fclose(out);
+			return 0;
+		}
+		if (cmd == "--ouvr-cards" && argc >= 3)
+		{
+			// Draws every headset card to PNG files in a folder, to look at the design without a headset
+			const std::string dir = std::string(argv[2]) + "/";
+			const auto out = [&](const char* name, const ui::card& c, u32 w, u32 h)
+			{
+				std::vector<u8> px;
+				const bool ok = ui::render(c, w, h, px) && ui::save_png(dir + name, px.data(), w, h);
+				std::printf("%s: %s\n", name, ok ? "ok" : "FAILED");
+			};
+			ui::card c;
+			c.kicker = L"ORDER UP!! VR"; c.title = L"Opening the restaurant"; c.subtitle = L"Starting the game on your PC. Keep its window open.";
+			c.progress = -2; c.phase = 0.35f; c.progress_label = L"12 s"; c.tip = L"GRIP grabs and holds. TRIGGER chooses.";
+			out("panel_start.png", c, panel_w, panel_h);
+			c = {}; c.kicker = L"FIRST START"; c.title = L"Setting up your kitchen"; c.subtitle = L"A one-time step after installing or updating. Later starts are quick.";
+			c.progress = 42; c.progress_label = L"About 3 minutes left"; c.tip = L"To flip, hold GRIP and flick your wrist up. Or flick the thumbstick up.";
+			out("panel_progress.png", c, panel_w, panel_h);
+			c = {}; c.kicker = L"PAUSED"; c.title = L"The game window is minimized";
+			c.subtitle = L"Restore the Order Up!! window on your PC (click it in the taskbar). The headset needs that window open.";
+			c.tip = L"Hold the left MENU button for 2 seconds to see all controls.";
+			out("panel_minimized.png", c, panel_w, panel_h);
+			out("help.png", help_card(), help_w, help_h);
+			out("sign.png", sign_card(true), sign_w, sign_h);
+			out("calib.png", calib_card(), 1024, 300);
+			out("chooser_stable.png", chooser_card(0, false, "stable"), chooser_w, chooser_h);
+			out("chooser_beta.png", chooser_card(1, true, "beta"), chooser_w, chooser_h);
+			return 0;
+		}
+		if (cmd == "--ouvr-lobby-test" && argc >= 4)
+		{
+			// Rebuilds every lobby restaurant and dumps it (vertices, indices, batches, spawn) for offline checks
+			for (int k = 0; k < static_cast<int>(std::size(lobby::places)); k++)
+			{
+				lobby::restaurant r;
+				const u64 t0 = GetTickCount64();
+				const bool ok = lobby::load(r, argv[2], k);
+				std::printf("%-12s %s %s: %zu vertices, %zu triangles, %zu batches, %zu pictures, stand %.2f %.2f %.2f facing %.0f deg, %.1f m free, %llu ms\n",
+					r.name.c_str(), ok ? "ok" : "FAILED", r.error.c_str(), r.v.size(), r.idx.size() / 3, r.batches.size(), r.pics.size(), r.spawn.x, r.spawn.y, r.spawn.z,
+					r.facing * 57.29578f, r.board_dist, static_cast<unsigned long long>(GetTickCount64() - t0));
+				std::printf("   %s\n", r.info.c_str());
+				if (!ok) continue;
+				std::FILE* o = std::fopen(fmt::format("%s_%d.bin", argv[3], k).c_str(), "wb");
+				if (!o) continue;
+				const u32 hdr[4] = {static_cast<u32>(r.v.size()), static_cast<u32>(r.idx.size()), static_cast<u32>(r.batches.size()), static_cast<u32>(r.pics.size())};
+				std::fwrite(hdr, 4, 4, o);
+				const f32 sp[5] = {r.spawn.x, r.spawn.y, r.spawn.z, r.facing, r.board_dist};
+				std::fwrite(sp, 4, 5, o);
+				std::fwrite(r.v.data(), sizeof(lobby::vert), r.v.size(), o);
+				std::fwrite(r.idx.data(), 4, r.idx.size(), o);
+				for (const auto& b : r.batches) { const s32 bb[4] = {static_cast<s32>(b.first), static_cast<s32>(b.count), b.tex, b.blend}; std::fwrite(bb, 4, 4, o); }
+				for (const auto& p : r.pics)
+				{
+					// a small copy of each picture (every 4th pixel) for the offline render
+					const u32 w = p.w / 4, h = p.h / 4;
+					const u32 wh[2] = {p.rgba.empty() ? 0u : w, p.rgba.empty() ? 0u : h};
+					std::fwrite(wh, 4, 2, o);
+					for (u32 y = 0; y < wh[1]; y++)
+						for (u32 x = 0; x < wh[0]; x++) std::fwrite(&p.rgba[(usz{y} * 4 * p.w + x * 4) * 4], 1, 4, o);
+				}
+				std::fclose(o);
+			}
+			return 0;
+		}
+		if (cmd == "--ouvr-edge-dump" && argc >= 5)
+		{
+			// Decodes every Edge segment's triangle list in a model file (the game's own decoder) for offline study:
+			// records of (segment offset, vertices, indices, index stream offset, its size) then the indices (u16)
+			std::vector<u8> job;
+			std::string err;
+			if (!chef::load_job(argv[2], job, err)) { std::printf("job: %s\n", err.c_str()); return 1; }
+			fs::file in(argv[3]);
+			if (!in) return 1;
+			const std::vector<u8> B = in.to_vector<u8>();
+			std::FILE* o = std::fopen(argv[4], "wb");
+			if (!o) return 1;
+			int found = 0, decoded = 0;
+			for (usz s = 0; s + 0x40 < B.size(); s += 16)
+			{
+				if ((B[s] & 0xf0) != 0x80 || (B[s + 6] & 0xf0) != 0x30) continue;
+				const u32 nv = chef::rd16be(&B[s + 8]), ni = chef::rd16be(&B[s + 10]);
+				if (nv < 3 || nv > 8000 || ni % 3 || ni == 0 || ni > 60000) continue;
+				found++;
+				const u32 isz = chef::rd16be(&B[s + 20]);
+				const u32 tris = ni / 3;
+				for (usz q = s + 16; q + 8 < B.size() && q < s + 0x20000; q += 16)
+				{
+					const u32 n = chef::rd16be(&B[q]), X = chef::rd16be(&B[q + 4]), bits = B[q + 6];
+					if (bits > 16 || X == 0 || X > 4096) continue;
+					const usz tot = 8 + X + (tris * 2 + 7) / 8 + (usz{n} * bits + 7) / 8;
+					if (chef::pad16(tot) != isz || n > ni || q + isz > B.size()) continue;
+					std::vector<u16> ix;
+					if (!chef::edge_decompress(job, &B[s], &B[q], isz, ni, ix)) continue;
+					u16 mx = 0;
+					for (u16 c : ix) mx = std::max(mx, c);
+					if (mx + 1u != nv) continue;
+					const u32 rec[5] = {static_cast<u32>(s), nv, ni, static_cast<u32>(q), isz};
+					std::fwrite(rec, 4, 5, o);
+					std::fwrite(ix.data(), 2, ix.size(), o);
+					decoded++;
+					break;
+				}
+			}
+			std::fclose(o);
+			std::printf("%d segments, %d decoded\n", found, decoded);
+			return 0;
+		}
+		if (cmd == "--ouvr-chef-test" && argc >= 4)
+		{
+			// Rebuilds both chefs from a game's USRDIR and writes them as OBJ (rest pose and a reaching pose)
+			for (int fem = 0; fem < 2; fem++)
+			{
+				chef::model m;
+				const u64 t0 = GetTickCount64();
+				const bool ok = chef::load(m, argv[2], fem != 0);
+				std::printf("%s chef: %s, %zu vertices, %zu triangles, texture %ux%u, %llu ms %s\n", fem ? "female" : "male", ok ? "ok" : "FAILED", m.v.size(), m.idx.size() / 3, m.tw, m.th,
+					static_cast<unsigned long long>(GetTickCount64() - t0), m.error.c_str());
+				if (!ok) continue;
+				for (int posed = 0; posed < 2; posed++)
+				{
+					chef::pose_in in;
+					in.scale = 1.f;
+					in.head = {0.f, m.eye_y, m.face_z + 0.03f};
+					in.body_yaw = 3.14159265f;    // facing +z, like the T pose
+					if (posed)
+					{
+						for (int sd = 0; sd < 2; sd++)
+						{
+							in.hand_valid[sd] = true;
+							in.hand[sd].position = {sd == 0 ? 0.25f : -0.25f, m.eye_y - 0.35f, m.face_z + 0.45f};
+							// held naturally: the handle tilts 60 degrees up from pointing forward (+z)
+							in.hand[sd].orientation = qnorm(qmul(yaw_q(3.14159265f), XrQuaternionf{std::sin(0.5236f), 0.f, 0.f, std::cos(0.5236f)}));
+							in.grip[sd] = sd == 0 ? 1.f : 0.f;
+							in.trig[sd] = sd == 0 ? 1.f : 0.f;
+						}
+						in.walk_phase = 1.2f;
+						in.walk_amount = 1.f;
+					}
+					chef::rigid T[chef::P_COUNT];
+					vec3 root; XrQuaternionf rq;
+					chef::solve(m, in, T, root, rq);
+					std::vector<vec3> P, N;
+					chef::skin(m, T, root, rq, in.scale, P, N);
+					std::FILE* f = std::fopen(fmt::format("%s_%s_%s.obj", argv[3], fem ? "female" : "male", posed ? "posed" : "rest").c_str(), "w");
+					if (!f) continue;
+					for (usz i = 0; i < P.size(); i++) std::fprintf(f, "v %f %f %f\nvt %f %f\n", P[i].x, P[i].y, P[i].z, m.v[i].u, m.v[i].v);
+					for (usz i = 0; i + 2 < m.idx.size(); i += 3) std::fprintf(f, "f %u/%u %u/%u %u/%u\n", m.idx[i] + 1, m.idx[i] + 1, m.idx[i + 1] + 1, m.idx[i + 1] + 1, m.idx[i + 2] + 1, m.idx[i + 2] + 1);
+					std::fclose(f);
+				}
+				// face: material ranges and pictures
+				for (int k = 0; k < chef::model::M_COUNT; k++) std::printf(" range %d: %u tris", k, m.range_count[k] / 3);
+				std::printf("\n");
+				for (int k = 0; k < 3; k++)
+					if (m.face_size[k])
+					{
+						std::vector<u8> bgra(m.face_rgba[k]);
+						for (usz i = 0; i + 3 < bgra.size(); i += 4) std::swap(bgra[i], bgra[i + 2]);
+						ui::save_png(fmt::format("%s_%s_face%d.png", argv[3], fem ? "female" : "male", k), bgra.data(), m.face_size[k], m.face_size[k], false);
+					}
+				// parts histogram
+				int hist[chef::P_COUNT]{};
+				for (const auto& x : m.v) hist[x.part[0]]++;
+				for (int k = 0; k < chef::P_COUNT; k++) std::printf(" part %d: %d", k, hist[k]);
+				std::printf("\n");
+			}
+			return 0;
+		}
+		return 1;
+	}
+}
diff --git a/rpcs3/Emu/Io/OrderUpVR.h b/rpcs3/Emu/Io/OrderUpVR.h
new file mode 100644
index 000000000..7b70b0b0a
--- /dev/null
+++ b/rpcs3/Emu/Io/OrderUpVR.h
@@ -0,0 +1,112 @@
+#pragma once
+#include <functional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Order Up VR: OpenXR bridge for the PS3 game Order Up!! (BLES01470).
+//
+// A dedicated thread owns an OpenXR session (D3D11 binding, independent of the
+// emulator's renderer). The renderer hands it finished game frames, which are
+// shown on a large world-locked virtual screen. The VR controller that aims at
+// that screen becomes the game's PlayStation Move pointer (see cellGem.cpp).
+
+#include "util/types.hpp"
+
+#include <vector>
+
+namespace ouvr
+{
+	struct pointer_state
+	{
+		bool active = false; // VR session is focused and a controller is tracked; use this instead of the mouse
+		bool on_screen = false;
+		f32 x = 0.5f;        // 0..1 across the virtual screen, left to right
+		f32 y = 0.5f;        // 0..1 top to bottom
+		f32 trigger = 0.0f;  // 0..1
+		bool t = false;
+		bool move = false;
+		bool cross = false;
+		bool circle = false;
+		bool square = false;
+		bool triangle = false;
+		bool start = false;
+		bool select = false;
+
+		// Real controller motion, in the emulated PS Eye camera frame (= the virtual screen: x right, y up,
+		// z towards the player). A real PS Move reports the same quantities, so the game's motion gestures work.
+		bool motion = false;
+		bool assist = false;   // the stick-flick flip is playing
+		f32 rq[4] = {0.f, 0.f, 0.f, 1.f}; // rotation beyond aiming (wrist twist, flicking past the screen), x y z w
+		f32 vel[3] = {};       // mm/s
+		f32 accel[3] = {};     // mm/s^2
+		f32 angvel[3] = {};    // rad/s
+		f32 angaccel[3] = {};  // rad/s^2
+		f32 disp[3] = {};      // mm, quick hand movement (slow drift removed)
+		// Real grabbing: the hand's ray in room space (origin + direction), for future 3D item pickup.
+		f32 ray_origin[3] = {};
+		f32 ray_dir[3] = {0.f, 0.f, -1.f};
+		f32 acc_dev[3] = {0.f, 0.f, 1.f}; // accelerometer in device axes, G (gravity included)
+		f32 gyro_dev[3] = {};  // gyroscope in device axes, rad/s
+	};
+
+	// Called by the renderer when a game boots / shuts down.
+	void start();
+	void stop();
+
+	// True while the VR session is running and wants a copy of every presented frame.
+	bool wants_frames();
+
+	// Latest presented game frame, 4 bytes per pixel.
+	// display_key: (location << 32) | offset of the display buffer shown.
+	void submit_frame(std::vector<u8>&& pixels, u32 width, u32 height, bool is_bgra, u64 display_key = ~0ull);
+
+	// The renderer could not present because the desktop game window is minimized or has no size.
+	void report_window_unavailable();
+
+	// Current controller-as-pointer state (thread safe).
+	pointer_state get_pointer();
+
+	// Diagnostics (written to log/orderup_vr.log). trace() counts calls per name and reports them every few seconds.
+	void trace(const char* name);
+
+	// True-VR research: records likely camera/projection matrices from vertex shader constants a few times per session
+	// (log/orderup_research.log). consts = all 468 transform constants (4 floats each), ids = constants the program reads.
+	void research_constants(u32 program_id, const f32* consts, const u16* ids, usz id_count);
+	void note(const char* fmt, ...);
+
+	// True VR (stereo + head tracking), called by the renderer for every draw on the RSX thread.
+	// The game draws every 3D object with one model-view-projection matrix in constants c1..c4; the mod finds the
+	// camera projection in it and re-renders the scene from the headset's eye. consts = the 468 transform constants,
+	// uses_mvp = the vertex program reads c1..c4.
+	// Returns 0 = leave the draw alone, 1 = 3D scene draw, 2 = 2D overlay draw (HUD, menus: placed on a plane in
+	// the 3D world). For 1 and 2, x receives a row-major 4x4 matrix to apply to the program's clip-space output.
+	// color_key / tex_keys: (location << 32) | offset of the colour target and of the textures the draw reads
+	// (location 0 = local video memory, 1 = main memory). They tell the scene, the copy of it onto the screen
+	// and the HUD apart.
+	// The launcher's mods that change the game's code (config/orderupvr_mods.txt), applied when the program loads
+	void note_game(const std::string& exe_hash);
+	void apply_code_patches(const std::string& exe_hash, const std::function<u8*(u32, u32)>& ptr, std::vector<u32>& applied);
+
+	// The next flat draw's first vertices (position attribute: x y z w each), for placing HUD elements
+	void hud_vertices(const f32* xyzw, u32 count, u32 type, u32 comps);
+	int stereo_draw_transform(const f32* consts, bool uses_mvp, u32 surface_w, u32 surface_h, u64 color_key, const u64* tex_keys, u32 tex_count, f32 x[16]);
+
+	// Clear of a colour target: returns true and the colour to use when the mod replaces it (the empty space around
+	// the game's view becomes see-through in the headset).
+	bool stereo_clear_color(u64 color_key, f32 rgba[4]);
+
+	// The game started a PS Move calibration (it asked the player to press Square and they did).
+	void note_calibration();
+
+	// Changes once per presented frame (the eye being rendered changes); the renderer re-applies the transform then.
+	u64 stereo_generation();
+
+	// A crash report to the live test stream (Experimental), sent before the process ends.
+	void live_fatal(std::string_view text);
+
+	// rows = the renderer's 4x4 viewport (scale/offset) matrix, row-major; it becomes rows * x.
+	void stereo_apply(void* rows, const f32 x[16]);
+	// Developer tools (not used in play): --ouvr-spu-disasm <in> <out> [start] [len]
+	int dev_tool(int argc, char** argv);
+}
diff --git a/rpcs3/Emu/Io/OrderUpVR_chef.inl b/rpcs3/Emu/Io/OrderUpVR_chef.inl
new file mode 100644
index 000000000..5a94a5761
--- /dev/null
+++ b/rpcs3/Emu/Io/OrderUpVR_chef.inl
@@ -0,0 +1,848 @@
+// Order Up VR: the game's own chef models, rebuilt at start-up from the player's own game files.
+//
+// The chefs live in USRDIR/Chef.wad (nested, zlib-compressed WADs; files named by CRC32 of their path, without the
+// final inversion). Their triangle lists use Sony's Edge compressed index format, which the game decodes on the SPUs.
+// We run the game's own decoder (from USRDIR/spurs/spu_codef.ppu.sprx, decrypted with RPCS3's own code) in a small
+// SPU interpreter, so nothing of the game is shipped with the mod.
+// Included inside namespace ouvr { namespace { ... } } of OrderUpVR.cpp, after the vec3 helpers.
+
+namespace chef
+{
