+		void place_screen(xr_state& xr)
+		{
+			vec3 f = xr.last_forward;
+			f.y = 0.0f;
+			const f32 len = std::sqrt(dot(f, f));
+			f = len > 0.001f ? f * (1.0f / len) : vec3{0.0f, 0.0f, -1.0f};
+
+			xr.screen_center = xr.last_head + f * xr.screen_distance;
+			xr.screen_center.y = xr.last_head.y - 0.10f;
+			xr.screen_yaw = std::atan2(-f.x, -f.z);
+			xr.screen_placed = true;
+
+			// True VR: the game camera sits at the player's eyes, facing where they face
+			xr.player_pos = xr.last_head;
+			xr.player_yaw = xr.screen_yaw;
+			vr_log("Screen placed: centre (%.2f, %.2f, %.2f), yaw %.1f deg, %.2f m wide at %.2f m",
+				xr.screen_center.x, xr.screen_center.y, xr.screen_center.z, xr.screen_yaw * 57.29578f, xr.screen_width, xr.screen_distance);
+		}
+
+		// Rotates a LOCAL-space vector into the virtual screen's frame (x right, y up, z towards the player),
+		// which is the frame of the emulated PS Eye camera.
+		vec3 to_screen(const xr_state& xr, vec3 v)
+		{
+			const f32 c = std::cos(xr.screen_yaw), s = std::sin(xr.screen_yaw);
+			return {v.x * c - v.z * s, v.y, v.x * s + v.z * c};
+		}
+
+		// Fills the PS Move motion fields from the real controller pose and velocity.
+		// center/yaw: the (virtual) screen the emulated PS Eye camera sits on.
+		void compute_motion(xr_state& xr, const XrSpaceLocation& aim, const XrSpaceVelocity& sv, pointer_state& out, f32 dt, f32 width, f32 height, vec3 center, f32 yaw)
+		{
+			const auto to_s = [yaw](vec3 v) { const f32 c = std::cos(yaw), s = std::sin(yaw); return vec3{v.x * c - v.z * s, v.y, v.x * s + v.z * c}; };
+			const XrQuaternionf qs = yaw_q(yaw);
+			const XrQuaternionf qc = qnorm(qmul(qconj(qs), aim.pose.orientation)); // controller orientation, screen frame
+			const vec3 p = to_s(to_vec(aim.pose.position) - center); // metres
+
+			// Split the orientation into "aiming at the screen" (already sent as the pointer) and the rest (twist, or
+			// pointing past the screen edge, as in a flick). The rest is what the game would see a real Move do.
+			const vec3 d = rotate(qc, {0.f, 0.f, -1.f});
+			const f32 dist = std::max(p.z, 0.2f);
+			f32 tx = d.z < -0.05f ? d.x / -d.z : (d.x >= 0.f ? 10.f : -10.f);
+			f32 ty = d.z < -0.05f ? d.y / -d.z : (d.y >= 0.f ? 10.f : -10.f);
+			tx = std::clamp(tx, (-width * 0.5f - p.x) / dist, (width * 0.5f - p.x) / dist);
+			ty = std::clamp(ty, (-height * 0.5f - p.y) / dist, (height * 0.5f - p.y) / dist);
+			const vec3 dc = normalize({tx, ty, -1.f});
+			const vec3 fwd{0.f, 0.f, -1.f};
+			const vec3 axis = cross(fwd, dc);
+			const XrQuaternionf qdir = qnorm({axis.x, axis.y, axis.z, 1.f + dot(fwd, dc)});
+			XrQuaternionf r = qnorm(qmul(qconj(qdir), qc));
+			if (r.w < 0.f) r = {-r.x, -r.y, -r.z, -r.w};
+			out.rq[0] = r.x; out.rq[1] = r.y; out.rq[2] = r.z; out.rq[3] = r.w;
+
+			vec3 v{}, av{};
+			if (sv.velocityFlags & XR_SPACE_VELOCITY_LINEAR_VALID_BIT) v = to_s(to_vec(sv.linearVelocity)) * 1000.f;
+			if (sv.velocityFlags & XR_SPACE_VELOCITY_ANGULAR_VALID_BIT) av = to_s(to_vec(sv.angularVelocity));
+			if (xr.have_prev && dt > 0.f)
+			{
+				xr.accel = xr.accel * 0.5f + ((v - xr.prev_vel) * (1.f / dt)) * 0.5f;
+				xr.angaccel = xr.angaccel * 0.5f + ((av - xr.prev_angvel) * (1.f / dt)) * 0.5f;
+			}
+			xr.prev_vel = v;
+			xr.prev_angvel = av;
+			xr.have_prev = true;
+
+			// Quick hand movement relative to where the hand has been over the last ~quarter second
+			const vec3 pm = p * 1000.f;
+			if (!xr.lp_init) { xr.lp_pos = pm; xr.lp_init = true; }
+			xr.lp_pos = xr.lp_pos + (pm - xr.lp_pos) * std::min(1.f, dt / 0.25f);
+			const vec3 disp = pm - xr.lp_pos;
+
+			for (int i = 0; i < 3; i++)
+			{
+				out.vel[i] = (&v.x)[i];
+				out.accel[i] = (&xr.accel.x)[i];
+				out.angvel[i] = (&av.x)[i];
+				out.angaccel[i] = (&xr.angaccel.x)[i];
+				out.disp[i] = (&disp.x)[i];
+			}
+
+			// Inertial sensors in device axes (Move: x right, y towards the sphere, z up)
+			const XrQuaternionf qi = qconj(qc);
+			const vec3 a_dev = rotate(qi, xr.accel * (1.f / 9810.f) + vec3{0.f, 1.f, 0.f});
+			const vec3 g_dev = rotate(qi, av);
+			out.acc_dev[0] = a_dev.x; out.acc_dev[1] = -a_dev.z; out.acc_dev[2] = a_dev.y;
+			out.gyro_dev[0] = g_dev.x; out.gyro_dev[1] = -g_dev.z; out.gyro_dev[2] = g_dev.y;
+			out.motion = true;
+		}
+
+		// Stick-flick flip: plays a clean half-circle flip on top of the real motion, for when a real flick is not
+		// recognised. Wrist rotates up and back (about 150 degrees) while the hand traces a half circle.
+		void apply_flip_assist(xr_state& xr, pointer_state& out)
+		{
+			if (!xr.assist_start) return;
+			constexpr f32 duration = 0.45f, pi = 3.14159265f, radius = 120.f, max_angle = 2.6f, h = 0.01f;
+			const f32 t = (GetTickCount64() - xr.assist_start) / 1000.f;
+			if (t >= duration) { xr.assist_start = 0; return; }
+
+			const auto pos = [&](f32 tt) { const f32 u = std::clamp(tt / duration, 0.f, 1.f); return vec3{-radius * std::cos(pi * u) * std::sin(pi * u), radius * std::sin(pi * u), 0.f}; };
+			const auto ang = [&](f32 tt) { const f32 u = std::clamp(tt / duration, 0.f, 1.f); return max_angle * std::sin(pi * u); };
+
+			const vec3 p0 = pos(t), p1 = pos(t - h), p2 = pos(t - 2 * h);
+			const vec3 vel = (p0 - p1) * (1.f / h);
+			const vec3 acc = (p0 - p1 * 2.f + p2) * (1.f / (h * h));
+			const f32 a0 = ang(t), a1 = ang(t - h), a2 = ang(t - 2 * h);
+			const f32 w = (a0 - a1) / h, wa = (a0 - 2 * a1 + a2) / (h * h);
+
+			const XrQuaternionf rq{out.rq[0], out.rq[1], out.rq[2], out.rq[3]};
+			const XrQuaternionf flip{std::sin(a0 * 0.5f), 0.f, 0.f, std::cos(a0 * 0.5f)};
+			const XrQuaternionf r = qnorm(qmul(rq, flip));
+			out.rq[0] = r.x; out.rq[1] = r.y; out.rq[2] = r.z; out.rq[3] = r.w;
+			for (int i = 0; i < 3; i++)
+			{
+				out.vel[i] += (&vel.x)[i];
+				out.accel[i] += (&acc.x)[i];
+				out.disp[i] += (&p0.x)[i];
+			}
+			out.assist = true;
+			out.angvel[0] += w;
+			out.angaccel[0] += wa;
+			out.gyro_dev[0] += w;
+			out.acc_dev[2] += acc.y / 9810.f;
+			out.motion = true;
+		}
+
+		void update_input(xr_state& xr, XrTime time, f32 dt)
+		{
+			pointer_state out;
+
+			// Head pose (used to place the screen)
+			XrSpaceLocation head{XR_TYPE_SPACE_LOCATION};
+			if (XR_SUCCEEDED(xrLocateSpace(xr.view_space, xr.local_space, time, &head)) &&
+				(head.locationFlags & XR_SPACE_LOCATION_POSITION_VALID_BIT) && (head.locationFlags & XR_SPACE_LOCATION_ORIENTATION_VALID_BIT))
+			{
+				xr.last_head = to_vec(head.pose.position);
+				xr.last_forward = rotate(head.pose.orientation, {0.0f, 0.0f, -1.0f});
+				if (!xr.screen_placed) place_screen(xr);
+			}
+
+			if (xr.session_state == XR_SESSION_STATE_FOCUSED)
+			{
+				XrActiveActionSet active{xr.action_set, XR_NULL_PATH};
+				XrActionsSyncInfo sync{XR_TYPE_ACTIONS_SYNC_INFO};
+				sync.countActiveActionSets = 1;
+				sync.activeActionSets = &active;
+				xrSyncActions(xr.session, &sync);
+
+				const f32 trig[2] = {get_float(xr, xr.trigger, 0), get_float(xr, xr.trigger, 1)};
+				const f32 grip[2] = {get_float(xr, xr.squeeze, 0), get_float(xr, xr.squeeze, 1)};
+
+				// The hand that pulls its trigger or grip while the other one is idle becomes the pointer hand.
+				const int other = 1 - xr.active_hand;
+				const f32 press_other = std::max(trig[other], grip[other]), press_active = std::max(trig[xr.active_hand], grip[xr.active_hand]);
+				if (press_other > 0.5f && press_active < 0.2f)
+				{
+					xr.active_hand = other;
+					vr_log("Pointer hand: %s", other ? "right" : "left");
+				}
+				const int hand = xr.active_hand;
+
+				// Left stick click: short = recentre (screen and game camera), hold 1 s = switch inside-the-game 3D / big screen.
+				const u64 now_ms = GetTickCount64();
+				if (get_bool(xr, xr.stick_click, xr.hand_path[0]))
+				{
+					if (!xr.stick_down_since) xr.stick_down_since = now_ms;
+					else if (xr.stick_down_since != ~0ull && now_ms - xr.stick_down_since > 1000)
+					{
+						xr.mode3d = !xr.mode3d;
+						persist_set("mode", xr.mode3d ? "3d" : "screen");
+						vr_log("View mode: %s", xr.mode3d ? "inside the game (3D)" : "big screen");
+						xr.stick_down_since = ~0ull;
+					}
+				}
+				else
+				{
+					if (xr.stick_down_since && xr.stick_down_since != ~0ull) place_screen(xr);
+					xr.stick_down_since = 0;
+				}
+
+				const XrVector2f rs = get_stick(xr, 1);
+				const XrVector2f ls = get_stick(xr, 0);
+				const bool grabbing = grip[hand] > 0.5f;
+				const XrVector2f hs = hand ? rs : ls;
+				if (grabbing && hs.y > 0.75f && xr.flick_armed && !xr.assist_start)
+				{
+					xr.assist_start = GetTickCount64();
+					xr.flick_armed = false;
+					vr_log("Flip assist (stick flick)");
+				}
+				if (hs.y < 0.4f) xr.flick_armed = true;
+
+				if (xr.live3d)
+				{
+					// Inside the game: left stick walks (where you look), right stick turns in 30 degree steps.
+					if (!grabbing && (std::fabs(ls.x) > 0.2f || std::fabs(ls.y) > 0.2f))
+					{
+						vec3 f = xr.last_forward;
+						f.y = 0.f;
+						f = normalize(f);
+						const vec3 r{-f.z, 0.f, f.x};
+						xr.player_pos = xr.player_pos - (r * ls.x + f * ls.y) * (1.4f * dt);
+					}
+					if (!grabbing && std::fabs(rs.x) > 0.7f && xr.snap_armed)
+					{
+						const vec3 head_rel = to_player(xr, xr.last_head);
+						xr.player_yaw += rs.x > 0.f ? 0.5236f : -0.5236f;
+						xr.player_pos = xr.last_head - rotate(yaw_q(xr.player_yaw), head_rel);
+						xr.snap_armed = false;
+					}
+					if (std::fabs(rs.x) < 0.3f) xr.snap_armed = true;
+				}
+				else
+				{
+					// Big screen: right stick up/down = distance, left stick up/down = size.
+					bool moved = false;
+					if (!grabbing && std::fabs(rs.y) > 0.6f)
+					{
+						xr.screen_distance = std::clamp(xr.screen_distance + rs.y * dt * 1.0f, 1.0f, 8.0f);
+						moved = true;
+					}
+					if (!grabbing && std::fabs(ls.y) > 0.6f)
+					{
+						xr.screen_width = std::clamp(xr.screen_width + ls.y * dt * 1.5f, 1.0f, 10.0f);
+					}
+					if (moved)
+					{
+						// Slide the screen along its own normal, keeping its direction.
+						const vec3 normal{std::sin(xr.screen_yaw), 0.0f, std::cos(xr.screen_yaw)};
+						const vec3 anchor = xr.screen_center + normal * dot(xr.last_head - xr.screen_center, normal);
+						xr.screen_center = anchor - normal * xr.screen_distance;
+					}
+				}
+
+				cam_info cam;
+				{
+					std::lock_guard lock(g_state_mutex);
+					cam = g_cam;
+				}
+
+				// Aim ray -> screen coordinates
+				XrSpaceVelocity aim_vel{XR_TYPE_SPACE_VELOCITY};
+				XrSpaceLocation aim{XR_TYPE_SPACE_LOCATION, &aim_vel};
+				if (xr.live3d && cam.valid && XR_SUCCEEDED(xrLocateSpace(xr.aim_space[hand], xr.local_space, time, &aim)) &&
+					(aim.locationFlags & XR_SPACE_LOCATION_POSITION_VALID_BIT) && (aim.locationFlags & XR_SPACE_LOCATION_ORIENTATION_VALID_BIT))
+				{
+					// Inside the game: follow the ray into the game camera's space and see where it meets the game's picture
+					// plane at the typical object distance; that point, seen from the game camera, is the pointer.
+					const f32 D = cam.depth;
+					const vec3 origin = to_vec(aim.pose.position);
+					const vec3 dir = rotate(aim.pose.orientation, {0.0f, 0.0f, -1.0f});
+					const vec3 o = level(cam.up, to_player(xr, origin) * (1.f / xr.unit), -1.f);
+					const vec3 d = level(cam.up, rotate(qconj(yaw_q(xr.player_yaw)), dir), -1.f);
+					const auto to_local = [&](f32 nx, f32 ny)
+					{
+						const vec3 q{D * (nx + cam.cx) / cam.sx, D * (ny + cam.cy) / cam.sy, -D};
+						return from_player(xr, level(cam.up, q) * xr.unit);
+					};
+
+					out.active = true;
+					if (d.z < -0.001f && (-D - o.z) / d.z > 0.f)
+					{
+						const f32 t = (-D - o.z) / d.z;
+						const vec3 q = o + d * t;
+						const f32 nx = (cam.sx * q.x - cam.cx * D) / D, ny = (cam.sy * q.y - cam.cy * D) / D;
+						out.x = (nx + 1.f) * 0.5f;
+						out.y = (1.f - ny) * 0.5f;
+						out.on_screen = out.x > 0.0f && out.x < 1.0f && out.y > 0.0f && out.y < 1.0f;
+
+						const auto alpha = [dt](f32 cutoff) { const f32 r = 2.f * 3.14159265f * cutoff * dt; return r / (r + 1.f); };
+						if (!xr.filter_init || !out.on_screen) { xr.fx = out.x; xr.fy = out.y; xr.fdx = xr.fdy = 0.f; xr.filter_init = out.on_screen; }
+						else
+						{
+							const f32 dx = (out.x - xr.fx) / dt, dy = (out.y - xr.fy) / dt;
+							xr.fdx += (dx - xr.fdx) * alpha(1.f);
+							xr.fdy += (dy - xr.fdy) * alpha(1.f);
+							const f32 speed = std::sqrt(xr.fdx * xr.fdx + xr.fdy * xr.fdy);
+							const f32 a = alpha(1.2f + 0.6f * speed);
+							xr.fx += (out.x - xr.fx) * a;
+							xr.fy += (out.y - xr.fy) * a;
+							out.x = xr.fx;
+							out.y = xr.fy;
+						}
+						xr.aim_origin = origin;
+						xr.aim_hit = to_local(out.x * 2.f - 1.f, 1.f - out.y * 2.f);
+					}
+					else
+					{
+						out.x = -1.0f;
+						out.y = -1.0f;
+					}
+
+					// The emulated PS Eye faces the player from the game picture
+					const f32 width = 2.f * D / cam.sx * xr.unit, height = 2.f * D / cam.sy * xr.unit;
+					compute_motion(xr, aim, aim_vel, out, dt, width, height, to_local(0.f, 0.f), xr.player_yaw);
+				}
+				else if (XR_SUCCEEDED(xrLocateSpace(xr.aim_space[hand], xr.local_space, time, &aim)) &&
+					(aim.locationFlags & XR_SPACE_LOCATION_POSITION_VALID_BIT) && (aim.locationFlags & XR_SPACE_LOCATION_ORIENTATION_VALID_BIT))
+				{
+					const f32 aspect = xr.sc_h ? static_cast<f32>(xr.sc_w) / xr.sc_h : 16.0f / 9.0f;
+					const f32 width = xr.screen_width;
+					const f32 height = width / aspect;
+
+					const vec3 normal{std::sin(xr.screen_yaw), 0.0f, std::cos(xr.screen_yaw)};
+					const vec3 right{std::cos(xr.screen_yaw), 0.0f, -std::sin(xr.screen_yaw)};
+					const vec3 up{0.0f, 1.0f, 0.0f};
+
+					const vec3 origin = to_vec(aim.pose.position);
+					const vec3 dir = rotate(aim.pose.orientation, {0.0f, 0.0f, -1.0f});
+					const f32 denom = dot(dir, normal);
+
+					out.active = true;
+					if (denom < -0.0001f)
+					{
+						const f32 t = dot(xr.screen_center - origin, normal) / denom;
+						const vec3 hit = origin + dir * t - xr.screen_center;
+						out.x = 0.5f + dot(hit, right) / width;
+						out.y = 0.5f - dot(hit, up) / height;
+						out.on_screen = t > 0.0f && out.x > 0.0f && out.x < 1.0f && out.y > 0.0f && out.y < 1.0f;
+
+						// One Euro filter: steadies small hand tremor, follows fast moves with almost no delay.
+						const auto alpha = [dt](f32 cutoff) { const f32 r = 2.f * 3.14159265f * cutoff * dt; return r / (r + 1.f); };
+						if (!xr.filter_init || !out.on_screen) { xr.fx = out.x; xr.fy = out.y; xr.fdx = xr.fdy = 0.f; xr.filter_init = out.on_screen; }
+						else
+						{
+							const f32 dx = (out.x - xr.fx) / dt, dy = (out.y - xr.fy) / dt;
+							xr.fdx += (dx - xr.fdx) * alpha(1.f);
+							xr.fdy += (dy - xr.fdy) * alpha(1.f);
+							const f32 speed = std::sqrt(xr.fdx * xr.fdx + xr.fdy * xr.fdy);
+							const f32 a = alpha(1.2f + 0.6f * speed);
+							xr.fx += (out.x - xr.fx) * a;
+							xr.fy += (out.y - xr.fy) * a;
+							out.x = xr.fx;
+							out.y = xr.fy;
+						}
+
+						xr.aim_origin = origin;
+						xr.aim_hit = xr.screen_center + right * ((out.x - 0.5f) * width) + up * ((0.5f - out.y) * height) + normal * 0.01f;
+					}
+					else
+					{
+						// Pointing away from the screen
+						out.x = -1.0f;
+						out.y = -1.0f;
+					}
+
+					compute_motion(xr, aim, aim_vel, out, dt, width, height, xr.screen_center, xr.screen_yaw);
+				}
+				xr.show_pointer = out.on_screen;
+
+				// Hold Left MENU for 2 seconds: show the controls card
+				if (get_bool(xr, xr.btn_menu))
+				{
+					if (!xr.menu_down_since) xr.menu_down_since = now_ms;
+					else if (now_ms - xr.menu_down_since > 2000) { xr.help_until = now_ms + 30000; xr.menu_down_since = now_ms + 600000; }
+				}
+				else xr.menu_down_since = 0;
+
+				// Grip grabs (the game's T button), trigger selects (the Move button), as in most VR games.
+				out.trigger = grip[hand];
+				out.t = grip[hand] > 0.5f;
+				out.move = trig[hand] > 0.5f;
+				apply_flip_assist(xr, out);
+				out.cross = get_bool(xr, xr.btn_a);
+				out.circle = get_bool(xr, xr.btn_b);
+				out.square = get_bool(xr, xr.btn_x);
+				out.triangle = get_bool(xr, xr.btn_y);
+				out.start = get_bool(xr, xr.btn_menu);
+				out.select = get_bool(xr, xr.stick_click, xr.hand_path[1]);
+			}
+
+			if ((xr.frames % 600) == 0)
+			{
+				vr_log("status: state=%d frame=%llu pointer active=%d on_screen=%d (%.2f, %.2f) T=%.2f hand=%s game_frame=%llu",
+					static_cast<int>(xr.session_state), static_cast<unsigned long long>(xr.frames), out.active, out.on_screen, out.x, out.y,
+					out.trigger, xr.active_hand ? "right" : "left", static_cast<unsigned long long>(xr.shown_frame_id));
+			}
+
+			std::lock_guard lock(g_state_mutex);
+			g_pointer = out;
+		}
+
+		// Returns false when the session is gone and the thread should end.
+		bool poll_events(xr_state& xr)
+		{
+			XrEventDataBuffer event{XR_TYPE_EVENT_DATA_BUFFER};
+			while (xrPollEvent(xr.instance, &event) == XR_SUCCESS)
+			{
+				if (event.type == XR_TYPE_EVENT_DATA_SESSION_STATE_CHANGED)
+				{
+					const auto& changed = *reinterpret_cast<XrEventDataSessionStateChanged*>(&event);
+					xr.session_state = changed.state;
+					vr_log("Session state -> %d", static_cast<int>(changed.state));
+
+					if (changed.state == XR_SESSION_STATE_READY)
+					{
+						XrSessionBeginInfo begin{XR_TYPE_SESSION_BEGIN_INFO};
+						begin.primaryViewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
+						if (xr_ok(xr, xrBeginSession(xr.session, &begin), "xrBeginSession")) g_session_running = true;
+					}
+					else if (changed.state == XR_SESSION_STATE_STOPPING)
+					{
+						g_session_running = false;
+						xrEndSession(xr.session);
+					}
+					else if (changed.state == XR_SESSION_STATE_EXITING || changed.state == XR_SESSION_STATE_LOSS_PENDING)
+					{
+						g_session_running = false;
+						return false;
+					}
+				}
+				else if (event.type == XR_TYPE_EVENT_DATA_INSTANCE_LOSS_PENDING)
+				{
+					g_session_running = false;
+					return false;
+				}
+				event = {XR_TYPE_EVENT_DATA_BUFFER};
+			}
+			return true;
+		}
+
+		void run_frame(xr_state& xr)
+		{
+			XrFrameState frame_state{XR_TYPE_FRAME_STATE};
+			if (XR_FAILED(xrWaitFrame(xr.session, nullptr, &frame_state))) return;
+			if (XR_FAILED(xrBeginFrame(xr.session, nullptr))) return;
+
+			const f32 dt = std::clamp(static_cast<f32>(frame_state.predictedDisplayPeriod) * 1e-9f, 0.001f, 0.05f);
+			update_input(xr, frame_state.predictedDisplayTime, dt);
+			upload_frame(xr);
+
+			// True VR: where the eyes are, for the renderer's next frame
+			{
+				XrViewLocateInfo li{XR_TYPE_VIEW_LOCATE_INFO};
+				li.viewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
+				li.displayTime = frame_state.predictedDisplayTime;
+				li.space = xr.local_space;
+				XrViewState vs{XR_TYPE_VIEW_STATE};
+				u32 n = 0;
+				xr.views[0] = {XR_TYPE_VIEW};
+				xr.views[1] = {XR_TYPE_VIEW};
+				xr.views_valid = XR_SUCCEEDED(xrLocateViews(xr.session, &li, &vs, 2, &n, xr.views)) && n == 2 &&
+					(vs.viewStateFlags & XR_VIEW_STATE_POSITION_VALID_BIT) && (vs.viewStateFlags & XR_VIEW_STATE_ORIENTATION_VALID_BIT);
+
+				std::lock_guard lock(g_state_mutex);
+				g_views.valid = xr.views_valid && xr.screen_placed && xr.session_state == XR_SESSION_STATE_FOCUSED;
+				for (int i = 0; i < 2; i++) { g_views.eye[i] = xr.views[i].pose; g_views.fov[i] = xr.views[i].fov; }
+				g_views.player_pos = xr.player_pos;
+				g_views.player_yaw = xr.player_yaw;
+				g_views.unit = xr.unit;
+				g_views.mode3d = xr.mode3d;
+				g_views.stereo = xr.stereo;
+			}
+			const u64 now_tick = GetTickCount64();
+			const bool was3d = xr.live3d;
+			xr.live3d = xr.mode3d && now_tick - xr.last_3d_tick < 400 && xr.eye_has[0] && (xr.mono3d || xr.eye_has[1]);
+			if (xr.live3d != was3d) vr_log("Headset view: %s", xr.live3d ? "inside the game (3D)" : "big screen");
+
+			XrCompositionLayerQuad quad{XR_TYPE_COMPOSITION_LAYER_QUAD};
+			XrCompositionLayerQuad panel{XR_TYPE_COMPOSITION_LAYER_QUAD};
+			XrCompositionLayerQuad help{XR_TYPE_COMPOSITION_LAYER_QUAD};
+			XrCompositionLayerQuad beam{XR_TYPE_COMPOSITION_LAYER_QUAD};
+			XrCompositionLayerQuad dot_layer{XR_TYPE_COMPOSITION_LAYER_QUAD};
+			XrCompositionLayerProjection proj{XR_TYPE_COMPOSITION_LAYER_PROJECTION};
+			XrCompositionLayerProjectionView pviews[2]{{XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW}, {XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW}};
+			const XrCompositionLayerBaseHeader* layers[6]{};
+			u32 layer_count = 0;
+
+			const std::string message = panel_message();
+			if (!message.empty() && message != xr.panel_text)
+			{
+				draw_panel(xr, message);
+				xr.panel_text = message;
+				vr_log("Panel: %s", message.substr(0, message.find('\n')).c_str());
+			}
+			else if (message.empty() && !xr.panel_text.empty())
+			{
+				xr.panel_text.clear();
+				vr_log("Panel hidden: game picture is live");
+			}
+
+			if (frame_state.shouldRender && xr.live3d && message.empty())
+			{
+				// Inside the game: each eye shows its newest image, from where that eye was when it was rendered
+				for (int i = 0; i < 2; i++)
+				{
+					const int src = xr.mono3d ? 0 : i;
+					const XrPosef& rel = xr.eye_rel[src];
+					const vec3 p = from_player(xr, to_vec(rel.position));
+					pviews[i].pose.position = {p.x, p.y, p.z};
+					pviews[i].pose.orientation = qnorm(qmul(yaw_q(xr.player_yaw), rel.orientation));
+					pviews[i].fov = xr.eye_fov[src];
+					pviews[i].subImage.swapchain = xr.eye_sc[src];
+					pviews[i].subImage.imageRect.offset = {0, 0};
+					pviews[i].subImage.imageRect.extent = {static_cast<s32>(xr.eye_w[src]), static_cast<s32>(xr.eye_h[src])};
+				}
+				proj.space = xr.local_space;
+				proj.viewCount = 2;
+				proj.views = pviews;
+				layers[layer_count++] = reinterpret_cast<const XrCompositionLayerBaseHeader*>(&proj);
+			}
+			else if (frame_state.shouldRender && xr.have_image && xr.screen_placed)
+			{
+				quad.space = xr.local_space;
+				quad.eyeVisibility = XR_EYE_VISIBILITY_BOTH;
+				quad.subImage.swapchain = xr.swapchain;
+				quad.subImage.imageRect.offset = {0, 0};
+				quad.subImage.imageRect.extent = {static_cast<s32>(xr.sc_w), static_cast<s32>(xr.sc_h)};
+				quad.pose.position = {xr.screen_center.x, xr.screen_center.y, xr.screen_center.z};
+				quad.pose.orientation = {0.0f, std::sin(xr.screen_yaw * 0.5f), 0.0f, std::cos(xr.screen_yaw * 0.5f)};
+				quad.size = {xr.screen_width, xr.screen_width * xr.sc_h / xr.sc_w};
+				layers[layer_count++] = reinterpret_cast<const XrCompositionLayerBaseHeader*>(&quad);
+			}
+
+			if (!xr.pointer_images_tried) { xr.pointer_images_tried = true; make_pointer_images(xr); }
+
+			// Laser from the hand to the screen, and a cursor where it lands (no emulator delay)
+			if (frame_state.shouldRender && xr.show_pointer && (xr.have_image || xr.live3d) && message.empty())
+			{
+				const vec3 along = xr.aim_hit - xr.aim_origin;
+				const f32 len = std::sqrt(dot(along, along));
+				if (xr.laser_ok && len > 0.05f)
+				{
+					const vec3 bx = along * (1.f / len);
+					vec3 bz = (xr.last_head - (xr.aim_origin + along * 0.5f));
+					bz = normalize(bz - bx * dot(bz, bx));
+					const vec3 by = cross(bz, bx);
+					const vec3 mid = xr.aim_origin + along * 0.5f;
+					beam.layerFlags = XR_COMPOSITION_LAYER_BLEND_TEXTURE_SOURCE_ALPHA_BIT;
+					beam.space = xr.local_space;
+					beam.eyeVisibility = XR_EYE_VISIBILITY_BOTH;
+					beam.subImage.swapchain = xr.laser;
+					beam.subImage.imageRect.extent = {256, 8};
+					beam.pose.position = {mid.x, mid.y, mid.z};
+					beam.pose.orientation = quat_from_axes(bx, by, bz);
+					beam.size = {len, 0.006f};
+					layers[layer_count++] = reinterpret_cast<const XrCompositionLayerBaseHeader*>(&beam);
+				}
+				if (xr.cursor_ok)
+				{
+					const f32 size = xr.live3d ? 0.03f : std::clamp(xr.screen_width * 0.018f, 0.03f, 0.12f);
+					dot_layer.layerFlags = XR_COMPOSITION_LAYER_BLEND_TEXTURE_SOURCE_ALPHA_BIT;
+					dot_layer.space = xr.local_space;
+					dot_layer.eyeVisibility = XR_EYE_VISIBILITY_BOTH;
+					dot_layer.subImage.swapchain = xr.cursor;
+					dot_layer.subImage.imageRect.extent = {64, 64};
+					dot_layer.pose.position = {xr.aim_hit.x, xr.aim_hit.y, xr.aim_hit.z};
+					dot_layer.pose.orientation = yaw_q(xr.live3d ? xr.player_yaw : xr.screen_yaw);
+					dot_layer.size = {size, size};
+					layers[layer_count++] = reinterpret_cast<const XrCompositionLayerBaseHeader*>(&dot_layer);
+				}
+			}
+
+			// Controls card: first session (until a few minutes after the game picture appears), or after holding Left MENU
+			{
+				const u64 now_ms = GetTickCount64();
+				static u64 first_live = 0;
+				bool want = now_ms < xr.help_until;
+				if (persist_get("intro") != "1")
+				{
+					want = true;
+					if (xr.have_image && message.empty())
+					{
+						if (!first_live) first_live = now_ms;
+						else if (now_ms - first_live > 180000) { persist_set("intro", "1"); vr_log("Controls intro shown"); }
+					}
+				}
+				if (want && !xr.help_drawn) { draw_help(xr); xr.help_drawn = true; }
+				if (want && xr.help_has && xr.screen_placed && frame_state.shouldRender)
+				{
+					// To the left of the screen, turned slightly towards the player (inside the game: front left, facing the player)
+					const vec3 right{std::cos(xr.screen_yaw), 0.0f, -std::sin(xr.screen_yaw)};
+					const vec3 normal{std::sin(xr.screen_yaw), 0.0f, std::cos(xr.screen_yaw)};
+					const f32 sh = xr.sc_w ? xr.screen_width * xr.sc_h / xr.sc_w : xr.screen_width * 9.f / 16.f;
+					const vec3 pos = xr.live3d ? from_player(xr, {-0.95f, -0.15f, -1.1f})
+						: xr.screen_center - right * (xr.screen_width * 0.5f + help_width_m * 0.55f) + normal * 0.35f + vec3{0.f, sh * 0.5f - help_width_m * help_h / help_w * 0.5f, 0.f};
+					const f32 yaw = xr.live3d ? xr.player_yaw + 0.7f : xr.screen_yaw + 0.35f;
+					help.space = xr.local_space;
+					help.eyeVisibility = XR_EYE_VISIBILITY_BOTH;
+					help.subImage.swapchain = xr.help;
+					help.subImage.imageRect.extent = {static_cast<s32>(help_w), static_cast<s32>(help_h)};
+					help.pose.position = {pos.x, pos.y, pos.z};
+					help.pose.orientation = {0.0f, std::sin(yaw * 0.5f), 0.0f, std::cos(yaw * 0.5f)};
+					help.size = {help_width_m, help_width_m * help_h / help_w};
+					layers[layer_count++] = reinterpret_cast<const XrCompositionLayerBaseHeader*>(&help);
+				}
+			}
+
+			if (frame_state.shouldRender && !message.empty() && xr.panel_has_image && xr.screen_placed)
+			{
+				// Floats just in front of the game screen, facing the player.
+				const vec3 normal{std::sin(xr.screen_yaw), 0.0f, std::cos(xr.screen_yaw)};
+				const vec3 pos = xr.screen_center + normal * std::max(xr.screen_distance - 1.8f, 0.2f);
+				panel.space = xr.local_space;
+				panel.eyeVisibility = XR_EYE_VISIBILITY_BOTH;
+				panel.subImage.swapchain = xr.panel;
+				panel.subImage.imageRect.offset = {0, 0};
+				panel.subImage.imageRect.extent = {static_cast<s32>(panel_w), static_cast<s32>(panel_h)};
+				panel.pose.position = {pos.x, pos.y, pos.z};
+				panel.pose.orientation = {0.0f, std::sin(xr.screen_yaw * 0.5f), 0.0f, std::cos(xr.screen_yaw * 0.5f)};
+				panel.size = {panel_width_m, panel_width_m * panel_h / panel_w};
+				layers[layer_count++] = reinterpret_cast<const XrCompositionLayerBaseHeader*>(&panel);
+			}
+
+			XrFrameEndInfo end{XR_TYPE_FRAME_END_INFO};
+			end.displayTime = frame_state.predictedDisplayTime;
+			end.environmentBlendMode = XR_ENVIRONMENT_BLEND_MODE_OPAQUE;
+			end.layerCount = layer_count;
+			end.layers = layer_count ? layers : nullptr;
+			xrEndFrame(xr.session, &end);
+			xr.frames++;
+		}
+
+		void destroy(xr_state& xr)
+		{
+			g_session_running = false;
+			{
+				std::lock_guard lock(g_state_mutex);
+				g_pointer = {};
+			}
+			if (xr.swapchain != XR_NULL_HANDLE) xrDestroySwapchain(xr.swapchain);
+			if (xr.panel != XR_NULL_HANDLE) xrDestroySwapchain(xr.panel);
+			if (xr.help != XR_NULL_HANDLE) xrDestroySwapchain(xr.help);
+			if (xr.cursor != XR_NULL_HANDLE) xrDestroySwapchain(xr.cursor);
+			if (xr.laser != XR_NULL_HANDLE) xrDestroySwapchain(xr.laser);
+			for (auto sc : xr.eye_sc) if (sc != XR_NULL_HANDLE) xrDestroySwapchain(sc);
+			{
+				std::lock_guard lock(g_state_mutex);
+				g_views = {};
+				g_cam = {};
+				for (auto& p : g_pending) p = {};
+			}
+			if (xr.session != XR_NULL_HANDLE) xrDestroySession(xr.session);
+			if (xr.instance != XR_NULL_HANDLE) xrDestroyInstance(xr.instance);
+			if (xr.context) xr.context->Release();
+			if (xr.device) xr.device->Release();
+			xr = {};
+		}
+
+		void thread_main()
+		{
+			vr_log("Order Up VR starting (title %s)", Emu.GetTitleID().c_str());
+
+			xr_state xr;
+			xr.mode3d = persist_get("mode") != "screen";
+			xr.stereo = persist_get("stereo") != "0";
+			if (const std::string ws = persist_get("worldscale"); !ws.empty())
+			{
+				xr.unit = std::clamp(static_cast<f32>(std::atof(ws.c_str())), 0.02f, 5.0f);
+			}
+			vr_log("True VR settings: view %s, %s, %.4f m per game unit", xr.mode3d ? "inside the game" : "big screen",
+				xr.stereo ? "stereo" : "mono", xr.unit);
+			if (create_instance(xr) && wait_for_system(xr) && create_device(xr) && create_session(xr) && create_actions(xr))
+			{
+				vr_log("VR session created. Waiting for the headset to become ready.");
+				while (!g_stop)
+				{
+					if (!poll_events(xr)) break;
+
+					if (g_session_running)
+					{
+						run_frame(xr);
+					}
+					else
+					{
+						std::this_thread::sleep_for(std::chrono::milliseconds(100));
+					}
+				}
+
+				if (g_session_running)
+				{
+					xrRequestExitSession(xr.session);
+				}
+			}
+
+			destroy(xr);
+			vr_log("Order Up VR stopped");
+		}
+	}
+
+	void start()
+	{
+		if (g_thread.joinable()) return;
+
+		const char* any_title = std::getenv("ORDERUP_VR_ANY_TITLE");
+		if (Emu.GetTitleID() != target_title && !(any_title && *any_title == '1')) return;
+
+		if (const char* enabled = std::getenv("ORDERUP_VR"); enabled && *enabled == '0')
+		{
+			vr_log("Disabled by ORDERUP_VR=0");
+			return;
+		}
+
+		g_stop = false;
+		persist_load();
+		g_start_tick = GetTickCount64();
+		g_last_frame_tick = 0;
+		g_window_unavailable_tick = 0;
+		g_rv.begun = false;
+		g_rv.enabled = false;
+		g_rv.want3d = false;
+		g_rv.frames_with = g_rv.frames_without = 0;
+		g_rv.cam = {};
+		g_rv.have_up = false;
+		g_rv.depth = 3.5f;
+		g_rv.scene_off = ~0u;
+		g_thread = std::thread(thread_main);
+	}
+
+	void stop()
+	{
+		if (!g_thread.joinable()) return;
+		g_stop = true;
+		g_thread.join();
+	}
+
+	bool wants_frames()
+	{
+		return g_session_running.load(std::memory_order_relaxed);
+	}
