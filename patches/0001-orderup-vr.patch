+		u64 rv_content_get(u64 key)
+		{
+			for (const auto& c : g_rv.content) if (c.key == key) return c.gen;
+			return 0;
+		}
+
+		void rv_content_set(u64 key, u64 gen)
+		{
+			auto& s = g_rv;
+			for (auto& c : s.content) if (c.key == key) { c.gen = gen; return; }
+			// Replace the oldest
+			auto* oldest = &s.content[0];
+			for (auto& c : s.content) if (c.gen < oldest->gen) oldest = &c;
+			*oldest = {key, gen};
+		}
