+						if (color_key == s.dominant_key && s.scene_key != color_key)
+						{
+							s.scene_key = color_key;
+							s.scene_w = surface_w;
+							s.scene_h = surface_h;
+							if (std::find(s.tainted.begin(), s.tainted.end(), color_key) == s.tainted.end()) s.tainted.push_back(color_key);
+						}
+					}
+					if (!s.fp_set) { std::memcpy(s.fp, m, sizeof(s.fp)); s.fp_set = true; }
