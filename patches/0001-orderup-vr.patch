+		// Where the VR HUD panels are this frame (player frame, metres; the player frame is the game camera's place)
+		// The game's current camera, straight from its memory: the view matrix (3 rows of right, up, back, each with its
+		// translation) the game keeps at 0x003821d8 in its data (found with the camera capture, BLES01470 only)
+		struct game_view { vec3 r[3]{}; vec3 t{}; };
+		bool read_game_view(game_view& v)
+		{
+			if (!g_game_known) return false;
+			constexpr u32 addr = 0x003821d8;
+			if (!vm::check_addr(addr, vm::page_readable, 48)) return false;
+			const u8* p = static_cast<const u8*>(vm::base(addr));
+			f32 f[12];
+			for (int k = 0; k < 12; k++)
+			{
+				f[k] = chef::rdf32be(p + k * 4);
+				if (!std::isfinite(f[k]) || std::fabs(f[k]) > 1e5f) return false;
+			}
+			for (int r = 0; r < 3; r++)
+			{
+				v.r[r] = {f[r * 4], f[r * 4 + 1], f[r * 4 + 2]};
+				const f32 n = dot(v.r[r], v.r[r]);
+				if (n < 0.8f || n > 1.2f) return false;
+			}
+			v.t = {f[3], f[7], f[11]};
+			return true;
+		}
+		vec3 game_to_view(const game_view& v, vec3 w) { return {dot(v.r[0], w) + v.t.x, dot(v.r[1], w) + v.t.y, dot(v.r[2], w) + v.t.z}; }
+		vec3 view_to_game(const game_view& v, vec3 q) { return v.r[0] * (q.x - v.t.x) + v.r[1] * (q.y - v.t.y) + v.r[2] * (q.z - v.t.z); }
+
+		// The game camera's height above the floor of the kitchen it looks at (from the kitchen's layout in the game files)
+		// (top_u: its counter tops above its floor, in game units)
+		bool kitchen_camera_height(f32 look_d, f32& cam_u, u32& pkg, f32* top_u)
+		{
+			game_view gv;
+			if (!read_game_view(gv)) return false;
+			const vec3 cw = view_to_game(gv, {0.f, 0.f, 0.f}), look = view_to_game(gv, {0.f, 0.f, -std::max(look_d, 0.5f)});
+			const interior::kitchen* k = interior::pick(look);
+			if (!k) return false;
+			const f32 h = cw.y - k->floor_y;
+			if (!(h > 1.f && h < 20.f)) return false;
+			cam_u = h;
+			pkg = k->pkg;
+			if (top_u) *top_u = k->top_y - k->floor_y;
+			return true;
+		}
+
+		// A short buzz in one controller
+		void buzz(xr_state& xr, int hand, f32 amplitude, int ms)
+		{
+			if (xr.haptic == XR_NULL_HANDLE || xr.session == XR_NULL_HANDLE) return;
+			XrHapticActionInfo info{XR_TYPE_HAPTIC_ACTION_INFO};
+			info.action = xr.haptic;
+			info.subactionPath = xr.hand_path[hand];
+			XrHapticVibration v{XR_TYPE_HAPTIC_VIBRATION};
+			v.amplitude = amplitude;
+			v.duration = static_cast<XrDuration>(ms) * 1000000;
+			v.frequency = XR_FREQUENCY_UNSPECIFIED;
+			xrApplyHapticFeedback(xr.session, &info, reinterpret_cast<const XrHapticBaseHeader*>(&v));
+		}
+
+		// ---- Stations follow you (room mode). The kitchen stays still in your room while the game's camera goes from
+		// station to station (Cross and Circle: the kitchen scripts' MoveStationLeft/Right). The game only acts on what
+		// its camera frames, so its camera follows you: when you reach (or walk) past the edge of what it frames, toward
+		// a station of the kitchen's row (from the kitchen's layout in the player's game files), the mod presses the
+		// button that goes there. Nothing moves for you: the kitchen stays where it is, the game now looks where you are.
+		// Never while you hold food, in a menu or a dialog, or in a cutscene. Which button goes which way is learned from
+		// the camera's own move (your own A or B, or the mod's first press) and remembered.
+
+		// A menu or a dialog of the game is open (its UI tree shows a menu, or a dialog's card): the stations stay
+		bool game_menu_open()
+		{
+			std::shared_ptr<const std::vector<uitree::elem>> el;
+			{
+				std::lock_guard lock(uitree::elems_mutex);
+				el = uitree::elems;
+			}
+			// (a menu, or a dialog's card smaller than the screen: uitree::menu_open, the same test the menus use)
+			return el && uitree::menu_open(*el);
+		}
+
+		// The station row the game's camera looks at (game world: the kitchen's layout and the camera in the game's memory)
+		struct station_row
+		{
+			game_view gv;
+			vec3 first{}, dir{}, nrm{};   // the row's first station at counter height, along the row, across it (level)
+			f32 top_y = 0.9f;
+			vec3 look{};                  // where the camera's centre meets the counter
+			std::vector<std::pair<f32, const interior::inode*>> nodes;   // its stations, by how far along the row they are
+			u32 pkg = 0;
+		};
+		bool find_station_row(const cam_info& cam, station_row& r)
+		{
+			if (!read_game_view(r.gv)) return false;
+			const vec3 cw = view_to_game(r.gv, {0.f, 0.f, 0.f}), fw = view_to_game(r.gv, {0.f, 0.f, -1.f}) - cw;
+			const f32 d = std::max(cam.food_d > 0.05f ? cam.food_d : cam.depth, 0.5f);
+			const interior::kitchen* kt = interior::pick(view_to_game(r.gv, {0.f, 0.f, -d}));
+			if (!kt) return false;
+			r.pkg = kt->pkg;
+			r.top_y = kt->top_y;
+			r.look = view_to_game(r.gv, {0.f, 0.f, -d});
+			if (fw.y < -0.05f)
+			{
+				const f32 t = (kt->top_y - cw.y) / fw.y;
+				if (t > 0.f && t < 80.f) r.look = cw + fw * t;
+			}
+			// the station nearest to where it looks, and the others of its row (the rows run along x in every kitchen; the
+			// arena's kitchen has a second row facing the first)
+			const interior::inode* closest = nullptr;
+			f32 bd = 4.f * 4.f;
+			for (const auto& nd : kt->n)
+			{
+				if (!interior::is_station(nd.lower)) continue;
+				const f32 dx = nd.pos.x - r.look.x, dz = nd.pos.z - r.look.z;
+				if (dx * dx + dz * dz < bd) { bd = dx * dx + dz * dz; closest = &nd; }
+			}
+			if (!closest) return false;   // the camera is not looking at the stations
+			const interior::inode* lo = nullptr;
+			const interior::inode* hi = nullptr;
+			for (const auto& nd : kt->n)
+			{
+				if (!interior::is_station(nd.lower) || std::fabs(nd.pos.z - closest->pos.z) > 1.f) continue;
+				if (!lo || nd.pos.x < lo->pos.x) lo = &nd;
+				if (!hi || nd.pos.x > hi->pos.x) hi = &nd;
+			}
+			if (!lo || !hi || hi->pos.x - lo->pos.x < 0.5f) return false;
+			vec3 dv = hi->pos - lo->pos;
+			dv.y = 0.f;
+			r.dir = normalize(dv);
+			r.nrm = {-r.dir.z, 0.f, r.dir.x};
+			r.first = {lo->pos.x, kt->top_y, lo->pos.z};
+			for (const auto& nd : kt->n)
+				if (interior::is_station(nd.lower) && std::fabs(nd.pos.z - closest->pos.z) <= 1.f) r.nodes.push_back({dot(nd.pos - lo->pos, r.dir), &nd});
+			std::sort(r.nodes.begin(), r.nodes.end(), [](const auto& a, const auto& b) { return a.first < b.first; });
+			return true;
+		}
+
+		// Where you stand at the counter (place_screen): the station row the game's camera looks at, in your frame (the game
+		// camera at 0, levelled, game units). S: the point on the row's line, at counter-top height, across from where the
+		// camera looks (kept between the row's end stations); N: level, across the row towards the camera (the cook's side,
+		// where you stand); look: where the camera's centre meets the counter top.
+		bool counter_stand(const cam_info& c, vec3& S, vec3& N, vec3& look, u32& pkg)
+		{
+			if (!c.valid) return false;
+			station_row r;
+			if (!find_station_row(c, r) || r.nodes.empty()) return false;
+			const auto to_p = [&](vec3 w) { return level(c.up_a, xform(c.D, game_to_view(r.gv, w))); };
+			const f32 s = std::clamp(dot(r.look - r.first, r.dir), r.nodes.front().first, r.nodes.back().first);
+			const vec3 sw = r.first + r.dir * s;   // (r.first is at the counter top's height, r.dir is level)
+			const vec3 cw = view_to_game(r.gv, {0.f, 0.f, 0.f});
+			vec3 nw = r.nrm;
+			if (dot(nw, cw - sw) < 0.f) nw = nw * -1.f;
+			S = to_p(sw);
+			look = to_p(r.look);
+			vec3 n = to_p(sw + nw) - S;
+			n.y = 0.f;
+			if (dot(n, n) < 1e-6f) return false;
+			N = normalize(n);
+			pkg = r.pkg;
+			return true;
+		}
+
+		void update_stations(xr_state& xr, const cam_info& cam, pointer_state& out, u64 now, bool grabbing)
+		{
+			auto& n = xr.nav;
+			if (!xr.live3d || !cam.valid || !cam.room)
+			{
+				if (n.ready || !n.framed.empty()) vr_log("Stations: left the kitchen view");
+				// (a press that was waiting goes to the game as it is from now on)
+				const int side = n.side_cross;
+				const bool pt = n.prev_trig, pg = n.prev_grip;
+				n = {};
+				n.side_cross = side;
+				n.prev_trig = pt;
+				n.prev_grip = pg;
+				return;
+			}
+			if (!n.side_cross)
+			{
+				const std::string v = persist_get("station_cross");
+				if (v == "1" || v == "-1") n.side_cross = v == "1" ? 1 : -1;
+			}
+			// Where the game camera looks, in the room (to learn which way a button went when the camera is not in memory)
+			const vec3 look_v = xform(cam.D, {0.f, 0.f, -cam.depth});
+			const vec3 tgt = from_player(xr, level(cam.up_a, look_v) * xr.unit);
+			const vec3 pivot = xr.last_head - rotate(yaw_q(xr.player_yaw), vec3{xr.eye_off.x, 0.f, xr.eye_off.z} * xr.unit);   // the game camera's spot
+			const auto heading = [&](vec3 p) { const vec3 v = p - pivot; return std::atan2(-v.x, -v.z); };
+			const bool settled = cam.still >= 18;
+
+			// The station row the game's camera looks at, and you on it (game world, game units)
+			station_row row;
+			const bool geo = !cam.cinema && find_station_row(cam, row);
+			n.geo = geo;
+			n.row_pkg = geo ? row.pkg : 0;
+			n.row_n = geo ? static_cast<int>(row.nodes.size()) : 0;
+			const f32 k = std::max(cam.hud_k, 1.f);   // the game's own view (not the wide view): what its camera frames
+			// Across the game's own view (-1 left edge .. 1 right edge) a point of the game's world is
+			const auto frame_x = [&](vec3 w, f32& nx)
+			{
+				const vec3 q = game_to_view(row.gv, w);
+				if (q.z > -0.05f) return false;
+				nx = (cam.sx * q.x + cam.cx * q.z) / -q.z * k;
+				return true;
+			};
+			// Your room to the game's world: player frame -> the anchor camera's view -> the current camera's view -> world
+			const mat4 Di = rigid_inv(cam.D);
+			const auto to_world = [&](vec3 local) { return view_to_game(row.gv, xform(Di, level(cam.up_a, to_player(xr, local) * (1.f / xr.unit), -1.f))); };
+			const auto dir_world = [&](vec3 d)
+			{
+				const vec3 v = xdir(Di, level(cam.up_a, rotate(qconj(yaw_q(xr.player_yaw)), d), -1.f));
+				return row.gv.r[0] * v.x + row.gv.r[1] * v.y + row.gv.r[2] * v.z;
+			};
+			const auto along = [&](vec3 w) { return dot(w - row.first, row.dir); };
+			const auto on_row = [&](f32 s) { return row.first + row.dir * s; };
+			const f32 s_head = geo ? along(to_world(xr.last_head)) : 0.f;
+
+			const auto start = [&](int btn, bool automatic)
+			{
+				n.pending_btn = btn;
+				n.pending_auto = automatic;
+				n.pending_want = 0;
+				xr.input_tick = now;   // (a camera move right after a press is yours, not a cutscene)
+				n.before = tgt;
+				n.before_ok = geo;
+				if (geo)
+				{
+					for (int i = 0; i < 3; i++) n.before_r[i] = row.gv.r[i];
+					n.before_t = row.gv.t;
+				}
+				n.pending_since = now;
+				n.moves_at_press = cam.moves;
+				n.moved = false;
+			};
+
+			// Your own presses (A = Cross, B = Circle) teach the mod which way they go
+			const bool a = get_bool(xr, xr.btn_a), b = get_bool(xr, xr.btn_b);
+			if (!n.pending_btn && a && !n.prev_a) start(1, false);
+			else if (!n.pending_btn && b && !n.prev_b) start(2, false);
+			n.prev_a = a;
+			n.prev_b = b;
+
+			// A press of ours is being held
+			if (now < n.press_until)
+			{
+				if (n.press_btn == 1) out.cross = true;
+				else out.circle = true;
+			}
+
+			if (n.pending_btn)
+			{
+				if (cam.moves != n.moves_at_press) n.moved = true;
+				if (n.moved && settled)
+				{
+					// Which way the view went: where the camera looks now, seen from where it looked before (+1 left)
+					int side = 0;
+					if (geo && n.before_ok)
+					{
+						game_view bv;
+						for (int i = 0; i < 3; i++) bv.r[i] = n.before_r[i];
+						bv.t = n.before_t;
+						const vec3 q = game_to_view(bv, row.look);
+						if (q.z < -0.05f && std::fabs(q.x / -q.z) > 0.05f) side = q.x < 0.f ? 1 : -1;
+					}
+					else
+					{
+						const f32 dh = std::remainder(heading(tgt) - heading(n.before), 6.2831853f);
+						if (std::fabs(dh) > 0.07f && std::fabs(dh) < 2.2f) side = dh > 0.f ? 1 : -1;
+					}
+					if (side)
+					{
+						const int sc = n.pending_btn == 1 ? side : -side;
+						if (sc != n.side_cross || !n.ready)
+							vr_log("Stations: %s changes station to your %s", n.pending_btn == 1 ? "Cross (A)" : "Circle (B)", side > 0 ? "left" : "right");
+						if (sc != n.side_cross)
+						{
+							n.side_cross = sc;
+							persist_set("station_cross", sc > 0 ? "1" : "-1");
+						}
+						n.ready = true;
+					}
+					// The mod's press did not take the view where it meant to: not that button again from here
+					if (n.pending_auto && side != n.pending_want) { n.tried |= n.pending_btn; n.tried_moves = cam.moves; n.tried_at = now; }
+					else n.tried = 0;
+					n.pending_btn = 0;
+				}
+				else if (!n.moved && now - n.pending_since > 1500)
+				{
+					// Nothing happened: no station that way from here (only remembered for the mod's own presses)
+					if (n.pending_auto)
+					{
+						n.tried |= n.pending_btn;
+						n.tried_moves = cam.moves;
+						n.tried_at = now;
+						// neither button moves the camera here: the game does not change station now, the mod stops pressing
+						if (n.tried == 3 && now >= n.btns_quiet_until)
+						{
+							n.btns_quiet_until = now + 30000;
+							vr_log("Stations: neither Cross nor Circle moved the game's camera here; no station presses for 30 s");
+						}
+					}
+					n.pending_btn = 0;
+				}
+				else if (now - n.pending_since > 6000) n.pending_btn = 0;
+			}
+			if (n.tried && (cam.moves != n.tried_moves || now - n.tried_at > 8000)) n.tried = 0;
+
+			// The camera has arrived somewhere: where you stand along the row from now on is "here"
+			if (settled && !n.was_settled) { n.settled_at = now; n.head_ref_ok = false; n.frame_log_due = true; }
+			n.was_settled = settled;
+			if (geo && settled && !n.head_ref_ok) { n.head_ref = s_head; n.head_ref_ok = true; }
+			if (geo && settled && n.frame_log_due)
+			{
