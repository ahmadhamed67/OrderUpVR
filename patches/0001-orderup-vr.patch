+					smp.AddressU = smp.AddressV = smp.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+					smp.MaxLOD = D3D11_FLOAT32_MAX;
+					cok = cok && SUCCEEDED(dev->CreateSamplerState(&smp, &g.csmp));
+					if (!cok) vr_log("Chef: could not create the chef's graphics resources");
+				}
+				else vr_log("Chef: shader compile failed: %s", ce ? static_cast<const char*>(ce->GetBufferPointer()) : "?");
+				if (cv) cv->Release();
+				if (cp) cp->Release();
+				if (ce) ce->Release();
+			}
+
+			// The lobby restaurant: textured, vertex-lit, with see-through and glowing parts
+			{
+				ID3DBlob* lv = nullptr;
+				ID3DBlob* lp = nullptr;
+				ID3DBlob* le = nullptr;
+				const usz ll = std::strlen(lobby_shader);
+				if (SUCCEEDED(compile(lobby_shader, ll, "orderupvr_lobby", nullptr, nullptr, "vs_main", "vs_4_0", 0, 0, &lv, &le)) &&
+					SUCCEEDED(compile(lobby_shader, ll, "orderupvr_lobby", nullptr, nullptr, "ps_main", "ps_4_0", 0, 0, &lp, &le)))
+				{
+					const D3D11_INPUT_ELEMENT_DESC l_layout[] =
+					{
+						{"POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, 0, D3D11_INPUT_PER_VERTEX_DATA, 0},
+						{"TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT, 0, 12, D3D11_INPUT_PER_VERTEX_DATA, 0},
+						{"COLOR", 0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 20, D3D11_INPUT_PER_VERTEX_DATA, 0},
+					};
+					bool lok = SUCCEEDED(dev->CreateVertexShader(lv->GetBufferPointer(), lv->GetBufferSize(), nullptr, &g.lvs)) &&
+						SUCCEEDED(dev->CreatePixelShader(lp->GetBufferPointer(), lp->GetBufferSize(), nullptr, &g.lps)) &&
+						SUCCEEDED(dev->CreateInputLayout(l_layout, 3, lv->GetBufferPointer(), lv->GetBufferSize(), &g.lil));
+					D3D11_BUFFER_DESC lcd{};
+					lcd.ByteWidth = sizeof(lobby_cb);
+					lcd.Usage = D3D11_USAGE_DEFAULT;
+					lcd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+					lok = lok && SUCCEEDED(dev->CreateBuffer(&lcd, nullptr, &g.lcb));
+					D3D11_SAMPLER_DESC smp{};
+					smp.Filter = D3D11_FILTER_ANISOTROPIC;
+					smp.MaxAnisotropy = 8;
+					smp.AddressU = smp.AddressV = smp.AddressW = D3D11_TEXTURE_ADDRESS_WRAP;
+					smp.MaxLOD = D3D11_FLOAT32_MAX;
