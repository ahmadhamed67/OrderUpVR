+	// Developer tools, run from the command line; never used during play.
+	int dev_tool(int argc, char** argv)
+	{
+		const std::string cmd = argv[1];
+		if (cmd == "--ouvr-spu-disasm" && argc >= 4)
+		{
+			std::FILE* in = std::fopen(argv[2], "rb");
+			if (!in) return 2;
+			std::vector<u8> data(0x40000);
+			const usz n = std::fread(data.data(), 1, data.size(), in);
+			std::fclose(in);
+			const u32 start = argc > 4 ? static_cast<u32>(std::strtoul(argv[4], nullptr, 0)) : 0;
+			const u32 len = argc > 5 ? static_cast<u32>(std::strtoul(argv[5], nullptr, 0)) : static_cast<u32>(n);
+			std::FILE* out = std::fopen(argv[3], "w");
+			if (!out) return 3;
+			SPUDisAsm dis(cpu_disasm_mode::normal, data.data(), 0);
+			for (u32 pc = start & ~3u; pc < start + len && pc + 4 <= n; pc += 4)
+			{
+				dis.disasm(pc);
+				std::fprintf(out, "%05x: %08x  %s\n", pc, static_cast<u32>(data[pc] << 24 | data[pc + 1] << 16 | data[pc + 2] << 8 | data[pc + 3]), dis.last_opcode.c_str());
+			}
+			std::fclose(out);
+			return 0;
+		}
+		if (cmd == "--ouvr-ppu-disasm" && argc >= 6)
+		{
+			// PPU disassembly of a decrypted ELF (program segments placed at their addresses): <elf> <out> <start> <length>
+			std::FILE* in = std::fopen(argv[2], "rb");
+			if (!in) return 2;
+			std::vector<u8> elf;
+			{
+				std::fseek(in, 0, SEEK_END);
+				elf.resize(std::ftell(in));
+				std::fseek(in, 0, SEEK_SET);
+				std::fread(elf.data(), 1, elf.size(), in);
+				std::fclose(in);
+			}
+			const auto be64 = [&](usz o) { u64 v = 0; for (int k = 0; k < 8; k++) v = v << 8 | elf[o + k]; return v; };
+			const auto be16 = [&](usz o) { return static_cast<u32>(elf[o] << 8 | elf[o + 1]); };
+			std::vector<u8> image(0x400000);
+			const u64 phoff = be64(0x20);
+			for (u32 i = 0; i < be16(0x38); i++)
+			{
+				const usz o = phoff + i * 56;
+				if ((elf[o] << 24 | elf[o + 1] << 16 | elf[o + 2] << 8 | elf[o + 3]) != 1) continue;
+				const u64 off = be64(o + 8), va = be64(o + 16), fsz = be64(o + 32);
+				if (va + fsz <= image.size() && off + fsz <= elf.size()) std::memcpy(image.data() + va, elf.data() + off, fsz);
+			}
+			const u32 start = static_cast<u32>(std::strtoul(argv[4], nullptr, 0)), len = static_cast<u32>(std::strtoul(argv[5], nullptr, 0));
+			std::FILE* out = std::fopen(argv[3], "w");
+			if (!out) return 3;
+			PPUDisAsm dis(cpu_disasm_mode::normal, image.data());
+			for (u32 pc = start & ~3u; pc < start + len && pc + 4 <= image.size(); pc += 4)
+			{
+				dis.disasm(pc);
+				std::fprintf(out, "%08x: %08x  %s\n", pc, static_cast<u32>(image[pc] << 24 | image[pc + 1] << 16 | image[pc + 2] << 8 | image[pc + 3]), dis.last_opcode.c_str());
+			}
+			std::fclose(out);
+			return 0;
+		}
+		if (cmd == "--ouvr-cards" && argc >= 3)
+		{
+			// Draws every headset card to PNG files in a folder, to look at the design without a headset
