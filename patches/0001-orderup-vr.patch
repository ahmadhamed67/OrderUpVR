+				hud_panel h{};
+				h.on = true;
+				h.P = p;
+				h.A = normalize(cross(vec3{0.f, 1.f, 0.f}, n));
+				h.B = {0.f, 1.f, 0.f};
+				h.hw = hw;
+				h.hh = hh;
+				xr.holder_pf[k] = to_pf_impl(xr, h);
+				xr.holder_up[k] = up;
+			};
+			// (stood at the kitchen's station row, xr.reach from its line: the counter's front edge is some way ahead of you, so
+			// the stand and the shelf go on the counter, just inside that edge, a little wider out to clear the oven and the
+			// food processor; else 10 cm ahead, as the counter is right at you)
+			const bool row = xr.stand_rule == 1;
+			const f32 sf = row ? std::max(xr.reach - 0.30f, 0.10f) : 0.10f, sr = row ? 0.68f : 0.60f;
+			put(0, sf, -sr, 0.03f, 0.32f, 0.10f);    // the stand: the portraits stand on its ledge, 3 cm above the counter
+			put(1, sf, sr, 0.22f, 0.32f, 0.10f);     // the shelf: its lowest plank 22 cm above the counter
+			put(2, 0.50f, 0.14f, 0.02f, 0.10f, 0.135f);    // the recipe card's bottom edge on the counter (20 x 27 cm at most)
+		}
+
+		// This frame's holders: at the kitchen's own counter height when its layout is known (and believable from where you
+		// are), and the recipe card in your left hand like a clipboard, facing you, when that hand is tracked
+		void layout_holders(xr_state& xr, const cam_info& c, const game_view* gv)
+		{
+			const vec3 head_p = to_player(xr, xr.last_head);
+			bool known = false;
+			f32 top = 0.f;
+			// (a new kitchen or place: its counter is judged again)
+			if (!xr.kitchen_top_ok || c.place_id != xr.top_place) { xr.top_trust = 0; xr.top_place = c.place_id; }
+			if (gv && xr.kitchen_top_ok)
+			{
+				const vec3 t = level(c.up_a, xform(c.D, game_to_view(*gv, xr.kitchen_top_w))) * xr.unit;
+				if (std::isfinite(t.y))
+				{
+					// believable from where you were the first time it was seen (a lean or a crouch later does not change that)
+					if (!xr.top_trust) xr.top_trust = t.y < head_p.y - 0.15f && t.y > head_p.y - 1.3f ? 1 : 2;
+					if (xr.top_trust == 1) { top = t.y; known = true; }
+				}
+			}
+			// the holders' height eases there over about half a second (a station cut moves the counter a little)
+			const u64 now_t = GetTickCount64();
+			const f32 dt_t = xr.top_t ? std::clamp(static_cast<f32>(now_t - xr.top_t) / 1000.f, 0.f, 0.25f) : 0.f;
+			xr.top_t = now_t;
+			if (known)
+			{
+				if (!xr.top_s_ok) { xr.top_y_s = top; xr.top_s_ok = true; }
+				else xr.top_y_s += (top - xr.top_y_s) * std::min(1.f, dt_t / 0.15f);
+				top = xr.top_y_s;
+			}
+			else xr.top_s_ok = false;
+			for (int k = 0; k < 3; k++)
+			{
+				hud_panel h = xr.holder_pf[k];
+				if (known) h.P.y = top + xr.holder_up[k];
+				xr.holder_out[k] = h;
+			}
+			// the recipe card on the counter stands on its bottom edge, leaning back a little (P stays that bottom edge)
+			if (xr.holder_out[2].on)
+			{
+				hud_panel& h = xr.holder_out[2];
+				const vec3 N = normalize(cross(h.A, h.B));
+				const f32 lean = 0.35f;
+				h.B = h.B * std::cos(lean) - N * std::sin(lean);
+			}
+			// The recipe card on the clipboard in your left hand only while you hold it up to read it: the hand idle (open, not
+			// the one you work with), within about 45 cm of your eyes and its top toward them. Reaching for food with that hand,
+			// or holding it down, the card stands on the counter instead (it never hangs in front of the food you reach for).
+			const bool was_in_hand = xr.clip_in_hand;
+			xr.clip_in_hand = false;
+			bool read_pose = false;
+			if (xr.live3d && xr.hand_valid[0] && !xr.xb_out && xr.active_hand != 0 && xr.hand_grip[0] < 0.5f && xr.hand_trig[0] < 0.5f)
+			{
+				const XrPosef& g = xr.hand_pose[0];
+				const vec3 to_eye = xr.last_head - to_vec(g.position);
+				const f32 de = std::sqrt(dot(to_eye, to_eye));
+				const vec3 up = rotate(g.orientation, vec3{0.f, 1.f, 0.f});
+				const f32 facing = de > 1e-3f ? dot(up, to_eye) / de : 0.f;
+				read_pose = de < (was_in_hand ? 0.55f : 0.45f) && facing > (was_in_hand ? 0.f : 0.2f);
+			}
+			if (read_pose)
+			{
+				// held at its bottom like a clipboard (16 x 22 cm at most): the card's middle 9 cm above your fist, turned to your eyes
+				const XrPosef& g = xr.hand_pose[0];
+				const vec3 up = rotate(g.orientation, vec3{0.f, 1.f, 0.f}), fw = rotate(g.orientation, vec3{0.f, 0.f, -1.f});
+				const vec3 cpos = to_player(xr, to_vec(g.position) + up * 0.09f + fw * 0.03f);
+				vec3 n = head_p - cpos;
+				n = dot(n, n) > 1e-6f ? normalize(n) : vec3{0.f, 0.f, 1.f};
+				vec3 A = cross(vec3{0.f, 1.f, 0.f}, n);
+				A = dot(A, A) > 1e-6f ? normalize(A) : vec3{1.f, 0.f, 0.f};
+				hud_panel& h = xr.holder_out[2];
+				h.on = true;
+				h.P = cpos;
+				h.A = A;
+				h.B = normalize(cross(n, A));
+				h.hw = 0.08f;
+				h.hh = 0.11f;
+				xr.clip_in_hand = true;
+			}
+		}
+
+		// ---- The boards you can pick up: the ticket rail, the assistants' stand, the shelf and the recipe clipboard. Close a
+		// hand (GRIP) on a board's frame (not on a card: a card is pressed, and not while that hand holds food) and the board
+		// comes with that hand, keeping where on it you took it; open the hand and it stays right there, in the kitchen (in
+		// the game's world, like the counter: walking, turning and station changes do not carry it along). Where you left each
+		// board is kept for each kitchen for the whole session. That GRIP never reaches the game, and a GRIP that took food
+		// never takes a board. The rail, the stand and the shelf stay upright while you carry them (they turn with your hand
+		// about the vertical, so their cards stay level); the clipboard turns every way with your hand. Let go of the clipboard
+		// with your right hand next to your left hand and it rides your left hand again, as before.
+		// Which card holders each hand does not press (the cards on the board that hand carries), a bit per holder (vr_card::holder).
+		// (input thread only)
+		u32 g_board_skip[2]{};
+
+		const char* board_name(int k) { return k == 0 ? "ticket rail" : k == 1 ? "assistants' stand" : k == 2 ? "shelf" : "recipe clipboard"; }
+
+		// The kitchen the boards' places are kept for: the kitchen from the game files you were placed in here (the same
+		// kitchen keeps its boards when you come back to it), else this place the renderer measured
+		u64 board_key(const xr_state& xr, const cam_info& c)
+		{
+			if (xr.kit_state == 1 && xr.kit_pkg && xr.kit_place_id == c.place_id) return xr.kit_pkg;
+			return (1ull << 32) | c.place_id;
+		}
+
+		// Between the player frame and the game's world, the same way the ticket rail is placed
+		vec3 board_w2pf(const xr_state& xr, const cam_info& c, const game_view& gv, vec3 w) { return level(c.up_a, xform(c.D, game_to_view(gv, w))) * xr.unit; }
+		vec3 board_pf2w(const xr_state& xr, const cam_info& c, const game_view& gv, vec3 p)
+		{
+			return view_to_game(gv, xform(rigid_inv(c.D), level(c.up_a, p * (1.f / xr.unit), -1.f)));
+		}
+
+		// Stood upright (y up, in your room as in the player frame), turned only about the vertical
+		void board_upright(hud_panel& p)
+		{
+			vec3 A{p.A.x, 0.f, p.A.z};
+			if (dot(A, A) < 0.04f)
+			{
+				// held on its end: the way its face looks decides
+				const vec3 N = cross(p.A, p.B);
+				A = cross(vec3{0.f, 1.f, 0.f}, vec3{N.x, 0.f, N.z});
+			}
+			p.A = dot(A, A) > 1e-6f ? normalize(A) : vec3{1.f, 0.f, 0.f};
+			p.B = {0.f, 1.f, 0.f};
+		}
+
+		// The board in hand h now (room space), from the hand's pose and where on the board you took it
+		hud_panel board_in_hand(const xr_state& xr, int h)
+		{
+			const XrPosef& g = xr.hand_pose[h];
+			hud_panel p{};
+			p.on = true;
+			p.P = to_vec(g.position) + rotate(g.orientation, xr.board_off_P[h]);
+			p.A = normalize(rotate(g.orientation, xr.board_off_A[h]));
+			p.B = normalize(rotate(g.orientation, xr.board_off_B[h]));
+			p.hw = xr.board_hw[h];
+			p.hh = xr.board_hh[h];
+			if (xr.board_held[h] != 3) board_upright(p);
+			return p;
+		}
+
+		// The hand can take a board: not while it holds food (or is taking hold of it), and not the hand of the EXIT button
+		bool board_hand_free(const xr_state& xr, int h)
+		{
+			if (xr.grab_active && xr.grab_hand == h) return false;
+			if (xr.hold_now && xr.active_hand == h) return false;
+			if (h == 0 && (xr.xb_out || xr.xb_arm_since || exit_zone(xr, true))) return false;
+			if (h == 1 && xr.xb_squeeze_since) return false;
+			return true;
+		}
+
+		// The board whose frame this hand is closing on (-1: none): the nearest handle within reach of the middle of your
+		// closed hand. Never while that spot is on a card's face (there your hand presses the card).
+		int board_under_hand(const xr_state& xr, const cam_info& c, int h)
+		{
+			const hand_geo hg = make_hand(xr.hand_pose[h], h, xr.hand_grip[h], xr.hand_trig[h]);
+			const vec3 g = hg.grab, gp = to_player(xr, g);
+			for (int i = 0; i < c.card_n; i++)
+			{
+				const hud_panel& pn = c.cards[i].pn;
+				if (pn.hw <= 0.f || pn.hh <= 0.f) continue;
+				const vec3 n = normalize(cross(pn.A, pn.B)), q = gp - pn.P;
+				if (std::fabs(dot(q, n)) > 0.025f) continue;
+				if (std::fabs(dot(q, pn.A)) < pn.hw - 0.005f && std::fabs(dot(q, pn.B)) < pn.hh - 0.005f) return -1;
+			}
+			int best = -1;
+			f32 best_d = 1e9f;
+			for (int k = 0; k < 4; k++)
+			{
+				if (!xr.board_ok[k]) continue;
+				if (k == 3 && h == 0 && xr.clip_in_hand) continue;   // (already in that hand)
+				f32 d = 1e9f;
+				if (k == 3)
+				{
+					// the clipboard: only its hardboard edge round the card (and its clip), up to 3 cm off its face. A hand in
+					// front of or behind the card itself never takes it (that is food behind it, or a press on the card), and on
+					// its counter spot its bottom edge, down among the food on the counter, is no handle either.
+					const hud_panel& b = xr.board_room[3];
+					const vec3 n = normalize(cross(b.A, b.B)), q = g - b.P;
+					const f32 dn = dot(q, n), u = dot(q, b.A), v = dot(q, b.B);
+					const bool over_card = std::fabs(u) < b.hw - 0.01f && std::fabs(v) < b.hh - 0.01f;
+					const bool bottom = !xr.clip_centred && v < -b.hh + 0.03f;
+					if (!over_card && !bottom && std::fabs(dn) <= 0.03f && std::fabs(u) <= b.hw + 0.03f && std::fabs(v) <= b.hh + 0.04f) d = std::fabs(dn);
+				}
+				else
+				{
+					vec3 a[4], e[4];
+					f32 r[4];
+					const int n = vrui::board_segs(xr, k, a, e, r);
+					for (int s = 0; s < n; s++)
+					{
+						const vec3 ab = e[s] - a[s];
+						const f32 t = std::clamp(dot(g - a[s], ab) / std::max(dot(ab, ab), 1e-6f), 0.f, 1.f);
+						const vec3 dd = g - (a[s] + ab * t);
+						const f32 dist = std::sqrt(dot(dd, dd));
+						if (dist <= r[s]) d = std::min(d, dist);
+					}
+				}
+				if (d < best_d) { best_d = d; best = k; }
+			}
+			return best;
+		}
+
+		// Once a frame (input), after the hands are read: which board each hand could take, taking one (GRIP closing on its
+		// frame), and putting it down (GRIP opening). A light tick when a hand comes to a board's frame, a firm one when you
+		// take it, a soft one when you put it down.
+		void update_boards(xr_state& xr, const f32 grip[2], u64 now)
+		{
+			(void)now;
+			cam_info c;
+			{
+				std::lock_guard lock(g_state_mutex);
+				c = g_cam;
+			}
+			const bool live = xr.live3d && xr.mode3d && !xr.chooser_active;
+			for (int h = 0; h < 2; h++)
+			{
+				const bool down = grip[h] > 0.5f;
+				const bool edge = down && !xr.board_grip_prev[h];
+				xr.board_grip_prev[h] = down;
+				const int hov = live && xr.hand_valid[h] && xr.board_held[h] < 0 && board_hand_free(xr, h) ? board_under_hand(xr, c, h) : -1;
+				if (hov >= 0 && hov != xr.board_hover[h] && !down) buzz(xr, h, 0.08f, 20);
+				xr.board_hover[h] = down && !edge ? -1 : hov;
+				if (edge && hov >= 0)
+				{
+					// taken: from the counter, from the kitchen, or from your other hand
+					for (int o = 0; o < 2; o++) if (xr.board_held[o] == hov) xr.board_held[o] = -1;
+					const XrPosef& g = xr.hand_pose[h];
+					const XrQuaternionf qi = qconj(g.orientation);
+					const hud_panel& b = xr.board_room[hov];
+					xr.board_off_P[h] = rotate(qi, b.P - to_vec(g.position));
+					xr.board_off_A[h] = rotate(qi, b.A);
+					xr.board_off_B[h] = rotate(qi, b.B);
+					xr.board_hw[h] = b.hw;
+					xr.board_hh[h] = b.hh;
+					xr.board_held[h] = hov;
+					xr.board_hover[h] = -1;
+					xr.grip_block[h] = true;
+					buzz(xr, h, 0.5f, 70);
+					vr_log("Board: the %s picked up (%s hand; GRIP is the board's, the game does not get it)", board_name(hov), h ? "right" : "left");
+				}
+				else if (xr.board_held[h] >= 0 && grip[h] < 0.4f && !live)
+				{
+					// Let go while the game's 3D view is away (a dialog, a short gap, a place change): where it would go in the
+					// kitchen is not known, so it goes back to where it was before you took it (it is not left floating)
+					const int k = xr.board_held[h];
+					xr.board_held[h] = -1;
+					buzz(xr, h, 0.3f, 50);
+					vr_log("Board: the %s let go while the game's 3D view was away - it is back where it was", board_name(k));
+				}
+				else if (xr.board_held[h] >= 0 && grip[h] < 0.4f)
+				{
+					// put down where it is now (while the game's 3D view is away it stays in your hand)
+					const int k = xr.board_held[h];
+					const hud_panel p = xr.hand_valid[h] ? board_in_hand(xr, h) : xr.board_room[k];
+					xr.board_held[h] = -1;
+					buzz(xr, h, 0.3f, 50);
+					const u64 key = board_key(xr, c);
+					auto& spot = xr.board_saved[key][k];
+					bool back = false;
+					if (k == 3 && h == 1 && xr.hand_valid[0])
+					{
+						const vec3 d = p.P - to_vec(xr.hand_pose[0].position);
+						back = dot(d, d) < 0.15f * 0.15f;
+					}
+					spot = {};
+					if (back) vr_log("Board: the recipe clipboard handed back to your left hand (it rides it again)");
+					else
+					{
+						const hud_panel q = to_pf_impl(xr, p);
+						spot.set = true;
+						spot.hw = p.hw;
+						spot.hh = p.hh;
+						spot.P = q.P; spot.A = q.A; spot.B = q.B;
+						spot.pf_place = c.place_id;
+						spot.pf_unit = xr.unit;
+						game_view gv;
+						if (c.valid && xr.live3d && read_game_view(gv))
+						{
+							const vec3 w = board_pf2w(xr, c, gv, q.P);
+							const vec3 wa = normalize(board_pf2w(xr, c, gv, q.P + q.A) - w), wb = normalize(board_pf2w(xr, c, gv, q.P + q.B) - w);
+							if (std::isfinite(w.x + w.y + w.z + wa.x + wa.y + wa.z + wb.x + wb.y + wb.z)) { spot.world = true; spot.P = w; spot.A = wa; spot.B = wb; }
+						}
+						xr.board_room[k] = p;
+						const vec3 dh = p.P - xr.last_head;
+						vr_log("Board: the %s put down %.2f m from your eyes, %.2f m below them (kept for this kitchen, %s %llx)", board_name(k),
+							std::sqrt(dot(dh, dh)), xr.last_head.y - p.P.y, spot.world ? "in the game's world," : "in your frame (the game's world not known),",
+							static_cast<unsigned long long>(key));
+					}
+				}
+				if (xr.board_held[h] < 0 && grip[h] <= 0.5f) xr.grip_block[h] = false;
+			}
+			for (int h = 0; h < 2; h++)
+			{
+				const int k = xr.board_held[h];
+				g_board_skip[h] = k < 0 ? 0u : k == 3 ? (1u << 3) | (1u << 4) : 1u << k;
+			}
+		}
+
+		// Each frame's layout (layout_hud): every board where it is now. In a hand: where that hand carries it. Put down in this
+		// kitchen: where you left it (from the game's world). Otherwise where the HUD placed it (the rail over the counter, the
+		// stand and the shelf beside you, the recipe card on the counter or riding your left hand). The cards are laid out on
+		// these poses by the renderer (rv_layout_cards), so they go along. Also how long each board must be for its cards.
+		void apply_boards(xr_state& xr, const cam_info& c, const game_view* gv, hud_panel out[4])
+		{
+			const auto it = xr.board_saved.find(board_key(xr, c));
+			const bool live = xr.live3d && xr.mode3d;
+			bool has[4]{};
+			for (int i = 0; i < c.card_n; i++)
+			{
+				const u8 hd = c.cards[i].holder;
+				has[hd < 3 ? hd : 3] = true;
+			}
+			xr.clip_centred = xr.clip_in_hand;
+			const vec3 head_p = to_player(xr, xr.last_head);
+			for (int k = 0; k < 4; k++)
+			{
+				hud_panel& tgt = k == 0 ? out[0] : xr.holder_out[k - 1];
+				int by = -1;
+				for (int h = 0; h < 2; h++) if (xr.board_held[h] == k) by = h;
+				bool moved = false;
+				hud_panel p = tgt;
+				if (by >= 0)
+				{
+					p = to_pf_impl(xr, xr.hand_valid[by] ? board_in_hand(xr, by) : xr.board_room[k]);
+					moved = true;
+				}
+				else if (it != xr.board_saved.end() && it->second[k].set)
+				{
+					const auto& s = it->second[k];
+					hud_panel q = p;
+					bool ok = true;
+					if (s.world)
+					{
+						ok = gv && c.valid;
+						if (ok)
+						{
+							q.P = board_w2pf(xr, c, *gv, s.P);
+							q.A = normalize(board_w2pf(xr, c, *gv, s.P + s.A) - q.P);
+							q.B = normalize(board_w2pf(xr, c, *gv, s.P + s.B) - q.P);
+						}
+					}
+					else
+					{
+						// (kept in your frame: only in the same place with the world at the same size; else its usual spot)
+						ok = s.pf_place == c.place_id && std::fabs(s.pf_unit - xr.unit) < 0.01f * std::max(xr.unit, 0.01f);
+						q.P = s.P; q.A = s.A; q.B = s.B;
+					}
+					q.hw = s.hw;
+					q.hh = s.hh;
+					const vec3 rel = q.P - head_p;
+					// (a board the kitchen's frame puts far off, or nowhere, stands at its usual spot meanwhile)
+					ok = ok && std::isfinite(q.P.x + q.P.y + q.P.z + q.A.x + q.A.y + q.A.z + q.B.x + q.B.y + q.B.z) && dot(rel, rel) < 6.f * 6.f;
+					if (ok) { p = q; moved = true; }
+				}
+				if (moved)
+				{
+					tgt.on = true;
+					tgt.P = p.P;
+					tgt.A = p.A;
+					tgt.B = p.B;
+					if (k == 3) { tgt.hw = p.hw; tgt.hh = p.hh; xr.clip_in_hand = false; xr.clip_centred = true; }
+				}
+				// this frame's board in your room (the clipboard by its middle; on its usual counter spot P is its bottom edge)
+				hud_panel r = from_pf_impl(xr, tgt);
+				if (k == 0 && c.pan_ok[0] && c.pan_hw[0] > 0.f) { r.hw = c.pan_hw[0]; r.hh = c.pan_hh[0]; }
+				if (k == 3 && !xr.clip_centred)
+				{
+					// (on its counter spot: the recipe card as it is drawn there, so it does not jump in your hand when you take
+					// the clipboard, and its handle is round the card you see)
+					bool got = false;
+					for (int i = 0; i < c.card_n && !got; i++)
+					{
+						const vr_card& cd = c.cards[i];
+						if (cd.holder != 3 || cd.pn.hw <= 0.f || cd.pn.hh <= 0.f) continue;
+						hud_panel cp = tgt;
+						cp.P = cd.pn.P;
+						r.P = from_pf_impl(xr, cp).P;
+						r.hw = cd.pn.hw;
+						r.hh = cd.pn.hh;
+						got = true;
+					}
+					if (!got) r.P = r.P + r.B * r.hh;
+				}
+				xr.board_room[k] = r;
+				xr.board_ok[k] = live && tgt.on && (k == 0 ? c.hud_seen[0] > 0 : has[k]);
+				// how far the cards reach along the stand and the shelf (kept while you carry it: the renderer's cards come a
+				// frame late)
+				if ((k == 1 || k == 2) && by < 0 && has[k])
+				{
+					f32 lo = 1e9f, hi = -1e9f, top = 0.f;
+					for (int i = 0; i < c.card_n; i++)
+					{
+						const vr_card& cd = c.cards[i];
+						if (cd.holder != k) continue;
+						const f32 a = dot(cd.pn.P - tgt.P, tgt.A);
+						lo = std::min(lo, a - cd.pn.hw);
+						hi = std::max(hi, a + cd.pn.hw);
+						top = std::max(top, dot(cd.pn.P + cd.pn.B * cd.pn.hh - tgt.P, tgt.B));
+					}
+					if (lo < hi && hi - lo < 1.5f)
+					{
+						xr.board_lo[k] = lo;
+						xr.board_hi[k] = hi;
+						xr.board_top[k] = std::clamp(top, 0.05f, 0.6f);
+					}
+				}
+				xr.board_lit[k] = by >= 0 ? 2 : (xr.board_hover[0] == k || xr.board_hover[1] == k) ? 1 : 0;
+			}
+		}
+
+		void layout_hud(xr_state& xr, hud_panel out[4])
+		{
+			if (g_game_known && interior::state.load() == 0) interior::start(game_usrdir());
+			const auto to_pf = [&](const hud_panel& p) { return to_pf_impl(xr, p); };
+			const auto from_pf = [&](const hud_panel& p) { return from_pf_impl(xr, p); };
+			cam_info c;
+			{
+				std::lock_guard lock(g_state_mutex);
+				c = g_cam;
+			}
+			// Each panel keeps the shape of its part of the game's screen
+			const f32 aspect = std::max(c.sy, 0.2f) / std::max(c.sx, 0.2f);   // screen width / height
+			const auto set = [](hud_panel& pn, vec3 at, vec3 face_to, f32 hw, f32 hh)
+			{
+				vec3 n = face_to - at;
+				n.y = 0.f;
+				n = dot(n, n) > 1e-6f ? normalize(n) : vec3{0.f, 0.f, 1.f};
+				pn.on = true;
+				pn.P = at;
+				pn.A = normalize(cross(vec3{0.f, 1.f, 0.f}, n));
+				pn.B = {0.f, 1.f, 0.f};
+				pn.hw = hw;
+				pn.hh = hh;
+			};
+			vec3 fwd = xr.last_forward;
+			fwd.y = 0.f;
+			fwd = dot(fwd, fwd) > 1e-6f ? normalize(fwd) : vec3{0.f, 0.f, -1.f};
+			const vec3 right{-fwd.z, 0.f, fwd.x};
+			const vec3 head = xr.last_head;
+			// Tickets and the side panels: placed once where you are placed, within reach, ticket-sized
+			if (!xr.hud_locked)
+			{
+				const f32 rail_hw = 0.48f;   // the top strip of the screen (22.5% of its height, full width)
+				// (within reach: 0.6 m ahead, just above your eyes, so a hand can take a ticket or the rail itself)
+				set(xr.hud_room[0], head + fwd * 0.60f + vec3{0.f, 0.05f, 0.f}, head, rail_hw, rail_hw * 0.225f / aspect);
+				const f32 side_hw = 0.11f;   // the side strips (30% of the width, 77.5% of the height)
+				set(xr.hud_room[1], head + fwd * 1.00f - right * 0.55f + vec3{0.f, -0.20f, 0.f}, head, side_hw * 1.6f, side_hw * 1.6f * (0.775f / 0.3f) / aspect);
+				set(xr.hud_room[2], head + fwd * 1.00f + right * 0.55f + vec3{0.f, -0.20f, 0.f}, head, side_hw * 1.6f, side_hw * 1.6f * (0.775f / 0.3f) / aspect);
+				// The stations at your counter (56% of your eye height): the plate lies on it in front of you, a little to the
+				// left; the trash bin stands on the floor by your right leg; the oven under the counter on your left, its
+				// controls on the counter's edge; the food processor on the counter on your right. All within reach (0.4-0.7 m).
+				{
+					const f32 cy = vrui::counter_y(xr);
+					const auto at = [&](f32 f, f32 r, f32 y) { vec3 p = head + fwd * f + right * r; p.y = y; return p; };
+					auto& pl = xr.spot_room[0];
+					pl.on = true; pl.P = at(0.42f, -0.18f, cy + 0.01f);
+					pl.A = right; pl.B = fwd; pl.hw = pl.hh = 0.13f;
+					auto& tr = xr.spot_room[1];
+					tr.on = true; tr.hw = tr.hh = 0.10f; tr.P = at(0.36f, 0.45f, cy - 0.10f);
+					tr.A = right; tr.B = {0.f, 1.f, 0.f};
+					auto& ov = xr.spot_room[2];
+					ov.on = true; ov.hw = ov.hh = 0.11f; ov.P = at(0.45f, -0.50f, cy + 0.02f + 0.11f);
+					ov.A = normalize(right + fwd * 0.6f); ov.B = {0.f, 1.f, 0.f};
+					auto& fp = xr.spot_room[3];
+					fp.on = true; fp.hw = fp.hh = 0.10f; fp.P = at(0.45f, 0.50f, cy + 0.24f + 0.10f);
+					fp.A = normalize(right - fwd * 0.6f); fp.B = {0.f, 1.f, 0.f};
+					vr_log("Stations: counter at %.2f m (floor %s), plate, bin, oven and food processor placed around you", cy - xr.floor_y, xr.floor_known ? "known" : "guessed");
+				}
+				place_holders(xr, head, fwd, right);   // the assistants' stand, the shelf and the recipe card's spot
+				xr.hud_locked = true;
+				// fixed in the game's world from now on: walking or turning with the stick no longer carries them along
+				for (int k = 0; k < 3; k++) xr.hud_pf[k] = to_pf(xr.hud_room[k]);
+				for (int k = 0; k < 4; k++) xr.spot_pf[k] = to_pf(xr.spot_room[k]);
+			}
+			// Menus and dialogs: each time one opens, on a panel sloping away from you like a kiosk's screen, at arm's length
+			// below your eyes (where your hands are, seated or standing), and there it stays while it is open. Open: the game's
+			// UI tree shows a menu or a dialog (not "something was drawn on the panel": the kitchen's own HUD pieces, a pause
+			// icon among them, kept that true all the time, so the panel never came to a dialog that opened)
+			const u64 now_m = GetTickCount64();
+			const bool up_now = xr.menu_open;   // (the UI tree's decision only: a small pause icon drawn in the kitchen is no menu)
+			if (up_now) xr.menu_seen_at = now_m;
+			const bool menu_up = up_now || (xr.menu_seen_at && now_m - xr.menu_seen_at < 800);
+			// (and again while it is open when you have walked more than a metre from where it came, with the stick or in your
+			// room: it is always within reach where you are, never back where you were. Not while your fingertip is on it.)
+			bool walked_off = false;
+			if (menu_up && xr.menu_was_up && xr.menu_locked && xr.hud_room[3].on && !xr.menu_touch_ok)
+			{
+				vec3 to = xr.hud_room[3].P - head;
+				to.y = 0.f;
+				walked_off = dot(to, to) > 1.0f;
+			}
+			if (walked_off) vr_log("Menu: you walked away from the menu in front of you, it came to where you are now");
+			if ((menu_up && !xr.menu_was_up) || !xr.menu_locked || walked_off)
+			{
+				// about 0.50 m wide at 0.68 m (40 degrees of your view, as a TV shows the game: its tips, OK buttons and tabs at a
+				// readable size, not filling your eyes), sloping back 25 degrees, still within your fingertips' reach
+				const f32 hw = 0.25f, slope = 0.44f;
+				hud_panel& m = xr.hud_room[3];
+				set(m, head + fwd * 0.68f + vec3{0.f, -0.20f, 0.f}, head, hw, hw / aspect);
+				m.B = vec3{0.f, std::cos(slope), 0.f} + fwd * std::sin(slope);
+				xr.hud_pf[3] = to_pf(xr.hud_room[3]);
+				xr.menu_locked = true;
+			}
+			xr.menu_was_up = menu_up;
+			// The player frame is the game's world (what the renderer and the pointer use): the panels stay where they were
+			// placed in the kitchen; the stations' room positions follow from there (you move, they do not)
+			for (int k = 0; k < 4; k++)
+			{
+				out[k] = xr.hud_pf[k];
+				xr.hud_room[k] = from_pf(xr.hud_pf[k]);
+				if (xr.spot_pf[k].on) xr.spot_room[k] = from_pf(xr.spot_pf[k]);
+			}
+			// Anchored in the game's world: placed once (at the food's distance, where the game's HUD shows each strip),
+			// then each frame from the game's camera to you. Facing you, upright.
+			game_view gv;
+			const bool view_ok = xr.live3d && c.valid && read_game_view(gv);
+			if (view_ok && !xr.hud_world_ok && c.food_d > 0.05f)
+			{
+				const f32 k = std::clamp(c.hud_k, 0.2f, 1.f);
+				const f32 sxn = std::max(c.sx * k, 0.1f), syn = std::max(c.sy * k, 0.1f), d = c.food_d;
+				const vec3 q[3] = {
+					{0.f, 0.775f * d / syn, -d},                 // the tickets: the top strip, centred
+					{-0.7f * d / sxn, -0.225f * d / syn, -d},    // the left strip
+					{0.7f * d / sxn, -0.225f * d / syn, -d},     // the right strip
+				};
+				for (int i = 0; i < 3; i++) xr.hud_world[i] = view_to_game(gv, q[i]);
+				xr.hud_world_ok = true;
+				for (bool& b : xr.spot_world_ok) b = false;
+				xr.kitchen_rail = false;
+				xr.kitchen_top_ok = false;
+				// The kitchen itself (from the game files): the ticket rail over the far side of its station line, the trash
+				// and the oven where this kitchen has them
+				f32 kd = 0.f;
+				const interior::kitchen* kt = interior::pick(view_to_game(gv, {0.f, 0.f, -d}), &kd);
+				// (only a kitchen whose floor agrees with the game camera's own height, as for your height: else the layout
+				// is not this camera's space, and the rail, the trash and the oven stay beside you)
+				f32 cam_mem = 0.f;
+				if (kt && game_camera_height(cam_mem))
+				{
+					const f32 hk = view_to_game(gv, {0.f, 0.f, 0.f}).y - kt->floor_y;
+					if (std::fabs(hk - cam_mem) >= 0.6f)
+					{
+						vr_log("Interior: kitchen %08x rejected for the rail and the stations (the camera is %.2f units above its floor, %.2f by its memory)", kt->pkg, hk, cam_mem);
+						kt = nullptr;
+					}
+				}
+				if (kt)
+				{
+					const vec3 cw = view_to_game(gv, {0.f, 0.f, 0.f});
+					const vec3 mid = (kt->line0 + kt->line1) * 0.5f;
+					vec3 away = mid - cw;
+					away.y = 0.f;
+					away = dot(away, away) > 1e-6f ? normalize(away) : vec3{0.f, 0.f, -1.f};
+					// The rail hangs within your reach: over the near edge of the counter, half a metre in front of where
+					// you stand (you stand xr.reach from the row's line), a little above your eyes, so you can take its
+					// tickets with a fingertip or lift the whole rail off without walking into the counter
+					const f32 uu = std::max(xr.unit, 0.05f);
+					const f32 near_u = (xr.reach - 0.50f) / uu;   // from the row's line towards you
+					const f32 up_u = xr.counter_drop > 0.1f ? (xr.counter_drop + 0.05f) / uu : 0.85f;
+					// (along the row: opposite where the camera looks, which is where you were stood)
+					vec3 along = mid;
+					{
+						const vec3 lk = view_to_game(gv, {0.f, 0.f, -d});
+						vec3 seg = kt->line1 - kt->line0;
+						seg.y = 0.f;
+						const f32 ll = dot(seg, seg);
+						if (ll > 1e-6f)
+						{
+							vec3 rel = lk - kt->line0;
+							rel.y = 0.f;
+							along = kt->line0 + seg * std::clamp(dot(rel, seg) / ll, 0.f, 1.f);
+						}
+					}
+					xr.hud_world[0] = {along.x - away.x * near_u, kt->top_y + up_u, along.z - away.z * near_u};
+					xr.kitchen_rail = true;
+					xr.kitchen_top_w = {mid.x, kt->top_y, mid.z};   // the counter top: the cards' stand and shelf stand on it
+					xr.kitchen_top_ok = true;
+					if (const interior::inode* t = interior::find(*kt, {"trash"}, {"sidewalk", "garbage", "stain"}))
+					{
+						xr.spot_world[1] = {t->pos.x, kt->top_y + 0.15f, t->pos.z};
+						xr.spot_world_ok[1] = true;
+					}
+					if (const interior::inode* o = interior::find(*kt, {"oven"}, {"station", "ceiling", "hood"}))
+					{
+						xr.spot_world[2] = {o->pos.x, kt->top_y + 0.15f, o->pos.z};
+						xr.spot_world_ok[2] = true;
+					}
+					vr_log("Interior: kitchen %08x (%.2f units from where the camera looks): ticket rail at %.2f %.2f %.2f, trash %s, oven %s",
+						kt->pkg, kd, xr.hud_world[0].x, xr.hud_world[0].y, xr.hud_world[0].z, xr.spot_world_ok[1] ? "at the kitchen's trash can" : "beside you",
+						xr.spot_world_ok[2] ? "at the kitchen's oven" : "beside you");
+				}
+				vr_log("HUD: tickets and side panels anchored in the restaurant (food %.2f units away; tickets at %.2f %.2f %.2f)", d, xr.hud_world[0].x, xr.hud_world[0].y, xr.hud_world[0].z);
+			}
+			xr.rail_world_now = false;
+			if (view_ok && xr.hud_world_ok)
+			{
+				const vec3 head_p = to_player(xr, xr.last_head);
+				for (int i = 0; i < 3; i++)
+				{
+					const vec3 pp = level(c.up_a, xform(c.D, game_to_view(gv, xr.hud_world[i]))) * xr.unit;
+					const vec3 rel = pp - head_p;
+					if (!std::isfinite(pp.x) || dot(rel, rel) > (i == 0 && xr.kitchen_rail ? 2.5f * 2.5f : 25.f)) continue;   // too far: keep the room spot
+					if (i == 0 && xr.kitchen_rail && (pp.y < head_p.y - 0.6f || pp.y > head_p.y + 1.2f)) continue;
+					if (i == 0) xr.rail_world_now = true;
+					vec3 n = head_p - pp;
+					n.y = 0.f;
+					n = dot(n, n) > 1e-6f ? normalize(n) : vec3{0.f, 0.f, 1.f};
+					out[i].P = pp;
+					out[i].A = normalize(cross(vec3{0.f, 1.f, 0.f}, n));
+					out[i].B = {0.f, 1.f, 0.f};
+				}
+				// the stations the kitchen has: at its trash can and oven, facing you
+				for (int k = 1; k < 3; k++)
+				{
+					if (!xr.spot_world_ok[k] || !xr.spot_pf[k].on) continue;
+					const vec3 pp = level(c.up_a, xform(c.D, game_to_view(gv, xr.spot_world[k]))) * xr.unit;
+					const vec3 rel = pp - head_p;
+					if (!std::isfinite(pp.x) || dot(rel, rel) > 2.5f * 2.5f || pp.y < head_p.y - 1.4f || pp.y > head_p.y + 0.3f) { xr.spot_world_ok[k] = false; continue; }
+					vec3 n = head_p - pp;
+					n.y = 0.f;
+					n = dot(n, n) > 1e-6f ? normalize(n) : vec3{0.f, 0.f, 1.f};
