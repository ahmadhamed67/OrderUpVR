<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root" Background="{StaticResource Bg}" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
  <Grid.RowDefinitions>
    <RowDefinition Height="46"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- Ambient background glow (animated from code) -->
  <Canvas Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
    <Ellipse x:Name="AmbientA" Width="620" Height="620" Canvas.Left="-220" Canvas.Top="-300" Opacity="0.22">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF7A00" Offset="0"/><GradientStop Color="#00FF7A00" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
    </Ellipse>
    <Ellipse x:Name="AmbientB" Width="560" Height="560" Canvas.Left="640" Canvas.Top="320" Opacity="0.14">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF3D6E" Offset="0"/><GradientStop Color="#00FF3D6E" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
    </Ellipse>
  </Canvas>

  <!-- Title bar -->
  <Grid Grid.Row="0" Margin="18,0,8,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource AccentGrad}">
        <TextBlock Text="VR" FontSize="9.5" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock x:Name="CaptionTitle" Text="Order Up VR" Margin="10,0,0,0" FontSize="12.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center" FontFamily="{StaticResource UiFont}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button x:Name="MinBtn" Style="{StaticResource Caption}" ToolTip="Minimize"><TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="10"/></Button>
      <Button x:Name="CloseBtn" Style="{StaticResource Caption}" Tag="close" ToolTip="Close"><TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/></Button>
    </StackPanel>
  </Grid>

  <!-- Pages -->
  <Grid Grid.Row="1" x:Name="Pages">

    <!-- ===================================================== SETUP -->
    <Grid x:Name="SetupPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Width="700" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40" Padding="40,34">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel x:Name="StepDots" Orientation="Horizontal" Margin="0,0,0,24"/>

          <!-- Step 1: welcome -->
          <StackPanel x:Name="StepWelcome" Grid.Row="1">
            <TextBlock Style="{StaticResource Overline}" Text="VR MOD FOR RPCS3"/>
            <TextBlock Style="{StaticResource H1}" Text="Order Up!! VR" Margin="0,4,0,0" FontSize="40"/>
            <TextBlock x:Name="WelcomeText" Style="{StaticResource DimText}" Margin="0,12,0,0" FontSize="14.5" LineHeight="22"
                       Text="Play the PlayStation 3 cooking game Order Up!! in virtual reality. Your VR controllers become the PlayStation Move, and the game appears in front of you in the headset."/>
            <Border x:Name="WelcomeBack" Visibility="Collapsed" Margin="0,18,0,0" Background="#1A3DDC97" BorderBrush="#403DDC97" BorderThickness="1" CornerRadius="12" Padding="14,10">
              <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Good}" Text="Welcome back. Your folders, settings and game cache from before are still here and will be reused."/>
            </Border>
            <TextBlock Style="{StaticResource DimText}" Margin="0,18,0,0" FontSize="12.5"
                       Text="You need your own RPCS3 with PS3 firmware and your own copy of the European game (BLES01470). Nothing in them is changed."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
              <Button x:Name="SetupCancelBtn" Style="{StaticResource Ghost}" Content="Cancel" Margin="0,0,10,0" Padding="20,11"/>
              <Button x:Name="GetStartedBtn" Style="{StaticResource Primary}" Width="190" Height="48" FontSize="15" Content="Get started"/>
            </StackPanel>
          </StackPanel>

          <!-- Step 2: folders -->
          <StackPanel x:Name="StepFolders" Grid.Row="1" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Overline}" Text="STEP 2 OF 3"/>
            <TextBlock Style="{StaticResource H1}" Text="Choose your folders" FontSize="30" Margin="0,4,0,6"/>
            <TextBlock Style="{StaticResource DimText}" Text="These were found automatically when possible."/>

            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Your RPCS3 folder" Margin="0,22,0,6"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="Rpcs3Box" Style="{StaticResource Field}"/>
              <Button x:Name="Rpcs3Browse" Grid.Column="1" Style="{StaticResource Ghost}" Content="Browse" Margin="10,0,0,0" Padding="18,9"/>
            </Grid>
            <TextBlock x:Name="Rpcs3Check" Style="{StaticResource DimText}" FontSize="12.5" Margin="2,6,0,0"/>

            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Order Up!! game folder" Margin="0,16,0,6"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="GameBox" Style="{StaticResource Field}"/>
              <Button x:Name="GameBrowse" Grid.Column="1" Style="{StaticResource Ghost}" Content="Browse" Margin="10,0,0,0" Padding="18,9"/>
            </Grid>
            <TextBlock x:Name="GameCheck" Style="{StaticResource DimText}" FontSize="12.5" Margin="2,6,0,0"/>

            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Install Order Up VR to" Margin="0,16,0,6"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="InstallBox" Style="{StaticResource Field}"/>
              <Button x:Name="InstallBrowse" Grid.Column="1" Style="{StaticResource Ghost}" Content="Browse" Margin="10,0,0,0" Padding="18,9"/>
            </Grid>
            <TextBlock x:Name="InstallCheck" Style="{StaticResource DimText}" FontSize="12.5" Margin="2,6,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
              <Button x:Name="FoldersBackBtn" Style="{StaticResource Ghost}" Content="Back" Margin="0,0,10,0" Padding="20,11"/>
              <Button x:Name="InstallBtn" Style="{StaticResource Primary}" Width="190" Height="48" FontSize="15" Content="Install"/>
            </StackPanel>
          </StackPanel>

          <!-- Step 3: installing -->
          <StackPanel x:Name="StepInstall" Grid.Row="1" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Overline}" Text="STEP 3 OF 3"/>
            <TextBlock x:Name="InstallTitle" Style="{StaticResource H1}" Text="Installing" FontSize="30" Margin="0,4,0,18"/>
            <StackPanel x:Name="InstallSteps"/>
            <TextBlock x:Name="InstallError" Style="{StaticResource Body}" Foreground="{StaticResource Bad}" Margin="0,14,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ===================================================== HOME -->
    <Grid x:Name="MainPage" Margin="24,4,24,24" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="16"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Hero: the game card -->
      <Grid x:Name="Hero" Grid.Row="0">
        <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3A1A06" Offset="0"/>
            <GradientStop Color="#24101F" Offset="0.55"/>
            <GradientStop Color="#141720" Offset="1"/>
          </LinearGradientBrush>
        </Grid.Background>
        <Canvas x:Name="HeroGlows" IsHitTestVisible="False">
          <Ellipse x:Name="HeroGlowA" Width="420" Height="420" Canvas.Left="-120" Canvas.Top="-200" Opacity="0.55">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF8A00" Offset="0"/><GradientStop Color="#00FF8A00" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse x:Name="HeroGlowB" Width="460" Height="460" Canvas.Left="560" Canvas.Top="-120" Opacity="0.45">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FF3D6E" Offset="0"/><GradientStop Color="#00FF3D6E" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse x:Name="HeroGlowC" Width="300" Height="300" Canvas.Left="300" Canvas.Top="90" Opacity="0.30">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#8B5CF6" Offset="0"/><GradientStop Color="#008B5CF6" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
          </Ellipse>
        </Canvas>
        <!-- The game's own art (read from the player's game folder when they ask for it) -->
        <Image x:Name="HeroArt" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Rectangle x:Name="HeroShade" Opacity="0" IsHitTestVisible="False">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#F00E1015" Offset="0"/>
              <GradientStop Color="#B00E1015" Offset="0.42"/>
              <GradientStop Color="#100E1015" Offset="0.85"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Border BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="20"/>
        <StackPanel VerticalAlignment="Center" Margin="40,0,0,0" HorizontalAlignment="Left" MaxWidth="560">
          <TextBlock Style="{StaticResource Overline}" Text="VR MOD  ·  PLAYSTATION 3  ·  RPCS3" Foreground="#FFC58A"/>
          <TextBlock Style="{StaticResource H1}" Text="Order Up!! VR" Margin="0,2,0,0" FontSize="46"/>
          <TextBlock Style="{StaticResource Body}" Foreground="#D9DCE3" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="Run the kitchen in virtual reality. Grab, chop and flip with your own hands."/>
          <StackPanel x:Name="Chips" Orientation="Horizontal" Margin="0,18,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16">
          <Button x:Name="WhatsNewBtn" Style="{StaticResource Ghost}" Padding="14,8" FontSize="12.5" Margin="0,0,8,0" Background="#D0141720">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="13" Margin="0,1,8,0"/><TextBlock x:Name="WhatsNewText" Text="What's new"/></StackPanel>
          </Button>
          <Button x:Name="ArtBtn" Style="{StaticResource Ghost}" Padding="14,8" FontSize="12.5" Background="#D0141720" ToolTip="Show the game's own artwork, read from your copy of the game">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE91B;" FontSize="13" Margin="0,1,8,0"/><TextBlock x:Name="ArtText" Text="Game art"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Status strip -->
      <UniformGrid x:Name="StatusPanel" Grid.Row="2" Rows="1"/>

      <!-- Bottom bar -->
      <Border Grid.Row="4" Style="{StaticResource Card}" Padding="24,16,16,16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
              <TextBlock x:Name="StatusText" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="10,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="Ready"/>
            </StackPanel>
            <TextBlock x:Name="SubText" Style="{StaticResource DimText}" FontSize="12.5" Margin="19,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <Grid x:Name="ProgressTrack" Height="5" Margin="19,10,0,0" Visibility="Collapsed" ClipToBounds="True">
              <Border CornerRadius="3" Background="{StaticResource Surface3}"/>
              <Border x:Name="ProgressFill" CornerRadius="3" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left" Width="0">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
              </Border>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
            <Button x:Name="UpdateBtn" Style="{StaticResource Ghost}" Width="48" Height="48" Padding="0" Margin="0,0,10,0" ToolTip="Check for updates">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="16"/>
            </Button>
            <Button x:Name="LogsBtn" Style="{StaticResource Ghost}" Width="48" Height="48" Padding="0" Margin="0,0,10,0" ToolTip="Collect logs for support">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="16"/>
            </Button>
            <Button x:Name="HelpBtn" Style="{StaticResource Ghost}" Width="48" Height="48" Padding="0" Margin="0,0,10,0" ToolTip="How to play">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" FontSize="16"/>
            </Button>
            <Button x:Name="SettingsBtn" Style="{StaticResource Ghost}" Width="48" Height="48" Padding="0" ToolTip="Settings">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="16"/>
            </Button>
          </StackPanel>
          <Button x:Name="PlayBtn" Grid.Column="2" Style="{StaticResource Primary}" Width="230" Height="60">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="PlayIcon" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="18" Margin="0,0,12,0"/>
              <TextBlock x:Name="PlayText" Text="PLAY" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- ===================================================== SETTINGS -->
    <Grid x:Name="SettingsPage" Margin="24,4,24,24" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <Button x:Name="BackBtn" Style="{StaticResource Ghost}" Padding="12,9">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;"/>
        </Button>
        <TextBlock Style="{StaticResource H1}" FontSize="28" Text="Settings" Margin="16,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Folders"/>
              <TextBlock Style="{StaticResource DimText}" Text="Order Up VR uses your RPCS3's firmware and saves, and your game files. It never changes them." Margin="0,4,0,8"/>
              <StackPanel x:Name="FolderRows"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="Updates and preferences" Margin="0,0,0,10"/>
              <StackPanel x:Name="ChannelRows" Margin="0,0,0,18"/>
              <CheckBox x:Name="AutoUpdateToggle" Style="{StaticResource Toggle}" Content="Check for updates automatically"/>
              <CheckBox x:Name="MinimizeToggle" Style="{StaticResource Toggle}" Content="Minimize the launcher while playing" Margin="0,14,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="In VR"/>
              <TextBlock Style="{StaticResource DimText}" Text="Pick what feels best. Changes reach the headset within a few seconds, even while you play." Margin="0,4,0,6" TextWrapping="Wrap"/>
              <StackPanel x:Name="VrRows"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
              <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="About"/>
                <TextBlock x:Name="AboutText" Style="{StaticResource DimText}" Margin="0,6,0,0"/>
              </StackPanel>
              <Button x:Name="GithubBtn" Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Project page"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
              <StackPanel Margin="0,0,180,0">
                <TextBlock Style="{StaticResource H2}" Text="Uninstall"/>
                <TextBlock Style="{StaticResource DimText}" Margin="0,6,0,0" Text="Remove Order Up VR from this PC. You can keep your settings and game cache for a quick reinstall later, or remove everything."/>
              </StackPanel>
              <Button x:Name="UninstallBtn" Style="{StaticResource Danger}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Uninstall..." Padding="18,10"/>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>

  <!-- Toast -->
  <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,118" Visibility="Collapsed"
          Background="{StaticResource Surface3}" BorderBrush="#3A404D" BorderThickness="1" CornerRadius="14" Padding="16,12" MaxWidth="420">
    <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45"/></Border.Effect>
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource Good}" FontSize="16" Margin="0,0,12,0"/>
      <TextBlock x:Name="ToastText" Style="{StaticResource Body}" MaxWidth="340"/>
    </StackPanel>
  </Border>

  <!-- Dialog -->
  <Grid x:Name="DialogLayer" Grid.RowSpan="2" Visibility="Collapsed" Background="#B0080A0E">
    <Border x:Name="DialogCard" Style="{StaticResource Card}" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,26" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
      <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
      <StackPanel>
        <TextBlock x:Name="DialogTitle" Style="{StaticResource H2}" FontSize="20"/>
        <TextBlock x:Name="DialogText" Style="{StaticResource DimText}" Margin="0,10,0,0" FontSize="13.5"/>
        <TextBlock x:Name="DialogMoreLink" Margin="0,14,0,0" FontSize="13.5" FontWeight="SemiBold" Cursor="Hand" Foreground="#FFB23C" Visibility="Collapsed" Text="What's new  ▾"/>
        <ScrollViewer x:Name="DialogMoreScroll" MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Visibility="Collapsed">
          <StackPanel x:Name="DialogMore"/>
        </ScrollViewer>
        <CheckBox x:Name="DialogCheck" Style="{StaticResource Toggle}" Margin="0,18,0,0" Visibility="Collapsed"/>
        <StackPanel x:Name="DialogButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
  <!-- How to play: one idea per card, with pictures and pointers -->
  <Grid x:Name="HelpLayer" Grid.RowSpan="2" Visibility="Collapsed" Background="#C8080A0E">
    <Border x:Name="HelpCard" Width="860" Height="520" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="22"
            Background="{StaticResource Surface}" BorderBrush="#2E333E" BorderThickness="1" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
      <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
      <Border.Effect><DropShadowEffect BlurRadius="44" ShadowDepth="8" Opacity="0.6"/></Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border CornerRadius="21,0,0,21" ClipToBounds="True">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#2C1607" Offset="0"/>
              <GradientStop Color="#1F1020" Offset="0.6"/>
              <GradientStop Color="#151821" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Canvas x:Name="HelpArt" Width="370" Height="520" ClipToBounds="True"/>
        </Border>
        <Grid Grid.Column="1" Margin="36,30,28,26">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="HelpStep" Style="{StaticResource Overline}" Foreground="#FFC58A"/>
          <Button x:Name="HelpClose" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,-10,0" ToolTip="Close"><TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="11"/></Button>
          <TextBlock x:Name="HelpTitle" Grid.Row="1" Style="{StaticResource H1}" FontSize="30" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="HelpLead" Grid.Row="2" Style="{StaticResource DimText}" FontSize="14.5" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="21"/>
          <StackPanel x:Name="HelpRows" Grid.Row="3" Margin="0,20,0,0"/>
          <Grid Grid.Row="4">
            <StackPanel x:Name="HelpDots" Orientation="Horizontal" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="HelpBack" Style="{StaticResource Ghost}" Content="Back" Padding="18,10" Margin="0,0,10,0"/>
              <Button x:Name="HelpNext" Style="{StaticResource Primary}" Width="140" Height="44" FontSize="14" Content="Next"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Grid>
